/// Tests for 'object' singleton declarations.
///

class Monster;
var
   Id : String;

begin
   function Describe() : String;
   begin
      Exit 'a generic monster';
   end

   function Kind() : String;
   begin
      Exit 'monster';
   end
end

object Goblin(Monster);
var
   Hp    : Integer := 10;
   Power : Integer := 3;

begin
   function Describe() : String;
   begin
      Exit 'goblin hp=' + Str(Hp);
   end

   function Loud() : String;
   begin
      Exit super.Describe() + '!';
   end
end

object Orc(Monster);
var
   Hp : Integer := 25;

begin
end

object Standalone;
var
   Note : String := 'no superclass';

begin
   function Show() : String;
   begin
      Exit this.Note;
   end
end

/// An object that declares 'Id' itself.  The declaration wins -- the name is
/// only contributed when the program has not claimed the field.
///
object Renamed;
var
   Id : String := 'something else';

begin
end

/// Declared with no value, which is the subtle case: having named the field,
/// the program owns it, so this is nil rather than 'Blank'.
///
object Blank;
var
   Id : String;

begin
end

test 'Object Is Reached By Name';
begin
   AssertEqual('goblin hp=10', Goblin.Describe());
end

test 'Object Fields';
begin
   AssertEqual(25, Orc.Hp);
   AssertEqual(3, Goblin.Power);
end

test 'Object Inherits Methods';
begin
   AssertEqual('a generic monster', Orc.Describe());
   AssertEqual('monster', Goblin.Kind());
end

test 'Object Super Call';
begin
   AssertEqual('a generic monster!', Goblin.Loud());
end

test 'Object Knows Its Own Id';
begin
   AssertEqual('Goblin', Goblin.Id);
   AssertEqual('Orc', Orc.Id);
end

/// Goblin and Orc inherit a declared 'Id' from Monster, so they would work even
/// if Id were only a field somebody happened to declare.  Standalone has no
/// superclass and declares no Id, which makes it the case that proves Id is
/// contributed by the 'object' declaration itself rather than invented on the
/// instance afterwards.
///
test 'An Object Without A Superclass Still Knows Its Id';
begin
   AssertEqual('Standalone', Standalone.Id);
end

test 'A Declared Id Wins Over The Objects Name';
begin
   AssertEqual('something else', Renamed.Id);
end

test 'A Declared Id With No Value Is Nil, Not The Name';
begin
   AssertEqual(nil, Blank.Id);
end

test 'Object Without Superclass';
begin
   AssertEqual('no superclass', Standalone.Show());
end

test 'Object Is A Singleton';
begin
   // An alias reaches the same instance, so a write through one is visible
   // through the other.
   var Alias := Orc;
   Alias.Hp := 99;

   AssertEqual(99, Orc.Hp);

   Orc.Hp := 25;
   AssertEqual(25, Alias.Hp);
end

test 'Objects Can Be Collected By Hand';
begin
   var Catalog := ['Goblin':Goblin, 'Orc':Orc];

   AssertEqual(2, Catalog.Length);
   AssertEqual(25, Catalog['Orc'].Hp);
end

// A constructor's surroundings: what has already run when its body begins, and
// what has not.  Three of these differ from the languages a reader arrives
// from, so they are pinned rather than left to be rediscovered.
//
// The superclass constructor is NOT called automatically: Derived() runs only
// its own body unless super.Init() is written.  C++ and Java both run the base
// constructor implicitly, and first.
//
// A call on 'this' reaches the MOST DERIVED override, as in Java and unlike
// C++.  But unlike Java that override sees INITIALISED fields, because field
// initialisers are not staged per class -- every one of them, inherited and
// declared, runs before any constructor body.  Java's classic trap does not
// arise here.
//
// Field initialisers run whether or not super.Init() is called, which is the
// part most easily misremembered: omitting the super call skips the parent's
// BODY, not its field setup.
//
class CtorBase;
var
    Trace : String := '';
    Ready : String := 'initialised';
    Extra : String;                 // no initialiser: nil until assigned

begin
    constructor Init ();
    begin
        Trace := Trace + 'B' + Describe();
    end

    function Describe () : String;
    begin
        Exit '(base)';
    end
end

class CtorDerived (CtorBase);
begin
    constructor Init ();
    begin
        super.Init();
        Trace := Trace + 'D';
    end

    function Describe () : String;
    begin
        Exit '(derived sees ' + Str(Ready) + ')';
    end
end

class CtorSilent (CtorBase);
begin
    constructor Init ();
    begin
        Trace := Trace + 'S';
    end
end

test 'Constructor Dispatches To The Most Derived Override';
begin
   AssertEqual('B(derived sees initialised)D', CtorDerived().Trace);
end

test 'Superclass Constructor Is Not Called Automatically';
begin
   // ⚠️ Str('S') and not 'S'.  A one-character literal is a Char, and a Char
   // does not compare equal to a String -- the assertion reads
   // 'Expected Char ''S'' but got String ''S''', which is issue #7 met in the
   // wild rather than in its own reproduction.
   AssertEqual(Str('S'), CtorSilent().Trace);
end

test 'Field Initialisers Run Without The Super Call';
begin
   AssertEqual('initialised', CtorSilent().Ready);
end

test 'A Field Without An Initialiser Is Nil Until Assigned';
begin
   AssertEqual(Str('nil'), Str(CtorSilent().Extra));
end
