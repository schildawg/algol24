/// Tests for module scoping and 'private'.
///
/// 'uses' gives each file an environment of its own.  Everything it declares is
/// visible to the importer except names marked 'private', which stay reachable
/// only from inside the module that declares them.
///

uses ModuleHelper;
uses ModuleHelper2;

test 'Exported Function Is Visible';
begin
    AssertEqual(1, HelperPeek());
end

test 'Two Modules May Each Own A Private Name';
begin
    // Both files declare a private 'Peek'.  Each module's function reaches its
    // own, which is the whole point of the feature.
    AssertEqual(1, HelperPeek());
    AssertEqual(2, Helper2Peek());
end

test 'Two Modules May Each Own A Private Variable';
begin
    AssertEqual(100, Helper2Calls());
end

test 'A Private Variable Is Shared Across Its Module';
begin
    var Before := CallCount();

    Bump();
    Bump();

    // Mutation sticks, so the private var is one binding rather than a copy
    // handed separately to each function that closes over it.
    AssertEqual(Before + 2, CallCount());
end

test 'A Private Class Is Usable Inside Its Module';
begin
    AssertEqual('secret', DescribeSecret());
end

test 'Importing A Module Twice Is A No-op';
begin
    // ModuleHelper is named by this file and, indirectly, nowhere else -- but
    // the guard that makes a repeat 'uses' harmless is what lets a diamond of
    // imports resolve at all.
    AssertEqual(1, HelperPeek());
end

test 'A Name Can Be Reached Through Its Unit';
begin
    // A unit is named by its FILE, so this is the same function the bare name
    // reaches -- qualification says where to look and nothing else.
    AssertEqual(1, ModuleHelper.HelperPeek());
    AssertEqual(HelperPeek(), ModuleHelper.HelperPeek());
    AssertEqual(2, ModuleHelper2.Helper2Peek());
end

test 'Qualification Respects Private';
begin
    // 'Peek' is private in both helpers.  A unit qualifier is not a way around
    // that: it reaches the export set, which is what 'private' removes a name
    // from.
    try
        ModuleHelper.Peek();
        Fail('reached a private name through its unit');
    except
        on E : String do AssertEqual('Undefined name ''Peek'' in unit ''ModuleHelper''.', E);
    end
end

test 'System Reaches A Built-in The Program Has Shadowed';
begin
    // Nothing here shadows anything, so this only pins that the unit exists and
    // means the built-ins.  The shadowed case is checked end to end by the
    // differential programs, which run a file that takes 'Max' over and reach
    // past it from the same file and from another one.
    AssertEqual(4, System.Length('abcd'));
    AssertEqual(9, System.Max(3, 9));
    AssertEqual('bcd', System.Copy('abcdef', 1, 3));
end

test 'A Chain Reaches Two Hops Down';
begin
    // Modules.a24 -> ModuleHelper -> ModuleHelper3.  This file may not name
    // ModuleHelper3, so the value comes back through ModuleHelper.
    AssertEqual(3, ViaHelper3());
end
