unit Shapes;

/// A unit whose primary class shares its name.
///
/// ⚠️ That is the ordinary shape, not an edge case: seventeen of algc's
/// twenty-two units are exactly this.  A bare class name cannot answer a dot in
/// any version of this language, so 'Shapes.Describe()' is free to mean the
/// unit while bare 'Shapes' goes on meaning the class.

class Shapes;
begin
    function Name() : String;
    begin
        Exit 'the class';
    end
end

class Circle;
var
    R : Integer;

begin
    constructor Init (R : Integer);
    begin
        this.R := R;
    end

    function Area() : Integer;
    begin
        Exit 3 * R * R;
    end
end

function Describe() : String;
begin
    Exit 'a free function';
end

/// Qualification must not route around 'private'.
private function Hidden() : String;
begin
    Exit 'not yours';
end

/// Read through the unit rather than called, which is a different emitter path.
var Sides := 4;
