// spec: DCL-014
//
// A subclass does not reach what its parent hid, when the receiver is declared
// as the parent.

class Parent;
private:
var Secret : Integer;
public:
begin
    constructor Init (); begin this.Secret := 1; end
end

class Child (Parent);
begin
    function Peek (P : Parent); begin Exit P.Secret; end
end

WriteLn (Child ().Peek (Parent ()));
