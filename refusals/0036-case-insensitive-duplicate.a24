// spec: SRC-011, VAR-007
//
// 'Xyz' and 'xyz' are ONE name, so the second declaration is a duplicate.
//
// ⚠️ The diagnostic quotes the lexeme AS WRITTEN, and names the OFFENDING
// occurrence -- the second declaration, spelled 'xyz'.  Every message on this
// path had to be corrected to do that: folding the key made them echo the key,
// so a program writing 'Shared' was told about 'shared' and a unit spelled
// 'Deep' was reported as 'deep'.

var Xyz := 1;
var xyz := 2;
