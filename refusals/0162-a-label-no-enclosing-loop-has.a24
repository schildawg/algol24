// spec: STM-010
//
// 'break' and 'continue' may name only a loop they are inside.  A label that
// names no enclosing loop is refused WHERE IT IS WRITTEN, on the same terms a
// 'break' outside a loop altogether is [STM-010] -- the parser is where the
// enclosing loops are known, and the jump is wrong however the program runs.

Outer:
for var I := 0; I < 3; I := I + 1 do
begin
    break Inner;
end
