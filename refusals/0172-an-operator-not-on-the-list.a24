// spec: EXP-020
//
// A class may define only '+', '-', '*', '/' and 'div'.  The list is closed
// because a new operator would need a precedence and an associativity, and
// [EXP-001] is a fixed table of seven levels with nowhere to put one.
//
// ⚠️ '=' in particular is not on it, and not merely for want of a place in the
// table: equality is coupled to membership by [VAL-013], so defining it would
// need a hash protocol to move with it.  See Annex H, H-17.

class Pair;
var Left, Right : Integer;

begin
    constructor Init (L : Integer, R : Integer); begin this.Left := L; this.Right := R; end

    operator = (Other : Pair) : Boolean; begin Exit Left = Other.Left; end
end
