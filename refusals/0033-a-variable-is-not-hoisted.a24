// spec: DCL-016
//
// ⚠️ A RUNTIME error rather than a refusal in the strict sense -- but the
// program produces no output before it, so it is recorded here beside the
// hoisting cases it contrasts with.
//
// A variable is not visible before its declaration has run.  The compiled back
// end hoists it and prints 'nil', substituting a value for a diagnostic (C-10).

WriteLn (Later);

var Later := 7;
