/// Core -- what the core of the language need not provide.
///
/// ⚠️ NOT called 'System', which is taken: the language's own System unit is
/// the built-ins [MOD-011], reachable as 'System.Ord'.  A library unit of that
/// name would be a second one, and 'System.Max' would mean different things
/// depending on which was in scope.
///
/// ⚠️ Moved OUT of the language, not added to it.  Each of these was a built-in
/// with a rule of its own; they are ordinary Algol-24 here, and the core is
/// smaller for it.  Nothing in the language could not be written in the
/// language -- that was the claim, and this is where it is paid.

/// The greater of two numbers, promoting as arithmetic does.
function Max (A, B);
begin
    if not ((A is Integer or A is Double) and (B is Integer or B is Double)) then
        raise 'Max expects numbers.';

    if A > B then Exit A;

    Exit B;
end

test 'Max takes the greater';
begin
    AssertEqual (7, Max (3, 7));
    AssertEqual (7, Max (7, 3));
    AssertEqual (3, Max (3, 3));
end

/// The remainder, its sign following the dividend.
///
/// ⚠️ `A - (A div B) * B` and not a primitive, because `div` truncates toward
/// zero [EXP-018] -- which is exactly what makes the remainder take the
/// dividend's sign.  Mod(-7, 3) is -1 and Mod(7, -3) is 1.
///
/// ⚠️ Its own zero check, because `div` would raise `Division by zero.` and the
/// message here names the operation the program actually wrote.
function Mod (A, B);
begin
    if not (A is Integer and B is Integer) then raise 'Mod expects Integers.';
    if B = 0 then raise 'Mod failed: Division by zero.';

    Exit A - (A div B) * B;
end

/// Succ and Pred step an ordinal: an Integer by one, a Char by one code point.
///
/// ⚠️ NOT enums.  'Succ (Red)' is 'Succ failed: ''Red'' has no ordinal.' -- an
/// enum member answers `Ordinal` [ENU-010] and stepping one was never part of
/// this.  Anything that is not an Integer or a single character is the same
/// message.
///
/// ⚠️ The two failures are different sentences.  A value with no ordinal at all
/// is one thing; a Char at the end of the range, where the ordinal exists and
/// the next one does not, is another.
function Stepped (X, By : Integer, What : String) : Any;
begin
    if X is Integer then Exit X + By;

    if not (X is Char) then
        raise What + ' failed: ''' + Str (X) + ''' has no ordinal.';

    var Code := Ord (X) + By;
    if Code < 0 or Code > 1114111 then
        raise What + ' failed: ''' + Str (X) + ''' has no ordinal beyond it.';

    Exit Char (Code);
end

function Succ (X);
begin
    Exit Stepped (X, 1, 'Succ');
end

function Pred (X);
begin
    Exit Stepped (X, -1, 'Pred');
end

/// The code point of one character, as an Integer.
///
/// ⚠️ An Integer and a Boolean answer too, and are not characters: an ordinal
/// is what `Ord` asks for, and an Integer already is one while a Boolean is
/// `1` or `0`.  Anything else -- a Double, nil, or text that is not exactly one
/// character -- is `Ord failed: 'X' has no ordinal.`
///
/// ⚠️ Decoded from UTF-8 by hand, over a Buffer's bytes, because there is no
/// other way for Algol-24 to see the bytes of a character.  A continuation byte
/// has its top two bits set to 10; the lead byte says how many follow.
function Ord (X) : Integer;
var
    B : Buffer;

begin
    if X is Integer then Exit X;

    if X is Boolean then
    begin
        if X then Exit 1;
        Exit 0;
    end

    // ⚠️ AN ENUM MEMBER ANSWERS TOO, and asking is the only way to find out.
    // A member carries its zero-based position as `Ordinal` [ENU-010] and
    // nothing else in the language does -- an Integer, a Char, nil, an instance
    // and a List were all checked, and every one of them raises.  There is no
    // `is Enum`, so a library function has no way to ask the question directly;
    // see LIBRARY.md, Q7.
    try Exit X.Ordinal; except end

    // ⚠️ A Char, never a one-character String, and the built-in was stricter
    // than it looked: 'Ord (Copy (''abc'', 1, 1))' fails where 'Ord (''b'')'
    // works, because a literal of one character IS a Char and a Copy of one is
    // not [LEX-026].  An equivalence check found this; reading the rule did not.
    if not (X is Char) then
        raise 'Ord failed: ''' + Str (X) + ''' has no ordinal.';

    B := Buffer ();
    B.Append (X);

    var Lead := B[0];
    if Lead < 128 then
    begin
        B.Free ();
        Exit Lead;
    end

    var Code  := 0;
    var Extra := 0;

    if Lead < 224      then begin Code := Mod (Lead, 32); Extra := 1; end
    else if Lead < 240 then begin Code := Mod (Lead, 16); Extra := 2; end
    else                    begin Code := Mod (Lead, 8);  Extra := 3; end

    for var I := 1; I <= Extra; I := I + 1 do
        Code := Code * 64 + Mod (B[I], 64);

    B.Free ();
    Exit Code;
end

test 'Max promotes, which it once did not';
begin
    AssertEqual (3.5, Max (3.5, 2));
    AssertEqual (3.5, Max (2, 3.5));
    AssertEqual (7,   Max (3, 7));
end
