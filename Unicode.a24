/// How many bytes the UTF-8 character introduced by this lead byte occupies,
/// or 0 if the byte cannot introduce one.
///
/// ⚠️ 0 for a CONTINUATION byte (0x80-0xBF) as well as for 0xF8 and above, so
/// a caller that steps by the result alone would not advance. Every caller here
/// treats 0 as "one bad byte" and steps by one, which is what stops an
/// ill-formed file from looping.
///
function SequenceLength (Lead : Integer) : Integer;
begin
    if Lead < 128 then Exit 1;
    if Lead < 192 then Exit 0;
    if Lead < 224 then Exit 2;
    if Lead < 240 then Exit 3;
    if Lead < 248 then Exit 4;

    Exit 0;
end

/// The code point of the character starting at Index, or -1 if the bytes there
/// are not well-formed UTF-8.
///
/// ⚠️ Rejects the three ill-formed encodings that decode to a plausible number
/// rather than failing outright: an OVERLONG form (a code point encoded in more
/// bytes than it needs), a SURROGATE (U+D800-U+DFFF, which UTF-8 may not carry),
/// and anything above U+10FFFF. Accepting an overlong would let two different
/// byte sequences name one identifier, which is exactly the injectivity the
/// mangler depends on.
///
function CodePointAt (Text : String, Index : Integer) : Integer;
var
    Code : Integer;

begin
    var Bytes := SequenceLength (Ord (Text[Index]));
    if Bytes = 0 then Exit -1;

    if Index + Bytes > Length (Text) then Exit -1;

    if Bytes = 1 then Exit Ord (Text[Index]);

    if Bytes = 2 then Code := Mod (Ord (Text[Index]), 32);
    else if Bytes = 3 then Code := Mod (Ord (Text[Index]), 16);
    else Code := Mod (Ord (Text[Index]), 8);

    for var I := 1; I < Bytes; I := I + 1 do
    begin
        var Continuation := Ord (Text[Index + I]);
        if Continuation < 128 or Continuation > 191 then Exit -1;

        Code := Code * 64 + Mod (Continuation, 64);
    end

    if Bytes = 2 and Code < 128 then Exit -1;
    if Bytes = 3 and Code < 2048 then Exit -1;
    if Bytes = 4 and Code < 65536 then Exit -1;

    if Code >= 55296 and Code <= 57343 then Exit -1;
    if Code > 1114111 then Exit -1;

    Exit Code;
end

/// Whether a code point is a Unicode letter -- category Lu, Ll, Lt, Lm or Lo.
///
/// ⚠️ Bisection over LETTER_RANGES, not a scan. There are 659 ranges and this
/// runs once per non-ASCII character of every identifier in every file the
/// compiler reads, itself included.
///
function IsLetterCode (Code : Integer) : Boolean;
var
    Low  : Integer := 0;
    High : Integer;

begin
    High := LETTER_RANGES.Length / 2 - 1;

    while Low <= High do
    begin
        var Middle := (Low + High) / 2;

        if Code < LETTER_RANGES[Middle * 2] then High := Middle - 1;
        else if Code > LETTER_RANGES[Middle * 2 + 1] then Low := Middle + 1;
        else Exit True;
    end

    Exit False;
end

/// The case fold of a whole name.
///
/// ⚠️ ASCII is folded arithmetically and everything else through CASE_FOLDS, so
/// an all-ASCII name -- which is nearly all of them -- costs no Map lookup.
///
/// ⚠️ The result may be LONGER than its input, because the fold is full: `ß` is
/// one character and folds to two. Nothing may assume the folded lexeme and the
/// spelling share a length or an index.
///
function FoldOf (Text : String) : String;
var
    Result : String := '';
    Index  : Integer := 0;

begin
    while Index < Length (Text) do
    begin
        var Code := Ord (Text[Index]);

        if Code < 128 then
        begin
            if Code >= 65 and Code <= 90 then Result := Result + Char (Code + 32);
            else Result := Result + Text[Index];

            Index := Index + 1;
        end
        else
        begin
            var Bytes := SequenceLength (Code);
            if Bytes = 0 then Bytes := 1;

            var Character := Copy (Text, Index, Bytes);

            if CASE_FOLDS.Contains (Character) then
                Result := Result + Str (CASE_FOLDS.Get (Character));
            else Result := Result + Character;

            Index := Index + Bytes;
        end
    end

    Exit Result;
end
