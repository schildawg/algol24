// spec: ENU-010
//
// ⚠️ A defect is a statement about the INTERPRETER and is never compiled.
//
// ENU-010 requires a member to answer Ordinal, its zero-based position, so
// this must print 0 then 2.  A member is opaque instead.
//
// ⚠️ The position is not merely unpublished -- it GOVERNS behaviour, because
// truthiness reads it [ENU-009].  A program can discover whether a member is
// falsey only by testing it for truth, which is the whole of D-13.

type Colour = (RED, GREEN, BLUE);

WriteLn (Str (RED) + ' is falsey: ' + Str (not RED));

WriteLn (RED.Ordinal);
WriteLn (BLUE.Ordinal);
