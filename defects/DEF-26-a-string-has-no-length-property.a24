// spec: RT-017
//
// ⚠️ A defect is a statement about the INTERPRETER and is never compiled.
//
// RT-017 makes a String answer Length as a property, so this must print 3.
// The interpreter refuses it; the COMPILED back end already answers 3 (C-9),
// which makes this one of the two places where the compiler is right and the
// interpreter is the one to change.
//
// ⚠️ A String is already iterable and subscriptable, so both lines below work.
// Not answering for its own length was the odd one out.

var S := 'abc';

WriteLn (S[0]);
for var C in S do Write (C);
WriteLn ('');

WriteLn (S.Length);
