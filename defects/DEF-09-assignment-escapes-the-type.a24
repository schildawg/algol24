// spec: VAR-006
//
// VAR-006 requires a written type to be enforced wherever a value reaches the
// variable.  Only the declaration enforces it.
//
//     var I : Integer := A;    -- refused (refusals/0013)
//
// The two lines below are that same assignment, one line apart, and they are
// accepted.  This must become a refusal.

var A : Any := 1;

var I : Integer;
I := A;
WriteLn (I);

// And nothing about the value has to be an Integer for it to land in one.
var S : Any := 'not an integer';
var J : Integer;
J := S;
WriteLn (J);
WriteLn (J is String);
