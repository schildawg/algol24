// spec: ERR-006
//
// ⚠️ A defect is a statement about the INTERPRETER and is never compiled.
//
// ERR-006 requires the three-line excerpt a parse error carries and both type
// names -- 'Expected Integer, found String.'  Five words arrive instead, with
// no file, no line, no token and neither type.
//
// ⚠️ Compare refusals/0008 and conformance/0100: the parser prints the file,
// the line, the source text and a caret for the SAME program shape.  The
// machinery exists and is used two phases earlier; the checker does not reach
// for it.
//
// ⚠️ And with ERR-002 there is no output to orient by either, because the
// program is stopped before any statement runs.  The message below is
// everything the programmer is given about a fault on line 22.

WriteLn ('never printed');

var Count  : Integer := 1;
var Name   : String  := 'text';
var Amount : Double  := 1.5;

var Wrong : Integer := Name;
