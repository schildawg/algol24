// spec: TYP-011
//
// ⚠️ Expected to FAIL compiled, because of C-8: the message matches, the
// 'Uncaught: ' prefix does not.

class Bag;
var Items : List;
begin
    constructor Init (); begin this.Items := [1, 2]; end
end

var B := Bag ();
WriteLn (B.Items.Length);

for var X in B do WriteLn (X);
