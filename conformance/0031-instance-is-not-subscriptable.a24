// spec: TYP-010
//
// ⚠️ A class WITHOUT 'Get' is not subscriptable, which is what this pins.  A
// class with one is [TYP-010], and 0171 covers that half -- the same division
// 0032 and 0165 make for iteration.  'At' is a method like any other and does
// not implement the protocol: a protocol is a NAME and a shape.

class Box;
var Items : List;
begin
    constructor Init (); begin this.Items := [10, 20]; end
    function At (I); begin Exit this.Items[I]; end
end

var B := Box ();
WriteLn (B.At (0));

WriteLn (B[0]);
