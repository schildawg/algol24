// spec: TYP-010
//
// ⚠️ Expected to FAIL compiled, because of C-7: both processors refuse this
// program, with different wording.

class Box;
var Items : List;
begin
    constructor Init (); begin this.Items := [10, 20]; end
    function At (I); begin Exit this.Items[I]; end
end

var B := Box ();
WriteLn (B.At (0));

WriteLn (B[0]);
