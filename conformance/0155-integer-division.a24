// spec: EXP-018
//
// 'div' is integer division, said deliberately.
//
// ⚠️ '/' is integer division on two Integers and real division as soon as a
// Double reaches it, so 'X / Y' cannot be read where X is declared Any.  'div'
// always truncates, and refuses what is not an Integer.

WriteLn (7 div 2);
WriteLn (-7 div 2);
WriteLn (7 div 2 is Integer);

// It binds as '*' and '/' do, so this groups as 'A + (B div C)'.
WriteLn (1 + 8 div 2);

// It grows with the Integer it divides [LEX-018].
WriteLn (9223372036854775807 * 2 div 2);

// ⚠️ A Double is REFUSED rather than truncated -- the bargain Mod makes.  '/'
// would quietly do real division instead, which is the ambiguity div exists to
// remove.
try
    WriteLn (7.0 div 2);
except
    on e : String do WriteLn (e);
end

try
    WriteLn (7 div 0);
except
    on e : String do WriteLn (e);
end

// '/' is unchanged, and still means both things.
WriteLn (7 / 2);
WriteLn (7.0 / 2);
