// spec: MOD-009
//
// Mid uses Deep.  This file uses Mid, so it sees Mid's names -- including one
// that reaches into Deep on its behalf -- but not Deep's own.

uses 'modules/Mid';

WriteLn (MidName ());
WriteLn (MidReachesDeep ());

// The diagnostic names the unit that would export it.
WriteLn (DeepName ());
