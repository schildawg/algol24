// spec: COL-005, TYP-012
//
// A built-in member read without being called is a value, and prints as a
// bound method does [TYP-012] -- it is the same kind of thing.
//
// ⚠️ The spelling is the one the PROGRAM WROTE, which is the only one both
// processors can agree on: a bound method prints the name its declaration
// used, and a built-in member has no declaration in the language to take a
// canonical spelling from.

var L := [3, 1, 2];

WriteLn (L.Sort);
WriteLn (L.SORT);
WriteLn (L.Add);

// The other two receivers whose members come from the runtime rather than
// from a class.
var B := Buffer (4);
WriteLn (B.Append);

var F := TextFile ();
WriteLn (F.WriteLn);

// And it is callable, which is the point of reading one.
var Sort := L.Sort;
Sort ();
WriteLn (L[0]);
