// spec: ERR-003
//
// A runtime error occurs during execution, so statements before it have run
// and their output stands.  This is the contrast with 0097: the same shape of
// program, failing in a different phase, keeps its output.

WriteLn ('this line runs');
WriteLn ('and so does this one');

var L := [1, 2];
WriteLn (L[9]);

WriteLn ('never reached');
