// spec: SRC-005, LEX-007, LEX-008
//
// '?' and '!' are identifier MARKS: they continue an identifier and may not
// begin one, so 'Gate?' and 'Send!' are single words while '?' and '!' alone
// are not identifiers at all.

var Gate?     := 1;
var Send!     := 2;
var _under    := 4;
var a1b2      := 8;
var Ready?Set := 16;

WriteLn (Gate? + Send! + _under + a1b2 + Ready?Set);

// A mark does not end a word, and either may appear more than once.
var Both?!    := 32;
WriteLn (Both?!);
