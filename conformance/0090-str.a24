// spec: RT-006
//
// Str renders any value, and the renderings are specified rather than left to
// the representation -- both processors must produce the same text.

WriteLn (Str (42));
WriteLn (Str (1.0));
WriteLn (Str (1.5));
WriteLn (Str (True));
WriteLn (Str (False));
WriteLn (Str (nil));
WriteLn (Str ('text'));
WriteLn (Str ('c'));
WriteLn (Str ([10, 20, 30]));
WriteLn (Str ([1 : 2]));
WriteLn (Str ([]));

class Plain; begin constructor Init (); begin end end
WriteLn (Str (Plain ()));

class Pretty;
begin
    constructor Init (); begin end
    function ToString (); begin Exit 'rendered by ToString'; end
end
WriteLn (Str (Pretty ()));

type Colour = (RED, GREEN);
WriteLn (Str (RED));
