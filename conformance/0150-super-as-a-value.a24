// spec: CLS-012, CLS-011
//
// 'super.M' read without calling it binds the parent's method to this
// receiver, exactly as 'B.M' binds the receiver's own [CLS-011].
//
// ⚠️ The search starts above the class that DECLARED the running method, not
// above the receiver's own class -- so an override does not find itself. That
// is what makes the value worth having: it is the only way to hold the
// implementation the override replaced.

class Animal;
begin
    constructor Init (); begin end
    function Speak (); begin Exit 'animal'; end
    function Name  (); begin Exit 'Animal'; end
end

class Dog (Animal);
begin
    constructor Init (); begin end
    function Speak (); begin Exit 'woof'; end

    function Both ();
    begin
        var Parent := super.Speak;

        Exit Parent () + ' and ' + Speak ();
    end

    function Held ();
    begin
        var M := super.Name;

        Exit M;
    end
end

var D := Dog ();

WriteLn (D.Both ());

// It survives being returned, so the binding is on the value and not on the
// method that made it.
WriteLn (D.Held () ());

// And it prints as a bound method does [TYP-012].
WriteLn (D.Held ());
