// spec: EXP-006
//
// ⚠️ Expected to FAIL compiled, because of C-8: the compiled runtime omits
// the 'Uncaught: ' prefix.
//
// ⚠️ Double division by zero is NOT an error.  These three print and the
// program continues.

WriteLn (1.0 / 0);
WriteLn (-1.0 / 0);
WriteLn (0.0 / 0);

// Integer division by zero is.  The asymmetry is specified, not tolerated.
WriteLn (1 / 0);
