// spec: EXP-015
//
// ⚠️ Expected to FAIL compiled, because of C-8: the compiled runtime omits
// the 'Uncaught: ' prefix.
//
// ⚠️ ASCII only.  EXP-015 counts CHARACTERS and the implementation counts
// bytes, so a subscript into text outside ASCII is DEF-01's business, not
// this case's.

var S := 'abc';

WriteLn (S[0]);
WriteLn (S[2]);
WriteLn (S[0] is Char);

WriteLn (S[9]);
