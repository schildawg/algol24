// spec: EXP-015
//
// ⚠️ CHARACTERS, not bytes [SRC-004].  This case was ASCII-only while the
// implementation counted bytes; 'café'[3] was the first half of a two-byte
// sequence rather than 'é', and the bound was five rather than four.

var S := 'abc';

WriteLn (S[0]);
WriteLn (S[2]);
WriteLn (S[0] is Char);

var T := 'café';

WriteLn (T[3]);
WriteLn (T[3] is Char);
WriteLn (Length (T));

// The bound is in characters too, so the last index is 3 and not 4.
try
    WriteLn (T[4]);
except
    on e : String do WriteLn (e);
end

WriteLn (S[9]);
