// spec: VAL-014
//
// compiled: no
//
// ⚠️ Opted out of the compiled half because of C-8: the compiled runtime omits
// the 'Uncaught: ' prefix.
//
// ⚠️ Ends in a RUNTIME error, so it belongs here rather than in refusals/: the
// program is accepted and runs before it raises.
//
// ⚠️ Pinned deliberately.  H-7 would give Strings an ordering, and this case is
// what turns red when it lands.

// Numbers and Chars order.
WriteLn (1 < 2);
WriteLn (1.5 >= 1.5);
WriteLn ('a' < 'b');

// Strings do not.
WriteLn ('ab' < 'cd');
