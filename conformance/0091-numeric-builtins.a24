// spec: RT-011, RT-012
//

// RT-011: Mod's sign follows the DIVIDEND.
uses 'lib/Core';        // Mod, Succ and Pred are library functions now

WriteLn (Mod (7, 3));
WriteLn (Mod (-7, 3));
WriteLn (Mod (7, -3));
WriteLn (Mod (6, 3));

// RT-012: clock() is a Double.
WriteLn (clock () is Double);
WriteLn (clock () > 0.0);
