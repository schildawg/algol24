// A fixture for chapter 23, not a conformance case.
//
// DELIBERATELY MISSING A SEMICOLON after its exit value, so a diagnostic
// raised while parsing it must name THIS file and quote THIS line.  Nothing
// else imports it, and anything that does will fail to parse -- which is the
// whole of what it is for.

unit Broken;

function Twice (N : Integer) : Integer;
begin
    Exit N * 2
end
