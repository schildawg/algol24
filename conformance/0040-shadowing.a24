// spec: DCL-003, DCL-004
//
// ⚠️ The shadowing happens inside a PROCEDURE rather than in a bare top-level
// block, so that this case can run under both processors.  A top-level
// begin...end is reordered by the compiled back end -- see C-11 -- which would
// otherwise force this case to opt out and lose the cross-check.

procedure ShadowsAVar ();
var X : Integer := 1;
begin
    begin
        // DCL-003: the inner declaration shadows the outer for the rest of its
        // scope.  The outer binding is untouched.
        var X := 2;
        WriteLn (X);

        X := 3;
        WriteLn (X);
    end

    WriteLn (X);
end

procedure ShadowsAConst ();
const K := 10;
begin
    begin
        // DCL-004: a var may shadow a const.  The inner name is an ordinary
        // variable and may be assigned.
        var K := 20;
        K := 30;
        WriteLn (K);
    end

    // The outer constant is unaffected.
    WriteLn (K);
end

ShadowsAVar ();
ShadowsAConst ();
