// spec: RT-009, RT-010
//
// Val answers an Integer where the text is one, and a Double where it is not.
// Max takes any two numbers and promotes.
//
// ⚠️ The last two lines are the point.  Each built-in was defensible alone --
// Val always yielding a Double, Max taking Integers only -- and together they
// left 'Max (Val (A), Val (B))' failing for EVERY input.

WriteLn (Val ('42'));
WriteLn (Val ('42') is Integer);
WriteLn (Val ('-7'));
WriteLn (Val ('1.5'));
WriteLn (Val ('1.5') is Double);

WriteLn (Max (3, 7));
WriteLn (Max (3.5, 2));
WriteLn (Max (2, 3.5));

WriteLn (Max (Val ('3'), Val ('7')));
WriteLn (Max (Val ('3.5'), Val ('2')));
