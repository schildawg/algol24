// spec: LEX-004
//

// Whitespace and comments SEPARATE tokens and are otherwise discarded, so the
// same expression written densely and written spaciously is one token stream.
var Dense := 1+2*3;
var Loose :=   1    // a comment between two tokens
    +
    2  *  3 ;

WriteLn (Dense);
WriteLn (Loose);
WriteLn (Dense = Loose);
