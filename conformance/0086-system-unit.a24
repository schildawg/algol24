// spec: MOD-011
//
// System is the unit of the built-in functions.  No file imports it and every
// file may qualify against it.

WriteLn (System.Copy ('abcdef', 0, 3));
WriteLn (System.Length ('abc'));
WriteLn (System.Ord ('A'));

// ⚠️ Max USED to be one of these and is a library function now, so it is no
// longer reachable as System.Max -- which is the point of the qualifier: it
// names the built-ins, and only those.

// The bare spellings are the same functions.
WriteLn (System.Copy ('abcdef', 0, 3) = Copy ('abcdef', 0, 3));
