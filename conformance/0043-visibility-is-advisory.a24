// spec: DCL-015
//
// ⚠️ This case pins a WEAKNESS, deliberately.  DCL-015 says private: is
// advisory -- checked statically and only where the receiver's type is known --
// and a specification that says so must be able to show it.
//
// Both processors agree here, so this is a property of the language rather
// than of one implementation.

class Counter;
private:
var Count : Integer;
public:
begin
    constructor Init (); begin this.Count := 5; end
end

// Through a receiver declared Any, the static check cannot see the type, and
// the private field is readable...
var C : Any := Counter ();
WriteLn (C.Count);

// ... and writable.
C.Count := 99;
WriteLn (C.Count);
