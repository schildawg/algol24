// spec: TYP-014
//
// 'Real' is another spelling of 'Double', not a second type.

var X : Real := 1.5;

WriteLn (X);
WriteLn (X is Real);
WriteLn (X is Double);

// ⚠️ One type, so widening reaches it exactly as it reaches the other
// spelling [VAR-004].
var Y : Real := 1;
WriteLn (Y);
WriteLn (Y is Double);

// A parameter declared either way accepts the same arguments.
function Twice (R : Real); begin Exit R * 2; end

WriteLn (Twice (3));
WriteLn (Twice (2.5));

var Z : Any := 1.5;
WriteLn (Z as Real);

// ⚠️ The CANONICAL spelling is what a diagnostic names, which is the alias
// telling the reader what it is.
var Bad : Any := 'text';
try
    WriteLn (Bad as Real);
except
    on e : String do WriteLn (e);
end

// It folds like every other name [SRC-011].
WriteLn (1.5 is real);
WriteLn (1.5 is REAL);
