// spec: COL-001
//
// A collection literal may hold any number of elements, and they need not be
// constants.
//
// ⚠️ Compiled this is refused -- C-27.  A literal is emitted as nested calls,
// one bracket level per element, and cc gives up at 256; above a hundred
// elements the emitter builds it in a helper instead, which it can only do when
// every element is itself a literal.  These are a variable.

var N := 7;
var Big := [N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N, N];

WriteLn (Big.Length);
WriteLn (Big[0] + Big[149]);
