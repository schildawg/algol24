// spec: STM-006, DCL-008
//
// A counted 'for' declares its variable in a scope of its own, so two loops at
// the top level may use the same name.  The second does not see the first's.
//
// ⚠️ Compiled this does not build -- C-13.  The emitter hoists both variables
// to file scope and 'cc' answers 'redefinition of v_I'.

for var I := 0; I < 2; I := I + 1 do Write (I);
WriteLn ('');

for var I := 0; I < 3; I := I + 1 do Write (I);
WriteLn ('');

// And the name is gone once the loop is over [DCL-008].
var I := 'not the loop variable';
WriteLn (I);
