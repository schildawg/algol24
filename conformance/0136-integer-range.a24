// spec: LEX-018, EXP-007
//
// Arithmetic inside the 32-bit range is unaffected, including at the edges.

WriteLn (2147483646 + 1);
WriteLn (-2147483647 - 1);
WriteLn (46340 * 46340);
WriteLn (2147483647 / 1);
WriteLn (-(-2147483647));

// ⚠️ The most negative Integer has no literal [LEX-033], so this is how it is
// written -- and the subtraction that reaches it is itself in range.
WriteLn (-2147483647 - 1);

// ⚠️ Only INTEGER arithmetic is ranged.  A Double follows IEEE 754 and does not
// raise -- 1.0 / 0 is Infinity [EXP-006], which conformance/0047 pins.
WriteLn (1.0 / 0 > 0);
WriteLn (2147483647 + 1.0);
