// spec: STM-009
//
// The collection is snapshotted when the loop begins, so adding to it inside
// the loop does not lengthen the walk.  Without the snapshot this would not
// terminate.

var L := [1, 2, 3];

for var E in L do
begin
    Write (E);
    L.Add (E + 10);
end
WriteLn ('');

// The additions did happen -- the walk simply did not see them.
WriteLn (L.Length);
