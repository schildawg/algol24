/// A text file handle, in Turbo Pascal's shape, as the interpreter sees it.
///
/// Wraps the host's TextFile the way ObjCollection wraps the host's List and
/// Map: every method delegates, so the failure messages -- 'Reset failed: cannot
/// open ''name''.' and the rest -- come from the one implementation rather than
/// from a second copy that would have to be kept in step.
///
/// Turbo Pascal spells these as free procedures over a 'var F : Text'
/// parameter.  Algol-24 has neither var parameters nor a Text type, so the
/// handle became the receiver; the names and their meanings are unchanged.
unit ObjFile;

uses Token;

/// A bound file method: a receiver, a name, and an arity.
///
/// One class rather than one per method, for the same reason CollectionMethod is
/// one class: the interpreter's calling convention wants something with Arity
/// and Call, and this is less code than twelve near-identical classes.
class FileMethod;
var
    /// The file the method is bound to.
    Receiver : ObjFile;

    /// The member name, as a TOKEN rather than the folded string.
    ///
    /// Dispatch wants the fold and a diagnostic wants the spelling the program
    /// wrote [SRC-011]; keeping the token keeps both without a second table.
    Name     : Token;

    /// How many arguments the member takes.
    TheArity : Integer;

begin
    /// Makes a method bound to a file.
    constructor Init (Receiver : ObjFile, Name : Token, TheArity : Integer);
    begin
        this.Receiver := Receiver;
        this.Name := Name;
        this.TheArity := TheArity;
    end

    /// How many arguments the member takes.
    function Arity () : Integer;
    begin
        Exit TheArity;
    end

    /// Invokes the member on its receiver.
    function Call (TheInterpreter, Arguments) : Any;
    begin
        Exit Receiver.Invoke (FoldCase (Str (Name.Lexeme)), Arguments);
    end

    /// Prints the member as a bound method is printed [TYP-012].
    ///
    /// It is the same kind of thing: a member read without being called.
    /// This inherited ObjInstance's rendering and printed 'FileMethod instance',
    /// naming a class that exists only inside algc -- a program has no way to
    /// know it, and nothing in the language answers to it.
    function ToString () : String;
    begin
        Exit '<fn ' + Str (Name.Lexeme) + '>';
    end
end

/// A TextFile as a program sees it, delegating to the host's.
class ObjFile;
var
    /// The host handle this stands for.
    Handle : Any;

begin
    /// Makes an unassigned file handle.
    constructor Init ();
    begin
        this.Handle := TextFile();
    end

    /// Gets a property.
    ///
    /// Eof answers directly -- it is a property in Algol-24, written without
    /// parentheses -- and everything else hands back something callable.
    ///
    /// # Raises
    ///
    /// 'Undefined property ''X''.' for a name a TextFile does not answer.
    ///
    /// # Satisfies
    ///
    /// [RT-021]
    function Get (TheName : Token) : Any;
    var
        Member : String;

    begin
        Member := FoldCase (TheName.Lexeme);

        if Member = 'eof' then Exit Handle.Eof;

        if Member = 'assign'  then Exit FileMethod (this, TheName, 1);
        if Member = 'reset'   then Exit FileMethod (this, TheName, 0);
        if Member = 'rewrite' then Exit FileMethod (this, TheName, 0);
        if Member = 'append'  then Exit FileMethod (this, TheName, 0);
        if Member = 'readln'  then Exit FileMethod (this, TheName, 0);
        if Member = 'write'   then Exit FileMethod (this, TheName, 1);
        if Member = 'writeln' then Exit FileMethod (this, TheName, 1);
        if Member = 'flush'   then Exit FileMethod (this, TheName, 0);
        if Member = 'close'   then Exit FileMethod (this, TheName, 0);
        if Member = 'erase'   then Exit FileMethod (this, TheName, 0);
        if Member = 'rename'  then Exit FileMethod (this, TheName, 1);

        raise 'Undefined property ''' + Str (TheName.Lexeme) + '''.';
    end

    /// Calls a method on the host handle.
    ///
    /// Every one delegates, so the open-and-read rules -- and the six members
    /// that refuse a file already open -- come from the host rather than from a
    /// second copy of them here.
    ///
    /// # Raises
    ///
    /// 'Undefined method ''X''.' for a name a TextFile does not answer, and
    /// whatever the host raises for a use the rules forbid.
    ///
    /// # Satisfies
    ///
    /// [RT-016], [RT-024]
    function Invoke (Name : String, Arguments : List) : Any;
    begin
        if Name = 'assign'  then Exit Handle.Assign (Arguments[0]);
        if Name = 'reset'   then Exit Handle.Reset ();
        if Name = 'rewrite' then Exit Handle.Rewrite ();
        if Name = 'append'  then Exit Handle.Append ();
        if Name = 'readln'  then Exit Handle.ReadLn ();
        if Name = 'write'   then Exit Handle.Write (Arguments[0]);
        if Name = 'writeln' then Exit Handle.WriteLn (Arguments[0]);
        if Name = 'flush'   then Exit Handle.Flush ();
        if Name = 'close'   then Exit Handle.Close ();
        if Name = 'erase'   then Exit Handle.Erase ();
        if Name = 'rename'  then Exit Handle.Rename (Arguments[0]);

        raise 'Undefined method ''' + Name + '''.';
    end

    /// Prints the file as the language names it.
    function ToString () : String;
    begin
        Exit Str (Handle);
    end
end
