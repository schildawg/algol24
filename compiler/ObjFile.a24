uses Token;

/// A text file handle, in Turbo Pascal's shape.
///
/// Wraps the host's TextFile the way ObjCollection wraps the host's List and
/// Map: every method delegates, so the failure messages -- 'Reset failed:
/// cannot open ''name''.' and the rest -- come from the one implementation
/// rather than from a second copy that would have to be kept in step.
///
/// Turbo Pascal spells these as free procedures over a 'var F: Text'
/// parameter.  Algol-24 has neither var parameters nor a Text type, so the
/// handle became the receiver; the names and their meanings are unchanged.
///

/// A bound file method: a receiver, a name, and an arity.
///
/// One class rather than one per method, for the same reason CollectionMethod
/// is one class: the interpreter's calling convention wants something with
/// Arity and Call, and this is less code than twelve near-identical classes.
///
class FileMethod;
var
    Receiver : ObjFile;

    /// ⚠️ The TOKEN, not the folded member name.  Dispatch wants the fold
    /// and the diagnostic wants the spelling the program wrote [SRC-011];
    /// keeping the token keeps both without a second table.
    Name     : Token;
    TheArity : Integer;

begin
    constructor Init (Receiver : ObjFile, Name : Token, TheArity : Integer);
    begin
        this.Receiver := Receiver;
        this.Name := Name;
        this.TheArity := TheArity;
    end

    function Arity () : Integer;
    begin
        Exit TheArity;
    end

    function Call (TheInterpreter, Arguments) : Any;
    begin
        Exit Receiver.Invoke (FoldCase (Str (Name.Lexeme)), Arguments);
    end

    /// ⚠️ Printed as a bound METHOD is [TYP-012], because it is the same kind
    /// of thing: a member read without being called.  This inherited
    /// ObjInstance's rendering and printed 'FileMethod instance', naming a class
    /// that exists only inside algc -- a program has no way to know it, and
    /// nothing in the language answers to it.
    function ToString () : String;
    begin
        Exit '<fn ' + Str (Name.Lexeme) + '>';
    end
end

class ObjFile;
var
    /// The host handle this stands for.
    Handle : Any;

begin
    constructor Init ();
    begin
        this.Handle := TextFile();
    end

    /// Property access.  Eof answers directly -- it is a property in Algol-24,
    /// written without parentheses -- and everything else hands back something
    /// callable.
    ///
    function Get (TheName : Token) : Any;
    var
        Member : String;

    begin
        // Folded, and the literals below written folded to match [SRC-011].
        Member := FoldCase (TheName.Lexeme);

        if Member = 'eof' then Exit Handle.Eof;

        if Member = 'assign'  then Exit FileMethod (this, TheName, 1);
        if Member = 'reset'   then Exit FileMethod (this, TheName, 0);
        if Member = 'rewrite' then Exit FileMethod (this, TheName, 0);
        if Member = 'append'  then Exit FileMethod (this, TheName, 0);
        if Member = 'readln'  then Exit FileMethod (this, TheName, 0);
        if Member = 'write'   then Exit FileMethod (this, TheName, 1);
        if Member = 'writeln' then Exit FileMethod (this, TheName, 1);
        if Member = 'flush'   then Exit FileMethod (this, TheName, 0);
        if Member = 'close'   then Exit FileMethod (this, TheName, 0);
        if Member = 'erase'   then Exit FileMethod (this, TheName, 0);
        if Member = 'rename'  then Exit FileMethod (this, TheName, 1);

        raise 'Undefined property ''' + Str (TheName.Lexeme) + '''.';
    end

    /// Runs a method by name.  Reached only through FileMethod, and Get is the
    /// only thing that hands one of those out.
    ///
    function Invoke (Name : String, Arguments : List) : Any;
    begin
        if Name = 'assign'  then Exit Handle.Assign (Arguments[0]);
        if Name = 'reset'   then Exit Handle.Reset ();
        if Name = 'rewrite' then Exit Handle.Rewrite ();
        if Name = 'append'  then Exit Handle.Append ();
        if Name = 'readln'  then Exit Handle.ReadLn ();
        if Name = 'write'   then Exit Handle.Write (Arguments[0]);
        if Name = 'writeln' then Exit Handle.WriteLn (Arguments[0]);
        if Name = 'flush'   then Exit Handle.Flush ();
        if Name = 'close'   then Exit Handle.Close ();
        if Name = 'erase'   then Exit Handle.Erase ();
        if Name = 'rename'  then Exit Handle.Rename (Arguments[0]);

        raise 'Undefined method ''' + Name + '''.';
    end

    /// Printed as the host renders a file handle.
    function ToString () : String;
    begin
        Exit Str (Handle);
    end
end
