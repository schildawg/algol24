uses TokenType;

/// Folds a name to the form it is looked up under.
///
/// Identifiers are matched WITHOUT REGARD TO CASE [SRC-011], so 'Xyz', 'xyz'
/// and 'XYZ' are one name.  The lexeme itself is never folded -- a diagnostic
/// must echo the spelling the program used -- so the fold happens where a name
/// becomes a KEY and nowhere else.
///
/// ⚠️ A named function rather than a bare ToLower at each site, and that is the
/// whole point: every lookup has to fold the same way as every store, or a name
/// goes in under one spelling and is searched for under another.  One name for
/// the rule makes the sites findable and keeps them in step.
///
const FOLD_UPPER := 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
const FOLD_LOWER := 'abcdefghijklmnopqrstuvwxyz';

/// The name a written type is compared under.
///
/// ⚠️ 'Real' is another spelling of 'Double' [TYP-014], not a type of its own,
/// so it is replaced HERE -- at the one point a written type becomes something
/// to compare -- and nothing downstream needs to know the alias exists.  The C
/// runtime therefore needs no case for it at all, which is what keeps the two
/// processors agreeing by construction rather than by both remembering.
///
/// ⚠️ Beside FoldCase for the same reason FoldCase exists: both normalise a
/// name before it is matched, and a normalisation applied at some sites and
/// not others is worse than none.
///
/// ⚠️ The canonical spelling wins in a DIAGNOSTIC too, so 'X as Real' on a
/// String says 'Cannot cast String to Double.'  That is the alias telling the
/// reader what it is, which is more use than echoing what they wrote.
///
/// The predefined subranges [TYP-015], as a name with a low and a high bound.
///
/// ⚠️ A subrange is a CONSTRAINT on an Integer, not a type of its own.  Nothing
/// is ever "a Byte" at run time -- TypeNameOf still answers 'Integer' -- so a
/// subrange name appears only where a type is WRITTEN, and the bounds are
/// checked there.
///
/// ⚠️ 'Byte' is 0..255 and 'Short' is 16 bits, which is the modern reading and
/// not Turbo Pascal's: its ShortInt was 8 bits and its Integer 16.  With
/// Integer unbounded the widths are no longer representations to match, only
/// ranges to name, and a reader should be able to say what 'Short' is without
/// looking it up.
///
/// ⚠️ There is no unsigned family.  Unsigned types exist to buy one more bit
/// inside a fixed width and to say "not negative"; an unbounded Integer removes
/// the first reason and '0 ..' states the second directly.
///
const SUBRANGE_NAMES := ['byte', 'word', 'short'];
const SUBRANGE_LOWS  := [0, 0, -32768];
const SUBRANGE_HIGHS := [255, 65535, 32767];

function SubrangeIndex (Name : Any) : Integer;
begin
    Exit SUBRANGE_NAMES.IndexOf (FoldCase (Name));
end

function IsSubrange (Name : Any) : Boolean;
begin
    Exit SubrangeIndex (Name) >= 0;
end

/// The type a written name stands for once a subrange is seen through.
///
/// ⚠️ Distinct from CanonicalType, and the difference is the point: 'Real' IS
/// 'Double', so the alias is replaced everywhere; a subrange is an Integer for
/// every question about TYPE and keeps its own name for the question about
/// RANGE.  Collapsing the two would lose the bounds.
///
function UnderlyingType (Name : Any) : String;
begin
    if IsSubrange (Name) then Exit 'Integer';

    Exit CanonicalType (Name);
end

function CanonicalType (Name : Any) : String;
begin
    if FoldCase (Name) = 'real' then Exit 'Double';

    Exit Str (Name);
end

function FoldCase (Name : Any) : String;
var
   Text : String;
   Out  : Buffer;

begin
    Text := Str (Name);

    // ⚠️ Scanned for an uppercase letter before anything is built, because
    // almost every name is already folded or has none, and the common case must
    // not allocate.  Strings are immutable and '+' copies both operands into an
    // arena that never reclaims, so a fold that built a new string on every
    // lookup would retain one per lookup.
    var Needs := False;
    for var I := 0; I < Length (Text); I := I + 1 do
        if Pos (FOLD_UPPER, Str (Text[I])) >= 0 then Needs := True;

    if not Needs then Exit Text;

    // A Buffer, not 'Out := Out + C' -- the latter is quadratic in memory that
    // is never reclaimed.
    Out := Buffer ();
    for var I := 0; I < Length (Text); I := I + 1 do
    begin
        var At := Pos (FOLD_UPPER, Str (Text[I]));

        if At >= 0 then Out.Append (Copy (FOLD_LOWER, At, 1));
        else Out.Append (Str (Text[I]));
    end

    Exit Out.Text;
end

/// Token
///
class Token;
var 
   TypeOfToken : TokenType;
   Lexeme      : String;
   Literal     : Any;
   LineNumber  : Integer;

   /// Column of the token's first character, counted from the start of its
   /// line.  Defaulted rather than passed, because 91 call sites construct a
   /// Token and only the scanner knows a real offset -- the rest are synthetic
   /// tokens built by the parser or by a test.
   Offset      : Integer := 0;

begin
    constructor Init(TypeOfToken : TokenType, Lexeme : String, Literal : Any, LineNumber : Integer);
    begin
        this.TypeOfToken := TypeOfToken;
        this.Lexeme := Lexeme;
        this.Literal := Literal;
        this.LineNumber := LineNumber;
    end

    function ToString() : String;
    begin
       Exit Str(TypeOfToken) +  ' ' + Lexeme + ' ' + Literal;
    end
end

test 'New Token';
begin
    var TheToken := Token(TOKEN_STRING, 'ABC', nil, 1);
    
    AssertEqual(TOKEN_STRING, TheToken.TypeOfToken);
    AssertEqual('ABC', TheToken.Lexeme);
    AssertEqual(nil, TheToken.Literal);
    AssertEqual(1, TheToken.LineNumber); 
end

test 'Token ToString';
begin
    var TheToken := Token(TOKEN_STRING, 'ABC', nil, 1);
    
    AssertEqual('TOKEN_STRING ABC nil', TheToken.ToString());
end