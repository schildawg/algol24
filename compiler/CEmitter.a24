/// The C back end: emits C11 for an Algol-24 program, one .c and .h pair per
/// source unit.
///
/// What it cannot emit it REFUSES BY NAME rather than emitting nothing.  A back
/// end that silently dropped a class declaration would produce a binary that
/// disagrees with the interpreter, and comparing output is the only thing
/// verifying any of this.  Failing loudly keeps the gaps honest about their own
/// size.
///
/// The output is a FIXED POINT, and exactly so: re-emitting this compiler from
/// its own source must reproduce the checked-in C byte for byte, which is what
/// makes a rebuild from the seed mean anything.  Behavioral equivalence would
/// be the weaker test and would not serve that.
///
/// Coverage is the language as this compiler itself uses it, which is the only
/// honest way to state it: algc compiles algc, so classes, objects, enums,
/// collections, closures, modules, overloads, 'try', 'case' and 'for ... in' all
/// come out.  What remains is a list of edge cases, each refused by name -- an
/// identifier carrying a character C has no spelling for, two modules claiming
/// one name, a 'var' as an unbraced branch, a function nested more than one
/// level deep or declared inside a method, 'super' used as a value, and a nested
/// 'uses'.
unit CEmitter;

uses Expr;
uses ObjFunction;
uses Stmt;
uses TokenType;
uses Token;

/// Beyond this many elements a collection literal is HOISTED into a helper
/// function instead of being emitted as nested calls.
///
/// Each keep-call is a bracket level and cc gives up at 256 -- clang says
/// 'bracket nesting level exceeded maximum of 256' and stops.  A generated table
/// of 659 ranges found it: the emitter produced a 40 KB expression nested 659
/// deep, which is a program this compiler could emit and could not build.
///
/// Well under the limit, so an ordinary literal is emitted exactly as before and
/// the seed does not churn.
const HOIST_ABOVE := 100;

/// Gets the indentation for a nesting depth.
///
/// Four spaces per level, built by hand because the language has no repeat.
function Indentation (Depth : Integer) : String;
var
    Result : String := '';

begin
    for var I := 0; I < Depth; I := I + 1 do
        Result := Result + '    ';

    Exit Result;
end

/// Escapes a string for a C literal.  Only what this emitter can produce.
///
/// Algol-24 strings have NO backslash escapes, so what is written here is
/// literally what comes out.  A C newline escape is the two characters backslash
/// and n, written as those two characters -- not doubled.  Reading these as
/// another language's literals is how the first draft emitted three backslashes
/// where C wanted two.
///
/// Str () goes round the opening quote, because a one-character literal is a
/// Char and a String is what this accumulates into.
function QuoteC (Text : Any) : String;
var
    Result : String;

begin
    Result := Str ('"');

    for var I := 0; I < Length (Text); I := I + 1 do
    begin
        var C := Str (Text)[I];

        if C = '"' then Result := Result + '\"';
        else if C = '\' then Result := Result + '\\';
        else if C = #10 then Result := Result + '\n';
        else if C = #9 then Result := Result + '\t';
        else if C = #13 then Result := Result + '\r';
        else Result := Result + Str (C);
    end

    Exit Result + Str ('"');
end

/// One source file, and what the C file emitted from it needs to know: the
/// declarations it owns, the modules it may name, and the names it hid.
class EmitUnit;
var
    /// The C file's stem -- the source file's, without '.a24'.
    Name       : String;

    /// The declarations this file owns.
    Statements : List;

    /// The modules this file said 'uses' for.  Its C includes their headers, and
    /// no others: that is what 'uses' means, transcribed.
    Imports    : List;

    /// The names this file marked 'private'.
    ///
    /// In the emitted C 'private' is exactly 'static'.  It used to be a RENAME
    /// with the module's name as a suffix, because every module was spliced into
    /// one file and two modules each declaring a Peek would have collided.  With
    /// a file per module, C's own linkage says it.
    PrivateNames : List;

    /// The path the file was loaded from, as the test report names it.
    FileName   : String;

begin
    /// Makes a unit from a file's name, declarations, imports and private names.
    constructor Init (Name : String, Statements : List, Imports : List,
                      PrivateNames : List, FileName : String);
    begin
        this.Name := Name;
        this.Statements := Statements;
        this.Imports := Imports;
        this.PrivateNames := PrivateNames;
        this.FileName := FileName;
    end
end

/// Emits one C file per source unit, plus the main file that starts the
/// program.
class CEmitter;
var

    /// File-scope declarations: prototypes, and the globals a top-level 'var'
    /// becomes.
    ///
    /// These five are BUFFERS, not Strings, and the difference is the difference
    /// between the compiler needing 1.25 GB to compile itself and needing a few
    /// tens of MB.  'X := X + Piece' allocates a fresh string and copies both
    /// operands, and nothing is ever freed -- so accumulating an emitted file
    /// that way keeps every intermediate, about n^2/2 bytes of live memory.  A
    /// Buffer appends in place and grows by doubling.  Same output, same order,
    /// same bytes; only the allocation volume changes, which is why the fixed
    /// point still holds across the change.
    ///
    /// They are never Freed.  A compiler is a batch process and the arena gives
    /// everything back at exit; Free exists for the VM, which owns its memory for
    /// a different reason.
    Declarations : Buffer := Buffer();

    /// Whole function bodies.
    Functions    : Buffer := Buffer();

    /// The body of main.
    MainBody     : Buffer := Buffer();

    /// Closure handles and class registrations, assigned at the TOP of main.
    ///
    /// One buffer for both, in declaration order, so a function exists as a value
    /// and a class is BUILT before any statement can pass one around or construct
    /// one -- which is what lets a class be declared after the code that uses it.
    Setup        : Buffer := Buffer();

    /// The empty class shells, emitted ahead of Setup.
    ///
    /// A class may inherit from one declared BELOW it, so binding the name is not
    /// enough -- the parent has to EXIST when the child is linked to it.  The
    /// interpreter hoists in two phases for exactly this, and one buffer in
    /// declaration order cannot: 'class Puppy (Hound);' above 'class Hound;'
    /// linked to a handle that was still nil, so 'Puppy () is Hound' was false and
    /// the inherited method was 'Undefined property'.  Every shell first, then the
    /// links, then fields and methods.
    Shells       : Buffer := Buffer();

    /// The body of the function being emitted, if any.
    ///
    /// A buffer of its own, and the reason is ordering: a NESTED function appends
    /// itself to Functions while its enclosing one is still being written, so the
    /// enclosing header and body can only be appended once the body is complete.
    /// Writing the header straight to Functions puts the outer function first and
    /// the closure line in main.
    Body         : Buffer := Buffer();

    /// The C symbol of each test body -- the runner in the main file calls them
    /// across file boundaries.
    TestSymbols  : List;

    /// The exported declarations of the module being emitted -- its header.
    Header       : String := '';

    /// The module being emitted.
    UnitName     : String := 'Main';
    /// The names that module declared 'private', which become static in C.
    PrivateNames : List;

    /// True while emitting the file the program starts from.
    ///
    /// It exports nothing: no file can 'uses' the root, so every symbol in it is
    /// static and its header holds only the initializer.
    RootUnit     : Boolean := False;

    /// Numbers this file's test bodies.
    ///
    /// Per file, and the symbol carries the module's name: a test symbol must be
    /// reachable from the runner in the main file, so it is exported, and two
    /// modules numbering from zero would otherwise export the same symbol.
    UnitTests    : Integer := 0;

    /// Which buffer Line is currently writing to -- 'main' or 'body'.
    ///
    /// A selector rather than a reference, because the language has none.
    Target       : String := 'main';

    /// The nesting depth the next line is indented to.
    Depth        : Integer := 1;

    /// True while emitting a statement written outside any function, so a 'var'
    /// there becomes a file-scope global rather than a local.
    AtTopLevel   : Boolean := False;

    /// The locals declared in the body being emitted, so a repeated name is
    /// declared once.
    Locals       : List;

    /// Every function the program declares, collected before anything is emitted
    /// so a call to one declared later still resolves.
    Declared     : Set;

    /// Numbers the slots 'and' and 'or' hold their left operand in, so each
    /// occurrence gets its own and nesting cannot make two share one.
    Logicals     : Integer := 0;

    /// Numbers the temporaries a 'for ... in' and a 'try' need, so they nest.
    Loops        : Integer := 0;

    /// How many 'try' frames are open around the statement being emitted.
    ///
    /// A frame is pushed by setjmp and popped when the try block falls through --
    /// but an 'Exit' or a 'break' LEAVES the block without reaching that pop, so
    /// the frame stays on the runtime's stack pointing at a C frame that has
    /// returned.  The next raise longjmps into dead stack.
    ///
    /// It survives a shallow test, because nothing has reused that memory yet.
    /// It did not survive algc compiling itself, which is where it was found.
    TryDepth     : Integer := 0;

    /// TryDepth as it was when the enclosing loop began, so 'break' pops only the
    /// frames opened inside the loop.
    LoopTryDepth : Integer := 0;

    /// The label of each enclosing loop, innermost last.
    ///
    /// LoopTryDepth is not enough once a break can NAME a loop.  It holds the
    /// innermost loop's depth, and 'break Outer' from two loops in has to pop
    /// everything opened inside OUTER -- the frames of the inner loop included.
    /// One number cannot answer that; a stack can.
    LoopLabels   : List := [];
    /// The TryDepth each enclosing loop began at, parallel to LoopLabels.
    LoopDepths   : List := [];

    /// C labels a goto has actually been emitted for.
    ///
    /// Emitted only when jumped to, and this is why it can be decided at all: the
    /// loop's BODY is written before its labels are, so by the time the closing
    /// brace is reached it is already known whether anything jumped.  A label
    /// nothing jumps to is a warning under -Wall, and writing one for every
    /// labelled loop would produce a pair of them for every single use.
    Jumped       : Set  := [];

    /// Each enclosing block's labels mapped to the TryDepth that block began at,
    /// innermost last.
    ///
    /// Recorded when the block is ENTERED, not when the label is emitted.  A
    /// FORWARD goto is emitted before its label, so at the jump there would
    /// otherwise be nothing to ask how many frames lie between them.  A label is
    /// always a top-level statement of its block, so the block's entry depth IS
    /// the label's depth.
    LabelDepths  : List := [];

    /// True while emitting a body that contains a try, so locals crossing the
    /// setjmp are declared volatile.
    Volatiles    : Boolean := False;

    /// The names the file being emitted must spell differently in C, because a
    /// header it includes already declares them.
    ///
    /// Only the ROOT file ever has any.  Every other file's colliding name is
    /// refused outright -- two modules exporting one name is
    /// 'Two modules exporting ''X'''.  But the root is not a module: nothing can
    /// import it, so its declaration SHADOWS the import rather than competing
    /// with it, and both processors run that correctly.  Its symbols being static
    /// does not stop them colliding; it changes how they collide.
    Renames      : Map;

    /// Names the program declares more than once, which become an overload set
    /// rather than a plain symbol.
    Overloaded   : Set;
    /// The unit each overloaded name belongs to, so its set is built once.
    OverloadsIn  : Map;

    /// Static parameter-list arrays already declared, so one is emitted once.
    Tables       : Set;

    /// Overload sets already built, so a name is registered once.
    SetsBuilt    : Set;

    /// Names already renamed, so a rename is applied once.
    Renamed      : Set;

    /// Bare names more than one imported module exports, mapped to those
    /// modules, so a use of one can be refused by name.
    AmbiguousImports : Map;

    /// Bare names more than one enumeration binds, mapped to those enumerations.
    AmbiguousMembers : Map;

    /// Locals a nested function captures, which must live in a cell rather than
    /// on the C stack.
    Boxed        : List;

    /// The cells in scope for the body being emitted.
    Cells        : List;

    /// Which cells each nested function captures, so its closure carries them.
    Captured     : Map;

    /// Every top-level name, collected before emission so a reference to one
    /// declared later still resolves.
    Globals      : Set;

    /// Every top-level name of the unit being emitted.
    TopLevel     : Set;

    /// Each unit's exported names.
    ///
    /// The emitter needs this even though it flattens, and it is the one
    /// visibility question it cannot duck.  A qualified name reaches the export
    /// set in the interpreter, so 'ModuleHelper.Peek ()' on a private Peek raises
    /// there -- while the emitted C called f_Peek, which after 'private' became
    /// C's own 'static' is a symbol in another translation unit and does not
    /// link.  A build failure rather than a divergence, but the program has a
    /// defined answer and this is where it comes from.
    UnitExports  : Map;

    /// Every top-level name each unit declares, private ones included -- what
    /// UnitExports is before 'private' is taken out of it.
    ///
    /// A private name still shadows a built-in inside its own file.
    UnitAll      : Map;

    /// The names that shadow a built-in in the file being emitted: that file's
    /// own top-level declarations plus the exports of the units it imported.
    /// Replaced per unit.
    ShadowNames  : Set;

    /// Folded name to the spelling the declaration used [SRC-011].
    ///
    /// Names are matched WITHOUT REGARD TO CASE, and every set this emitter
    /// consults -- Declared, Classes, Objects, Globals, ShadowNames -- is keyed by
    /// the spelling each was declared with.  So 'GREET ()' calling
    /// 'function Greet' matched nothing and was refused, though the mangling
    /// lowercases both to the same symbol and it would have been right.
    ///
    /// Canonicalising the name ONCE, rather than folding at every lookup, is what
    /// keeps this small: the sets stay as they are.
    Canonical    : Map;

    /// True while emitting a function declared inside another, which is how a
    /// second level of nesting is refused.
    InsideNested : Boolean := False;

    /// True when emitting the test bodies and a runner instead of the program.
    EmitTests    : Boolean := False;

    /// Test bodies in the order they were met.
    Tests        : List;
    /// The file each test came from, parallel to Tests, so the report groups by
    /// file exactly as the interpreted one does.
    TestFiles    : List;

    /// The file whose statements are being emitted.
    CurrentFile  : String := '';

    /// The file handed to --compile, which the report names.
    SourceFile   : String := '';

    /// Class name to its parent, for every class the program declares.
    Classes      : Map;

    /// The classes this unit declares, as against those it imported.
    OwnClasses   : Set;

    /// Object and enum-type names, which answer a dot without being classes.
    Objects      : Set;
    /// The enumeration type names the program declares.
    EnumTypes    : Set;
    /// Enum member names mapped to the symbol each becomes.
    EnumMembers  : Map;

    /// The class whose body is being emitted, or '' outside one.
    CurrentClass : String := '';

    /// The fields reachable from the body being emitted, so a bare name that is
    /// really a field emits as one.
    VisibleFields  : Set;
    /// The methods reachable from the body being emitted, on the same terms as
    /// VisibleFields.
    VisibleMethods : Set;

begin
    /// Makes an emitter with its buffers and name tables empty.
    constructor Init ();
    begin
        this.Locals := List();
        this.Declared := Set();
        this.Classes := Map();
        this.OwnClasses := Set();
        this.Objects := Set();
        this.EnumTypes := Set();
        this.EnumMembers := Map();
        this.VisibleFields := Set();
        this.VisibleMethods := Set();
        this.Renames := Map();
        this.AmbiguousMembers := Map();
        this.AmbiguousImports := Map();
        this.Renamed := Set();
        this.Overloaded := Set();
        this.OverloadsIn := Map();
        this.Tables := Set();
        this.SetsBuilt := Set();
        this.Boxed := List();
        this.Cells := List();
        this.Captured := Map();
        this.Globals := Set();
        this.TopLevel := Set();
        this.UnitExports := Map();
        this.UnitAll := Map();
        this.ShadowNames := Set();
        this.Canonical := Map();
        this.Tests := List();
        this.TestFiles := List();
        this.TestSymbols := List();
        this.PrivateNames := List();
    end

    /// Refuses a construct by name.
    ///
    /// Raises rather than emitting nothing.  A back end that silently dropped a
    /// declaration would produce a binary that disagrees with the interpreter.
    /// The wording is part of the observable surface, so a refusal is compared
    /// like any other output.
    ///
    /// # Raises
    ///
    /// '<X> is not supported by the C back end yet.'
    procedure Unsupported (Construct : Any);
    begin
        raise Str (Construct) + ' is not supported by the C back end yet.';
    end

    /// Writes one indented line to whichever buffer Target selects.
    ///
    /// Takes Any, because a one-character literal is a Char and most callers
    /// hand it a String.
    procedure Line (Text : Any);
    begin
        if Target = 'body' then
            Body.Append (Indentation (Depth) + Str (Text) + #10);
        else
            MainBody.Append (Indentation (Depth) + Str (Text) + #10);
    end

    /// Gets a C identifier for an Algol-24 name.
    ///
    /// Algol-24 identifiers may contain '?' and '!', which C does not allow, and
    /// could otherwise collide with a C keyword or a runtime symbol.  Prefixing
    /// solves both at once.
    ///
    /// A unit suffix is joined with a RAW separator after each half is escaped,
    /// never by escaping the joined string.  '_' escapes to 'V', so escaping the
    /// joined form would give a symbol an identifier actually spelled that way
    /// also gives.  Escaping the halves keeps the separator outside the alphabet
    /// the escape uses, which is what reserves it.
    ///
    /// Renames therefore holds the UNIT alone.  It held the joined form once, and
    /// escaped that whole string -- the very thing the rule above forbids.  The
    /// result stayed injective only by the accident of the name appearing twice.
    function Mangle (Prefix : String, Name : String) : String;
    begin
        if Renames.Contains (Str (Name)) then
            Exit Prefix + Escaped (Str (Name)) + '__'
               + Escaped (Str (Renames.Get (Str (Name))));

        Exit SymbolOf (Prefix, Str (Name));
    end

    /// Gets the mangled symbol for a name, applying any rename first.
    ///
    /// Every symbol goes through here or through Mangle, never by
    /// hand-concatenating a prefix.
    function SymbolOf (Prefix : String, Name : String) : String;
    begin
        Exit Prefix + Escaped (Name);
    end

    /// Gets the C symbol of a class handle.
    function ClassHandle (Name : String) : String;
    begin
        Exit Mangle ('k_', Name);
    end

    /// Gets the C symbol of a unit's initializer.
    function InitName (Name : String) : String;
    begin
        Exit SymbolOf ('i_', Name);
    end

    /// Gets the C symbol of an enumeration type.
    function EnumTypeName (Name : String) : String;
    begin
        Exit Mangle ('e_', Name);
    end

    /// Gets the C symbol of an enumeration member.
    ///
    /// The type and the member are escaped separately and joined with a raw
    /// separator, for the reason Mangle gives.
    function EnumMemberName (TypeName : String, Member : String) : String;
    begin
        Exit Mangle ('e_', TypeName) + '_' + Escaped (Member);
    end

    /// Gets a code point as exactly six uppercase hexadecimal digits.
    function HexOf (Code : Integer) : String;
    var
        Result : String := '';
        Left   : Integer;

    begin
        Left := Code;

        for var I := 0; I < 6; I := I + 1 do
        begin
            Result := Copy ('0123456789ABCDEF', Mod (Left, 16), 1) + Result;
            Left := Left / 16;
        end

        Exit Result;
    end

    /// Escapes an identifier into the alphabet C accepts.
    ///
    /// Every letter and digit LOWERCASES, '?' becomes 'Q', '!' becomes 'E', '_'
    /// becomes 'V', and anything else becomes 'U' and six hexadecimal digits -- so
    /// an emoji emits as U01F642 and any Unicode identifier compiles.
    ///
    /// THE LOWERCASING IS WHAT MAKES THE REST POSSIBLE, and the two decisions
    /// depend on each other.  Identifiers are case-insensitive [SRC-011], so case
    /// carries no information and lowering is lossless -- which frees the whole
    /// uppercase range to mean 'escape'.  Neither half works alone.
    ///
    /// INJECTIVE, and the scheme it replaced was not.  That one passed letters
    /// through untouched and wrote '?' as '_q', so 'Ready?' and 'Ready_q' emitted
    /// one symbol between them and cc refused the result.  Here they are 'readyQ'
    /// and 'readyVq'.  The same argument is why an identifier spelled 'U01F642'
    /// does not collide with the escape for an emoji: the first lowers, the second
    /// does not.
    ///
    /// '_' IS NOT PASSED THROUGH -- it becomes 'V' -- which is the whole reason it
    /// is available as a separator between two escaped names.
    ///
    /// # Satisfies
    ///
    /// [SRC-005]
    function Escaped (Name : String) : String;
    var
        Result : Buffer;

    begin
        Result := Buffer ();

        for var I := 0; I < Length (Name); I := I + 1 do
        begin
            var C := Str (Name)[I];

            if C >= 'a' and C <= 'z' then Result.Append (Str (C));
            else if C >= '0' and C <= '9' then Result.Append (Str (C));
            else if C >= 'A' and C <= 'Z' then Result.Append (Char (Ord (C) + 32));
            else if C = '?' then Result.Append ('Q');
            else if C = '!' then Result.Append ('E');
            else if C = '_' then Result.Append ('V');
            else Result.Append ('U' + HexOf (Ord (C)));
        end

        Exit Result.Text;
    end

    /// Reduces text to what a C comment or a file name may carry.
    function Sanitize (Text : String) : String;
    var
        Result : String := '';

    begin
        for var I := 0; I < Length (Text); I := I + 1 do
        begin
            var C := Str (Text)[I];

            if (C >= 'a' and C <= 'z') or (C >= 'A' and C <= 'Z')
                                       or (C >= '0' and C <= '9') then
                Result := Result + Str (C);
            else Result := Result + '_';
        end

        Exit Result;
    end

    /// Collects every source file into an EmitUnit, one per module, before any
    /// C is written.
    procedure CollectUnits (Statements : List, Name : String, Privates : List,
                            Units : List, FileName : String);
    var
        Own     : List;
        Imports : List;

    begin
        Own := List();
        Imports := List();

        for var I := 0; I < Statements.Length; I := I + 1 do
        begin
            var TheStmt := Statements[I];

            if TheStmt is ModuleStmt then
            begin
                var ModuleName := UnitNameOf (Str (TheStmt.FileName));
                Imports.Add (ModuleName);

                if TheStmt.Statements <> Nil then
                    CollectUnits (TheStmt.Statements, ModuleName,
                                  TheStmt.PrivateNames, Units, Str (TheStmt.FileName));
            end

            Own.Add (TheStmt);
        end

        Units.Add (EmitUnit (Name, Own, Imports, Privates, FileName));
    end

    /// Gets the unit name a path stands for -- its stem.
    function UnitNameOf (Key : String) : String;
    var
        Start : Integer;
        Stem  : String;

    begin
        Start := 0;
        for var I := 0; I < Length (Key); I := I + 1 do
            if Key[I] = '/' then Start := I + 1;

        Stem := Copy (Key, Start, Length (Key) - Start);

        if Length (Stem) > 4 then
            if Copy (Stem, Length (Stem) - 4, 4) = '.a24' then
                Stem := Copy (Stem, 0, Length (Stem) - 4);

        Exit Sanitize (Stem);
    end

    /// Gets the C symbol of a variable.
    function VariableName (Name : String) : String;
    begin
        Exit Mangle ('v_', Name);
    end

    /// Gets the C symbol of the flag saying a global has been initialized.
    ///
    /// A 'var' is not hoisted, so reading one before its declaration has run must
    /// be an error rather than nil -- and in C the storage exists from the start.
    /// The flag is what makes the two agree.
    function DeclaredFlag (Name : String) : String;
    begin
        Exit Mangle ('d_', Name);
    end

    /// Gets the C symbol of a subprogram's body.
    function FunctionName (Name : String) : String;
    begin
        Exit Mangle ('f_', Name);
    end

    /// Gets the C symbol of a subprogram's closure value.
    function HandleName (Name : String) : String;
    begin
        Exit Mangle ('fn_', Name);
    end

    /// Gets the C symbol of an overload set.
    function SetName (Name : String) : String;
    begin
        Exit Mangle ('o_', Name);
    end

    /// Gets the symbol a name evaluates to when used as a value -- the overload
    /// set where there is one, otherwise the closure.
    function SubprogramValue (Name : String) : String;
    begin
        if Overloaded.Contains (Name) then Exit SetName (Name);

        Exit HandleName (Name);
    end

    /// Gets the C symbol of a subprogram, with its signature folded in where the
    /// name is overloaded.
    ///
    /// Overloads select on the whole signature rather than on arity, so the
    /// symbol has to carry the parameter types to stay distinct.
    function FunctionSymbol (TheStmt : Any) : String;
    var
        Symbol : String;

    begin
        var Name := Str (TheStmt.Name.Lexeme);
        if not Overloaded.Contains (Name) then Exit FunctionName (Name);

        Symbol := FunctionName (Name) + '_' + Str (TheStmt.Params.Length);

        var Types := DeclaredTypes (TheStmt);
        for var I := 0; I < Types.Length; I := I + 1 do
            if Types[I] <> 'Any' then Symbol := Symbol + '_' + Escaped (Str (Types[I]));

        Exit Symbol;
    end

    /// Gets a subprogram's C prototype.
    function Prototype (TheStmt : Any) : String;
    var
        Lead : String;

    begin
        Lead := 'static Value ';
        if Exported (Str (TheStmt.Name.Lexeme)) then Lead := 'Value ';

        Exit Lead + FunctionSymbol (TheStmt)
           + '(Value **cells, Value *args, int32_t count)';
    end

    /// Whether a top-level statement runs during a test run.
    ///
    /// A declaration does; the program's own statements do not, because '--test'
    /// runs the test blocks instead of the program.
    function RunsWhenTesting (TheStmt : Stmt) : Boolean;
    begin
        Exit TheStmt is FunctionStmt or TheStmt is ClassStmt
          or TheStmt is ObjectStmt   or TheStmt is EnumStmt
          or TheStmt is VarGroupStmt or TheStmt is VarStmt
          or TheStmt is SubrangeStmt or TheStmt is ModuleStmt;
    end

    /// Whether a name reaches this unit's header, or is static to its file.
    function Exported (Name : String) : Boolean;
    begin
        if RootUnit then Exit False;

        Exit not PrivateNames.Contains (Name);
    end

    /// Declares a file-scope value, in the header when it is exported and in the
    /// C file when it is not.
    procedure DeclareValue (Symbol : String, Name : String);
    begin
        if Exported (Name) then
        begin
            Declarations.Append ('Value ' + Symbol + ';' + #10);
            Header := Header + 'extern Value ' + Symbol + ';' + #10;
        end
        else Declarations.Append ('static Value ' + Symbol + ';' + #10);
    end

    /// Declares a file-scope variable and the flag that says whether it has been
    /// initialized.
    procedure DeclareVariable (Symbol : String, Name : String);
    begin
        DeclareValue (Symbol, Name);

        if Exported (Name) then
        begin
            Declarations.Append ('bool ' + DeclaredFlag (Name) + ';' + #10);
            Header := Header + 'extern bool ' + DeclaredFlag (Name) + ';' + #10;
        end
        else Declarations.Append ('static bool ' + DeclaredFlag (Name) + ';' + #10);
    end

    /// Whether a statement is a test block.
    function IsTest (TheStmt : Any) : Boolean;
    begin
        Exit TheStmt.Name.Literal <> Nil;
    end

    /// Collects every subprogram the program declares, before anything is
    /// emitted, so a call to one declared later still resolves.
    ///
    /// It also decides which names are overloaded, since that changes the symbol
    /// each declaration gets.
    procedure CollectFunctions (Statements : List);
    begin
        for var I := 0; I < Statements.Length; I := I + 1 do
        begin
            var TheStmt := Statements[I];

            if TheStmt is FunctionStmt then
            begin
                if not IsTest (TheStmt) then
                begin
                    Declared.Add (Str (TheStmt.Name.Lexeme));
                    Canonical.Put (FoldCase (TheStmt.Name.Lexeme), Str (TheStmt.Name.Lexeme));
                end

                CollectFunctions (TheStmt.Body);
            end

            if TheStmt is ClassStmt then
            begin
                Classes.Put (Str (TheStmt.Name.Lexeme), TheStmt);
                Canonical.Put (FoldCase (TheStmt.Name.Lexeme), Str (TheStmt.Name.Lexeme));
            end

            if TheStmt is ObjectStmt then
            begin
                Objects.Add (Str (TheStmt.Name.Lexeme));
                Canonical.Put (FoldCase (TheStmt.Name.Lexeme), Str (TheStmt.Name.Lexeme));
            end

            if TheStmt is EnumStmt then
            begin
                EnumTypes.Add (Str (TheStmt.Name.Lexeme));
                Canonical.Put (FoldCase (TheStmt.Name.Lexeme), Str (TheStmt.Name.Lexeme));

                for var J := 0; J < TheStmt.Members.Length; J := J + 1 do
                begin
                    var Member := Str (TheStmt.Members[J].Lexeme);

                    if EnumMembers.Contains (Member) then
                        if Str (EnumMembers.Get (Member)) <> Str (TheStmt.Name.Lexeme) then
                            MarkAmbiguousMember (Member, Str (EnumMembers.Get (Member)),
                                                 Str (TheStmt.Name.Lexeme));

                    EnumMembers.Put (Member, Str (TheStmt.Name.Lexeme));
                    Canonical.Put (FoldCase (Member), Member);
                end
            end

            if TheStmt is BlockStmt then CollectFunctions (TheStmt.Statements);
        end
    end

    /// Collects every top-level name, for the same reason CollectFunctions runs
    /// first: a reference may precede its declaration.
    procedure CollectGlobals (Statements : List);
    begin
        for var I := 0; I < Statements.Length; I := I + 1 do
        begin
            var TheStmt := Statements[I];

            if TheStmt is VarStmt then
            begin
                Globals.Add (Str (TheStmt.Name.Lexeme));
                Canonical.Put (FoldCase (TheStmt.Name.Lexeme), Str (TheStmt.Name.Lexeme));
            end

            if TheStmt is VarGroupStmt then
                for var J := 0; J < TheStmt.Names.Length; J := J + 1 do
                begin
                    Globals.Add (Str (TheStmt.Names[J].Lexeme));
                    Canonical.Put (FoldCase (TheStmt.Names[J].Lexeme),
                                   Str (TheStmt.Names[J].Lexeme));
                end

            if TheStmt is FunctionStmt and not IsTest (TheStmt) then
            begin
                if TopLevel.Contains (Str (TheStmt.Name.Lexeme)) or Variadic (TheStmt) then
                    Overloaded.Add (Str (TheStmt.Name.Lexeme));

                TopLevel.Add (Str (TheStmt.Name.Lexeme));
            end
        end
    end

    /// Records the file being compiled, which the report names.
    procedure CompilingFile (Name : String);
    begin
        SourceFile := Name;
    end

    /// Switches the emitter to emitting test bodies and a runner instead of the
    /// program.
    procedure WithTests ();
    begin
        EmitTests := True;
    end

    /// Emits a whole program, answering a map of file name to C source.
    ///
    /// One .c and .h pair per source unit, plus a main file whose generated main
    /// calls each unit's initializer in DEPENDENCY ORDER before running the
    /// program's own statements.  A module must be initialized before anything
    /// that imports it, which is the same order the interpreter runs them in.
    ///
    /// Names are collected before anything is written -- see CollectFunctions and
    /// CollectGlobals -- because a call may precede its declaration.
    ///
    /// # Raises
    ///
    /// Whatever Unsupported refuses, by name.
    function Emit (Statements : List, Stem : String) : Map;
    var
        Units          : List;
        Files          : Map;
        MainBodyText   : String;

    begin
        Units := List();
        Files := Map();
        MainBodyText := '';

        CollectUnits (Statements, Stem, List(), Units, SourceFile);

        var Seen := Set();
        for var U := 0; U < Units.Length; U := U + 1 do
        begin
            if Seen.Contains (Str (Units[U].Name)) then
                Unsupported ('Two modules named ''' + Str (Units[U].Name) + '''');

            Seen.Add (Str (Units[U].Name));
        end

        for var U := 0; U < Units.Length; U := U + 1 do
            CollectFunctions (Units[U].Statements);

        for var U := 0; U < Units.Length; U := U + 1 do
        begin
            TopLevel := Set();
            Overloaded := Set();

            CollectGlobals (Units[U].Statements);

            OverloadsIn.Put (Str (Units[U].Name), Overloaded);
        end

        for var U := 0; U < Units.Length; U := U + 1 do
        begin
            var Exported := Set();
            var Own := Units[U].Statements;

            for var I := 0; I < Own.Length; I := I + 1 do
            begin
                var TheStmt := Own[I];

                if TheStmt is FunctionStmt and not IsTest (TheStmt) then
                    Exported.Add (Str (TheStmt.Name.Lexeme));

                if TheStmt is ClassStmt  then Exported.Add (Str (TheStmt.Name.Lexeme));
                if TheStmt is ObjectStmt then Exported.Add (Str (TheStmt.Name.Lexeme));
                if TheStmt is VarStmt    then Exported.Add (Str (TheStmt.Name.Lexeme));

                if TheStmt is EnumStmt then
                begin
                    Exported.Add (Str (TheStmt.Name.Lexeme));

                    for var J := 0; J < TheStmt.Members.Length; J := J + 1 do
                        Exported.Add (Str (TheStmt.Members[J].Lexeme));
                end

                if TheStmt is VarGroupStmt then
                    for var J := 0; J < TheStmt.Names.Length; J := J + 1 do
                        Exported.Add (Str (TheStmt.Names[J].Lexeme));
            end

            var Everything := Set();
            for var I := 0; I < Exported.ToList().Length; I := I + 1 do
                Everything.Add (Exported.ToList()[I]);

            UnitAll.Put (Str (Units[U].Name), Everything);

            var Hidden := Units[U].PrivateNames;
            for var I := 0; I < Hidden.Length; I := I + 1 do
                Exported.Remove (Str (Hidden[I]));

            UnitExports.Put (Str (Units[U].Name), Exported);
        end

        var ExportedBy := Map();
        for var U := 0; U < Units.Length - 1; U := U + 1 do
        begin
            var Visible := UnitExports.Get (Str (Units[U].Name)) as Set;
            var Names := ExportedNames (Units[U]);

            for var I := 0; I < Names.Length; I := I + 1 do
            begin
                var TheName := Str (Names[I]);

                if Visible.Contains (TheName) then
                begin
                    if ExportedBy.Contains (TheName) then
                    begin
                        if Str (ExportedBy.Get (TheName)) <> Str (Units[U].Name) then
                            Renamed.Add (TheName);
                    end
                    else ExportedBy.Put (TheName, Str (Units[U].Name));
                end
            end
        end

        for var U := 0; U < Units.Length; U := U + 1 do
        begin
            var Unit := Units[U];

            Declarations := Buffer();
            Functions := Buffer();
            Setup := Buffer();
            Shells := Buffer();

            Overloaded := OverloadsIn.Get (Str (Unit.Name)) as Set;
            SetsBuilt := Set();

            OwnClasses := Set();
            for var I := 0; I < Unit.Statements.Length; I := I + 1 do
                if Unit.Statements[I] is ClassStmt or Unit.Statements[I] is ObjectStmt then
                    OwnClasses.Add (FoldCase (Unit.Statements[I].Name.Lexeme));
            MainBody := Buffer();
            Header := '';
            Target := 'main';

            Logicals := 0;
            Loops := 0;
            UnitTests := 0;

            var IsMain := U = Units.Length - 1;

            if IsMain then EmitSubranges ();

            UnitName := Str (Unit.Name);
            PrivateNames := Unit.PrivateNames as List;
            RootUnit := IsMain;
            CurrentFile := Str (Unit.FileName);

            Renames := Map();

            var Visible := Set();
            var ImportOwner := Map();

            AmbiguousImports := Map();

            for var I := 0; I < Unit.Imports.Length; I := I + 1 do
                if UnitExports.Contains (Str (Unit.Imports[I])) then
                begin
                    var From := Str (Unit.Imports[I]);
                    var Seen := (UnitExports.Get (From) as Set).ToList();

                    for var J := 0; J < Seen.Length; J := J + 1 do
                    begin
                        var TheName := Str (Seen[J]);

                        Visible.Add (TheName);

                        if ImportOwner.Contains (TheName) then
                        begin
                            if Str (ImportOwner.Get (TheName)) <> From then
                                MarkAmbiguousImport (TheName, Str (ImportOwner.Get (TheName)), From);
                        end
                        else ImportOwner.Put (TheName, From);
                    end
                end

            if UnitAll.Contains (Str (Unit.Name)) then
            begin
                var Declares := (UnitAll.Get (Str (Unit.Name)) as Set).ToList();
                for var I := 0; I < Declares.Length; I := I + 1 do
                    AmbiguousImports.Remove (Str (Declares[I]));
            end

            var Mine := ExportedNames (Unit);
            for var I := 0; I < Mine.Length; I := I + 1 do
            begin
                var TheName := Str (Mine[I]);

                if Visible.Contains (TheName) then
                    if IsMain or Unit.PrivateNames.Contains (TheName) then
                        Renames.Put (TheName, Str (Unit.Name));

                if Renamed.Contains (TheName) then
                    if not Unit.PrivateNames.Contains (TheName) then
                        Renames.Put (TheName, Str (Unit.Name));
            end

            var Reached := ImportOwner.Keys();
            for var I := 0; I < Reached.Length; I := I + 1 do
            begin
                var TheName := Str (Reached[I]);

                if Renamed.Contains (TheName) and not Renames.Contains (TheName) then
                    if not AmbiguousImports.Contains (TheName) then
                        Renames.Put (TheName, Str (ImportOwner.Get (TheName)));
            end

            ShadowNames := Set();

            if UnitAll.Contains (Str (Unit.Name)) then
            begin
                var Own := (UnitAll.Get (Str (Unit.Name)) as Set).ToList();
                for var I := 0; I < Own.Length; I := I + 1 do
                    ShadowNames.Add (Own[I]);
            end

            for var I := 0; I < Unit.Imports.Length; I := I + 1 do
                if UnitExports.Contains (Str (Unit.Imports[I])) then
                begin
                    var Seen := (UnitExports.Get (Str (Unit.Imports[I])) as Set).ToList();
                    for var J := 0; J < Seen.Length; J := J + 1 do
                        ShadowNames.Add (Seen[J]);
                end

            for var I := 0; I < Unit.Statements.Length; I := I + 1 do
            begin
                var TheStmt := Unit.Statements[I];

                if TheStmt is FunctionStmt and not IsTest (TheStmt) then
                begin
                    Declarations.Append (Prototype (TheStmt) + ';' + #10);

                    if Exported (Str (TheStmt.Name.Lexeme)) then
                        Header := Header + Prototype (TheStmt) + ';' + #10;
                end
            end

            AtTopLevel := True;

            PushLabels (Unit.Statements);

            for var I := 0; I < Unit.Statements.Length; I := I + 1 do
            begin
                var TheStmt := Unit.Statements[I];

                if RunsWhenTesting (TheStmt) or not (EmitTests and IsMain) then
                begin
                    if TheStmt is BlockStmt then
                    begin
                        Volatiles := ContainsTry (TheStmt.Statements);
                        Boxed     := BoxesFor (TheStmt.Statements);
                        Cells     := List();

                        Execute (TheStmt);

                        Boxed     := List();
                        Cells     := List();
                        Volatiles := False;
                    end
                    else Execute (TheStmt);
                end
            end

            PopLabels ();

            AtTopLevel := False;

            if IsMain then
            begin
                var InitBody := MainBody;
                MainBody := Buffer();

                if EmitTests then EmitTestRunner ();

                MainBodyText := MainBody.Text;
                MainBody := InitBody;
            end

            Files.Put (Str (Unit.Name) + '.h', UnitHeader (Unit));
            Files.Put (Str (Unit.Name) + '.c', UnitSource (Unit, Units, IsMain, MainBodyText));
        end

        Exit Files;
    end

    /// Builds a unit's header: what it exports, and the includes it needs.
    function UnitHeader (Unit : Any) : String;
    var
        Guard : String;
        Text  : String;

    begin
        Guard := 'ALG_' + Upper (Str (Unit.Name)) + '_H';

        Text := '/* Generated from Algol-24.  Do not edit. */' + #10;
        Text := Text + '#ifndef ' + Guard + #10;
        Text := Text + '#define ' + Guard + #10 + #10;
        Text := Text + '#include "algol.h"' + #10 + #10;
        Text := Text + Header;
        Text := Text + 'void init_' + Str (Unit.Name) + '(void);' + #10;
        Text := Text + #10 + '#endif' + #10;

        Exit Text;
    end

    /// Builds one unit's C file: its includes, its declarations, its function
    /// bodies and its initializer.
    function UnitSource (Unit : Any, Units : List, IsMain : Boolean,
                         Written : String) : String;
    var
        Text : String;

    begin
        Text := '/* Generated from Algol-24.  Do not edit. */' + #10;
        Text := Text + '#include "' + Str (Unit.Name) + '.h"' + #10;

        for var I := 0; I < Unit.Imports.Length; I := I + 1 do
            Text := Text + '#include "' + Str (Unit.Imports[I]) + '.h"' + #10;

        Text := Text + #10;

        if Declarations.Length > 0 then Text := Text + Declarations.Text + #10;
        if Functions.Length > 0 then Text := Text + Functions.Text;

        Text := Text + 'void init_' + Str (Unit.Name) + '(void) {' + #10;
        Text := Text + Shells.Text;
        Text := Text + Setup.Text;
        Text := Text + MainBody.Text;
        Text := Text + '}' + #10;

        if IsMain then
        begin

            Text := Text + #10 + 'int main(int argc, char **argv) {' + #10;
            Text := Text + '    alg_set_arguments(argc, argv);' + #10;

            Text := Text + '    init_' + Str (Unit.Name) + '();' + #10;

            Text := Text + Written;
            Text := Text + '    return 0;' + #10 + '}' + #10;
        end

        Exit Text;
    end

    /// Upper-cases text, for the include guard a header carries.
    function Upper (Text : String) : String;
    var
        Result : String;

    begin
        Result := '';
        for var I := 0; I < Length (Text); I := I + 1 do
        begin
            var C := Text[I];

            if C >= 'a' then
                if C <= 'z' then C := Char (Ord (C) - 32);

            Result := Result + C;
        end
        Exit Result;
    end

    /// Emits the main that runs the test bodies and prints the report.
    ///
    /// It reproduces the interpreted report LINE FOR LINE, including the
    /// '[ERROR]' line naming why each failure failed, and it names the ROOT file
    /// rather than the file each test lives in -- both deliberately, because the
    /// two reports are compared.
    ///
    /// A failing run exits 70 through Halt rather than raising, so a failing suite
    /// prints only the report through either processor.
    procedure EmitTestRunner ();
    var
        Files : List;

    begin
        for var I := 0; I < TestSymbols.Length; I := I + 1 do
            Declarations.Append ('Value ' + Str (TestSymbols[I])
                          + '(Value **cells, Value *args, int32_t count);' + #10);

        MainBody.Append ('    alg_test_begin(' + Str (Tests.Length) + ', '
                  + QuoteC (SourceFile) + ');' + #10);

        Files := List();
        for var I := 0; I < TestFiles.Length; I := I + 1 do
            if not Files.Contains (TestFiles[I]) then Files.Add (TestFiles[I]);

        for var F := 0; F < Files.Length; F := F + 1 do
        begin
            MainBody.Append ('    alg_test_file(' + QuoteC (Str (Files[F])) + ');' + #10);

            var Ordered := List();
            for var I := 0; I < Tests.Length; I := I + 1 do
                if TestFiles[I] = Files[F] then Ordered.Add (I);

            for var A := 0; A < Ordered.Length; A := A + 1 do
                for var B := A + 1; B < Ordered.Length; B := B + 1 do
                    if Str (Tests[Ordered[B]].Name.Lexeme)
                     < Str (Tests[Ordered[A]].Name.Lexeme) then
                    begin
                        var Swap := Ordered[A];
                        Ordered[A] := Ordered[B];
                        Ordered[B] := Swap;
                    end

            for var A := 0; A < Ordered.Length; A := A + 1 do
                MainBody.Append ('    alg_test_run('
                          + QuoteC (Str (Tests[Ordered[A]].Name.Literal)) + ', '
                          + Str (TestSymbols[Ordered[A]]) + ');' + #10);

            MainBody.Append ('    alg_test_end_file();' + #10);
        end

        MainBody.Append ('    return alg_test_summary();' + #10);
    end

    /// Emits one statement, dispatching through its Accept.
    procedure Execute (TheStmt : Any);
    begin
        TheStmt.Accept (this);
    end

    /// Emits one expression and answers the C text for it.
    function Evaluate (TheExpr : Any) : String;
    var
        Text : String;

    begin
        Text := TheExpr.Accept (this) as String;

        if TheExpr.Cast <> '' then
            Exit 'alg_cast(' + Text + ', ' + QuoteC (Str (TheExpr.Cast)) + ')';

        Exit Text;
    end

    /// Emits one test body as a function the runner can call.
    ///
    /// The symbol carries the module's name, because the runner lives in the main
    /// file and calls across file boundaries.
    procedure EmitTest (TheStmt : Any);
    var
        Symbol : String;

    begin
        Symbol := 't_' + UnitName + '_' + Str (UnitTests);
        UnitTests := UnitTests + 1;

        Tests.Add (TheStmt);
        TestFiles.Add (CurrentFile);
        TestSymbols.Add (Symbol);

        var EnclosingTarget := Target;
        var EnclosingBody := Body;
        var EnclosingLocals := Locals;
        var EnclosingTop := AtTopLevel;
        var EnclosingVolatiles := Volatiles;
        var EnclosingDepth := Depth;
        var EnclosingBoxed := Boxed;
        var EnclosingCaptured := Captured;
        var EnclosingCells := Cells;

        Target := 'body';
        Body := Buffer();
        Depth := 1;

        AtTopLevel := False;
        Volatiles := ContainsTry (TheStmt.Body);
        Boxed := BoxesFor (TheStmt.Body);
        Captured := Map();
        Cells := List();
        Locals := List();

        var EnclosingTryDepth := TryDepth;
        var EnclosingLoopTry := LoopTryDepth;

        TryDepth := 0;
        LoopTryDepth := 0;

        HoistCells (TheStmt.Body);

        PushLabels (TheStmt.Body);

        for var I := 0; I < TheStmt.Body.Length; I := I + 1 do
            Execute (TheStmt.Body[I]);

        PopLabels ();

        var Written := Body.Text;

        Target := EnclosingTarget;
        Body := EnclosingBody;
        Locals := EnclosingLocals;
        AtTopLevel := EnclosingTop;
        Volatiles := EnclosingVolatiles;
        Depth := EnclosingDepth;
        Boxed := EnclosingBoxed;
        Captured := EnclosingCaptured;
        Cells := EnclosingCells;
        TryDepth := EnclosingTryDepth;
        LoopTryDepth := EnclosingLoopTry;

        Declarations.Append ('Value ' + Symbol
                     + '(Value **cells, Value *args, int32_t count);' + #10);

        Functions.Append ('Value ' + Symbol
                   + '(Value **cells, Value *args, int32_t count) {' + #10);
        Functions.Append ('    (void)cells; (void)args; (void)count;' + #10);
        Functions.Append (Written);
        Functions.Append ('    return alg_nil();' + #10 + '}' + #10 + #10);
    end

    /// Refuses a 'var' used as an unbraced branch, where C has nowhere to put the
    /// declaration.
    procedure RefuseBareBinding (Body : Any);
    begin
        if Body is VarStmt or Body is VarGroupStmt then
            Unsupported ('A ''var'' as an unbraced branch or loop body');
    end

    /// Whether a body declares a subprogram inside itself.
    function DeclaresNested (Statements : List) : Boolean;
    begin
        for var I := 0; I < Statements.Length; I := I + 1 do
        begin
            var TheStmt := Statements[I];

            if TheStmt is FunctionStmt then Exit True;

            if TheStmt is BlockStmt and DeclaresNested (TheStmt.Statements) then Exit True;
            if TheStmt is WhileStmt and DeclaresNested ([TheStmt.Body]) then Exit True;
            if TheStmt is ForInStmt and DeclaresNested ([TheStmt.Body]) then Exit True;

            if TheStmt is IfStmt then
            begin
                if DeclaresNested ([TheStmt.ThenBranch]) then Exit True;

                if TheStmt.ElseBranch <> Nil and DeclaresNested ([TheStmt.ElseBranch]) then
                    Exit True;
            end

            if TheStmt is TryStmt then
            begin
                if DeclaresNested ([TheStmt.TryBlock]) then Exit True;

                var Handlers := TheStmt.Handlers.Values();
                for var J := 0; J < Handlers.Length; J := J + 1 do
                    if DeclaresNested ([Handlers[J].Body]) then Exit True;
            end
        end

        Exit False;
    end

    /// Adds a name to a list unless it is already there.
    procedure AddOnce (Names : List, Name : String);
    begin
        if not Names.Contains (Name) then Names.Add (Name);
    end

    /// Collects every name a statement list binds directly.
    procedure CollectBindings (Statements : List, Names : List);
    begin
        for var I := 0; I < Statements.Length; I := I + 1 do
        begin
            var TheStmt := Statements[I];

            if TheStmt is VarStmt then AddOnce (Names, Str (TheStmt.Name.Lexeme));

            if TheStmt is VarGroupStmt then
                for var J := 0; J < TheStmt.Names.Length; J := J + 1 do
                    AddOnce (Names, Str (TheStmt.Names[J].Lexeme));

            if TheStmt is ForInStmt then
            begin
                AddOnce (Names, Str (TheStmt.Name.Lexeme));
                CollectBindings ([TheStmt.Body], Names);
            end

            if TheStmt is BlockStmt then CollectBindings (TheStmt.Statements, Names);
            if TheStmt is WhileStmt then CollectBindings ([TheStmt.Body], Names);

            if TheStmt is IfStmt then
            begin
                CollectBindings ([TheStmt.ThenBranch], Names);

                if TheStmt.ElseBranch <> Nil then
                    CollectBindings ([TheStmt.ElseBranch], Names);
            end

            if TheStmt is TryStmt then
            begin
                CollectBindings ([TheStmt.TryBlock], Names);

                var Handlers := TheStmt.Handlers.Values();
                for var J := 0; J < Handlers.Length; J := J + 1 do
                begin
                    AddOnce (Names, Str (Handlers[J].Name));
                    CollectBindings ([Handlers[J].Body], Names);
                end
            end
        end
    end

    /// Gets the names one statement binds.
    function BoundNames (TheStmt : Any) : List;
    var
        Names : List;

    begin
        Names := List();

        for var I := 0; I < TheStmt.Params.Length; I := I + 1 do
            AddOnce (Names, Str (TheStmt.Params[I].Lexeme));

        CollectBindings (TheStmt.Body, Names);
        Exit Names;
    end

    /// Gets what a body must box before it is emitted: everything it binds, if it
    /// declares a function of its own, and nothing otherwise.
    ///
    /// EVERY body that can hold a declaration has to do this, not just the one in
    /// VisitFunctionStmt.  The program's 'begin ... end' and a 'test' block are C
    /// function bodies too, and while they did not, a function declared in either
    /// read its captures as plain locals of another C function -- which does not
    /// compile.
    function BoxesFor (Body : List) : List;
    var
        Names : List;

    begin
        Names := List();
        if DeclaresNested (Body) then CollectBindings (Body, Names);

        Exit Names;
    end

    /// Gets the C expression that reads a captured variable's cell.
    function Cell (Name : String) : String;
    begin
        Exit Mangle ('c_', Name);
    end

    /// Gets the C expression for the receiver inside a method.
    function ThisRef () : String;
    begin
        if Captured.Contains ('this') then Exit Read ('this');

        Exit 'v_this';
    end

    /// Gets the C expression for a cell's address, which is what a closure
    /// carries.
    function CellPointer (Name : String) : String;
    begin
        if Captured.Contains (Name) then Exit 'cells[' + Str (Captured.Get (Name)) + ']';

        Exit Cell (Name);
    end

    /// Gets the cells a nested body may reach: those handed to it, and its own.
    function VisibleCells (Given : Map, Own : List) : List;
    var
        Names : List;

    begin
        Names := Given.Keys();
        for var I := 0; I < Own.Length; I := I + 1 do AddOnce (Names, Str (Own[I]));

        Exit Names;
    end

    /// Gets how a name is read, once cells and fields are accounted for.
    ///
    /// A captured variable is a HEAP CELL, not a copy.  Counter () hands back a
    /// Bump that keeps incrementing the same Count, and a second Counter () gets
    /// its own -- so the capture has to outlive the call AND be shared with it.
    function Read (Name : String) : String;
    begin
        if Captured.Contains (Name) then
            Exit '(*cells[' + Str (Captured.Get (Name)) + '])';

        if Boxed.Contains (Name) then Exit '(*' + Cell (Name) + ')';

        Exit Guarded (Name, VariableName (Name));
    end

    /// Builds a closure over the named cells.
    function ClosureOf (TheStmt : Any, Cells : List) : String;
    var
        Array : String;

    begin
        Array := 'NULL, 0';

        if Cells.Length > 0 then
        begin
            var Joined := '';
            for var I := 0; I < Cells.Length; I := I + 1 do
            begin
                if I > 0 then Joined := Joined + ', ';

                Joined := Joined + CellPointer (Str (Cells[I]));
            end

            Array := '(Value*[]){' + Joined + '}, ' + Str (Cells.Length);
        end

        Exit 'alg_closure(' + QuoteC (Str (TheStmt.Name.Lexeme)) + ', '
           + FunctionSymbol (TheStmt) + ', ' + Array + ', '
           + Str (TheStmt.Params.Length) + ', '
           + TypeTable (FunctionSymbol (TheStmt), ParameterTable (TheStmt)) + ')';
    end

    /// Whether a body holds a try, which decides whether its locals are declared
    /// volatile.
    ///
    /// A local modified between setjmp and longjmp is indeterminate unless it is
    /// volatile, so this is not a nicety.
    function ContainsTry (Statements : List) : Boolean;
    begin
        for var I := 0; I < Statements.Length; I := I + 1 do
        begin
            var TheStmt := Statements[I];

            if TheStmt is TryStmt then Exit True;

            if TheStmt is BlockStmt and ContainsTry (TheStmt.Statements) then Exit True;
            if TheStmt is WhileStmt and ContainsTry ([TheStmt.Body]) then Exit True;
            if TheStmt is ForInStmt and ContainsTry ([TheStmt.Body]) then Exit True;

            if TheStmt is IfStmt then
            begin
                if ContainsTry ([TheStmt.ThenBranch]) then Exit True;

                if TheStmt.ElseBranch <> Nil and ContainsTry ([TheStmt.ElseBranch]) then
                    Exit True;
            end
        end

        Exit False;
    end

    /// Gets a fresh temporary name for the body being emitted.
    function Local () : String;
    begin
        if Volatiles then Exit 'volatile Value ';

        Exit 'Value ';
    end

    /// Records that a name must live in a cell, because something nested
    /// captures it.
    procedure RequireCell (Name : String);
    begin
        if not Cells.Contains (Name) then Unsupported ('A capture of ''' + Name + '''');
    end

    /// Opens a block, answering a mark that CloseScope restores to.
    function OpenScope () : List;
    begin
        Exit [Cells.Length, Locals.Length];
    end

    /// Closes a block, discarding the cells it declared.
    procedure CloseScope (Mark : List);
    begin
        while Cells.Length > Mark[0] do Cells.RemoveAt (Cells.Length - 1);
        while Locals.Length > Mark[1] do Locals.RemoveAt (Locals.Length - 1);
    end

    /// Declares one cell and gives it a starting value.
    procedure DeclareCell (Name : String, Initial : String);
    var
        Qualifier : String;

    begin
        Qualifier := '';
        if Volatiles then Qualifier := 'volatile ';

        Line ('Value *' + Qualifier + Cell (Name) + ' = alg_cell(' + Initial + ');');
        Line ('(void)' + Cell (Name) + ';');

        Cells.Add (Name);
    end

    /// Opens a body by declaring a cell for every boxed name the statement list
    /// binds DIRECTLY, empty, before any of it runs.
    ///
    /// This is what lets a nested function capture a variable declared after it --
    /// which the interpreter allows, because a closure keeps the environment and
    /// the binding lands in it before the call.  Compiled, the closure is built
    /// where the declaration stands, so the cell has to exist by then; the 'var'
    /// becomes a write through it.
    ///
    /// Per BLOCK, not per function, and that is the whole of per-iteration
    /// capture: a loop body is one statement list entered afresh each pass, so its
    /// cells are new each pass.  Hoisting them to the top of the function instead
    /// would make every iteration share one cell, and three closures made in a
    /// loop would all read the last value.
    procedure HoistCells (Statements : List);
    begin
        for var I := 0; I < Statements.Length; I := I + 1 do
        begin
            var TheStmt := Statements[I];

            if TheStmt is VarStmt and Boxed.Contains (Str (TheStmt.Name.Lexeme)) then
            begin
                Locals.Add (Str (TheStmt.Name.Lexeme));
                DeclareCell (Str (TheStmt.Name.Lexeme), 'alg_nil()');
            end

            if TheStmt is VarGroupStmt then
                for var J := 0; J < TheStmt.Names.Length; J := J + 1 do
                    if Boxed.Contains (Str (TheStmt.Names[J].Lexeme)) then
                    begin
                        Locals.Add (Str (TheStmt.Names[J].Lexeme));
                        DeclareCell (Str (TheStmt.Names[J].Lexeme), 'alg_nil()');
                    end
        end
    end

    /// Emits one 'on' handler, with the raised value bound to its name.
    procedure EmitHandlerBody (Handler : Any, Frame : String);
    begin
        var Mark := OpenScope ();

        Line ('{');
        Depth := Depth + 1;

        Locals.Add (Str (Handler.Name));

        if Boxed.Contains (Str (Handler.Name)) then
            DeclareCell (Str (Handler.Name), Frame + '.raised');
        else
        begin
            Line (Local () + VariableName (Str (Handler.Name)) + ' = ' + Frame + '.raised;');
            Line ('(void)' + VariableName (Str (Handler.Name)) + ';');
        end

        Execute (Handler.Body);

        Depth := Depth - 1;
        Line ('}');

        CloseScope (Mark);
    end

    /// Gets a subprogram's declared parameter types, as the runtime's table
    /// wants them.
    function DeclaredTypes (TheMethod : Any) : List;
    var
        Types : List;

    begin
        Types := List();

        for var I := 0; I < TheMethod.Params.Length; I := I + 1 do
        begin
            var Declared := Str (TheMethod.ParamTypes[I]);
            if Declared = '' then Declared := 'Any';

            Types.Add (Declared);
        end

        Exit Types;
    end

    /// Builds the static array of parameter descriptions a method registers
    /// with.
    ///
    /// Emitted once per distinct signature -- see Tables -- because overloads
    /// select on the whole signature and many methods share a shape.
    function ParameterTable (TheMethod : Any) : List;
    var
        Written : List;

    begin
        Written := List();

        for var I := 0; I < TheMethod.Params.Length; I := I + 1 do
        begin
            var Declared := Str (TheMethod.ParamTypes[I]);
            if Declared = '' then Declared := 'Any';

            if I < TheMethod.ParamGenerics.Length then
            begin
                var Element := Str (TheMethod.ParamGenerics[I]);

                if Element <> '' then Declared := Declared + ' of ' + Element;
            end

            Written.Add (Str (TheMethod.Params[I].Lexeme) + ' : ' + Declared);
        end

        Exit Written;
    end

    /// Whether a subprogram's last parameter gathers what is left over.
    function Variadic (TheStmt : Any) : Boolean;
    begin
        if TheStmt.Params.Length = 0 then Exit False;

        var Last := TheStmt.Params.Length - 1;

        if Last >= TheStmt.ParamTypes.Length    then Exit False;
        if Last >= TheStmt.ParamGenerics.Length then Exit False;

        Exit Str (TheStmt.ParamTypes[Last]) = 'List'
         and Str (TheStmt.ParamGenerics[Last]) <> '';
    end

    /// Gets the C symbol of a method, carrying its owner and its signature.
    function MethodSymbol (Owner : String, TheMethod : Any) : String;
    var
        Symbol : String;

    begin
        Symbol := 'm_' + Escaped (Owner) + '_' + Escaped (Str (TheMethod.Name.Lexeme))
                + '_' + Str (TheMethod.Params.Length);

        var Types := DeclaredTypes (TheMethod);
        for var I := 0; I < Types.Length; I := I + 1 do
            if Types[I] <> 'Any' then
                Symbol := Symbol + '_' + Escaped (Str (Types[I]));

        Exit Symbol;
    end

    /// Gets the fields or methods a class body may reach as bare names,
    /// inherited ones included.
    function NamesVisible (SuperName : String, Own : List, Fields : Boolean) : Set;
    var
        Names : Set;
        At    : String;

    begin
        Names := Set();

        for var I := 0; I < Own.Length; I := I + 1 do
            Names.Add (FoldCase (Own[I].Name.Lexeme));

        At := SuperName;
        while At <> '' do
        begin
            if not Classes.Contains (At) then Exit Names;

            var Ancestor := Classes.Get (At);

            var Inherited := Ancestor.Methods;
            if Fields then Inherited := Ancestor.Fields;

            for var I := 0; I < Inherited.Length; I := I + 1 do
                Names.Add (FoldCase (Inherited[I].Name.Lexeme));

            At := '';
            if Ancestor.Superclass <> Nil then At := Str (Ancestor.Superclass.Name.Lexeme);
        end

        Exit Names;
    end

    /// Emits one method as a C function taking its receiver and its arguments.
    procedure EmitMethod (Owner : String, TheMethod : Any);
    var
        EnclosingLocals : List;
        EnclosingTop    : Boolean;
        EnclosingDepth  : Integer;
        Opening         : String;

    begin
        EnclosingLocals := Locals;
        EnclosingTop := AtTopLevel;
        EnclosingDepth := Depth;

        Locals := List();
        AtTopLevel := False;

        var EnclosingTarget := Target;
        var EnclosingBody := Body;

        Target := 'body';
        Body := Buffer();
        Depth := 1;

        var EnclosingVolatiles := Volatiles;
        Volatiles := ContainsTry (TheMethod.Body);

        var EnclosingBoxed := Boxed;
        var EnclosingCaptured := Captured;
        var EnclosingCells := Cells;

        Boxed := List();
        Captured := Map();
        Cells := List();

        if DeclaresNested (TheMethod.Body) then
        begin
            Boxed := BoundNames (TheMethod);
            AddOnce (Boxed, 'this');

            DeclareCell ('this', 'v_this');
        end

        var EnclosingTryDepth := TryDepth;
        var EnclosingLoopTry := LoopTryDepth;

        TryDepth := 0;
        LoopTryDepth := 0;

        for var I := 0; I < TheMethod.Params.Length; I := I + 1 do
        begin
            var Name := Str (TheMethod.Params[I].Lexeme);
            Locals.Add (Name);

            var Slot := 'args[' + Str (I) + ']';

            if I < TheMethod.ParamTypes.Length then
            begin
                var Declared := Str (TheMethod.ParamTypes[I]);

                if Declared <> '' and Declared <> 'Any' then
                    Slot := 'alg_widen(' + Slot + ', ' + QuoteC (Declared) + ')';
            end

            if Boxed.Contains (Name) then DeclareCell (Name, Slot);
            else
            begin
                Line (Local () + VariableName (Name) + ' = ' + Slot + ';');
                Line ('(void)' + VariableName (Name) + ';');
            end
        end

        HoistCells (TheMethod.Body);

        PushLabels (TheMethod.Body);

        for var I := 0; I < TheMethod.Body.Length; I := I + 1 do
            Execute (TheMethod.Body[I]);

        PopLabels ();

        Line ('return alg_nil();');

        var Written := Body.Text;

        Target := EnclosingTarget;
        Body := EnclosingBody;

        Functions.Append ('static Value ' + MethodSymbol (Owner, TheMethod)
                   + '(Value v_this, Value *args, int32_t count) {' + #10);

        Functions.Append ('    (void)v_this; (void)args; (void)count;' + #10);
        Functions.Append (Written);
        Functions.Append ('}' + #10 + #10);

        Depth := EnclosingDepth;
        AtTopLevel := EnclosingTop;
        Locals := EnclosingLocals;
        Volatiles := EnclosingVolatiles;
        Boxed := EnclosingBoxed;
        Captured := EnclosingCaptured;
        Cells := EnclosingCells;
        TryDepth := EnclosingTryDepth;
        LoopTryDepth := EnclosingLoopTry;
    end

    /// Emits a class: its shell, then its link to its parent, then its fields
    /// and methods.
    ///
    /// The three go to different buffers, because a class may inherit from one
    /// declared below it -- see Shells.
    procedure EmitClass (Name : String, Superclass : Any, Fields : List,
                         Methods : List, IsObject : Boolean);
    var
        Handle    : String;
        SuperName : String;
        Applied   : String;
        Initializer : String;

        EnclosingClass   : String;
        EnclosingFields  : Set;
        EnclosingMethods : Set;

    begin
        Handle := ClassHandle (Name);
        DeclareValue (Handle, Name);

        EnclosingClass := CurrentClass;
        EnclosingFields := VisibleFields;
        EnclosingMethods := VisibleMethods;

        SuperName := '';
        if Superclass <> Nil then SuperName := Str (Superclass.Name.Lexeme);

        CurrentClass := Name;
        VisibleFields := NamesVisible (SuperName, Fields, True);
        VisibleMethods := NamesVisible (SuperName, Methods, False);

        var DeclaresId := False;
        for var I := 0; I < Fields.Length; I := I + 1 do
            if Str (Fields[I].Name.Lexeme) = 'Id' then DeclaresId := True;

        var AddId := IsObject and not DeclaresId;
        if AddId then VisibleFields.Add (FoldCase ('Id'));

        Applied := '';
        for var I := 0; I < Fields.Length; I := I + 1 do
        begin
            var Value := 'alg_nil()';
            if Fields[I].Initializer <> Nil then
            begin
                Value := Evaluate (Fields[I].Initializer);

                Value := BoundValue (Fields[I].TypeName, Value);
            end

            Applied := Applied + '    alg_set_property(v_this, '
                     + QuoteC (Str (Fields[I].Name.Lexeme)) + ', ' + Value + ');' + #10;
        end

        if AddId then
            Applied := Applied + '    alg_set_property(v_this, "Id", alg_string('
                     + QuoteC (Name) + '));' + #10;

        Initializer := InitName (Name);
        Functions.Append ('static Value ' + Initializer
                   + '(Value v_this, Value *args, int32_t count) {' + #10);

        Functions.Append ('    (void)v_this; (void)args; (void)count;' + #10);
        Functions.Append (Applied);
        Functions.Append ('    return alg_nil();' + #10 + '}' + #10 + #10);

        for var I := 0; I < Methods.Length; I := I + 1 do
            EmitMethod (Name, Methods[I]);

        CurrentClass := EnclosingClass;
        VisibleFields := EnclosingFields;
        VisibleMethods := EnclosingMethods;

        Shells.Append ('    ' + Handle + ' = alg_class(' + QuoteC (Name)
               + ', alg_nil());' + #10);

        var Hoisted := SuperName = '' or OwnClasses.Contains (FoldCase (SuperName));

        if SuperName <> '' then
        begin
            if not Classes.Contains (SuperName) and not Objects.Contains (SuperName) then
                raise '''' + SuperName + ''' is not a class.';

            if not Hoisted then
                Built (Hoisted, 'alg_class_declared(' + ClassHandle (SuperName) + ', '
                     + QuoteC (SuperName) + ');');

            Built (Hoisted, 'alg_class_super(' + Handle + ', '
                 + ClassHandle (SuperName) + ');');
        end

        for var I := 0; I < Fields.Length; I := I + 1 do
            Built (Hoisted, 'alg_class_field(' + Handle + ', '
                 + QuoteC (Str (Fields[I].Name.Lexeme)) + ');');

        if AddId then
            Built (Hoisted, 'alg_class_field(' + Handle + ', "Id");');

        Built (Hoisted, 'alg_class_initializer(' + Handle + ', ' + Initializer + ');');

        for var I := 0; I < Methods.Length; I := I + 1 do
        begin
            var TheMethod := Methods[I];
            var Types := ParameterTable (TheMethod);

            var Table := 'NULL';

            if Types.Length > 0 then
            begin
                Table := 't_' + Copy (MethodSymbol (Name, TheMethod), 2,
                                      Length (MethodSymbol (Name, TheMethod)) - 2);

                var Quoted := '';
                for var J := 0; J < Types.Length; J := J + 1 do
                begin
                    if J > 0 then Quoted := Quoted + ', ';

                    Quoted := Quoted + QuoteC (Str (Types[J]));
                end

                Declarations.Append ('static const char *' + Table
                             + '[] = { ' + Quoted + ' };' + #10);
            end

            if TheMethod.IsProperty then
                Built (Hoisted, 'alg_class_property(' + Handle + ', '
                     + QuoteC (Str (TheMethod.Name.Lexeme)) + ', '
                     + MethodSymbol (Name, TheMethod) + ');');
            else
                Built (Hoisted, 'alg_class_method(' + Handle + ', '
                     + QuoteC (Str (TheMethod.Name.Lexeme)) + ', '
                     + MethodSymbol (Name, TheMethod) + ', '
                     + Str (TheMethod.Params.Length) + ', ' + Table + ');');
        end

        if IsObject then Built (Hoisted, 'alg_class_is_object(' + Handle + ');');
    end

    /// Writes a line to Setup or to the current body, depending on whether the
    /// declaration is hoisted.
    procedure Built (Hoisted : Boolean, Text : String);
    begin
        if Hoisted then Setup.Append ('    ' + Text + #10);
        else Line (Text);
    end

    /// Emits a 'var' or 'const': a local, a cell, or a file-scope global.
    ///
    /// A top-level 'var' becomes a global plus a flag saying whether its
    /// declaration has run, because in C the storage exists from the start while
    /// the language says a variable is not hoisted.
    procedure VisitVarStmt (TheStmt : VarStmt);
    var
        Value : String;

    begin
        Value := 'alg_nil()';
        if TheStmt.Initializer <> Nil then
        begin
            Value := Evaluate (TheStmt.Initializer);

            if Str (TheStmt.TypeName) <> '' and Str (TheStmt.TypeName) <> 'Any' then
                Value := 'alg_widen(' + Value + ', ' + QuoteC (Str (TheStmt.TypeName)) + ')';
        end

        if AtTopLevel then
        begin
            DeclareVariable (VariableName (Str (TheStmt.Name.Lexeme)),
                             Str (TheStmt.Name.Lexeme));

            Line (VariableName (Str (TheStmt.Name.Lexeme)) + ' = ' + Value + ';');

            Line (DeclaredFlag (Str (TheStmt.Name.Lexeme)) + ' = true;');
        end
        else if Boxed.Contains (Str (TheStmt.Name.Lexeme)) then
        begin
            RequireCell (Str (TheStmt.Name.Lexeme));

            Locals.Add (Str (TheStmt.Name.Lexeme));
            Line ('*' + Cell (Str (TheStmt.Name.Lexeme)) + ' = ' + Value + ';');
        end
        else
        begin
            Locals.Add (Str (TheStmt.Name.Lexeme));

            Line (Local () + VariableName (Str (TheStmt.Name.Lexeme)) + ' = ' + Value + ';');
            Line ('(void)' + VariableName (Str (TheStmt.Name.Lexeme)) + ';');
        end
    end

    /// Emits an expression evaluated for its effect, its value discarded.
    procedure VisitExpressionStmt (TheStmt : ExpressionStmt);
    begin
        Line ('(void)(' + Evaluate (TheStmt.Expression) + ');');
    end

    /// Opens a label scope, recording the TryDepth the block began at.
    ///
    /// Recorded on ENTRY, because a forward goto is emitted before its label and
    /// would otherwise have nothing to ask how many frames lie between them.
    procedure PushLabels (Statements : List);
    var
        Here : Map;

    begin
        Here := Map();

        for var I := 0; I < Statements.Length; I := I + 1 do
            if Statements[I] is LabelStmt then
                Here.Put (FoldCase (Str (Statements[I].Name.Lexeme)), TryDepth);

        LabelDepths.Add (Here);
    end

    /// Closes the innermost label scope.
    procedure PopLabels ();
    begin
        LabelDepths.RemoveAt (LabelDepths.Length - 1);
    end

    /// Gets the TryDepth the block declaring a label began at.
    function DepthOfLabel (TheLabel : String) : Integer;
    var
        Folded : String;

    begin
        Folded := FoldCase (TheLabel);

        for var S := LabelDepths.Length - 1; S >= 0; S := S - 1 do
            if LabelDepths[S].Contains (Folded) then
                Exit LabelDepths[S].Get (Folded) as Integer;

        Exit TryDepth;
    end

    /// Gets the C label a 'goto' jumps to.
    ///
    /// Frames are popped down to the label's block, which may be several: a goto
    /// out of two trys leaves both.  The runtime's frame stack would otherwise
    /// point at C frames that have returned.
    function GotoTarget (TheLabel : String) : String;
    begin
        Exit 'lg_' + Escaped (FoldCase (TheLabel));
    end

    /// Emits a goto, popping the try frames it leaves and marking the label as
    /// jumped to.
    ///
    /// The mark is what lets a C label be written only where something reaches
    /// it, since an unused label is a warning under -Wall.
    procedure VisitGotoStmt (TheStmt : GotoStmt);
    begin
        PopFramesTo (DepthOfLabel (TheStmt.Label));

        Line ('goto ' + GotoTarget (TheStmt.Label) + ';');
    end

    /// Emits a block, with its own cells and label scope.
    procedure VisitBlockStmt (TheStmt : BlockStmt);
    begin
        var Mark := OpenScope ();

        var EnclosingTop := AtTopLevel;
        AtTopLevel := False;

        Line ('{');
        Depth := Depth + 1;
        HoistCells (TheStmt.Statements);
        PushLabels (TheStmt.Statements);

        for var I := 0; I < TheStmt.Statements.Length; I := I + 1 do
            Execute (TheStmt.Statements[I]);

        PopLabels ();

        Depth := Depth - 1;
        Line ('}');

        AtTopLevel := EnclosingTop;
        CloseScope (Mark);
    end

    /// Emits an if, braced on both branches.
    ///
    /// A 'var' as an unbraced branch is refused: C has nowhere to put the
    /// declaration.
    procedure VisitIfStmt (TheStmt : IfStmt);
    begin
        RefuseBareBinding (TheStmt.ThenBranch);
        if TheStmt.ElseBranch <> Nil then RefuseBareBinding (TheStmt.ElseBranch);

        var Mark := OpenScope ();

        Line ('if (alg_truthy(' + Evaluate (TheStmt.Condition) + ')) {');
        Depth := Depth + 1;
        Execute (TheStmt.ThenBranch);
        Depth := Depth - 1;
        CloseScope (Mark);

        if TheStmt.ElseBranch <> Nil then
        begin
            Line ('} else {');
            Depth := Depth + 1;
            Execute (TheStmt.ElseBranch);
            Depth := Depth - 1;
            CloseScope (Mark);
        end

        Line ('}');
    end

    /// Emits a while, and the counted for that desugars into one.
    ///
    /// A loop carrying a step becomes a C 'for (; cond; step)' rather than a
    /// while with the step appended to the body.  That is what makes a
    /// 'continue' still advance the loop: the continue target sits at the END of
    /// the body, and C runs a for's step clause after the body however the body
    /// was reached.  Appending the step to the body instead would skip it on
    /// exactly the iterations that take the shortcut.
    procedure VisitWhileStmt (TheStmt : WhileStmt);
    begin
        RefuseBareBinding (TheStmt.Body);

        var Mark := OpenScope ();

        if TheStmt.Increment <> Nil then
            Line ('for (; alg_truthy(' + Evaluate (TheStmt.Condition) + '); '
                + Evaluate (TheStmt.Increment) + ') {');
        else
            Line ('while (alg_truthy(' + Evaluate (TheStmt.Condition) + ')) {');

        Depth := Depth + 1;

        var EnclosingLoopDepth := LoopTryDepth;
        LoopTryDepth := TryDepth;
        LoopLabels.Add (TheStmt.Label);
        LoopDepths.Add (TryDepth);

        Execute (TheStmt.Body);

        LoopLabels.RemoveAt (LoopLabels.Length - 1);
        LoopDepths.RemoveAt (LoopDepths.Length - 1);
        LoopTryDepth := EnclosingLoopDepth;

        EmitContinueTarget (TheStmt.Label);

        Depth := Depth - 1;
        Line ('}');

        EmitBreakTarget (TheStmt.Label);

        CloseScope (Mark);
    end

    /// Emits the label a 'continue' jumps to: the end of the loop body, from
    /// which C's own step clause runs next.
    ///
    /// Emitted only when something jumped to it, since an unused C label is a
    /// warning under -Wall.
    procedure EmitContinueTarget (TheLabel : String);
    begin
        if TheLabel = '' then Exit;
        if not Jumped.Contains (ContinueTarget (TheLabel)) then Exit;

        Line (ContinueTarget (TheLabel) + ': ;');
    end

    /// Emits the label a 'break' jumps to: the first thing AFTER the loop, which
    /// is where leaving it lands.
    procedure EmitBreakTarget (TheLabel : String);
    begin
        if TheLabel = '' then Exit;
        if not Jumped.Contains (BreakTarget (TheLabel)) then Exit;

        Line (BreakTarget (TheLabel) + ': ;');
    end

    /// Emits an 'Exit', popping every try frame open inside the subprogram.
    ///
    /// Leaving a try block without reaching its pop would strand a frame pointing
    /// at a C frame that has returned.
    procedure VisitReturnStmt (TheStmt : ReturnStmt);
    var
        Value : String;

    begin
        Value := 'alg_nil()';
        if TheStmt.Value <> Nil then Value := Evaluate (TheStmt.Value);

        if TryDepth = 0 then
        begin
            Line ('return ' + Value + ';');
            Exit;
        end

        var Slot := 'ret_' + Str (Loops);
        Loops := Loops + 1;

        Line (Local () + Slot + ' = ' + Value + ';');

        for var I := 0; I < TryDepth; I := I + 1 do
            Line ('alg_pop_frame();');

        Line ('return ' + Slot + ';');
    end

    /// Emits a subprogram that is a C symbol: a body that marshals and calls out.
    ///
    /// The DECLARED PARAMETER LIST is what describes the call, and it is the array
    /// ParameterTable already builds for overload selection -- so nothing new had
    /// to be emitted to say what the signature is.
    ///
    /// # Safety
    ///
    /// Past this boundary the runtime cannot check a pointer, a lifetime or an
    /// arity.  A declaration that misdescribes the C function is a crash rather
    /// than a diagnostic.
    procedure EmitForeign (TheStmt : FunctionStmt);
    var
        Symbol : String;

    begin
        Symbol := FunctionSymbol (TheStmt);

        var Table := TypeTable (Symbol, ParameterTable (TheStmt));

        Functions.Append ('Value ' + Symbol
                   + '(Value **cells, Value *args, int32_t count) {' + #10);
        Functions.Append ('    (void)cells; (void)count;' + #10);
        Functions.Append ('    return alg_foreign(' + QuoteC (Str (TheStmt.Symbol)) + ', '
                   + QuoteC (Str (TheStmt.Library)) + ', ' + Table + ', '
                   + Str (TheStmt.Params.Length) + ', '
                   + QuoteC (Str (TheStmt.ReturnType)) + ', args);' + #10);
        Functions.Append ('}' + #10 + #10);
        var Name := Str (TheStmt.Name.Lexeme);

        if Overloaded.Contains (Name) then
        begin
            if not Declared.Contains (SetName (Name)) then
            begin
                DeclareValue (SetName (Name), Name);
                Setup.Append ('    ' + SetName (Name) + ' = alg_overloads('
                       + QuoteC (Name) + ');' + #10);
            end

            Setup.Append ('    alg_overload(' + SetName (Name) + ', ' + Symbol + ', '
                   + Str (TheStmt.Params.Length) + ', ' + Table + ');' + #10);

            Exit;
        end

        DeclareValue (HandleName (Name), Name);

        Setup.Append ('    ' + HandleName (Name) + ' = alg_closure('
               + QuoteC (Name) + ', ' + Symbol + ', NULL, 0, '
               + Str (TheStmt.Params.Length) + ', ' + Table + ');' + #10);
    end

    /// Emits a whole subprogram body, written into its own buffer.
    ///
    /// Its own buffer because a NESTED function appends itself to Functions while
    /// its enclosing one is still being written -- see Body.
    ///
    /// A function nested more than one level deep, or declared inside a method, is
    /// refused by name.
    procedure VisitFunctionStmt (TheStmt : FunctionStmt);
    var
        EnclosingLocals : List;
        EnclosingTop    : Boolean;
        EnclosingDepth  : Integer;

    begin
        if IsTest (TheStmt) then
        begin
            if EmitTests then EmitTest (TheStmt);

            Exit;
        end

        if TheStmt.Symbol <> '' then
        begin
            EmitForeign (TheStmt);

            Exit;
        end

        var Nested := not AtTopLevel;

        EnclosingLocals := Locals;
        EnclosingTop := AtTopLevel;
        EnclosingDepth := Depth;

        var EnclosingBoxed := Boxed;
        var EnclosingCaptured := Captured;
        var EnclosingCells := Cells;
        var EnclosingNested := InsideNested;

        Locals := List();

        var Inherited := VisibleCells (Captured, EnclosingCells);

        if Nested then
        begin
            var Index := Map();
            for var I := 0; I < Inherited.Length; I := I + 1 do
                Index.Put (Str (Inherited[I]), I);

            Captured := Index;
            InsideNested := True;
        end
        else Captured := Map();

        Cells := List();

        var EnclosingVolatiles := Volatiles;
        Volatiles := ContainsTry (TheStmt.Body);

        var EnclosingTryDepth := TryDepth;
        var EnclosingLoopTry := LoopTryDepth;

        TryDepth := 0;
        LoopTryDepth := 0;

        Boxed := List();
        if DeclaresNested (TheStmt.Body) then Boxed := BoundNames (TheStmt);

        AtTopLevel := False;

        var EnclosingTarget := Target;
        var EnclosingBody := Body;

        Target := 'body';
        Body := Buffer();
        Depth := 1;

        if not Nested then
            Line ('alg_arity(count, ' + Str (TheStmt.Params.Length) + ');');

        for var I := 0; I < TheStmt.Params.Length; I := I + 1 do
        begin
            var ParamName := Str (TheStmt.Params[I].Lexeme);
            Locals.Add (ParamName);

            if Boxed.Contains (ParamName) then
            begin
                var Qualifier := 'Value *';
                if Volatiles then Qualifier := 'Value *volatile ';

                Line (Qualifier + Cell (ParamName) + ' = alg_cell('
                    + BoundArgument (TheStmt.Params, TheStmt.ParamTypes, I) + ');');
                Line ('(void)' + Cell (ParamName) + ';');

                Cells.Add (ParamName);
            end
            else
            begin
                Line (Local () + VariableName (ParamName) + ' = '
                    + BoundArgument (TheStmt.Params, TheStmt.ParamTypes, I) + ';');
                Line ('(void)' + VariableName (ParamName) + ';');
            end
        end

        HoistCells (TheStmt.Body);
        PushLabels (TheStmt.Body);

        for var I := 0; I < TheStmt.Body.Length; I := I + 1 do
            Execute (TheStmt.Body[I]);

        PopLabels ();

        Line ('return alg_nil();');

        var Written := Body.Text;

        Target := EnclosingTarget;
        Body := EnclosingBody;

        Functions.Append (Prototype (TheStmt) + ' {' + #10);

        Functions.Append ('    (void)cells; (void)args; (void)count;' + #10);
        Functions.Append (Written);
        Functions.Append ('}' + #10 + #10);

        var CapturedCells := Inherited;

        Depth := EnclosingDepth;
        AtTopLevel := EnclosingTop;
        Locals := EnclosingLocals;
        Volatiles := EnclosingVolatiles;
        Boxed := EnclosingBoxed;
        Captured := EnclosingCaptured;
        Cells := EnclosingCells;
        TryDepth := EnclosingTryDepth;
        LoopTryDepth := EnclosingLoopTry;
        InsideNested := EnclosingNested;

        var Name := Str (TheStmt.Name.Lexeme);

        if Nested then
        begin
            Locals.Add (Name);
            Line (Local () + VariableName (Name) + ' = '
                + ClosureOf (TheStmt, CapturedCells) + ';');
        end
        else if Overloaded.Contains (Name) then
        begin
            if not SetsBuilt.Contains (Name) then
            begin
                SetsBuilt.Add (Name);

                DeclareValue (SetName (Name), Name);
                Setup.Append ('    ' + SetName (Name) + ' = alg_overloads('
                       + QuoteC (Name) + ');' + #10);
            end

            Setup.Append ('    alg_overload(' + SetName (Name) + ', '
                   + FunctionSymbol (TheStmt) + ', ' + Str (TheStmt.Params.Length)
                   + ', ' + TypeTable (FunctionSymbol (TheStmt), ParameterTable (TheStmt))
                   + ');' + #10);
        end
        else
        begin
            DeclareValue (HandleName (Name), Name);

            Setup.Append ('    ' + HandleName (Name) + ' = '
                   + ClosureOf (TheStmt, List()) + ';' + #10);
        end
    end

    /// Declares the static array of declared parameter types a subprogram
    /// registers with, once per distinct signature.
    function TypeTable (Symbol : String, Types : List) : String;
    var
        Table : String;

    begin
        if Types.Length = 0 then Exit 'NULL';

        Table := 't_' + Symbol;

        if Tables.Contains (Table) then Exit Table;
        Tables.Add (Table);

        var Quoted := '';
        for var I := 0; I < Types.Length; I := I + 1 do
        begin
            if I > 0 then Quoted := Quoted + ', ';

            Quoted := Quoted + QuoteC (Str (Types[I]));
        end

        Declarations.Append ('static const char *' + Table + '[] = { ' + Quoted + ' };' + #10);

        Exit Table;
    end

    /// Emits a literal.
    ///
    /// The literal's VALUE is emitted, not its text -- '0xFF' and '255' both
    /// become the same integer constant.
    function VisitLiteral (TheExpr : LiteralExpr) : String;
    var
        Value : Any;

    begin
        Value := TheExpr.Value;

        if Value = Nil then Exit 'alg_nil()';
        if Value = True then Exit 'alg_bool(true)';
        if Value = False then Exit 'alg_bool(false)';

        if Value is Integer then
        begin
            if Value > 9223372036854775807 or Value < -9223372036854775807 then
                Exit 'alg_integer(' + QuoteC (Str (Value)) + ')';

            Exit 'alg_int(' + Str (Value) + ')';
        end
        if Value is Double then Exit 'alg_double(' + Str (Value) + ')';
        if Value is String then Exit 'alg_string(' + QuoteC (Str (Value)) + ')';
        if Value is Char then Exit 'alg_char_value(' + Str (Ord (Value)) + ')';

        Unsupported ('A literal of type ' + TypeNameOf (Value));
    end

    /// Emits a bare name: a local, a cell, a field of the receiver, a global, or
    /// a built-in.
    function VisitVariableExpr (TheExpr : VariableExpr) : String;
    var
        Name : String;

    begin
        Name := Spelled (Str (TheExpr.Name.Lexeme));

        if Captured.Contains (Name) or Boxed.Contains (Name) then Exit Read (Name);

        if CurrentClass <> '' and not Locals.Contains (Name)
                              and VisibleFields.Contains (FoldCase (Name)) then
            Exit 'alg_property(' + ThisRef () + ', ' + QuoteC (Name) + ')';

        if not Locals.Contains (Name) then
        begin
            if AmbiguousMembers.Contains (Name) then
                Exit '(alg_error(' + QuoteC (AmbiguousMessage (Str (TheExpr.Name.Lexeme),
                                             Str (AmbiguousMembers.Get (Name))))
                   + '), alg_nil())';

            if AmbiguousImports.Contains (Name) then
                Exit '(alg_error(' + QuoteC (AmbiguousMessage (Str (TheExpr.Name.Lexeme),
                                             Str (AmbiguousImports.Get (Name))))
                   + '), alg_nil())';

            if EnumMembers.Contains (Name) then
                Exit EnumMemberName (Str (EnumMembers.Get (Name)), Name);

            if EnumTypes.Contains (Name) then Exit EnumTypeName (Name);

            if Objects.Contains (Name) then
                Exit 'alg_singleton(' + ClassHandle (Name) + ')';

            if Declared.Contains (Name) then Exit SubprogramValue (Name);
        end

        Unreachable (Name);

        if not Locals.Contains (Name) and not Globals.Contains (Name)
                                      and not Classes.Contains (Name)
                                      and not Objects.Contains (Name) then
            Exit '(alg_error(' + QuoteC (MissingName (Name)) + '), alg_nil())';

        Exit Guarded (Name, VariableName (Name));
    end

    /// Emits a read of a file-scope variable, checked against its declaration
    /// having run.
    ///
    /// A RUNTIME check, and it has to be: the read may sit inside a function
    /// declared above the variable and called from below it, which is legal and
    /// common.  Nothing the emitter can see decides it -- a function returning a
    /// later global is correct or an error depending on when it is called.
    ///
    /// Only a FILE-SCOPE variable.  A local is a C local declared where the
    /// program declares it, so it cannot be named before it exists -- cc refuses
    /// that outright, and the guard would be dead code.
    function Guarded (Name : String, Text : String) : String;
    begin
        if Locals.Contains (Name) then Exit Text;

        if not Globals.Contains (Name) then Exit Text;

        Exit '(alg_declared(' + DeclaredFlag (Name) + ', '
           + QuoteC (Name) + '), ' + Text + ')';
    end

    /// Builds the message for a name nothing declares.
    function MissingName (Name : String) : String;
    var
        Units : List;

    begin
        Units := UnitExports.Keys();

        for var I := 0; I < Units.Length; I := I + 1 do
            if (UnitExports.Get (Units[I]) as Set).Contains (Name) then
                Exit 'Undefined variable ''' + Name + '''. Unit ''' + Str (Units[I])
                   + ''' exports it; this file has no ''uses'' for it.';

        Exit 'Undefined variable ''' + Name + '''.';
    end

    /// Gets the spelling a name was declared with, for a diagnostic.
    ///
    /// Lookups are folded and a message must echo what the program wrote.
    function Spelled (Name : String) : String;
    begin
        if Locals.Contains (Name) then Exit Str (Name);
        if Canonical.Contains (FoldCase (Name)) then Exit Str (Canonical.Get (FoldCase (Name)));

        Exit Str (Name);
    end

    /// Refuses a name that is declared but cannot be reached from here.
    procedure Unreachable (Name : String);
    begin
        if not InsideNested then Exit;
        if Locals.Contains (Name) then Exit;
        if Globals.Contains (Name) then Exit;

        Unsupported ('Reading ''' + Name + ''' from a nested function');
    end

    /// Wraps a value in the widening its declared type calls for.
    function BoundValue (Declared : Any, Value : String) : String;
    begin
        if Str (Declared) = '' or Str (Declared) = 'Any' then Exit Str (Value);

        Exit 'alg_widen(' + Str (Value) + ', ' + QuoteC (Str (Declared)) + ')';
    end

    /// Emits an assignment to a bare name, widened to the type declared for it.
    function VisitAssignExpr (TheExpr : AssignExpr) : String;
    var
        Name : String;

    begin
        Name := Str (TheExpr.Name.Lexeme);

        var Written := BoundValue (TheExpr.Declared, Evaluate (TheExpr.Value));

        if Captured.Contains (Name) or Boxed.Contains (Name) then
            Exit '(' + Read (Name) + ' = ' + Written + ')';

        if CurrentClass <> '' and not Locals.Contains (Name)
                              and VisibleFields.Contains (FoldCase (Name)) then
            Exit 'alg_set_property(' + ThisRef () + ', ' + QuoteC (Name) + ', ' + Written + ')';

        Unreachable (Name);

        Exit Guarded (Name, '(' + VariableName (Name) + ' = ' + Written + ')');
    end

    /// Emits a parenthesised expression.
    function VisitGrouping (TheExpr : GroupingExpr) : String;
    begin
        Exit '(' + Evaluate (TheExpr.Expression) + ')';
    end

    /// Emits an 'is' type test, including a subrange's bounds check.
    function VisitIsExpr (TheExpr : IsExpr) : String;
    begin
        Exit 'alg_is(' + Evaluate (TheExpr.Obj) + ', '
           + QuoteC (CanonicalType (TheExpr.TypeName.Lexeme)) + ')';
    end

    /// Emits a prefix operator, or a class's own unary operator.
    function VisitUnary (TheExpr : UnaryExpr) : String;
    var
        Operand : String;

    begin
        Operand := Evaluate (TheExpr.Right);

        case TheExpr.Op.TypeOfToken of
            TOKEN_MINUS : Exit 'alg_negate(' + Operand + ')';
            TOKEN_NOT   : Exit 'alg_not(' + Operand + ')';
        end

        Unsupported ('Unary ''' + Str (TheExpr.Op.Lexeme) + '''');
    end

    /// Emits a binary operation, or a class's own operator.
    ///
    /// The runtime decides promotion, text joining and ordering, so the two
    /// processors cannot disagree about what an operator means.
    function VisitBinary (TheExpr : BinaryExpr) : String;
    var
        Left  : String;
        Right : String;
        Call  : String;

    begin
        Left  := Evaluate (TheExpr.Left);
        Right := Evaluate (TheExpr.Right);

        Call := '';
        case TheExpr.Op.TypeOfToken of
            TOKEN_PLUS          : Call := 'alg_add';
            TOKEN_MINUS         : Call := 'alg_subtract';
            TOKEN_STAR          : Call := 'alg_multiply';
            TOKEN_SLASH         : Call := 'alg_divide';
            TOKEN_DIV           : Call := 'alg_div_int';
            TOKEN_GREATER       : Call := 'alg_greater';
            TOKEN_GREATER_EQUAL : Call := 'alg_greater_equal';
            TOKEN_LESS          : Call := 'alg_less';
            TOKEN_LESS_EQUAL    : Call := 'alg_less_equal';
            TOKEN_EQUAL         : Call := 'alg_equal';
            TOKEN_NOT_EQUAL     : Call := 'alg_not_equal';
            TOKEN_IN            : Call := 'alg_in';
        end

        if Call = '' then Unsupported ('Binary ''' + Str (TheExpr.Op.Lexeme) + '''');

        Exit Call + '(' + Left + ', ' + Right + ')';
    end

    /// Gets the argument counts a built-in accepts.
    function BuiltinCounts (Name : String) : List;
    var
        Counts : List;

    begin
        Counts := List();

        for var K := 0; K <= 3; K := K + 1 do
        begin
            var Probe := List();
            for var I := 0; I < K; I := I + 1 do Probe.Add ('0');

            if Builtin (Name, K) <> '' then Counts.Add (K);
            else if ConstructorFor (Name, Probe, '0') <> '' then Counts.Add (K);
        end

        Exit Counts;
    end

    /// Builds the arity message a built-in reports, naming what it accepts.
    function CountsMessage (Counts : List, Got : Integer) : String;
    var
        Expected : String;

    begin
        Expected := '';
        for var I := 0; I < Counts.Length; I := I + 1 do
        begin
            if I > 0 then Expected := Expected + ' or ';

            Expected := Expected + Str (Counts[I]);
        end

        Exit 'Expected ' + Expected + ' arguments but got ' + Str (Got) + '.';
    end

    /// Gets the renames in force while a unit's statements are emitted.
    function RenamesOf (Unit : String, Name : String) : Map;
    var
        Only : Map;

    begin
        Only := Map();
        if Renamed.Contains (Name) then Only.Put (Name, Unit);

        Exit Only;
    end

    /// Records that two imported modules both export a name, so a bare use of it
    /// can be refused by name.
    procedure MarkAmbiguousImport (Name : String, First : String, Second : String);
    begin
        if not AmbiguousImports.Contains (Name) then
        begin
            AmbiguousImports.Put (Name, First + ' or ' + Second);
            Exit;
        end

        AmbiguousImports.Put (Name,
            Str (AmbiguousImports.Get (Name)) + ' or ' + Second);
    end

    /// Records that two enumerations both bind a member name.
    procedure MarkAmbiguousMember (Member : String, First : String, Second : String);
    begin
        if not AmbiguousMembers.Contains (Member) then
        begin
            AmbiguousMembers.Put (Member, First + ' or ' + Second);
            Exit;
        end

        AmbiguousMembers.Put (Member,
            Str (AmbiguousMembers.Get (Member)) + ' or ' + Second);
    end

    /// Builds the message an ambiguous bare name reports, naming every owner.
    function AmbiguousMessage (Written : String, Owners : String) : String;
    begin
        Exit '''' + Written + ''' is ambiguous: ' + Owners + '.';
    end

    /// Whether a name is one of the assertions a test block uses.
    function IsAssertion (Name : String) : Boolean;
    var
        Folded : String;

    begin
        Folded := FoldCase (Name);

        Exit Folded = 'asserttrue' or Folded = 'assertequal' or Folded = 'fail';
    end

    /// Gets the runtime call a built-in maps onto, or '' when it is not one.
    ///
    /// Keyed by name AND arity, because 'Length' is both a function and a property
    /// on a collection -- and they do NOT mean the same thing.  Length measures
    /// TEXT and refuses a collection; the property answers its count.  Both mapped
    /// onto one runtime call once, so 'Length ([10, 20, 30])' answered 12 compiled
    /// -- the length of the rendering -- where the interpreter refuses it and
    /// '.Length' is 3.
    function Builtin (Name : String, Count : Integer) : String;
    var
        Key : String;

    begin
        Key := Name + '/' + Str (Count);

        if Key = 'WriteLn/1' then Exit 'alg_writeln';
        if Key = 'WriteLn/0' then Exit 'alg_writeln_blank';
        if Key = 'Write/1'   then Exit 'alg_write';
        if Key = 'Str/1'     then Exit 'alg_str';
        if Key = 'Length/1'  then Exit 'alg_text_length';
        if Key = 'Copy/3'    then Exit 'alg_copy';
        if Key = 'Pos/2'     then Exit 'alg_pos';
        if Key = 'Pos/3'     then Exit 'alg_pos_from';
        if Key = 'ToUpper/1' then Exit 'alg_to_upper';
        if Key = 'ToLower/1' then Exit 'alg_to_lower';
        if Key = 'Char/1'    then Exit 'alg_char';
        if Key = 'Ord/1'     then Exit 'alg_ord';
        if Key = 'Val/1'     then Exit 'alg_val';
        if Key = 'Succ/1'    then Exit 'alg_succ';
        if Key = 'Pred/1'    then Exit 'alg_pred';
        if Key = 'Foreign/5' then Exit 'alg_foreign_call';
        if Key = 'Mod/2'     then Exit 'alg_mod';
        if Key = 'clock/0'   then Exit 'alg_clock';
        if Key = 'Halt/1'    then Exit 'alg_halt';

        if EmitTests then
        begin
            if Key = 'AssertTrue/1'  then Exit 'alg_assert_true';
            if Key = 'AssertEqual/2' then Exit 'alg_assert_equal';
            if Key = 'Fail/1'        then Exit 'alg_assert_fail';
        end

        if Key = 'FileExists/1' then Exit 'alg_file_exists';
        if Key = 'MkDir/1'      then Exit 'alg_mkdir';
        if Key = 'RmDir/1'      then Exit 'alg_rmdir';
        if Key = 'ChDir/1'      then Exit 'alg_chdir';
        if Key = 'GetDir/0'     then Exit 'alg_getdir';
        if Key = 'ParamCount/0' then Exit 'alg_param_count';
        if Key = 'ParamStr/1'   then Exit 'alg_param_str';

        Exit '';
    end

    /// Joins every argument of a Write or WriteLn into one string, as the
    /// interpreter's Rendered does.
    function RunTogether (Arguments : List) : String;
    var
        Result : String;

    begin
        Result := 'alg_str(' + Str (Arguments[0]) + ')';

        for var I := 1; I < Arguments.Length; I := I + 1 do
            Result := 'alg_add(' + Result + ', alg_str(' + Str (Arguments[I]) + '))';

        Exit Result;
    end

    /// Whether any argument at a call site named the parameter it fills.
    function AnyNamed (Names : List) : Boolean;
    begin
        for var I := 0; I < Names.Length; I := I + 1 do
            if Str (Names[I]) <> '' then Exit True;

        Exit False;
    end

    /// Builds the array of parameter names a named call passes.
    function NameArray (Names : List) : String;
    var
        Joined : String := '';

    begin
        if Names.Length = 0 then Exit 'NULL';

        for var I := 0; I < Names.Length; I := I + 1 do
        begin
            if I > 0 then Joined := Joined + ', ';

            Joined := Joined + QuoteC (Str (Names[I]));
        end

        Exit '(const char*[]){' + Joined + '}';
    end

    /// Emits a call, named or positional.
    function Calling (Callee : String, Emitted : List, Names : List) : String;
    begin
        if not AnyNamed (Names) then
            Exit 'alg_call(' + Callee + ', ' + ArgumentArray (Emitted) + ')';

        Exit 'alg_call_named(' + Callee + ', ' + ArgumentArray (Emitted) + ', '
           + NameArray (Names) + ')';
    end

    /// Emits a construction, which is a call on a class handle.
    function Constructing (Handle : String, Emitted : List, Names : List) : String;
    begin
        if not AnyNamed (Names) then
            Exit 'alg_new(' + Handle + ', ' + ArgumentArray (Emitted) + ')';

        Exit 'alg_new_named(' + Handle + ', ' + ArgumentArray (Emitted) + ', '
           + NameArray (Names) + ')';
    end

    /// Emits a method call, which dispatches at run time on the whole signature.
    function Invoking (Receiver : String, TheName : String, Emitted : List,
                       Names : List) : String;
    begin
        if not AnyNamed (Names) then
            Exit 'alg_invoke(' + Receiver + ', ' + QuoteC (TheName) + ', '
               + ArgumentArray (Emitted) + ')';

        Exit 'alg_invoke_named(' + Receiver + ', ' + QuoteC (TheName) + ', '
           + ArgumentArray (Emitted) + ', ' + NameArray (Names) + ')';
    end

    /// Builds the compound literal a call passes its arguments in.
    function ArgumentArray (Arguments : List) : String;
    var
        Joined : String := '';

    begin
        if Arguments.Length = 0 then Exit 'NULL, 0';

        for var I := 0; I < Arguments.Length; I := I + 1 do
        begin
            if I > 0 then Joined := Joined + ', ';

            Joined := Joined + Str (Arguments[I]);
        end

        Exit '(Value[]){' + Joined + '}, ' + Str (Arguments.Length);
    end

    /// Gets the names a unit exports.
    function ExportedNames (Unit : EmitUnit) : List;
    var
        Names : List;

    begin
        Names := List();

        for var I := 0; I < Unit.Statements.Length; I := I + 1 do
        begin
            var TheStmt := Unit.Statements[I];

            if TheStmt is FunctionStmt and not IsTest (TheStmt) then
                Names.Add (Str (TheStmt.Name.Lexeme));

            if TheStmt is ClassStmt  then Names.Add (Str (TheStmt.Name.Lexeme));
            if TheStmt is ObjectStmt then Names.Add (Str (TheStmt.Name.Lexeme));
            if TheStmt is VarStmt    then Names.Add (Str (TheStmt.Name.Lexeme));

            if TheStmt is EnumStmt then
            begin
                Names.Add (Str (TheStmt.Name.Lexeme));

                for var J := 0; J < TheStmt.Members.Length; J := J + 1 do
                    Names.Add (Str (TheStmt.Members[J].Lexeme));
            end

            if TheStmt is VarGroupStmt then
                for var J := 0; J < TheStmt.Names.Length; J := J + 1 do
                    Names.Add (Str (TheStmt.Names[J].Lexeme));
        end

        Exit Names;
    end

    /// Emits a construction of a named class.
    function ConstructorFor (Name : String, Arguments : List, Joined : String) : String;
    begin
        if Name = 'List'  and Arguments.Length = 0 then Exit 'alg_list()';
        if Name = 'Map'   and Arguments.Length = 0 then Exit 'alg_map()';
        if Name = 'Stack' and Arguments.Length = 0 then Exit 'alg_stack()';
        if Name = 'Set'   and Arguments.Length = 0 then Exit 'alg_set()';
        if Name = 'Set'   and Arguments.Length = 1 then Exit 'alg_set_of(' + Joined + ')';
        if Name = 'Array' and Arguments.Length = 1 then Exit 'alg_array(' + Joined + ')';

        if Name = 'TextFile' and Arguments.Length = 0 then Exit 'alg_text_file()';

        if Name = 'Buffer' and Arguments.Length = 0 then Exit 'alg_buffer(alg_int(0))';
        if Name = 'Buffer' and Arguments.Length = 1 then Exit 'alg_buffer(' + Joined + ')';

        Exit '';
    end

    /// Emits a call reaching through a unit qualifier.
    function UnitCall (Unit : String, Name : String, Arguments : List, Joined : String,
                       Names : List) : String;
    begin
        if UnitExports.Contains (Unit) and not (UnitExports.Get (Unit) as Set).Contains (Name) then
            Exit '(alg_error(' + QuoteC ('Undefined name ''' + Name + ''' in unit '''
                                       + Unit + '''.') + '), alg_nil())';

        if Unit = 'System' then
        begin
            var TheBuiltin := Builtin (Name, Arguments.Length);
            if TheBuiltin <> '' then Exit TheBuiltin + '(' + Joined + ')';

            var TheConstructor := ConstructorFor (Name, Arguments, Joined);
            if TheConstructor <> '' then Exit TheConstructor;

            Unsupported ('A call to ''' + Unit + '.' + Name + '''');
        end

        var Saved := Renames;
        Renames := RenamesOf (Unit, Name);

        var Built := '';
        if Classes.Contains (Name) then
            Built := Constructing (ClassHandle (Name), Arguments, Names);
        else if Declared.Contains (Name) and Overloaded.Contains (Name) then
            Built := Calling (SetName (Name), Arguments, Names);
        else if Declared.Contains (Name) then
            if AnyNamed (Names) then Built := Calling (HandleName (Name), Arguments, Names);
            else Built := FunctionName (Name) + '(NULL, ' + ArgumentArray (Arguments) + ')';
        else if Globals.Contains (Name) then
            Built := Calling (Read (Name), Arguments, Names);

        Renames := Saved;

        if Built <> '' then Exit Built;

        Unsupported ('A call to ''' + Unit + '.' + Name + '''');
        Exit '';
    end

    /// Emits a call: a built-in, a construction, a unit call, a method, or a
    /// plain subprogram.
    function VisitCall (TheExpr : CallExpr) : String;
    var
        Arguments : List;
        Joined    : String;

    begin
        if TheExpr.Callee is SuperExpr then
        begin
            if CurrentClass = '' then Unsupported ('''super'' outside a class');

            var Emitted := List();
            for var I := 0; I < TheExpr.Arguments.Length; I := I + 1 do
                Emitted.Add (Evaluate (TheExpr.Arguments[I]));

            Exit 'alg_invoke_from(' + ClassHandle (CurrentClass) + ', ' + ThisRef () + ', '
               + QuoteC (Str (TheExpr.Callee.Method.Lexeme)) + ', '
               + ArgumentArray (Emitted) + ')';
        end

        if TheExpr.Callee is GetExpr and TheExpr.Callee.Unit <> '' then
        begin
            var Emitted := List();
            for var I := 0; I < TheExpr.Arguments.Length; I := I + 1 do
                Emitted.Add (Evaluate (TheExpr.Arguments[I]));

            var Text := '';
            for var I := 0; I < Emitted.Length; I := I + 1 do
            begin
                if I > 0 then Text := Text + ', ';

                Text := Text + Str (Emitted[I]);
            end

            Exit UnitCall (Str (TheExpr.Callee.Unit), Str (TheExpr.Callee.Name.Lexeme),
                           Emitted, Text, TheExpr.ArgumentNames);
        end

        if TheExpr.Callee is GetExpr then
        begin
            var Receiver := Evaluate (TheExpr.Callee.Obj);

            var Emitted := List();
            for var I := 0; I < TheExpr.Arguments.Length; I := I + 1 do
                Emitted.Add (Evaluate (TheExpr.Arguments[I]));

            Exit Invoking (Receiver, Str (TheExpr.Callee.Name.Lexeme), Emitted,
                           TheExpr.ArgumentNames);
        end

        if not (TheExpr.Callee is VariableExpr) then
        begin
            var Emitted := List();
            for var I := 0; I < TheExpr.Arguments.Length; I := I + 1 do
                Emitted.Add (Evaluate (TheExpr.Arguments[I]));

            Exit Calling (Evaluate (TheExpr.Callee), Emitted, TheExpr.ArgumentNames);
        end

        Arguments := List();
        for var I := 0; I < TheExpr.Arguments.Length; I := I + 1 do
            Arguments.Add (Evaluate (TheExpr.Arguments[I]));

        Joined := '';
        for var I := 0; I < Arguments.Length; I := I + 1 do
        begin
            if I > 0 then Joined := Joined + ', ';

            Joined := Joined + Str (Arguments[I]);
        end

        var Name := Spelled (Str (TheExpr.Callee.Name.Lexeme));

        if Locals.Contains (Name) or Captured.Contains (Name) or Boxed.Contains (Name) then
            Exit Calling (Read (Name), Arguments, TheExpr.ArgumentNames);

        var Shadowed := ShadowNames.Contains (Name);

        if not Shadowed and AnyNamed (TheExpr.ArgumentNames)
                        and BuiltinCounts (Name).Length > 0 then
            Exit '(alg_error(' + QuoteC ('A built-in has no named parameters.')
               + '), alg_nil())';

        if not Shadowed and Arguments.Length > 1 then
        begin
            var One := Builtin (Name, 1);

            if One = 'alg_writeln' or One = 'alg_write' then
                Exit One + '(' + RunTogether (Arguments) + ')';
        end

        if not Shadowed then
        begin
            var TheBuiltin := Builtin (Name, Arguments.Length);
            if TheBuiltin <> '' then Exit TheBuiltin + '(' + Joined + ')';
        end

        if not Shadowed then
        begin
            var TheConstructor := ConstructorFor (Name, Arguments, Joined);
            if TheConstructor <> '' then Exit TheConstructor;
        end

        if Classes.Contains (Name) then
            Exit Constructing (ClassHandle (Name), Arguments, TheExpr.ArgumentNames);

        if Objects.Contains (Name) then
            Exit Calling ('alg_singleton(' + ClassHandle (Name) + ')', Arguments,
                          TheExpr.ArgumentNames);

        if AmbiguousImports.Contains (Name) then
            Exit '(alg_error(' + QuoteC (AmbiguousMessage (Str (TheExpr.Callee.Name.Lexeme),
                                         Str (AmbiguousImports.Get (Name))))
               + '), alg_nil())';

        if CurrentClass <> '' and not Declared.Contains (Name)
                              and VisibleMethods.Contains (FoldCase (Name)) then
            Exit Invoking (ThisRef (), Name, Arguments, TheExpr.ArgumentNames);

        if Declared.Contains (Name) and not ShadowNames.Contains (Name) then
            Exit '(alg_error(' + QuoteC (MissingName (Name)) + '), alg_nil())';

        if Declared.Contains (Name) and Overloaded.Contains (Name) then
            Exit Calling (SetName (Name), Arguments, TheExpr.ArgumentNames);

        if Declared.Contains (Name) then
        begin
            if AnyNamed (TheExpr.ArgumentNames) then
                Exit Calling (HandleName (Name), Arguments, TheExpr.ArgumentNames);

            Exit FunctionName (Name) + '(NULL, ' + ArgumentArray (Arguments) + ')';
        end

        if Globals.Contains (Name) then
            Exit Calling (Read (Name), Arguments, TheExpr.ArgumentNames);

        if not EmitTests and IsAssertion (Name) then
            Exit '(alg_error(' + QuoteC (MissingName (Name)) + '), alg_nil())';

        if not Shadowed then
        begin
            var Counts := BuiltinCounts (Name);

            if Counts.Length > 0 then
                Exit '(alg_error('
                   + QuoteC (CountsMessage (Counts, Arguments.Length)) + '), alg_nil())';
        end

        if not Locals.Contains (Name)  and not Globals.Contains (Name)
                                       and not Classes.Contains (Name)
                                       and not Objects.Contains (Name)
                                       and not Declared.Contains (Name)
                                       and not EnumTypes.Contains (Name)
                                       and not EnumMembers.Contains (Name)
                                       and not AmbiguousMembers.Contains (Name) then
            Exit '(alg_error(' + QuoteC (MissingName (Name)) + '), alg_nil())';

        Unsupported ('A call to ''' + Name + '''');
    end

    /// Emits 'and' and 'or', holding the left operand in a numbered slot so it is
    /// evaluated once.
    ///
    /// Each occurrence gets its own slot, so nesting cannot make two share one.
    function VisitLogical (TheExpr : LogicalExpr) : String;
    var
        Slot : String;
        Test : String;

    begin
        var Left  := Evaluate (TheExpr.Left);
        var Right := Evaluate (TheExpr.Right);

        Slot := 'or_' + Str (Logicals);
        Logicals := Logicals + 1;

        Declarations.Append ('static Value ' + Slot + ';' + #10);

        Test := '!alg_truthy(';
        if TheExpr.Op.TypeOfToken = TOKEN_OR then Test := 'alg_truthy(';

        Exit '(' + Slot + ' = ' + Left + ', ' + Test + Slot + ') ? '
           + Slot + ' : ' + Right + ')';
    end

    /// Emits one parameter's binding at the top of a subprogram body.
    function BoundArgument (Params : Any, Types : Any, I : Integer) : String;
    begin
        var Slot := 'args[' + Str (I) + ']';

        if I >= Types.Length then Exit Slot;

        var Declared := Str (Types[I]);
        if Declared = '' or Declared = 'Any' then Exit Slot;

        Exit 'alg_param(' + Slot + ', ' + QuoteC (Declared) + ')';
    end

    /// Whether every element of a collection literal is itself a literal.
    function AllLiterals (TheExpr : CollectionExpr) : Boolean;
    begin
        for var I := 0; I < TheExpr.Values.Length; I := I + 1 do
            if not (TheExpr.Values[I] is LiteralExpr) then Exit False;

        if TheExpr.IsMap then
            for var I := 0; I < TheExpr.Keys.Length; I := I + 1 do
                if not (TheExpr.Keys[I] is LiteralExpr) then Exit False;

        Exit True;
    end

    /// Emits a collection literal, hoisting it into a helper when it is large.
    function VisitCollectionExpr (TheExpr : CollectionExpr) : String;
    var
        Built : String;

    begin
        if TheExpr.Values.Length > HOIST_ABOVE then
        begin
            if AllLiterals (TheExpr) then Exit HoistedCollection (TheExpr);

            Exit ComputedCollection (TheExpr);
        end

        if TheExpr.IsMap then
        begin
            Built := 'alg_map()';

            for var I := 0; I < TheExpr.Keys.Length; I := I + 1 do
                Built := 'alg_map_keep(' + Built + ', ' + Evaluate (TheExpr.Keys[I])
                       + ', ' + Evaluate (TheExpr.Values[I]) + ')';

            Exit Built;
        end

        Built := 'alg_list()';

        for var I := 0; I < TheExpr.Values.Length; I := I + 1 do
            Built := 'alg_list_keep(' + Built + ', ' + Evaluate (TheExpr.Values[I]) + ')';

        Exit Built;
    end

    /// Emits a large CONSTANT literal as a function instead of an expression.
    ///
    /// One assignment per element rather than one nested call, so the bracket
    /// depth is 1 however many elements there are -- cc gives up at 256.
    function HoistedCollection (TheExpr : CollectionExpr) : String;
    var
        Symbol : String;

    begin
        Symbol := 'lit_' + Str (Loops);
        Loops := Loops + 1;

        Declarations.Append ('static Value ' + Symbol + '(void);' + #10);

        Functions.Append ('static Value ' + Symbol + '(void) {' + #10);

        if TheExpr.IsMap then
        begin
            Functions.Append ('    Value it = alg_map();' + #10);

            for var I := 0; I < TheExpr.Keys.Length; I := I + 1 do
                Functions.Append ('    it = alg_map_keep(it, ' + Evaluate (TheExpr.Keys[I])
                          + ', ' + Evaluate (TheExpr.Values[I]) + ');' + #10);
        end
        else
        begin
            Functions.Append ('    Value it = alg_list();' + #10);

            for var I := 0; I < TheExpr.Values.Length; I := I + 1 do
                Functions.Append ('    it = alg_list_keep(it, '
                          + Evaluate (TheExpr.Values[I]) + ');' + #10);
        end

        Functions.Append ('    return it;' + #10 + '}' + #10 + #10);

        Exit Symbol + '()';
    end

    /// Emits a large literal whose elements are COMPUTED, as a function the
    /// elements are passed into.
    ///
    /// One compound literal at the call, not one nested call per element, so the
    /// bracket depth is 1 however many there are.  ArgumentArray builds every
    /// call's arguments the same way, so this introduces no shape the emitted C
    /// did not already have.
    ///
    /// A Map's keys and values are INTERLEAVED into one array, key first.  Two
    /// arrays would need two parameters and two compound literals for no gain.
    function ComputedCollection (TheExpr : CollectionExpr) : String;
    var
        Symbol : String;
        Joined : String;

    begin
        Symbol := 'lit_' + Str (Loops);
        Loops := Loops + 1;

        Joined := '';

        var Emitted := List();
        for var I := 0; I < TheExpr.Values.Length; I := I + 1 do
        begin
            if TheExpr.IsMap then Emitted.Add (Evaluate (TheExpr.Keys[I]));

            Emitted.Add (Evaluate (TheExpr.Values[I]));
        end

        for var I := 0; I < Emitted.Length; I := I + 1 do
        begin
            if I > 0 then Joined := Joined + ', ';

            Joined := Joined + Str (Emitted[I]);
        end

        Declarations.Append ('static Value ' + Symbol + '(Value *e);' + #10);
        Functions.Append ('static Value ' + Symbol + '(Value *e) {' + #10);

        if TheExpr.IsMap then
        begin
            Functions.Append ('    Value it = alg_map();' + #10);

            for var I := 0; I < TheExpr.Values.Length; I := I + 1 do
                Functions.Append ('    it = alg_map_keep(it, e[' + Str (I * 2)
                          + '], e[' + Str (I * 2 + 1) + ']);' + #10);
        end
        else
        begin
            Functions.Append ('    Value it = alg_list();' + #10);

            for var I := 0; I < TheExpr.Values.Length; I := I + 1 do
                Functions.Append ('    it = alg_list_keep(it, e[' + Str (I) + ']);' + #10);
        end

        Functions.Append ('    return it;' + #10 + '}' + #10 + #10);

        Exit Symbol + '((Value[]){' + Joined + '})';
    end

    /// Emits 'A[I]', including a class's own Get.
    function VisitSubscriptExpr (TheExpr : SubscriptExpr) : String;
    begin
        Exit 'alg_subscript_get(' + Evaluate (TheExpr.Obj) + ', '
           + Evaluate (TheExpr.Index) + ')';
    end

    /// Emits 'A[I] := V', including a class's own Put.
    function VisitSetSubscriptExpr (TheExpr : SetSubscriptExpr) : String;
    begin
        Exit 'alg_subscript_set(' + Evaluate (TheExpr.Obj) + ', '
           + Evaluate (TheExpr.Index) + ', ' + Evaluate (TheExpr.Value) + ')';
    end

    /// Emits a name read through a unit qualifier.
    function UnitValue (Unit : String, Name : String) : String;
    begin
        if UnitExports.Contains (Unit) and not (UnitExports.Get (Unit) as Set).Contains (Name) then
            Exit '(alg_error(' + QuoteC ('Undefined name ''' + Name + ''' in unit '''
                                       + Unit + '''.') + '), alg_nil())';

        if Unit = 'System' then Unsupported ('''' + Unit + '.' + Name + ''' as a value');

        var Saved := Renames;
        Renames := RenamesOf (Unit, Name);

        var Built := '';
        if EnumMembers.Contains (Name) then
            Built := EnumMemberName (Str (EnumMembers.Get (Name)), Name);
        else if EnumTypes.Contains (Name) then Built := EnumTypeName (Name);
        else if Objects.Contains (Name)   then Built := 'alg_singleton(' + ClassHandle (Name) + ')';
        else if Classes.Contains (Name)   then Built := ClassHandle (Name);
        else if Declared.Contains (Name)  then Built := SubprogramValue (Name);
        else if Globals.Contains (Name)   then Built := Guarded (Name, VariableName (Name));

        Renames := Saved;

        if Built <> '' then Exit Built;

        Unsupported ('''' + Unit + '.' + Name + ''' as a value');
        Exit '';
    end

    /// Emits a property read, on a receiver or through a unit.
    function VisitGetExpr (TheExpr : GetExpr) : String;
    begin
        if TheExpr.Unit <> '' then
            Exit UnitValue (Str (TheExpr.Unit), Str (TheExpr.Name.Lexeme));

        Exit 'alg_property(' + Evaluate (TheExpr.Obj) + ', '
           + QuoteC (Str (TheExpr.Name.Lexeme)) + ')';
    end

    /// Emits a property write, on a receiver or through a unit.
    function VisitSetExpr (TheExpr : SetExpr) : String;
    begin
        if TheExpr.Unit <> '' then
        begin
            var Written := Evaluate (TheExpr.Value);
            var Unit := Str (TheExpr.Unit);
            var Name := Str (TheExpr.Name.Lexeme);

            if UnitExports.Contains (Unit) and not (UnitExports.Get (Unit) as Set).Contains (Name) then
                Exit '(alg_error(' + QuoteC ('Undefined name ''' + Name + ''' in unit '''
                                           + Unit + '''.') + '), alg_nil())';

            if Unit <> 'System' and Globals.Contains (Name) then
                Exit Guarded (Name, '(' + VariableName (Name) + ' = ' + Written + ')');

            Unsupported ('An assignment to ''' + Unit + '.' + Name + '''');
        end

        Exit 'alg_set_property(' + Evaluate (TheExpr.Obj) + ', '
           + QuoteC (Str (TheExpr.Name.Lexeme)) + ', '
           + BoundValue (TheExpr.Declared, Evaluate (TheExpr.Value)) + ')';
    end

    /// Emits 'super.M' as a method bound to the receiver, found from the
    /// enclosing class rather than from the receiver's own.
    ///
    /// That is what reaches past an override: the search starts at the class the
    /// method is written in, so a subclass redefining M does not capture it.
    ///
    /// # Raises
    ///
    /// '''super'' outside a class is not supported by the C back end yet.'
    function VisitSuperExpr (TheExpr : SuperExpr) : String;
    begin
        if CurrentClass = '' then Unsupported ('''super'' outside a class');

        Exit 'alg_bound_from(' + ClassHandle (CurrentClass) + ', ' + ThisRef ()
           + ', ' + QuoteC (Str (TheExpr.Method.Lexeme)) + ')';
    end

    /// Emits 'this', the receiver the method was called on.
    function VisitThisExpr (TheExpr : ThisExpr) : String;
    begin
        Exit ThisRef ();
    end

    /// Emits a class declaration.
    procedure VisitClassStmt (TheStmt : ClassStmt);
    begin
        EmitClass (Str (TheStmt.Name.Lexeme), TheStmt.Superclass,
                   TheStmt.Fields, TheStmt.Methods, False);
    end

    /// Emits an object: one class, and a name bound to its single instance.
    procedure VisitObjectStmt (TheStmt : ObjectStmt);
    begin
        EmitClass (Str (TheStmt.Name.Lexeme), TheStmt.Superclass,
                   TheStmt.Fields, TheStmt.Methods, True);
    end

    /// Records a subrange, whose bounds are emitted together by EmitSubranges.
    procedure VisitSubrangeStmt (TheStmt : SubrangeStmt);
    begin
    end

    /// Emits every subrange's bounds into the unit's initializer, so a range
    /// check has them before anything runs.
    procedure EmitSubranges ();
    begin
        for var I := 0; I < SUBRANGE_NAMES.Length; I := I + 1 do
            Shells.Append ('    alg_subrange('
                   + QuoteC (Str (SUBRANGE_NAMES[I])) + ', '
                   + QuoteC (Str (SUBRANGE_LOWS[I]))  + ', '
                   + QuoteC (Str (SUBRANGE_HIGHS[I])) + ');' + #10);
    end

    /// Emits an enumeration: the type, and each member bound both bare and under
    /// the type.
    ///
    /// Both names reach the SAME object, because enum equality is identity.
    procedure VisitEnumStmt (TheStmt : EnumStmt);
    var
        TheType : String;

    begin
        TheType := EnumTypeName (Str (TheStmt.Name.Lexeme));

        DeclareValue (TheType, Str (TheStmt.Name.Lexeme));
        Setup.Append ('    ' + TheType + ' = alg_enum_type('
               + QuoteC (Str (TheStmt.Name.Lexeme)) + ');' + #10);

        for var I := 0; I < TheStmt.Members.Length; I := I + 1 do
        begin
            var Symbol := EnumMemberName (Str (EnumMembers.Get (Str (TheStmt.Members[I].Lexeme))),
                                          Str (TheStmt.Members[I].Lexeme));

            DeclareValue (Symbol, Str (TheStmt.Members[I].Lexeme));
            Setup.Append ('    ' + Symbol + ' = alg_enum_member(' + TheType
                   + ', ' + QuoteC (Str (TheStmt.Members[I].Lexeme)) + ');' + #10);
        end
    end

    /// Emits a try as a setjmp frame, with each handler selected by class.
    ///
    /// The frame is pushed on entry and popped when the block falls through --
    /// and every path that LEAVES the block early has to pop it too, which is
    /// what TryDepth is counted for.
    procedure VisitTryStmt (TheStmt : TryStmt);
    var
        Id       : Integer;
        Frame    : String;
        Handlers : List;
        CatchAll : Any;
        Keys     : List;

    begin
        Id := Loops;
        Loops := Loops + 1;

        Frame := 'frame_' + Str (Id);

        Handlers := List();
        CatchAll := Nil;

        Keys := TheStmt.Handlers.Keys();
        for var I := 0; I < Keys.Length; I := I + 1 do
        begin
            if Keys[I] = 'default' then CatchAll := TheStmt.Handlers.Get (Keys[I]);
            else Handlers.Add (Keys[I]);
        end

        Line ('{');
        Depth := Depth + 1;

        Line ('AlgFrame ' + Frame + ';');
        Line ('alg_push_frame(&' + Frame + ');');
        Line ('if (ALG_SETJMP(' + Frame + '.jump) == 0) {');
        Depth := Depth + 1;

        TryDepth := TryDepth + 1;
        Execute (TheStmt.TryBlock);
        TryDepth := TryDepth - 1;

        Line ('alg_pop_frame();');

        Depth := Depth - 1;
        Line ('}');
        Line ('else {');
        Depth := Depth + 1;

        if Handlers.Length = 0 then EmitHandlerBody (CatchAll, Frame);
        else
        begin
            var Names := '';
            for var I := 0; I < Handlers.Length; I := I + 1 do
            begin
                if I > 0 then Names := Names + ', ';

                Names := Names + QuoteC (Str (Handlers[I]));
            end

            var Table := 'names_' + Str (Id);
            Line ('static const char *' + Table + '[] = {' + Names + '};');
            Line ('int32_t which_' + Str (Id) + ' = alg_handler(' + Frame + '.raised, '
                + Table + ', ' + Str (Handlers.Length) + ');');

            for var I := 0; I < Handlers.Length; I := I + 1 do
            begin
                var Lead := 'else if';
                if I = 0 then Lead := 'if';

                Line (Lead + ' (which_' + Str (Id) + ' == ' + Str (I) + ') {');
                Depth := Depth + 1;

                EmitHandlerBody (TheStmt.Handlers.Get (Handlers[I]), Frame);

                Depth := Depth - 1;
                Line ('}');
            end

            Line ('else {');
            Depth := Depth + 1;

            if CatchAll <> Nil then EmitHandlerBody (CatchAll, Frame);
            else Line ('alg_raise(' + Frame + '.raised);');

            Depth := Depth - 1;
            Line ('}');
        end

        Depth := Depth - 1;
        Line ('}');

        Depth := Depth - 1;
        Line ('}');
    end

    /// Emits a raise, which longjmps to the nearest frame.
    procedure VisitRaiseStmt (TheStmt : RaiseStmt);
    begin
        if TheStmt.Value = Nil then Line ('alg_raise(alg_nil());');
        else Line ('alg_raise(' + Evaluate (TheStmt.Value) + ');');
    end

    /// Emits 'for X in C do', over a collection, a String or a class offering
    /// Elements.
    procedure VisitForInStmt (TheStmt : ForInStmt);
    var
        Id       : Integer;
        Snapshot : String;
        Index    : String;
        Counter  : String;

    begin
        RefuseBareBinding (TheStmt.Body);

        Id := Loops;
        Loops := Loops + 1;

        Snapshot := 'loop_' + Str (Id);
        Index := 'at_' + Str (Id);

        var Mark := OpenScope ();

        Line ('{');
        Depth := Depth + 1;

        Line (Local () + Snapshot + ' = alg_iterable(' + Evaluate (TheStmt.Iterable) + ');');

        Counter := 'int32_t ';
        if Volatiles then Counter := 'volatile int32_t ';

        Line ('for (' + Counter + Index + ' = 0; ' + Index + ' < alg_iterable_count('
            + Snapshot + '); ' + Index + '++) {');
        Depth := Depth + 1;

        Locals.Add (Str (TheStmt.Name.Lexeme));

        var Element := 'alg_iterable_at(' + Snapshot + ', ' + Index + ')';

        if Boxed.Contains (Str (TheStmt.Name.Lexeme)) then
            DeclareCell (Str (TheStmt.Name.Lexeme), Element);
        else
        begin
            Line (Local () + VariableName (Str (TheStmt.Name.Lexeme)) + ' = ' + Element + ';');
            Line ('(void)' + VariableName (Str (TheStmt.Name.Lexeme)) + ';');
        end

        var EnclosingLoopDepth := LoopTryDepth;
        LoopTryDepth := TryDepth;
        LoopLabels.Add (TheStmt.Label);
        LoopDepths.Add (TryDepth);

        Execute (TheStmt.Body);

        LoopLabels.RemoveAt (LoopLabels.Length - 1);
        LoopDepths.RemoveAt (LoopDepths.Length - 1);
        LoopTryDepth := EnclosingLoopDepth;

        EmitContinueTarget (TheStmt.Label);

        Depth := Depth - 1;
        Line ('}');

        EmitBreakTarget (TheStmt.Label);

        Depth := Depth - 1;
        Line ('}');

        CloseScope (Mark);
    end

    /// Gets the C label a 'break' jumps to.
    function BreakTarget (TheLabel : String) : String;
    begin
        Exit 'lb_' + Escaped (FoldCase (TheLabel));
    end

    /// Gets the C label a 'continue' jumps to.
    function ContinueTarget (TheLabel : String) : String;
    begin
        Exit 'lc_' + Escaped (FoldCase (TheLabel));
    end

    /// Gets the TryDepth the named loop began at, so a jump out of it pops the
    /// right number of frames.
    function DepthOfLoop (TheLabel : String) : Integer;
    begin
        for var I := LoopLabels.Length - 1; I >= 0; I := I - 1 do
            if FoldCase (Str (LoopLabels[I])) = FoldCase (TheLabel) then
                Exit LoopDepths[I] as Integer;

        Exit LoopTryDepth;
    end

    /// Pops try frames down to a given depth, before a jump leaves them.
    procedure PopFramesTo (From : Integer);
    begin
        for var I := From; I < TryDepth; I := I + 1 do
            Line ('alg_pop_frame();');
    end

    /// Emits a break, popping the frames opened inside the loop it leaves.
    procedure VisitBreakStmt (TheStmt : BreakStmt);
    begin
        if TheStmt.Label = '' then
        begin
            PopFramesTo (LoopTryDepth);
            Line ('break;');

            Exit;
        end

        PopFramesTo (DepthOfLoop (TheStmt.Label));

        var Target := BreakTarget (TheStmt.Label);
        Jumped.Add (Target);

        Line ('goto ' + Target + ';');
    end

    /// Emits a continue, popping the frames opened inside the loop body.
    procedure VisitContinueStmt (TheStmt : ContinueStmt);
    begin
        if TheStmt.Label = '' then
        begin
            PopFramesTo (LoopTryDepth);
            Line ('continue;');

            Exit;
        end

        PopFramesTo (DepthOfLoop (TheStmt.Label));

        var Target := ContinueTarget (TheStmt.Label);
        Jumped.Add (Target);

        Line ('goto ' + Target + ';');
    end

    /// Emits a labelled statement, writing the C label only where something
    /// jumps to it.
    procedure VisitLabelStmt (TheStmt : LabelStmt);
    begin
        if TheStmt.Targeted then Line (GotoTarget (Str (TheStmt.Name.Lexeme)) + ': ;');

        Execute (TheStmt.Inner);
    end

    /// Emits a group declaration, evaluating the initializer once into a
    /// temporary and binding every name from it.
    procedure VisitVarGroupStmt (TheStmt : VarGroupStmt);
    var
        Value  : String;
        Shared : String;

    begin
        Value := 'alg_nil()';
        if TheStmt.Initializer <> Nil then Value := Evaluate (TheStmt.Initializer);

        Shared := 'shared_' + Str (Loops);
        Loops := Loops + 1;

        if AtTopLevel then
        begin
            Declarations.Append ('static Value ' + Shared + ';' + #10);
            Line (Shared + ' = ' + Value + ';');
        end
        else Line (Local () + Shared + ' = ' + Value + ';');

        for var I := 0; I < TheStmt.Names.Length; I := I + 1 do
        begin
            var Name := Str (TheStmt.Names[I].Lexeme);

            if AtTopLevel then
            begin
                DeclareVariable (VariableName (Name), Name);

                Line (VariableName (Name) + ' = ' + Shared + ';');
                Line (DeclaredFlag (Name) + ' = true;');
            end
            else if Boxed.Contains (Name) then
            begin
                RequireCell (Name);

                Locals.Add (Name);
                Line ('*' + Cell (Name) + ' = ' + Shared + ';');
            end
            else
            begin
                Locals.Add (Name);

                Line (Local () + VariableName (Name) + ' = ' + Shared + ';');
                Line ('(void)' + VariableName (Name) + ';');
            end
        end
    end

    /// Emits an imported module.
    ///
    /// A module becomes its own C file with its own initializer, called in
    /// dependency order before the program's statements run.  A NESTED 'uses' --
    /// one inside a body rather than at the top of a file -- is refused by name.
    procedure VisitModuleStmt (TheStmt : ModuleStmt);
    begin
        if not AtTopLevel then Unsupported ('A nested ''uses''');

        if TheStmt.Statements <> Nil then
            Line ('init_' + UnitNameOf (Str (TheStmt.FileName)) + '();');
    end
end
