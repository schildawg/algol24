// Verify that block statements are parsed successfully.
//
test 'Parse Block Statement';
begin
    var TheScanner := Scanner (' begin var a := 1; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Declaration();

    AssertEqual('BlockStmt', Result.ClassName);
end

// Parsing a block should return a parse error if it is does not have a closing brace.
//
test 'Parse Block Expect Close';
begin
    var TheScanner := Scanner (' begin var a := 1;');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
               // The missing 'end' is what is wrong, and what the message now
               // names.  Block() used to run off the end of the input and fail
               // in whatever statement rule came next, reporting 'Expect
               // expression!' -- and this test asserted that.
               AssertEqual('Expect ''end'' after block.', e);
               Exit;
            end
    end
    Fail('No exception thrown.');
end

// Test parsing an or expression.
//
test 'Parse Or';
begin
    var TheScanner := Scanner ('true or false');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.ParseOr();

    AssertEqual('LogicalExpr', Result.ClassName);
end

// Test parsing an and expression.
//
test 'Parse And';
begin
    var TheScanner := Scanner ('true and false');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.ParseOr();

    AssertEqual('LogicalExpr', Result.ClassName);
end

// Test parsing an if statement.
//
test 'Parse If Statement';
begin
    var TheScanner := Scanner ('if true then true; else false;');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertEqual('IfStmt', Result.ClassName);
end

// Parsing an if statement without an opening paren should return a parse error.
//
test 'Parse If Expect Then';
begin
    var TheScanner := Scanner ('if true true;');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
                AssertEqual('Expect ''then'' after if condition.', e);
                Exit;
            end
    end
    Fail('No exception thrown.');
end

// Test parsing a while statement.
//
test 'Parse While Statement';
begin
    var TheScanner := Scanner ('while true do true;');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertEqual('WhileStmt', Result.ClassName);
end

// A while statement missing a left paren should return a parse error.
//
test 'Parse While Expect Do';
begin
    var TheScanner := Scanner ('while true true;');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
                AssertEqual('Expect ''do'' after condition.', e);
                Exit;
            end
    end
    Fail('No exception thrown.');
end

// A for statement should return an elaborate while statement.
//
test 'Parse For Statement';
begin
    var TheScanner := Scanner ('for var i := 0; i < 10; i := i + 1 do true;');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertEqual('BlockStmt', Result.ClassName);
end

