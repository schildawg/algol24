/// The parser, which is also the module loader: tokens in, a list of statements
/// out, with every file a 'uses' clause names parsed inline.
unit Parser;

uses Console;
uses Expr;
uses Interpreter;
uses Scanner;
uses Stmt;
uses Token;
uses TokenType;

/// Reads a whole file as one string.
///
/// Here rather than in Main.a24 because the Parser is the thing that loads a
/// module, and Main is loaded after it -- a function there would not be in
/// scope.  ReadLn drops the terminator, so the lines are rejoined with #10,
/// which is what the language says a line ends with and what the scanner counts.
function ReadWholeFile (Name : String) : String;
begin
    var F := TextFile();
    F.Assign (Name);
    F.Reset();

    var Result := Buffer();

    while not F.Eof do
    begin
        Result.Append (F.ReadLn());
        Result.Append (#10);
    end

    F.Close();
    Exit Result.Text;
end

/// Turns one file's tokens into statements, loading the files it imports.
class Parser;
var
   /// The tokens being parsed.
   Tokens :  List of Token;

   /// The position of the token about to be read.
   Current : Integer;

   /// The file these tokens came from, so a 'uses' clause can look for its
   /// module beside the importer before falling back to the working directory.
   /// '' when the source did not come from a file.
   FileName : String := '';

   /// Every module file already loaded, keyed by resolved path.
   ///
   /// SHARED with the parsers of the files this one imports -- which is what
   /// makes a diamond load once and stops a cycle from recursing forever.
   Loaded : Map := [:];

   /// Names marked 'private' in this file.
   PrivateNames : List := [];

   /// Whether a 'private:' marker is currently in force.
   ///
   /// Parser state rather than a parameter, because a marker's reach is lexical
   /// and crosses the helpers that read declarations -- a var section may begin
   /// public and turn private halfway down.
   InPrivateSection : Boolean := False;

   /// The names a 'private:' marker has covered in the class being parsed.
   ClassPrivates    : List := [];

   /// How many loops enclose the statement being parsed, so 'break' outside one
   /// can be rejected where it is written rather than at run time.
   ///
   /// Not reset when a function body is entered.  A 'break' inside a function
   /// declared inside a loop is therefore accepted, and would escape the call at
   /// run time.  Odd, and deliberate.
   LoopDepth : Integer := 0;

   /// Whether the body being parsed belongs to a 'procedure' rather than a
   /// 'function', so 'Exit E;' can be refused where it means nothing [FUN-003].
   ///
   /// Saved and restored around a body, not merely set: a function may be
   /// declared inside a procedure, and its 'Exit E' is perfectly legal.
   InProcedure : Boolean := False;

   /// ParameterType's second answer.
   ///
   /// A parameter's element type is wanted beside its type name, and a function
   /// returns one thing.  A field for one caller is the smaller of the two
   /// evils; the alternative is re-reading the tokens.
   LastGeneric : String := '';

   /// The label written just before the loop now being parsed, or ''.
   PendingLabel : String := '';

   /// The labels of the loops this statement is inside, innermost last.
   ///
   /// '' for an unlabelled one, so the depth is right and no name matches it.
   LoopLabels : List := [];

begin
    /// Makes a parser over a file's tokens.
    constructor Init(Tokens : List);
    begin
       this.Tokens := Tokens;
       this.Current := 0;
    end

    /// Consumes an optional 'unit Name;' header and checks it against the file.
    ///
    /// It declares nothing and produces no statement: a unit is named by its
    /// FILE, here as in Turbo Pascal, and the header only writes that name down
    /// where a reader can see it.  What it buys is the check.
    ///
    /// 'unit' is not a keyword -- it is an ordinary identifier recognized by
    /// position, so a program may still name a variable after it [LEX-011].
    /// Recognising it needs three tokens: the word, an identifier, and a
    /// semicolon.
    ///
    /// # Raises
    ///
    /// 'Unit ''X'' must match its file name ''Y''.' when the two disagree.
    ///
    /// # Satisfies
    ///
    /// [LEX-011], [MOD-004]
    procedure UnitHeader ();
    begin
        if not Check (TOKEN_IDENTIFIER)                  then Exit;
        if Peek().Lexeme <> 'unit'                       then Exit;
        if PeekNext().TypeOfToken <> TOKEN_IDENTIFIER    then Exit;

        Advance();
        var Name := Advance();
        Consume (TOKEN_SEMICOLON, 'Expect '';'' after unit name.');

        var Expected := UnitStem (FileName);

        if Expected = '' or Expected = 'REPL' then Exit;

        if Expected <> Str (Name.Lexeme) then
            raise Error (Name, 'Unit ''' + Str (Name.Lexeme)
                             + ''' must match its file name ''' + Expected + '''.');
    end

    /// Gets the unit name a path stands for -- its stem, so 'lib/ModA.a24' is
    /// the unit ModA.
    function UnitStem (Key : String) : String;
    var
        Stem : String;

    begin
        Stem := Key;

        for var I := Length (Key) - 1; I >= 0; I := I - 1 do
            if Key[I] = '/' or Key[I] = '\' then
            begin
                Stem := Copy (Key, I + 1, Length (Key) - I - 1);
                I := -1;
            end

        if Length (Stem) > 4 and Copy (Stem, Length (Stem) - 4, 4) = '.a24' then
            Exit Copy (Stem, 0, Length (Stem) - 4);

        Exit Stem;
    end

    /// Parses the whole file and answers its statements.
    ///
    /// The file being parsed is entered in Loaded BEFORE its own 'uses' clauses
    /// are read.  The root used to be the one file never entered, so a module
    /// importing the root back -- Parser uses Interpreter, which uses Parser --
    /// parsed it a second time and the emitter saw two units of one name.
    ///
    /// # Satisfies
    ///
    /// [MOD-014]
    function Parse () : List;
    var
        Statements : List of Stmt;

    begin
        Statements := List();

        if FileName <> '' then Loaded.Put (FileName, True);

        UnitHeader ();

        while Not IsAtEnd () do
        begin
            if Match (TOKEN_USES) then
            begin
                var TheModule := UsesStatement ();

                if TheModule <> Nil then Statements.Add (TheModule);
            end
            else if Match (TOKEN_PRIVATE) then
            begin
                var Decl := Declaration ();
                RecordPrivate (Decl);
                Statements.Add (Decl);
            end
            else Statements.Add (Declaration ());
        end
        Exit Statements;
    end

    /// Parses one statement, dispatching on the token it begins with.
    ///
    /// # Satisfies
    ///
    /// [STM-022]
    function Statement () : Stmt;
    begin
        if Match (TOKEN_TYPE) then Exit EnumDeclaration ();
        if Match (TOKEN_CLASS) then Exit ClassDeclaration ();
        if Match (TOKEN_OBJECT) then Exit ClassDeclaration ('object');
        if Match (TOKEN_FUNCTION) then Exit ParseFunction ('function');
        if Match (TOKEN_PROCEDURE) then Exit ParseFunction ('procedure');
        if Match (TOKEN_VAR) then Exit VarDeclaration ();
        if Match (TOKEN_CONST) then Exit ConstDeclaration ();

        if Check (TOKEN_IDENTIFIER) and PeekNext().TypeOfToken = TOKEN_COLON then
            Exit LabelStatement ();

        if Match (TOKEN_CASE) then Exit CaseStatement();
        if Match (TOKEN_IF) then Exit IfStatement();
        if Match (TOKEN_WHILE) then Exit WhileStatement();
        if Match (TOKEN_FOR) then Exit ForStatement();
        if Match (TOKEN_EXIT) then Exit ReturnStatement();
        if Match (TOKEN_TRY) then Exit TryStatement();
        if Match (TOKEN_BREAK) then Exit BreakStatement();
        if Match (TOKEN_CONTINUE) then Exit ContinueStatement();
        if Match (TOKEN_GOTO) then Exit GotoStatement();
        if Match (TOKEN_RAISE) then Exit RaiseStatement();
        if Match (TOKEN_BEGIN) then Exit BlockStmt (Block());

        Exit ExpressionStatement ();
    end

    /// Parses 'case E of' ... 'end', desugaring it into a chain of ifs.
    ///
    /// There is no CaseStmt node.  Each arm becomes an IfStmt testing the
    /// subject against that arm's values, chained through the else branch, so
    /// every later pass sees a shape it already understands and nothing had to
    /// learn a new node.
    ///
    /// # Raises
    ///
    /// 'Expect ''of'' after case condition.', 'Expect '':'' after condition.'
    /// and 'Expected ''end''.'
    ///
    /// # Satisfies
    ///
    /// [STM-011], [STM-012], [STM-013]
    function CaseStatement () : Stmt;
    var
        Left      : Expr;
        Top       : IfStmt;
        Current   : IfStmt;
        Condition : Expr;
        Branch    : IfStmt;

    begin
        Left := Expression ();
        Consume (TOKEN_OF, 'Expect ''of'' after case condition.');

        Top := Nil as IfStmt;
        Current := Nil as IfStmt;

        while True do
        begin
            Condition := BinaryExpr (Left, Equals (), Expression ());

            while Match (TOKEN_COMMA) do
                Condition := LogicalExpr (Condition, Either (),
                                          BinaryExpr (Left, Equals (), Expression ()));

            Consume (TOKEN_COLON, 'Expect '':'' after condition.');

            Branch := IfStmt (Condition, Statement (), Nil);

            if Top = Nil then Top := Branch;
            else Current.ElseBranch := Branch;

            Current := Branch;

            if Match (TOKEN_ELSE) or Match (TOKEN_END) then Break;
        end

        if Previous().TypeOfToken = TOKEN_ELSE then
        begin
            Current.ElseBranch := BodyStatement ();
            Consume (TOKEN_END, 'Expected ''end''.');
        end

        Exit Top;
    end

    /// Consumes the '=' that separates a case arm's value from its body.
    function Equals () : Token;
    begin
        Exit Token (TOKEN_EQUAL, '=', Nil, Previous().LineNumber);
    end

    /// Consumes the ',' that joins two values of one case arm.
    function Either () : Token;
    begin
        Exit Token (TOKEN_OR, 'or', Nil, Previous().LineNumber);
    end

    /// Parses the body of a branch or a loop, where a DECLARATION is refused.
    ///
    /// Not merely useless -- actively wrong.  A declaration here escapes into
    /// the ENCLOSING scope, so whether the name exists is decided by a runtime
    /// condition: 'if True then var X := 1;' leaves X defined and the same
    /// program with a false condition leaves it undefined.
    ///
    /// Declarations stay legal in Statement itself, because a 'try' body is a
    /// statement and 'try var X := 1; ...' has to parse.  This is the branch and
    /// loop positions only.
    ///
    /// The C back end already refused this, so the fix made the language, the
    /// compiler and the interpreter agree -- the one divergence that closed by
    /// the LANGUAGE moving rather than the compiler.
    ///
    /// # Satisfies
    ///
    /// [STM-002]
    function BodyStatement () : Stmt;
    begin
        if Check (TOKEN_VAR) or Check (TOKEN_CONST) or Check (TOKEN_TYPE)
        or Check (TOKEN_CLASS) or Check (TOKEN_OBJECT)
        or Check (TOKEN_FUNCTION) or Check (TOKEN_PROCEDURE) then
            raise Error (Peek (),
                'A declaration cannot be a branch or loop body; use ''begin'' ... ''end''.');

        Exit Statement ();
    end

    /// Whether a written type name is a collection, and so may carry an element
    /// type.
    ///
    /// Every collection, not only List.  'Map of Integer', 'Set of Integer' and
    /// 'Array of Integer' were each refused with 'Expect '';'' after variable
    /// declaration.' -- so only a List could say what it held, and there was no
    /// reason for that but the one name being spelled out here.
    ///
    /// For a Map the element type is the VALUE type, because that is what a
    /// subscript and a Get yield; a Map's keys are not constrained.
    ///
    /// # Satisfies
    ///
    /// [VAR-008]
    function IsCollectionType (TypeName : String) : Boolean;
    begin
        // Inferred rather than declared String: ToLower answers whichever of
        // Char and String it was given [RT-025], so it reduces to no type at
        // all and cannot fill a declared one [VAR-006].
        var Lowered := ToLower (TypeName);

        Exit Lowered = 'list'  or Lowered = 'map'   or Lowered = 'set'
          or Lowered = 'stack' or Lowered = 'array';
    end

    /// Parses 'if C then S', with an optional 'else S'.
    ///
    /// No parentheses: the condition is an expression and 'then' is what closes
    /// it, which is why nothing here has to balance a bracket.
    ///
    /// Both branches are a BodyStatement rather than a Statement, so a
    /// declaration in either is refused.
    ///
    /// # Raises
    ///
    /// 'Expect ''then'' after if condition.'
    ///
    /// # Satisfies
    ///
    /// [STM-004]
    function IfStatement () : Stmt;
    var
        Condition  : Expr;
        ThenBranch : Stmt;
        ElseBranch : Stmt;

    begin
        Condition := Expression();
        Consume (TOKEN_THEN, 'Expect ''then'' after if condition.');

        ThenBranch := BodyStatement ();
        if Match (TOKEN_ELSE) then
        begin
            ElseBranch := BodyStatement ();
        end

        Exit IfStmt (Condition, ThenBranch, ElseBranch);
    end

    /// Parses both 'for' forms: the counted one, and 'for X in C do'.
    ///
    /// The counted form desugars into a block holding the initializer and a
    /// WhileStmt carrying the step, which is why the loop variable belongs to
    /// the loop and is not visible after it [DCL-008].  The step rides on the
    /// node rather than being appended to the body so that 'continue' still runs
    /// it.
    ///
    /// # Raises
    ///
    /// 'Expect variable name.', 'Expect '';'' after loop condition' and
    /// 'Expect ''do'' after for clauses.'
    ///
    /// # Satisfies
    ///
    /// [DCL-008], [STM-006]
    function ForStatement () : Stmt;
    var
        Initializer : Stmt;
        Increment   : Expr;
        Condition   : Expr;
        Body        : Stmt;

        StmtList    : List of Stmt;
        WhileList   : List of Stmt;

    begin
        if Match (TOKEN_SEMICOLON) then
            Initializer := Nil;
        else if Match (TOKEN_VAR) then
        begin
            var Name := Consume (TOKEN_IDENTIFIER, 'Expect variable name.');

            if Match (TOKEN_IN) then Exit ForInStatement (Name);

            Initializer := VarDeclaration (Name);
        end
        else
            Initializer := ExpressionStatement();

        if Not Check (TOKEN_SEMICOLON) then
        begin
           Condition := Expression ();
        end
        Consume (TOKEN_SEMICOLON, 'Expect '';'' after loop condition');

        if Not Check (TOKEN_DO) then
        begin
           Increment := Expression ();
        end
        Consume (TOKEN_DO, 'Expect ''do'' after for clauses.');

        var Named := TakeLabel ();

        LoopDepth := LoopDepth + 1;
        Body := BodyStatement ();
        LoopDepth := LoopDepth - 1;

        LoopLabels.RemoveAt (LoopLabels.Length - 1);

        if Condition = Nil then Condition := LiteralExpr (True);

        var Loop := WhileStmt (Condition, Body);
        Loop.Increment := Increment;
        Loop.Label := Named;

        Body := Loop;

        if Initializer <> Nil then
        begin
            WhileList := List();
            WhileList.Add (Initializer);
            WhileList.Add (Body);

            Body := BlockStmt (WhileList);
        end

        Exit Body;
    end

    /// Parses 'while C do S'.
    ///
    /// No parentheses, on the same terms as 'if': 'do' is what closes the
    /// condition.
    ///
    /// # Raises
    ///
    /// 'Expect ''do'' after condition.'
    function WhileStatement () : Stmt;
    var
        Condition : Expr;
        Body      : Stmt;

    begin
        Condition := Expression();
        Consume (TOKEN_DO, 'Expect ''do'' after condition.');

        var Named := TakeLabel ();

        LoopDepth := LoopDepth + 1;
        Body := BodyStatement ();
        LoopDepth := LoopDepth - 1;

        LoopLabels.RemoveAt (LoopLabels.Length - 1);

        var Loop := WhileStmt (Condition, Body);
        Loop.Label := Named;

        Exit Loop;
    end

    /// Parses 'Exit', with a value from a function and none from a procedure.
    ///
    /// A value is refused inside a procedure, where it would mean nothing --
    /// which is what InProcedure is carried for.
    ///
    /// # Raises
    ///
    /// 'Expect '';'' after value.', and a refusal for a value in a procedure.
    function ReturnStatement () : Stmt;
    var
        Keyword : Token;
        Value   : Expr;

    begin
        Keyword := Previous();

        if Not Check(TOKEN_SEMICOLON) then
        begin
            if InProcedure then
                raise Error (Keyword, 'A procedure cannot exit a value.');

            Value := Expression();
        end

        Consume(TOKEN_SEMICOLON, 'Expect '';'' after exit value.');
        Exit ReturnStmt(Keyword, Value);
    end

    /// Records the names a 'private' declaration introduces.
    ///
    /// An enum contributes its members as well as its type name: they bind as
    /// bare names, so leaving them exported would export the type in all but
    /// spelling.
    ///
    /// EVERY declaration kind, and the list has to be complete: a kind missing
    /// here is not a name that fails to be private, it is a name that is
    /// SILENTLY PUBLIC.  ObjectStmt was missing, so a 'private object' was
    /// reachable from any importing file -- 'secret' where 'Undefined variable'
    /// is the correct answer.
    ///
    /// It had a second symptom that made it worse than a leak.  Because the
    /// object never reached PrivateNames, the emitter's export set kept it, so a
    /// private object shadowing an import was refused as 'Two modules exporting
    /// ''Solo''' -- a message that is false on its face, since that unit does not
    /// export Solo.  No gate could see either half: comparing output needs a test
    /// with a private object in it, and comparing emitted C says nothing when the
    /// program is refused before any C exists.
    ///
    /// # Satisfies
    ///
    /// [MOD-006]
    procedure RecordPrivate (Decl : Any);
    begin
        if Decl is FunctionStmt or Decl is ClassStmt or Decl is ObjectStmt
                                or Decl is VarStmt then
        begin
            PrivateNames.Add (Str (Decl.Name.Lexeme));
            Exit;
        end

        if Decl is VarGroupStmt then
        begin
            for var TheName in Decl.Names do
                PrivateNames.Add (Str (TheName.Lexeme));

            Exit;
        end

        if Decl is EnumStmt then
        begin
            PrivateNames.Add (Str (Decl.Name.Lexeme));

            for var Member in Decl.Members do
                PrivateNames.Add (Str (Member.Lexeme));

            Exit;
        end

        raise Error (Previous(), '''private'' must precede a declaration.');
    end

    /// Gets the directory part of a path, or '' when there is none.
    ///
    /// String work rather than a path library, because the language has no such
    /// library -- and this is the whole of what module resolution needs.
    function DirectoryOf (Path : String) : String;
    var
        Cut : Integer := -1;

    begin
        for var I := 0; I < Length (Path); I := I + 1 do
            if Path[I] = '/' then Cut := I;

        if Cut < 0 then Exit '';

        Exit Copy (Path, 0, Cut);
    end

    /// Resolves a 'uses' name to a file: beside the importing file first, then
    /// the working directory.
    ///
    /// Beside the importer first is what lets a program keep its own modules
    /// next to it without the working directory deciding what it imports.
    ///
    /// # Raises
    ///
    /// A refusal naming the module when neither location has the file.
    ///
    /// # Satisfies
    ///
    /// [MOD-002]
    function ResolveModule (Where : Token, ModuleName : String) : String;
    var
        TheFile : String;
        Dir     : String;

    begin
        TheFile := ModuleName + '.a24';
        Dir := DirectoryOf (FileName);

        if Dir <> '' then
        begin
            var Beside := Dir + '/' + TheFile;
            if FileExists (Beside) then Exit Beside;
        end

        if FileExists (TheFile) then Exit TheFile;

        var Searched := 'the working directory';
        if Dir <> '' then Searched := '''' + Dir + ''' or the working directory';

        raise Error (Where, 'Could not find module ''' + ModuleName
                          + ''': no ' + TheFile + ' in ' + Searched + '.');
    end

    /// Parses 'uses Name;' and loads the file, answering it as one statement.
    ///
    /// The file is parsed INLINE, by a sub-parser sharing this one's Loaded map.
    /// A diamond therefore loads once, and a re-import answers an empty module
    /// node rather than nothing -- so the second importer still sees the module
    /// and a cycle terminates instead of recursing.
    ///
    /// Circular imports work, which is not an accident of the implementation:
    /// Parser uses Interpreter and Interpreter uses Parser.
    ///
    /// # Raises
    ///
    /// Whatever ResolveModule raises when the file cannot be found.
    ///
    /// # Satisfies
    ///
    /// [MOD-001], [MOD-003], [MOD-012]
    function UsesStatement () : Stmt;
    var
        ModuleName : String;
        Where      : Token;

    begin
        if Match (TOKEN_STRING) then ModuleName := Str (Previous().Literal);
        else ModuleName := Str (Consume (TOKEN_IDENTIFIER, 'Expected identifier.').Lexeme);

        Where := Previous();
        Consume (TOKEN_SEMICOLON, 'Expected '';''');

        var Path := ResolveModule (Where, ModuleName);

        if Loaded.Contains (Path) then
        begin
            var Seen := ModuleStmt (Where, Nil, List());
            Seen.FileName := Path;
            Seen.UnitName := UnitStem (Path);

            Exit Seen;
        end
        Loaded.Put (Path, True);

        var SubScanner := Scanner (ReadWholeFile (Path));
        var SubParser  := Parser (SubScanner.ScanTokens());

        SubParser.FileName := Path;

        SubParser.Loaded := Loaded;

        var Result := SubParser.Parse();

        var TheModule := ModuleStmt (Where, Result, SubParser.PrivateNames);
        TheModule.FileName := Path;
        TheModule.UnitName := UnitStem (Path);

        Exit TheModule;
    end

    /// Parses a single 'const N := 5;'.
    ///
    /// The section form goes through DeclarationSection; this is the statement
    /// form, which is what a top-level constant uses.
    ///
    /// # Raises
    ///
    /// 'Expect constant name.' and a refusal for a const without an initializer.
    ///
    /// # Satisfies
    ///
    /// [VAR-012]
    function ConstDeclaration () : Stmt;
    var
        Name : Token;

    begin
        Name := Consume (TOKEN_IDENTIFIER, 'Expect constant name.');

        var TypeName := '';
        var Generic  := '';

        if Match (TOKEN_COLON) then
        begin
            TypeName := CanonicalType (Consume (TOKEN_IDENTIFIER, 'Expect type name.').Lexeme);

            if IsCollectionType (TypeName) and Match (TOKEN_OF) then
                Generic := Str (Consume (TOKEN_IDENTIFIER, 'Expect generic type.').Lexeme);
        end

        if Not Match (TOKEN_ASSIGN) then
            raise Error (Name, 'A constant must be given a value.');

        var Initializer := Expression ();
        Consume (TOKEN_SEMICOLON, 'Expect '';'' after constant declaration.');

        var TheVar := VarStmt (Name, Initializer);
        TheVar.TypeName := TypeName;
        TheVar.Generic := Generic;
        TheVar.IsConstant := True;

        Exit TheVar;
    end

    /// Consumes a 'private:' or 'public:' marker and records which is in force.
    function MatchVisibility () : Boolean;
    begin
        if Check (TOKEN_PRIVATE) and PeekNext().TypeOfToken = TOKEN_COLON then
        begin
            Advance (); Advance ();
            InPrivateSection := True;
            Exit True;
        end

        if Check (TOKEN_PUBLIC) and PeekNext().TypeOfToken = TOKEN_COLON then
        begin
            Advance (); Advance ();
            InPrivateSection := False;
            Exit True;
        end

        Exit False;
    end

    /// Whether what follows opens a 'var' or 'const' section rather than a
    /// statement.
    function IsDeclarationSection () : Boolean;
    begin
        Exit Check (TOKEN_VAR) or Check (TOKEN_CONST) or Check (TOKEN_TYPE);
    end

    /// Whether the current section has ended and another begins.
    function IsNextSection () : Boolean;
    begin
        if IsAtEnd () then Exit True;

        Exit Check (TOKEN_END) or Check (TOKEN_BEGIN)
          or Check (TOKEN_FUNCTION) or Check (TOKEN_PROCEDURE)
          or Check (TOKEN_CONSTRUCTOR)
          or Check (TOKEN_VAR) or Check (TOKEN_CONST) or Check (TOKEN_TYPE);
    end

    /// Parses a 'var' or 'const' section: a run of declarations under one
    /// keyword.
    ///
    /// Several names may share one declaration -- 'Current, Start, Line :
    /// Integer;' -- which becomes a VarGroupStmt rather than N separate ones,
    /// because the initializer is evaluated once for the whole group.
    ///
    /// # Satisfies
    ///
    /// [VAR-009], [VAR-010], [VAR-015]
    function DeclarationSection (IsConstant : Boolean) : List;
    var
        Stmts : List;
        Noun  : String;

    begin
        Stmts := List();

        Noun := 'variable';
        if IsConstant then Noun := 'constant';

        while Not IsNextSection () do
        begin
            while MatchVisibility () do
            begin
            end

            if IsNextSection () then break;

            var Names := List();
            Names.Add (Consume (TOKEN_IDENTIFIER, 'Expect ' + Noun + ' name.'));

            while Match (TOKEN_COMMA) do
                Names.Add (Consume (TOKEN_IDENTIFIER, 'Expect ' + Noun + ' name.'));

            if InPrivateSection then
                for var TheName in Names do
                    ClassPrivates.Add (Str (TheName.Lexeme));

            var TypeName := '';
            var Generic  := '';

            if Match (TOKEN_COLON) then
            begin
                TypeName := CanonicalType (Consume (TOKEN_IDENTIFIER, 'Expect type name.').Lexeme);

                if IsCollectionType (TypeName) and Match (TOKEN_OF) then
                    Generic := Str (Consume (TOKEN_IDENTIFIER, 'Expect generic type.').Lexeme);
            end

            var Initializer := Nil as Expr;
            if Match (TOKEN_ASSIGN) then Initializer := Expression ();
            else if IsConstant then
                raise Error (Names[0], 'A constant must be given a value.');

            Consume (TOKEN_SEMICOLON, 'Expect '';'' after ' + Noun + ' declaration.');

            if Names.Length = 1 then
            begin
                var TheVar := VarStmt (Names[0], Initializer);
                TheVar.TypeName := TypeName;
                TheVar.Generic := Generic;
                TheVar.IsConstant := IsConstant;

                Stmts.Add (TheVar);
            end
            else
            begin
                var TheGroup := VarGroupStmt (Names, Initializer);
                TheGroup.TypeName := TypeName;
                TheGroup.Generic := Generic;
                TheGroup.IsConstant := IsConstant;

                Stmts.Add (TheGroup);
            end
        end

        Exit Stmts;
    end

    /// Reads every declaration section of a body, with visibility markers
    /// allowed.
    procedure ReadDeclarationSections (Body : List);
    begin
        ReadDeclarationSections (Body, False);
    end

    /// Reads every declaration section of a body.
    ///
    /// A subprogram's own locals take no visibility marker, which is what the
    /// second parameter turns off: 'private:' belongs to a class or a unit, not
    /// to a block of locals nobody outside can name anyway.
    ///
    /// # Satisfies
    ///
    /// [DCL-011], [DCL-012], [VAR-011]
    procedure ReadDeclarationSections (Body : List, AllowVisibility : Boolean);
    begin
        while True do
        begin
            if AllowVisibility then
                while MatchVisibility () do
                begin
                end

            if not IsDeclarationSection () then break;

            if Match (TOKEN_VAR) then
            begin
                var Section := DeclarationSection (False);
                for var Declaration in Section do
                    Body.Add (Declaration);
            end
            else if Match (TOKEN_CONST) then
            begin
                var Section := DeclarationSection (True);
                for var Declaration in Section do
                    Body.Add (Declaration);
            end
            else
            begin
                Advance ();
                while Not IsNextSection () do
                    Body.Add (EnumDeclaration ());
            end
        end
    end

    /// Parses the rest of 'for X in C do S', the name already consumed.
    ///
    /// The loop variable takes no type: the grammar has no slot for one in this
    /// form, only in the counted one.
    function ForInStatement (Name : Token) : Stmt;
    var
        Iterable : Expr;
        Body     : Stmt;

    begin
        Iterable := Expression ();
        Consume (TOKEN_DO, 'Expect ''do'' after ''for ... in'' clause.');

        var Named := TakeLabel ();

        LoopDepth := LoopDepth + 1;
        Body := BodyStatement ();
        LoopDepth := LoopDepth - 1;

        LoopLabels.RemoveAt (LoopLabels.Length - 1);

        var Loop := ForInStmt (Name, Iterable, Body);
        Loop.Label := Named;

        Exit Loop;
    end

    /// Parses 'break', optionally naming an enclosing loop.
    ///
    /// Refused where no loop encloses it, and where the label names no
    /// enclosing loop -- both at the point it is written rather than at run
    /// time.
    ///
    /// # Satisfies
    ///
    /// [STM-010]
    function BreakStatement () : Stmt;
    var
        Keyword : Token;

    begin
        Keyword := Previous();

        if LoopDepth = 0 then
            raise Error (Keyword, 'Must be inside a loop to use ''break''.');

        var Named := JumpLabel (Keyword, 'break');

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after ''break''.');

        var Leaving := BreakStmt (Keyword);
        Leaving.Label := Named;

        Exit Leaving;
    end

    /// Parses 'Name:' and the statement it labels.
    ///
    /// A label on a LOOP is copied into the loop as well, because a labelled
    /// 'continue' has to be caught by the loop itself and a wrapper cannot begin
    /// someone else's next iteration.
    function LabelStatement () : Stmt;
    var
        Name : Token;

    begin
        Name := Advance ();
        Advance ();

        PendingLabel := Str (Name.Lexeme);

        var Inner := Statement ();

        PendingLabel := '';

        Exit LabelStmt (Name, Inner);
    end

    /// Takes the label pending for the loop about to be parsed, clearing it.
    function TakeLabel () : String;
    var
        Taken : String;

    begin
        Taken := PendingLabel;
        PendingLabel := '';

        LoopLabels.Add (Taken);

        Exit Taken;
    end

    /// Whether a label names one of the loops this statement is inside.
    function EnclosingLoop (TheLabel : String) : Boolean;
    begin
        for var LoopLabel in LoopLabels do
            if FoldCase (Str (LoopLabel)) = FoldCase (TheLabel) then Exit True;

        Exit False;
    end

    /// Reads the optional label after 'break' or 'continue', checking it names
    /// an enclosing loop.
    ///
    /// # Raises
    ///
    /// A refusal naming the verb when the jump is outside any loop, or names a
    /// label no enclosing loop has.
    function JumpLabel (Keyword : Token, Verb : String) : String;
    var
        Named : String;

    begin
        if not Check (TOKEN_IDENTIFIER) then Exit '';

        Named := Str (Advance ().Lexeme);

        if not EnclosingLoop (Named) then
            raise Error (Keyword, 'No enclosing loop is labelled ''' + Named + '''.');

        Exit Named;
    end

    /// Parses 'continue', optionally naming an enclosing loop.
    ///
    /// # Satisfies
    ///
    /// [STM-010]
    function ContinueStatement () : Stmt;
    var
        Keyword : Token;

    begin
        Keyword := Previous();

        if LoopDepth = 0 then
            raise Error (Keyword, 'Must be inside a loop to use ''continue''.');

        var Named := JumpLabel (Keyword, 'continue');

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after ''continue''.');

        var Beginning := ContinueStmt (Keyword);
        Beginning.Label := Named;

        Exit Beginning;
    end

    /// Consumes the symbol an 'operator' declaration is naming.
    function OperatorToken () : Token;
    begin
        if Check (TOKEN_PLUS) or Check (TOKEN_MINUS) or Check (TOKEN_STAR)
        or Check (TOKEN_SLASH) or Check (TOKEN_DIV) then Exit Advance ();

        raise Error (Peek (), 'An operator must be one of + - * / div.');
    end

    /// Parses 'operator + (Other : Money) : Money; begin ... end'.
    ///
    /// The member's NAME is the operator's lexeme, so '+' is a method called
    /// '+'.  Nothing downstream needs a new idea: dispatch, mangling and the
    /// class table all treat it as the method it is, and the mangling spells '+'
    /// as U00002B without being asked.
    ///
    /// UNARY AND BINARY ARE TOLD APART BY ARITY, as the two forms of subscript
    /// are: 'operator - (Other)' is subtraction and 'operator - ()' is negation.
    /// The language already tells arities apart everywhere, so neither form
    /// needs a word of its own.
    ///
    /// # Satisfies
    ///
    /// [EXP-020]
    function ParseOperator () : Stmt;
    var
        Name   : Token;
        Params : List;
        Body   : List;

    begin
        Name := OperatorToken ();

        Consume (TOKEN_LEFT_PAREN, 'Expect ''('' after operator.');

        Params := List();
        var ParamTypes := List();
        var ParamGenerics := List();

        if not Check (TOKEN_RIGHT_PAREN) then
        begin
            Params.Add (Consume (TOKEN_IDENTIFIER, 'Expect parameter name.'));
            ParamTypes.Add (ParameterType ());
            ParamGenerics.Add (LastGeneric);
        end

        Consume (TOKEN_RIGHT_PAREN, 'Expect '')'' after operator parameters.');

        if Params.Length > 1 then
            raise Error (Name, 'An operator takes one argument, or none for a unary one.');

        var ReturnType := '';
        var ReturnGeneric := '';

        if Match (TOKEN_COLON) then
        begin
            ReturnType := CanonicalType (Consume (TOKEN_IDENTIFIER, 'Expect type name.').Lexeme);

            if IsCollectionType (ReturnType) and Match (TOKEN_OF) then
                ReturnGeneric := Str (Consume (TOKEN_IDENTIFIER, 'Expect generic type.').Lexeme);
        end

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after operator signature.');

        Body := List();
        ReadDeclarationSections (Body);

        Consume (TOKEN_BEGIN, 'Expect ''begin'' before operator body.');

        var WasInProcedure := InProcedure;
        InProcedure := False;

        var Rest := Block ();

        InProcedure := WasInProcedure;

        for var Each in Rest do
            Body.Add (Each);

        var TheOperator := FunctionStmt (Name, Params, Body);
        TheOperator.ReturnType    := ReturnType;
        TheOperator.ReturnGeneric := ReturnGeneric;
        TheOperator.ParamTypes    := ParamTypes;
        TheOperator.ParamGenerics := ParamGenerics;

        Exit TheOperator;
    end

    /// Parses 'property Count : Integer; begin ... end'.
    ///
    /// NO PARAMETER LIST, which is the whole syntactic difference.  A property is
    /// read rather than called, so a parameter would have nowhere to arrive from
    /// -- and leaving the parentheses off is what makes the declaration say that.
    ///
    /// It becomes a FunctionStmt of arity 0 with IsProperty set, so resolution,
    /// checking, binding and emission treat it as the method it is.
    ///
    /// # Satisfies
    ///
    /// [CLS-017]
    function ParseProperty () : Stmt;
    var
        Name : Token;
        Body : List;

    begin
        Name := Consume (TOKEN_IDENTIFIER, 'Expect property name.');

        var ReturnType := '';
        var ReturnGeneric := '';

        if Match (TOKEN_COLON) then
        begin
            ReturnType := CanonicalType (Consume (TOKEN_IDENTIFIER, 'Expect type name.').Lexeme);

            if IsCollectionType (ReturnType) and Match (TOKEN_OF) then
                ReturnGeneric := Str (Consume (TOKEN_IDENTIFIER, 'Expect generic type.').Lexeme);
        end

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after property signature.');

        Body := List();
        ReadDeclarationSections (Body);

        Consume (TOKEN_BEGIN, 'Expect ''begin'' before property body.');

        var WasInProcedure := InProcedure;
        InProcedure := False;

        var Rest := Block ();

        InProcedure := WasInProcedure;

        for var Each in Rest do
            Body.Add (Each);

        var TheProperty := FunctionStmt (Name, List(), Body);
        TheProperty.ReturnType    := ReturnType;
        TheProperty.ReturnGeneric := ReturnGeneric;
        TheProperty.IsProperty    := True;

        Exit TheProperty;
    end

    /// Parses 'goto Name;'.
    function GotoStatement () : Stmt;
    var
        Keyword : Token;

    begin
        Keyword := Previous();

        var Named := Str (Consume (TOKEN_IDENTIFIER, 'Expect a label after ''goto''.').Lexeme);

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after ''goto''.');

        Exit GotoStmt (Keyword, Named);
    end

    /// Parses 'raise E;'.
    function RaiseStatement () : Stmt;
    var
        Keyword : Token;
        Value   : Expr;

    begin
        Keyword := Previous();
        Value := Expression();

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after raised value.');
        Exit RaiseStmt (Keyword, Value);
    end

    /// Parses 'try ... except' with its handlers.
    ///
    /// Handlers are collected into a Map keyed by type name, with an untyped
    /// 'on E do' and any trailing statements both keyed 'default' -- an untyped
    /// handler IS the catch-all, and keying it by its absent type would make it
    /// unreachable.
    ///
    /// There are three ways to catch everything and one to catch nothing: an
    /// untyped 'on E do', statements after the handlers, or an except block with
    /// no 'on' handlers at all -- which includes an empty one, where
    /// 'try ... except end' deliberately discards the error.  But when typed
    /// handlers are present and none matches, the value keeps unwinding rather
    /// than being swallowed here.
    ///
    /// # Raises
    ///
    /// A refusal for a repeated handler -- two for one type, two untyped ones,
    /// or an untyped one beside a trailing block.  The map would quietly keep
    /// the last and that branch would never run.
    function TryStatement () : Stmt;
    var
        Statements  : List;
        Handlers    : Map;
        HasHandlers : Boolean;
        Variable    : Token;
        TheType     : Token;
        Key         : String;
        Trailing    : Token;
        ExceptStmts : List;

    begin
        Statements := List();
        while Not Check (TOKEN_EXCEPT) and Not IsAtEnd () do
            Statements.Add (Statement ());

        Consume (TOKEN_EXCEPT, 'Expect ''except'' after try block.');

        Handlers := Map();
        HasHandlers := False;

        while CheckWord ('on') do
        begin
            HasHandlers := True;
            Advance ();

            Variable := Consume (TOKEN_IDENTIFIER, 'Expected variable name.');

            TheType := Nil;
            if Match (TOKEN_COLON) then
                TheType := Consume (TOKEN_IDENTIFIER, 'Expected type.');

            Consume (TOKEN_DO, 'Expected ''do''.');

            Key := 'default';
            if TheType <> Nil then Key := Str (TheType.Lexeme);

            if Handlers.Contains (Key) then
            begin
                if TheType = Nil then
                    raise Error (Variable, 'A handler for any exception is already given.');

                raise Error (TheType, 'Duplicate handler for ''' + Key + '''.');
            end

            Handlers.Put (Key, ExceptHandler (Str (Variable.Lexeme), Statement ()));
        end

        Trailing := Peek ();

        ExceptStmts := List();
        while Not Check (TOKEN_END) and Not IsAtEnd () do
            ExceptStmts.Add (Statement ());

        if Not HasHandlers or Not ExceptStmts.IsEmpty then
        begin
            if Not ExceptStmts.IsEmpty and Handlers.Contains ('default') then
                raise Error (Trailing,
                    'A handler for any exception is already given by an untyped ''on''.');

            Handlers.Put ('default', ExceptHandler ('Any', BlockStmt (ExceptStmts)));
        end

        Consume (TOKEN_END, 'Expect ''end'' after except block.');
        Exit TryStmt (BlockStmt (Statements), Handlers);
    end

    /// Parses a 'var' declaration, reading the name first.
    ///
    /// # Raises
    ///
    /// 'Expect variable name.'
    function VarDeclaration () : Stmt;
    begin
        Exit VarDeclaration (Consume (TOKEN_IDENTIFIER, 'Expect variable name.'));
    end

    /// Parses a 'var' declaration whose name has already been consumed.
    ///
    /// The two forms exist because a counted 'for' has read the name before it
    /// knows it is looking at a declaration.
    ///
    /// The written type may be a subrange name, or a collection carrying an
    /// element type -- 'List of Integer' -- which is recorded for checking and
    /// never enforced at run time.
    ///
    /// # Satisfies
    ///
    /// [TYP-002], [VAR-001]
    function VarDeclaration (Name : Token) : Stmt;
    var
       Initializer : Expr;

    begin
        var TypeName := '';
        var Generic  := '';

        if Match (TOKEN_COLON) then
        begin
            TypeName := CanonicalType (Consume (TOKEN_IDENTIFIER, 'Expect type name.').Lexeme);

            if IsCollectionType (TypeName) and Match (TOKEN_OF) then
                Generic := Str (Consume (TOKEN_IDENTIFIER, 'Expect generic type.').Lexeme);
        end

        if Match (TOKEN_ASSIGN) then
        begin
            Initializer := Expression();
        end

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after variable declaration.');

        var TheVar := VarStmt (Name, Initializer);
        TheVar.TypeName := TypeName;
        TheVar.Generic  := Generic;

        Exit TheVar;
    end

    /// Parses an expression evaluated for its effect, its value discarded.
    function ExpressionStatement () : Stmt;
    var
       TheExpr : Expr;

    begin
        TheExpr := Expression();
        Consume(TOKEN_SEMICOLON, 'Expect '';'' after expression.');

        Exit ExpressionStmt (TheExpr);
    end

    /// Parses a subprogram declaration -- a function, a procedure, a method or
    /// a constructor.
    ///
    /// One routine for all four, taking the kind as a word, because they differ
    /// only in what they may return and where they may appear.  InProcedure is
    /// saved and restored around the body rather than merely set: a function may
    /// be declared inside a procedure, and its 'Exit E' is perfectly legal.
    ///
    /// A declaration carrying an 'external' symbol has NO BODY.  Its statement
    /// list is empty and nothing walks it; the call goes to the runtime instead,
    /// which finds the symbol and builds the call.
    ///
    /// # Raises
    ///
    /// 'Expect ''('' after <kind> name.', 'Expect parameter name.' and
    /// 'Expect '')'' after parameters.' -- the first composed from Kind, so a
    /// procedure and a function each name themselves.  Also a refusal for a
    /// value returned from a procedure.
    ///
    /// # Satisfies
    ///
    /// [FUN-001], [FUN-003], [FUN-004], [FUN-012], [FUN-014]
    function ParseFunction (Kind : String) : Stmt;
    var
        Name   : Token;
        Params : List of Token;
        Body   : List of Stmt;

    begin
        Name := Consume (TOKEN_IDENTIFIER, 'Expect ' + Kind + ' name.');
        Consume (TOKEN_LEFT_PAREN, 'Expect ''('' after ' + Kind + ' name.');
        Params := List();
        var ParamTypes := List();
        var ParamGenerics := List();

        if Not Check (TOKEN_RIGHT_PAREN) then
        begin
            Params.Add (Consume (TOKEN_IDENTIFIER, 'Expect parameter name.'));
            ParamTypes.Add (ParameterType ());
            ParamGenerics.Add (LastGeneric);

            while Match (TOKEN_COMMA) do
            begin
                if Params.Length >= 255 then
                begin
                    raise 'Can''t have more than 255 parameters.';
                end
                Params.Add (Consume (TOKEN_IDENTIFIER, 'Expect parameter name.'));
                ParamTypes.Add (ParameterType ());
                ParamGenerics.Add (LastGeneric);
            end
        end
        Consume (TOKEN_RIGHT_PAREN, 'Expect '')'' after parameters.');

        var ReturnType := '';
        var ReturnGeneric := '';
        if Match (TOKEN_COLON) then
            ReturnType := CanonicalType (Consume (TOKEN_IDENTIFIER, 'Expect return type.').Lexeme);

            if IsCollectionType (ReturnType) and Match (TOKEN_OF) then
                ReturnGeneric := Str (Consume (TOKEN_IDENTIFIER, 'Expect generic type.').Lexeme);

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after ' + Kind + ' signature.');

        if Match (TOKEN_EXTERNAL) then
        begin
            var Symbol := Consume (TOKEN_STRING, 'Expect a symbol name after ''external''.');

            var InLibrary := '';

            if Match (TOKEN_IN) then
                InLibrary := Str (Consume (TOKEN_STRING,
                                  'Expect a library name after ''in''.').Literal);

            Consume (TOKEN_SEMICOLON, 'Expect '';'' after an external declaration.');

            var Foreign := FunctionStmt (Name, Params, List());
            Foreign.ReturnType    := ReturnType;
            Foreign.ReturnGeneric := ReturnGeneric;
            Foreign.ParamTypes    := ParamTypes;
            Foreign.ParamGenerics := ParamGenerics;
            Foreign.Symbol      := Str (Symbol.Literal);
            Foreign.Library       := InLibrary;

            Exit Foreign;
        end

        Body := List();
        ReadDeclarationSections (Body);

        Consume (TOKEN_BEGIN, 'Expect ''begin'' before ' + Kind + ' body.');

        var WasInProcedure := InProcedure;
        InProcedure := Kind = 'procedure';

        var Rest := Block ();

        InProcedure := WasInProcedure;

        for var Each in Rest do
            Body.Add (Each);

        var TheFunction := FunctionStmt (Name, Params, Body);
        TheFunction.ReturnType := ReturnType;
        TheFunction.ReturnGeneric := ReturnGeneric;
        TheFunction.ParamTypes := ParamTypes;
        TheFunction.ParamGenerics := ParamGenerics;

        Exit TheFunction;
    end

    /// Reads a parameter's written type, leaving any element type in
    /// LastGeneric.
    ///
    /// # Satisfies
    ///
    /// [VAR-008]
    function ParameterType () : String;
    begin
        LastGeneric := '';

        if not Match (TOKEN_COLON) then Exit '';

        var TypeName := CanonicalType (Consume (TOKEN_IDENTIFIER, 'Expect type name.').Lexeme);

        if IsCollectionType (TypeName) and Match (TOKEN_OF) then
            LastGeneric := Str (Consume (TOKEN_IDENTIFIER, 'Expect generic type.').Lexeme);

        Exit TypeName;
    end

    /// Parses 'begin' ... 'end' and answers the statements between.
    function Block () : List;
    var
       Statements : List of Statement;

    begin
        Statements := List();

        while Not Check (TOKEN_END) and Not IsAtEnd () do
        begin
            Statements.Add (Declaration ());
        end

        Consume (TOKEN_END, 'Expect ''end'' after block.');
        Exit Statements;
    end

    /// Parses an assignment, or whatever expression stands where its target
    /// would be.
    ///
    /// The target decides the node: a bare name is an AssignExpr, a property is
    /// a SetExpr, and a subscript is a SetSubscriptExpr rather than an
    /// AssignExpr with a subscript target, because that target is not a name and
    /// nothing about it resolves like one.
    ///
    /// # Raises
    ///
    /// A refusal for an assignment to something that cannot be assigned to.
    ///
    /// # Satisfies
    ///
    /// [EXP-017]
    function Assignment () : Expr;
    var
       TheExpr : Expr;
       Equals  : Token;
       Value   : Expr;

    begin
        TheExpr := ParseOr ();

        if Match (TOKEN_ASSIGN) then
        begin
            Equals := Previous ();
            Value  := Assignment ();

            if TheExpr.ClassName = 'VariableExpr' then
                Exit AssignExpr (TheExpr.Name, Value);
            else if TheExpr.ClassName = 'GetExpr' then
                Exit SetExpr (TheExpr.Obj, TheExpr.Name, Value);
            else if TheExpr.ClassName = 'SubscriptExpr' then
                Exit SetSubscriptExpr (TheExpr.Obj, TheExpr.Index, Value, TheExpr.Bracket);

            raise 'Invalid assignment target.';
        end
        Exit TheExpr;
    end

    /// Parses 'or', which does not evaluate its right operand unless it has to.
    function ParseOr () : Expr;
    var
       TheExpr : Expr;
       Op      : Token;
       Right   : Expr;

    begin
        TheExpr := ParseAnd ();

        while Match (TOKEN_OR) do
        begin
            Op := Previous ();
            Right := ParseAnd ();
            TheExpr := LogicalExpr (TheExpr, Op, Right);
        end

        Exit TheExpr;
    end

    /// Parses 'and', which does not evaluate its right operand unless it has
    /// to.
    function ParseAnd () : Expr;
    var
       TheExpr : Expr;
       Op      : Token;
       Right   : Expr;

    begin
        TheExpr := Equality ();

        while Match (TOKEN_AND) do
        begin
            Op := Previous ();
            Right := Equality ();
            TheExpr := LogicalExpr (TheExpr, Op, Right);
        end

        Exit TheExpr;
    end

    /// Parses an expression -- the entry point to the whole precedence chain.
    ///
    /// # Satisfies
    ///
    /// [EXP-001]
    function Expression() : Expr;
    var
        TheExpr : Expr;

    begin
        TheExpr := Assignment ();

        Exit TheExpr;
    end

    /// Parses one top-level item: a declaration, a test block, or a statement.
    ///
    /// # Satisfies
    ///
    /// [TST-001]
    function Declaration();
    begin
            if IsTestBlock () then Exit TestDeclaration ();

            Exit Statement ();
    end

    /// Whether what follows is a test block.
    ///
    /// 'test' is not a keyword -- it is an ordinary identifier recognized by
    /// position, so this needs the quoted name after it to be sure [LEX-011].
    function IsTestBlock () : Boolean;
    begin
        if not Check (TOKEN_IDENTIFIER) then Exit False;
        if Peek().Lexeme <> 'test' then Exit False;

        Exit PeekNext().TypeOfToken = TOKEN_STRING
          or PeekNext().TypeOfToken = TOKEN_CHAR;
    end

    /// Parses 'test ''Name''; begin ... end'.
    function TestDeclaration () : Stmt;
    var
        Name : Token;
        Body : List;

    begin
        Advance ();

        if Check (TOKEN_CHAR) then Name := Advance();
        else Name := Consume (TOKEN_STRING, 'Expect a test name.');
        Consume (TOKEN_SEMICOLON, 'Expect '';'' after test name.');
        Consume (TOKEN_BEGIN, 'Expect ''begin'' before test body.');

        Body := Block ();
        Exit FunctionStmt (Name, List(), Body);
    end

    /// Parses 'type X = ...', which declares an enumeration or a subrange.
    ///
    /// Which of the two is decided by the character after the '='.
    ///
    /// # Satisfies
    ///
    /// [ENU-001]
    function EnumDeclaration () : Stmt;
    var
        Name    : Token;
        Members : List;

    begin
        Name := Consume (TOKEN_IDENTIFIER, 'Expect enum name.');
        Consume (TOKEN_EQUAL, 'Expect ''='' after enum declaration.');

        if not Check (TOKEN_LEFT_PAREN) then Exit SubrangeDeclaration (Name);

        Consume (TOKEN_LEFT_PAREN, 'Expect ''('' before enum members.');

        Members := List();
        Members.Add (Consume (TOKEN_IDENTIFIER, 'Expect member name.'));

        while Match (TOKEN_COMMA) do
            Members.Add (Consume (TOKEN_IDENTIFIER, 'Expect member name.'));

        Consume (TOKEN_RIGHT_PAREN, 'Expect '')'' after enum members.');
        Consume (TOKEN_SEMICOLON, 'Expect '';'' after enum declaration.');

        Exit EnumStmt (Name, Members);
    end

    /// Parses 'type Digit = 0 .. 9;' -- a subrange of Integer.
    ///
    /// The bounds are LITERALS, optionally signed, rather than expressions.  A
    /// subrange is hoisted like a class and an enum, so its bounds must be known
    /// before anything runs -- and an expression would have to be evaluated,
    /// which needs the declaration to have run already.
    ///
    /// # Satisfies
    ///
    /// [TYP-016]
    function SubrangeDeclaration (Name : Token) : Stmt;
    var
        Low  : Integer;
        High : Integer;

    begin
        Low := SubrangeBound ();
        Consume (TOKEN_DOT_DOT, 'Expect ''..'' between subrange bounds.');
        High := SubrangeBound ();

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after subrange declaration.');

        if Low > High then
            Error (Name, 'A subrange must not be empty: ' + Str (Low)
                       + ' is above ' + Str (High) + '.');

        Exit SubrangeStmt (Name, Low, High);
    end

    /// Reads one bound: an integer literal, optionally preceded by '-'.
    ///
    /// There is no negative literal [LEX-019], so the sign is read here rather
    /// than being part of the number -- the same rule the rest of the language
    /// follows, applied where an expression cannot be.
    function SubrangeBound () : Integer;
    var
        Negative : Boolean;

    begin
        Negative := Match (TOKEN_MINUS);

        var Bound := Consume (TOKEN_INTEGER, 'Expect an integer bound.');

        if Negative then Exit 0 - (Bound.Literal as Integer);

        Exit Bound.Literal as Integer;
    end

    /// Parses a class, naming itself 'class' in its diagnostics.
    function ClassDeclaration ();
    begin
        Exit ClassDeclaration ('class');
    end

    /// Parses a class or an object.
    ///
    /// ONE routine for both, differing only in the noun in its messages and in
    /// which node it builds at the end.  An object is a class in every respect
    /// but what its name evaluates to, and two copies of this would be two
    /// places for a class feature to be added and an object feature to be
    /// forgotten.
    ///
    /// # Satisfies
    ///
    /// [CLS-001], [CLS-002], [CLS-015]
    function ClassDeclaration (Kind : String);
    var
        Name       : Token;
        Methods    : List;
        Fields     : List;
        Superclass : VariableExpr;

    begin
        Name := Consume (TOKEN_IDENTIFIER, 'Expect ' + Kind + ' name.');
        Superclass := Nil as VariableExpr;

        if Match (TOKEN_LEFT_PAREN) then
        begin
           Consume (TOKEN_IDENTIFIER, 'Expect superclass name.');
           Superclass := VariableExpr (Previous ());
           Consume (TOKEN_RIGHT_PAREN, 'Expect '')'' after superclass name.');
        end

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after ' + Kind + ' declaration.');

        ClassPrivates := List();
        InPrivateSection := False;

        Fields := List();
        var Section := List();
        ReadDeclarationSections (Section, True);

        for var Each in Section do
        begin

            if Each is VarGroupStmt then
            begin
                for var TheName in Each.Names do
                begin
                    var Field := VarStmt (TheName, Each.Initializer);
                    Field.TypeName := Each.TypeName;
                    Field.Generic := Each.Generic;

                    Fields.Add (Field);
                end
            end
            else Fields.Add (Each);
        end

        Consume (TOKEN_BEGIN, 'Expect ''begin'' before ' + Kind + ' body.');

        InPrivateSection := False;

        Methods := List();
        while Not Check (TOKEN_END) and Not IsAtEnd () do
        begin
            while MatchVisibility () do
            begin
            end

            if Check (TOKEN_END) or IsAtEnd () then break;

            var Method : Stmt;

            if Match (TOKEN_CONSTRUCTOR) then
                Method := ParseFunction ('constructor');
            else if Match (TOKEN_PROCEDURE) then
                Method := ParseFunction ('procedure');
            else if Match (TOKEN_PROPERTY) then
                Method := ParseProperty ();
            else if Match (TOKEN_OPERATOR) then
                Method := ParseOperator ();
            else
            begin
                Consume (TOKEN_FUNCTION,
                    'Expect ''function'', ''procedure'' or ''constructor'' in class body.');
                Method := ParseFunction ('method');
            end

            if InPrivateSection then ClassPrivates.Add (Str (Method.Name.Lexeme));

            Methods.Add (Method);
        end

        Consume (TOKEN_END, 'Expect ''end'' after ' + Kind + ' body.');

        if Kind = 'object' then
        begin
            var TheObject := ObjectStmt (Name, Superclass, Methods, Fields);
            TheObject.PrivateMembers := ClassPrivates;

            Exit TheObject;
        end

        var TheClass := ClassStmt (Name, Superclass, Methods, Fields);
        TheClass.PrivateMembers := ClassPrivates;

        Exit TheClass;
    end

    /// Parses '=' and '<>', the loosest-binding of the operators.
    function Equality() : Expr;
    var
       TheExpr  : Expr;
       TheOperator : Token;
       Right    : Expr;

    begin
       TheExpr := Comparison();

       while Match (TOKEN_NOT_EQUAL) or Match (TOKEN_EQUAL) do
       begin
           TheOperator := Previous();
           Right := Comparison();

           TheExpr := BinaryExpr(TheExpr, TheOperator, Right);
       end

       Exit TheExpr;
    end

    /// Parses '<', '<=', '>' and '>=', and the 'is' type test.
    ///
    /// 'is' sits here rather than beside 'as' because it consumes a type name
    /// after itself, so 'A is Dog and B is Cat' has to keep parsing.
    function Comparison() : Expr;
    var
        TheExpr : Expr;
        TheOperator : Token;
        Right : Expr;

    begin
        TheExpr := Term();

        while True do
        begin
            if Match (TOKEN_IS) then
            begin
                TheExpr := IsExpr (TheExpr,
                    Consume (TOKEN_IDENTIFIER, 'Expect type name after ''is''.'));
            end
            else if Match (TOKEN_GREATER) or Match (TOKEN_GREATER_EQUAL) or
                    Match (TOKEN_LESS)    or Match (TOKEN_LESS_EQUAL) or
                    Match (TOKEN_IN) then
            begin
                TheOperator := Previous();
                Right := Term();
                TheExpr := BinaryExpr(TheExpr, TheOperator, Right);
            end
            else Exit TheExpr;
        end
        Exit TheExpr;
    end

    /// Parses '+' and '-'.
    ///
    /// # Satisfies
    ///
    /// [EXP-002]
    function Term() : Expr;
    var
        TheExpr : Expr;
        TheOperator : Token;
        Right : Expr;

    begin
        TheExpr := Factor();

        while Match (TOKEN_MINUS) or Match (TOKEN_PLUS) do
        begin
            TheOperator := Previous();
            Right := Factor();
            TheExpr := BinaryExpr(TheExpr, TheOperator, Right);
        end
        Exit TheExpr;
    end

    /// Parses '*', '/' and 'div', which bind tighter than '+' and '-'.
    function Factor() : Expr;
    var
        TheExpr  : Expr;
        TheOperator : Token;
        Right    : Expr;

    begin
        TheExpr := Unary();
        while Match(TOKEN_SLASH) or Match(TOKEN_STAR) or Match(TOKEN_DIV) do
        begin
            TheOperator := Previous();
            Right := Unary();

            TheExpr := BinaryExpr(TheExpr, TheOperator, Right);
        end
        Exit TheExpr;
    end

    /// Parses a prefix '-' or 'not', and the 'as' cast.
    ///
    /// 'as' binds HERE, at the unary level, and applies to the operand beside it
    /// and nothing further: 'A and B as C' is 'A and (B as C)', and
    /// 'A as Integer > 3' is '(A as Integer) > 3'.
    ///
    /// It used to bind below 'or', in Expression, which had two consequences.
    /// 'A and B as C' cast the whole conjunction -- an oddity while a cast had no
    /// run-time effect, and a live fault once it became a checked conversion,
    /// since 'False and 5 as Integer' then cast a Boolean and raised.  And
    /// 'A as Integer > 3' did not parse at all: the cast consumed the expression
    /// and the comparison had nothing to attach to.
    ///
    /// # Satisfies
    ///
    /// [EXP-003]
    function Unary() : Expr;
    var
       TheOperator : Token;
       Right    : Expr;
       TheExpr  : Expr;

    begin
        if Match (TOKEN_NOT) or Match (TOKEN_MINUS) then
        begin
            TheOperator := Previous();
            Right    := Unary();

            Exit UnaryExpr(TheOperator, Right);
        end

        TheExpr := Call();

        if Match (TOKEN_AS) then
            TheExpr.Cast := CanonicalType (Consume (TOKEN_IDENTIFIER,
                'Expect typecast identifier.').Lexeme);

        Exit TheExpr;
    end

    /// Parses a collection literal -- '[1, 2, 3]', '[''a'': 1]', '[]' and '[:]'.
    ///
    /// One node for both kinds, told apart by a colon after the first element.
    /// '[]' is an empty List and '[:]' an empty Map, which is the only place the
    /// two empty forms can be distinguished at all.
    function CollectionLiteral () : Expr;
    var
        Keys   : List;
        Values : List;
        IsMap  : Boolean;

    begin
        Keys := List();
        Values := List();
        IsMap := False;

        if Match (TOKEN_COLON) then
        begin
            IsMap := True;
            Consume (TOKEN_RIGHT_BRACKET, 'Expect '']'' after map.');

            Exit CollectionExpr (True, Keys, Values);
        end

        if Match (TOKEN_RIGHT_BRACKET) then Exit CollectionExpr (False, Keys, Values);

        var First := Expression ();
        if Match (TOKEN_COLON) then
        begin
            IsMap := True;
            Keys.Add (First);
            Values.Add (Expression ());
        end
        else Values.Add (First);

        while Match (TOKEN_COMMA) do
        begin
            if IsMap then
            begin
                Keys.Add (Expression ());
                Consume (TOKEN_COLON, 'Expect '':'' after key.');
                Values.Add (Expression ());
            end
            else Values.Add (Expression ());
        end

        Consume (TOKEN_RIGHT_BRACKET, 'Expect '']'' after list.');
        Exit CollectionExpr (IsMap, Keys, Values);
    end

    /// Parses a call, a property access and a subscript, left to right.
    ///
    /// The loop is what makes 'A.B (1)[2].C' read in the order written.
    function Call () : Expr;
    var
       TheExpr : Expr;
       Name    : Token;

    begin
        TheExpr := Primary();

        while True do
        begin
            if Match (TOKEN_LEFT_PAREN) then
                TheExpr := FinishCall (TheExpr);
            else if Match (TOKEN_LEFT_BRACKET) then
                begin
                    var Bracket := Previous ();
                    var Index   := Expression ();

                    Consume (TOKEN_RIGHT_BRACKET, 'Expect '']'' after subscript.');
                    TheExpr := SubscriptExpr (TheExpr, Index, Bracket);
                end
            else if Match (TOKEN_DOT) then
                begin
                    Name := Consume (TOKEN_IDENTIFIER, 'Expect property name after ''.''.');
                    TheExpr := GetExpr (TheExpr, Name);
                end
            else
                Break;
        end
        Exit TheExpr;
    end

    /// Reads the argument list of a call, the '(' already consumed.
    ///
    /// # Raises
    ///
    /// 'Expect '')'' after arguments.', and a refusal for a positional argument
    /// following a named one.
    function FinishCall (Callee : Expr) : Expr;
    var
        Arguments : List of Expr;
        Names     : List of String;
        Paren     : Token;

    begin
        Arguments := List();
        Names     := List();

        if Not Check (TOKEN_RIGHT_PAREN) then
        begin
            Argument (Arguments, Names);
            while Match (TOKEN_COMMA) do
            begin
                if Arguments.Length >= 255 then
                    raise 'Can''t have more than 255 arguments.';

                Argument (Arguments, Names);
            end
        end
        Paren := Consume(TOKEN_RIGHT_PAREN, 'Expect '')'' after arguments.');

        var TheCall := CallExpr (Callee, Paren, Arguments);
        TheCall.ArgumentNames := Names;

        Exit TheCall;
    end

    /// Reads one argument, and the parameter name it fills when it names one.
    ///
    /// The name is collected BESIDE the expression rather than inside it.  An
    /// argument is an expression and a name is not one, so a name is not
    /// something the tree can hold in the same slot.
    procedure Argument (Arguments : List, Names : List);
    begin
        if Check (TOKEN_IDENTIFIER) and PeekNext().TypeOfToken = TOKEN_COLON then
        begin
            var TheName := Str (Advance().Lexeme);
            Advance ();

            Names.Add (TheName);
            Arguments.Add (Expression ());

            Exit;
        end

        if Names.Length > 0 and Str (Names[Names.Length - 1]) <> '' then
            raise 'A positional argument cannot follow a named one.';

        Names.Add ('');
        Arguments.Add (Expression ());
    end

    /// Parses the tightest-binding forms: a literal, a name, 'this', 'super', a
    /// parenthesised expression, and a collection literal.
    ///
    /// Where the recursive descent bottoms out, so a token reaching here that
    /// begins no expression is the parse error the whole chain finally reports.
    ///
    /// # Raises
    ///
    /// 'Expect expression!' for a token that starts none, and
    /// 'Expect '')'' after expression.' for an unclosed group.
    ///
    /// # Satisfies
    ///
    /// [COL-001]
    function Primary() : Expr;
    var
        TheExpr : Expr;
        Keyword : Token;
        Method  : Token;

    begin
        if Match (TOKEN_FALSE) then Exit LiteralExpr(False);
        if Match (TOKEN_TRUE) then Exit LiteralExpr(True);
        if Match (TOKEN_NIL) then Exit LiteralExpr(nil);

        if Match (TOKEN_LEFT_BRACKET) then Exit CollectionLiteral ();

        if Match (TOKEN_INTEGER) or Match (TOKEN_NUMBER)
        or Match (TOKEN_STRING)  or Match (TOKEN_CHAR) then
        begin
            Exit LiteralExpr (Previous().Literal);
        end

        if Match (TOKEN_SUPER) then
        begin
           Keyword := Previous();
           Consume (TOKEN_DOT, 'Expect ''.'' after ''super''.');
           Method := Consume (TOKEN_IDENTIFIER, 'Expect superclass method name.');
           Exit SuperExpr (Keyword, Method);
        end

        if Match (TOKEN_THIS) then Exit ThisExpr (Previous());

        if Match (TOKEN_IDENTIFIER) then
        begin
           Exit VariableExpr (Previous());
        end

        if Match (TOKEN_LEFT_PAREN) then
        begin
            TheExpr := Expression();
            Consume (TOKEN_RIGHT_PAREN, 'Expect '')'' after expression.');

            Exit GroupingExpr (TheExpr);
        end
        raise 'Expect expression!';
    end

    /// Consumes the next token when it is of this kind, and answers whether it
    /// did.
    function Match(TheType : TokenType) : Boolean;
    begin
        if Check (TheType) then
        begin
            Advance();
            Exit True;
        end
        Exit False;
    end

    /// Reports a parse error against a token and answers it to be raised.
    function Error(TheToken: Token, Message : String) : Any;
    begin
        Console.Error (TheToken, Message);

        Exit Message;
    end

    /// Consumes a token of the required kind, or fails with the given message.
    ///
    /// # Raises
    ///
    /// The message given, against the token actually found.
    function Consume (TypeOfToken : TokenType, Message : String) : Token;
    begin
        if Check (TypeOfToken) then Exit Advance();

        raise Error (Previous(), Message);
    end

    /// Whether the next token is of this kind, without consuming it.
    function Check(TheType : TokenType) : Boolean;
    begin
       if IsAtEnd() then Exit False;

       Exit Peek().TypeOfToken = TheType;
    end

    /// Whether the next token is an identifier spelling this word.
    ///
    /// How the context-sensitive words are recognized, since none of them is a
    /// keyword [LEX-011].
    function CheckWord (Word : String) : Boolean;
    begin
        if Not Check (TOKEN_IDENTIFIER) then Exit False;

        Exit ToLower (Str (Peek().Lexeme)) = Word;
    end

    /// Consumes the next token and answers it.
    function Advance() : Token;
    begin
       if Not IsAtEnd() then Current := Current + 1;

       Exit Previous();
    end

    /// Whether the parse has reached the EOF token.
    function IsAtEnd() : Boolean;
    begin
       Exit Peek().TypeOfToken = EOF;
    end

    /// Gets the next token without consuming it.
    function Peek() : Token;
    begin
       Exit Tokens[Current];
    end

    /// Gets the token after the next one without consuming either.
    function PeekNext() : Token;
    begin
       if Current + 1 >= Tokens.Length then Exit Tokens[Tokens.Length - 1];

       Exit Tokens[Current + 1];
    end

    /// Gets the token most recently consumed.
    function Previous() : Token;
    begin
       Exit Tokens[Current - 1];
    end
end

// Parsing a false token should return a false literal.
//
test 'Parse False';
begin
    var TheScanner := Scanner ('false');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Primary();

    AssertEqual(False, Result.Value);
end

// Parsing a true token should return a true literal.
//
test 'Parse True';
begin
    var TheScanner := Scanner ('true');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Primary();

    AssertEqual(True, Result.Value);
end

// Parsing a nil token should return a literal of nil.
//
test 'Parse Nil';
begin
    var TheScanner:= Scanner ('nil');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Primary();

    AssertEqual(Nil, Result.Value);
end

// Parsing a number token should return a number literal
//
test 'Parse Number';
begin
    var TheScanner:= Scanner ('3.14');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Primary();

    AssertEqual(3.14, Result.Value);
end

// Parsing a string token should return a String literal.
//
test 'Parse String';
begin
    var TheScanner:= Scanner ('''ABC''');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Primary();

    AssertEqual('ABC', Result.Value);
end

// Parsing a token of paranthesis should return a Grouping expression.
//
test 'Parse Parenthesis';
begin
    var TheScanner:= Scanner ('(1)');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Primary();

    AssertEqual(1.0, Result.Expression.Value);
end

// When parsing parenthesis, primary should return an error when there is an unmatched closing parenthesis.
//
test 'Parse Parenthesis Error';
begin
    var TheScanner:= Scanner ('(1');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
       TheParser.Primary();
    except
        on e : String do
            begin
               AssertEqual ('Expect '')'' after expression.', e);
               Exit;
            end
    end
    Fail('No error raised');
end

// Should fail if reaches the end and a valid primary expression is not matched.
//
test 'Parse Primary Error';
begin
    var TheScanner:= Scanner ('-1');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
       TheParser.Primary();
    except
        on e : String do
            begin
                AssertEqual ('Expect expression!', e);
                Exit;
            end
    end
    Fail('No error raised');
end

// Negative numbers should return a unary with token type of Minus.
//
test 'Parse Unary Minus';
begin
    var TheScanner := Scanner ('-1');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Unary();

    AssertEqual(TOKEN_MINUS, Result.Op.TypeOfToken);
    AssertEqual(1.0, Result.Right.Value);
end

// Parsing ! should return a Unary
//
test 'Parse Unary Bang';
begin
    var TheScanner := Scanner ('not true');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Unary();

    AssertEqual(TOKEN_NOT, Result.Op.TypeOfToken);
    AssertEqual(True, Result.Right.Value);
end

// Parsing != should return a Binary expression.
//
test 'Parse Comparison Bang Equal';
begin
    var TheScanner := Scanner ('1 <> 2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Equality();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_NOT_EQUAL, Result.Op.TypeOfToken);
end

// Parsing == should return a Binary expression.
//
test 'Parse Comparison Equal Equal';
begin
    var TheScanner := Scanner ('1 = 2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Equality();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_EQUAL, Result.Op.TypeOfToken);
end

// Parsing / should return a Binary.
//
test 'Parse Factor Slash';
begin
    var TheScanner := Scanner ('1/2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Factor();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_SLASH, Result.Op.TypeOfToken);
end

// Parsing * should return a Binary.
//
test 'Parse Factor Star';
begin
    var TheScanner := Scanner ('1*2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Factor();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_STAR, Result.Op.TypeOfToken);
end

// Parsing + should return a Binary.
//
test 'Parse Term Plus';
begin
    var TheScanner := Scanner ('1+2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Term();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_PLUS, Result.Op.TypeOfToken);
end

// Parsing - should return a Binary.
//
test 'Parse Term Minus';
begin
    var TheScanner := Scanner ('1-2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Term();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_MINUS, Result.Op.TypeOfToken);
end

// Parsing > should return a Binary.
//
test 'Parse Comparison Greater';
begin
    var TheScanner := Scanner ('1 > 2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Comparison();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_GREATER, Result.Op.TypeOfToken);
end

// Parsing >= should return a Binary.
//
test 'Parse Comparison Greater Equal';
begin
    var TheScanner := Scanner ('1 >= 2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Comparison();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_GREATER_EQUAL, Result.Op.TypeOfToken);
end

// Parsing < should return a Binary.
//
test 'Parse Comparison Less';
begin
    var TheScanner := Scanner ('1 < 2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Comparison();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_LESS, Result.Op.TypeOfToken);
end

// Parsing <= should return a Binary.
//
test 'Parse Comparison Less Equal';
begin
    var TheScanner := Scanner ('1 <= 2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Comparison();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_LESS_EQUAL, Result.Op.TypeOfToken);
end

// ⚠️ 'print' is an ORDINARY NAME, and these two tests replace a pair that
// asserted it was a statement.  It was a thirty-eighth keyword with a statement
// of its own, and neither is part of this language: 'var print := 7;' was
// refused with 'Expect variable name.' [LEX-010, STM-022].
//
test 'Parse Print Is An Ordinary Name';
begin
    var TheScanner := Scanner ('var print := 7;');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertEqual('VarStmt', Result.ClassName);
    AssertEqual('print', Result.Name.Lexeme);
end

// And usable as one, not merely declarable.
//
test 'Parse Print Is Callable As A Name';
begin
    var TheScanner := Scanner ('print (123);');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertEqual('ExpressionStmt', Result.ClassName);
    AssertEqual('CallExpr', Result.Expression.ClassName);
end

// Test parsing an expression statement.
//
test 'Parse Expression Statement';
begin
    var TheScanner := Scanner ('a := 1;');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertEqual('ExpressionStmt', Result.ClassName);
end

// Should not be able to assign to a rvalue.
//
test 'Parse Expression Invalid Assignment';
begin
    var TheScanner := Scanner ('1 := 1;');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
               AssertEqual('Invalid assignment target.', e);
               Exit;
            end
    end
    Fail('No exception thrown.');
end

// Expression statement should end with a semicolon.
//
test 'Parse Expression Expect Semicolon';
begin
    var TheScanner := Scanner ('a := 1');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
               AssertEqual('Expect '';'' after expression.', e);
               Exit;
            end
    end
    Fail('No exception thrown.');
end

