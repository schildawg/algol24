//
test 'Parse Class No Begin';
begin
    var TheScanner := Scanner ('class Breakfast;');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Declaration();
    except
        on e : String do
            begin
                AssertEqual('Expect ''begin'' before class body.', e);
