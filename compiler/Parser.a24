uses Console;
uses Expr;
uses Interpreter;
uses Scanner;
uses Stmt;
uses Token;
uses TokenType;

/// Parses a list of tokens, creating a list of statements.
///
/// # Example
/// 
/// var TheScanner:= Scanner ('3.14');
/// var TheParser := Parser (TheScanner.ScanTokens());
///
/// var Result := TheParser.Primary();
///
/// AssertEqual(3.14, Result.Value);
/// 
/// Reads a whole file.
///
/// Here rather than in Main.a24 because the Parser is the thing that loads a
/// module, and Main is loaded after it -- a function there would not be in
/// scope.  ReadLn drops the terminator, so the lines are rejoined with #10,
/// which is what the language says a line ends with and what the scanner
/// counts.
///
function ReadWholeFile (Name : String) : String;
begin
    var F := TextFile();
    F.Assign (Name);
    F.Reset();

    // ⚠️ A Buffer, not 'Result := Result + Line'.  That copies the whole file
    // so far on every line, so reading an n-byte source costs n^2/2 bytes of
    // memory that is never reclaimed -- and this compiler's own largest source
    // is 113 KB.
    var Result := Buffer();

    while not F.Eof do
    begin
        Result.Append (F.ReadLn());
        Result.Append (#10);
    end

    F.Close();
    Exit Result.Text;
end

class Parser;
var 
   Tokens :  List of Token;
   Current : Integer;

   /// The file these tokens came from, so a 'uses' clause can look for its
   /// module beside the importer before falling back to the working directory.
   /// '' when the source did not come from a file.
   FileName : String := '';

   /// Every module file already loaded, keyed by resolved path.  SHARED with
   /// the parsers of the files this one imports -- which is what makes a
   /// diamond load once and stops a cycle from recursing forever.
   Loaded : Map := [:];

   /// Names marked 'private' in this file.
   PrivateNames : List := [];

   /// Whether a 'private:' marker is currently in force, and the names it has
   /// covered in the class being parsed.
   ///
   /// ⚠️ Parser state rather than a parameter, because a marker's reach is
   /// lexical and crosses the helpers that read declarations -- a var section
   /// may begin public and turn private halfway down.
   InPrivateSection : Boolean := False;
   ClassPrivates    : List := [];

   /// How many loops enclose the statement being parsed, so 'break' outside
   /// one can be rejected where it is written rather than at run time.
   ///
   /// ⚠️ Not reset when a function body is entered.  A 'break' inside a
   /// function declared inside a loop is therefore accepted, and would escape
   /// the call at run time.  Odd, and deliberate.
   LoopDepth : Integer := 0;

   /// Whether the body being parsed belongs to a 'procedure' rather than a
   /// 'function', so 'Exit E;' can be refused where it means nothing [FUN-003].
   ///
   /// ⚠️ Saved and restored around a body, not merely set: a function may be
   /// declared inside a procedure, and its 'Exit E' is perfectly legal.
   InProcedure : Boolean := False;

   /// ParameterType's second answer.
   ///
   /// ⚠️ A parameter's element type is wanted beside its type name, and a
   /// function returns one thing.  A field for one caller is the smaller of the
   /// two evils; the alternative is re-reading the tokens.
   LastGeneric : String := '';

begin
    /// Creates a new Parser.
    ///
    constructor Init(Tokens : List);
    begin
       this.Tokens := Tokens;
       this.Current := 0;
    end

    /// Parses a list of statements.
    ///
    /// Consumes an optional 'unit Name;' header and checks it against the file.
    ///
    /// It declares nothing and produces no statement: a unit is named by its
    /// FILE, here as in Turbo Pascal, and the header only writes that name down
    /// where a reader can see it.  What it buys is the check -- a file renamed
    /// without its header, or a header copied between files, is caught here
    /// instead of turning into a qualified name that silently reaches the wrong
    /// unit.
    ///
    /// ⚠️ 'unit' is CONTEXT-SENSITIVE, matched as an identifier the way 'test'
    /// is, and not added to the keyword table.  Keyword lookup is
    /// case-insensitive, so promoting a common word makes every existing
    /// identifier spelled that way a parse error -- which is what happened when
    /// 'object' became one and cost 252 of them in a single file.
    ///
    procedure UnitHeader ();
    begin
        if not Check (TOKEN_IDENTIFIER)                  then Exit;
        if Peek().Lexeme <> 'unit'                       then Exit;
        if PeekNext().TypeOfToken <> TOKEN_IDENTIFIER    then Exit;

        Advance();
        var Name := Advance();
        Consume (TOKEN_SEMICOLON, 'Expect '';'' after unit name.');

        var Expected := UnitStem (FileName);

        // The REPL and a scan with no file behind it have nothing to disagree
        // with.
        if Expected = '' or Expected = 'REPL' then Exit;

        // ⚠️ Through Error, not a bare raise.  Error prints the '[ERROR] file:
        // message' line with a caret under the offending token, which is what
        // every other diagnostic in this parser produces and what the reference
        // documents.  A raise alone reached the top as 'Uncaught:' with no
        // position at all -- a check that compares the sentence and not the
        // line around it cannot see the difference.
        if Expected <> Str (Name.Lexeme) then
            raise Error (Name, 'Unit ''' + Str (Name.Lexeme)
                             + ''' must match its file name ''' + Expected + '''.');
    end

    /// The file's stem -- the name a unit answers to.  The Resolver and the
    /// Interpreter each work this out the same way for the same reason.
    function UnitStem (Key : String) : String;
    var
        Stem : String;

    begin
        Stem := Key;

        for var I := Length (Key) - 1; I >= 0; I := I - 1 do
            if Key[I] = '/' or Key[I] = '\' then
            begin
                Stem := Copy (Key, I + 1, Length (Key) - I - 1);
                I := -1;
            end

        if Length (Stem) > 4 and Copy (Stem, Length (Stem) - 4, 4) = '.a24' then
            Exit Copy (Stem, 0, Length (Stem) - 4);

        Exit Stem;
    end

    function Parse () : List;
    var 
        Statements : List of Stmt;

    begin
        Statements := List();

        // ⚠️ The file being parsed is entered in Loaded BEFORE its own 'uses'
        // clauses are read, so a module that imports it back finds it already
        // loaded [MOD-014].  A sub-parser's path is put there by UsesStatement
        // already, which makes this a no-op for every file but the ROOT -- and
        // the root was the one file it was never done for.  A cycle through the
        // root parsed the root a SECOND time, and the two copies did not share
        // their names.
        //
        // ⚠️ Identity is the path STRING, as it is throughout Loaded, so the
        // root's own name and the name a module resolves for it must match
        // character for character.  ResolveModule answers the working-directory
        // path, which is what the driver was given.
        if FileName <> '' then Loaded.Put (FileName, True);

        UnitHeader ();

        while Not IsAtEnd () do
        begin
            if Match (TOKEN_USES) then
            begin
                var TheModule := UsesStatement ();

                // Nil when the file was already loaded by an earlier 'uses',
                // so importing it twice is a no-op rather than a redefinition.
                if TheModule <> Nil then Statements.Add (TheModule);
            end
            else if Match (TOKEN_PRIVATE) then
            begin
                var Decl := Declaration ();
                RecordPrivate (Decl);
                Statements.Add (Decl);
            end
            else Statements.Add (Declaration ());
        end  
        Exit Statements;
    end

    /// Parses a statement.
    ///
    function Statement () : Stmt;
    begin
        // ⚠️ Declarations are statements, so 'var' and friends are legal in a
        // single-statement body -- an if branch, a loop body, a try block --
        // and not only inside a begin/end.  They used to sit in Declaration()
        // alone, which meant 'try var X := 1; ... ' would not parse.  Found by
        // a test that raises a runtime error from a var declared inside the
        // try.
        if Match (TOKEN_TYPE) then Exit EnumDeclaration ();
        if Match (TOKEN_CLASS) then Exit ClassDeclaration ();
        if Match (TOKEN_OBJECT) then Exit ClassDeclaration ('object');
        if Match (TOKEN_FUNCTION) then Exit ParseFunction ('function');
        if Match (TOKEN_PROCEDURE) then Exit ParseFunction ('procedure');
        if Match (TOKEN_VAR) then Exit VarDeclaration ();
        if Match (TOKEN_CONST) then Exit ConstDeclaration ();

        if Match (TOKEN_CASE) then Exit CaseStatement();
        if Match (TOKEN_IF) then Exit IfStatement();
        if Match (TOKEN_WHILE) then Exit WhileStatement();
        if Match (TOKEN_FOR) then Exit ForStatement();
        if Match (TOKEN_EXIT) then Exit ReturnStatement();
        if Match (TOKEN_TRY) then Exit TryStatement();
        if Match (TOKEN_BREAK) then Exit BreakStatement();
        if Match (TOKEN_RAISE) then Exit RaiseStatement();
        if Match (TOKEN_BEGIN) then Exit BlockStmt (Block());

        Exit ExpressionStatement ();
    end

    /// Parses an if statement
    ///
    /// # Errors
    ///
    /// Raises an error if no opening parenthesis after if.
    /// Raises an error if no closing parenthesis after condition.
    ///
    // Parses a case statement, desugaring it into an if/else-if chain.
    //
    //     case X of
    //         1:    'one';
    //         2, 3: 'two or three';
    //     else
    //         'other';
    //     end
    //
    // becomes 'if X = 1 then ... else if X = 2 or X = 3 then ... else ...', so
    // branches are tested in order, and there is no fallthrough and no jump
    // table.  Nothing downstream learns about 'case': there is no CaseStmt, and
    // the interpreter and resolver need no change at all.
    //
    // Labels are arbitrary expressions rather than constants, and there are no
    // ranges.  That generality is why a branch takes exactly one statement --
    // with ';' terminating rather than separating, a second statement cannot be
    // told from the next branch's label.
    //
    // # Errors
    //
    // Raises an error if no 'of' after the condition, no ':' after a label, or
    // no 'end' after an else branch.
    //
    function CaseStatement () : Stmt;
    var
        Left      : Expr;
        Top       : IfStmt;
        Current   : IfStmt;
        Condition : Expr;
        Branch    : IfStmt;

    begin
        Left := Expression ();
        Consume (TOKEN_OF, 'Expect ''of'' after case condition.');

        Top := Nil as IfStmt;
        Current := Nil as IfStmt;

        while True do
        begin
            Condition := BinaryExpr (Left, Equals (), Expression ());

            // Comma-separated alternatives are just more 'or'.
            while Match (TOKEN_COMMA) do
                Condition := LogicalExpr (Condition, Either (),
                                          BinaryExpr (Left, Equals (), Expression ()));

            Consume (TOKEN_COLON, 'Expect '':'' after condition.');

            Branch := IfStmt (Condition, Statement (), Nil);

            if Top = Nil then Top := Branch;
            else Current.ElseBranch := Branch;

            Current := Branch;

            if Match (TOKEN_ELSE) or Match (TOKEN_END) then Break;
        end

        if Previous().TypeOfToken = TOKEN_ELSE then
        begin
            Current.ElseBranch := BodyStatement ();
            Consume (TOKEN_END, 'Expected ''end''.');
        end

        Exit Top;
    end

    // The '=' and 'or' a desugared case is built from.  Synthetic tokens: they
    // stand at the position of the label that produced them, so an error inside
    // a branch still points somewhere real.
    //
    function Equals () : Token;
    begin
        Exit Token (TOKEN_EQUAL, '=', Nil, Previous().LineNumber);
    end

    function Either () : Token;
    begin
        Exit Token (TOKEN_OR, 'or', Nil, Previous().LineNumber);
    end

    /// The body of a branch or a loop, where a DECLARATION is refused.
    ///
    /// ⚠️ Not merely useless -- actively wrong.  A declaration here escapes into
    /// the ENCLOSING scope, so whether the name exists is decided by a runtime
    /// condition: 'if True then var X := 1;' leaves X defined and the same
    /// program with a false condition leaves it undefined [STM-002].
    ///
    /// ⚠️ Declarations stay legal in Statement itself, because a 'try' body is
    /// a statement and 'try var X := 1; ...' has to parse.  This is the branch
    /// and loop positions only.
    ///
    /// ⚠️ The C back end already refused this, so fixing it makes the language,
    /// the compiler and the interpreter agree -- the one entry in Annex C that
    /// closes by the LANGUAGE moving rather than the compiler (C-12).
    function BodyStatement () : Stmt;
    begin
        if Check (TOKEN_VAR) or Check (TOKEN_CONST) or Check (TOKEN_TYPE)
        or Check (TOKEN_CLASS) or Check (TOKEN_OBJECT)
        or Check (TOKEN_FUNCTION) or Check (TOKEN_PROCEDURE) then
            raise Error (Peek (),
                'A declaration cannot be a branch or loop body; use ''begin'' ... ''end''.');

        Exit Statement ();
    end

    /// A collection type name, which may carry an element type [VAR-008].
    ///
    /// ⚠️ Every collection, not only List.  'Map of Integer', 'Set of Integer'
    /// and 'Array of Integer' were each refused with 'Expect '';'' after
    /// variable declaration.' -- so only a List could say what it held, and
    /// there was no reason for that but the one name being spelled out here.
    ///
    /// ⚠️ For a Map the element type is the VALUE type, because that is what a
    /// subscript and a Get yield [VAR-016]; a Map's keys are not constrained.
    function IsCollectionType (TypeName : String) : Boolean;
    var
        Lowered : String;

    begin
        Lowered := ToLower (TypeName);

        Exit Lowered = 'list'  or Lowered = 'map'   or Lowered = 'set'
          or Lowered = 'stack' or Lowered = 'array';
    end

    function IfStatement () : Stmt;
    var
        Condition  : Expr;
        ThenBranch : Stmt;
        ElseBranch : Stmt;

    begin
        Condition := Expression();
        Consume (TOKEN_THEN, 'Expect ''then'' after if condition.');

        ThenBranch := BodyStatement ();
        if Match (TOKEN_ELSE) then
        begin
            ElseBranch := BodyStatement ();
        end

        Exit IfStmt (Condition, ThenBranch, ElseBranch);
    end

    /// Parses a for statement
    ///
    /// # Errors
    ///
    /// Raise an error if no opening parenthesis after for.
    /// Raise an error if no semicolon after loop condition.
    /// Raise an error if no closing parenthesis after for clauses.
    ///
    function ForStatement () : Stmt;
    var
        Initializer : Stmt;
        Increment   : Expr;
        Condition   : Expr;
        Body        : Stmt;
        
        StmtList    : List of Stmt;
        WhileList   : List of Stmt;

    begin
        if Match (TOKEN_SEMICOLON) then
            Initializer := Nil;
        else if Match (TOKEN_VAR) then
        begin
            // 'for var X in C do' and 'for var I := 0; ...' agree up to the
            // name, so read it and let the next token decide.
            var Name := Consume (TOKEN_IDENTIFIER, 'Expect variable name.');

            if Match (TOKEN_IN) then Exit ForInStatement (Name);

            Initializer := VarDeclaration (Name);
        end
        else 
            Initializer := ExpressionStatement();

        if Not Check (TOKEN_SEMICOLON) then
        begin
           Condition := Expression ();
        end
        Consume (TOKEN_SEMICOLON, 'Expect '';'' after loop condition'); 

        if Not Check (TOKEN_DO) then
        begin
           Increment := Expression ();
        end
        Consume (TOKEN_DO, 'Expect ''do'' after for clauses.');

        LoopDepth := LoopDepth + 1;
        Body := BodyStatement ();
        LoopDepth := LoopDepth - 1;
        
        if Increment <> Nil then
        begin
            StmtList := List();
            StmtList.Add (Body);
            StmtList.Add (ExpressionStmt (Increment));

            Body := BlockStmt (StmtList);
        end

        if Condition = Nil then Condition := LiteralExpr (True);
        Body := WhileStmt(Condition, Body);

        if Initializer <> Nil then
        begin
            WhileList := List();
            WhileList.Add (Initializer);
            WhileList.Add (Body);

            Body := BlockStmt (WhileList);
        end

        Exit Body;
    end

    /// Parses a while statement
    ///
    /// # Errors
    ///
    /// Raises an error if no opening parenthesis after while.
    /// Raises an error if no closing parenthesis after condition.
    ///
    function WhileStatement () : Stmt;
    var
        Condition : Expr;
        Body      : Stmt;

    begin
        Condition := Expression();
        Consume (TOKEN_DO, 'Expect ''do'' after condition.');

        LoopDepth := LoopDepth + 1;
        Body := BodyStatement ();
        LoopDepth := LoopDepth - 1;

        Exit WhileStmt (Condition, Body);
    end

    /// Parses a statement
    /// 
    /// # Errors
    ///
    /// Raises an error if no semicolon after value.
    /// 
    /// Parses a return statement.
    ///
    ///
    /// # Errors
    ///
    /// Raises an error if no semicolon after value.
    ///
    function ReturnStatement () : Stmt;
    var
        Keyword : Token;
        Value   : Expr;

    begin
        Keyword := Previous();

        if Not Check(TOKEN_SEMICOLON) then
        begin
            // ⚠️ The word means something, or it means nothing.  Without this a
            // procedure may return a value and a caller may use it, so
            // 'procedure' documents intent and constrains nothing -- and no
            // reader can tell from a declaration whether a call has a result
            // worth using [FUN-003].
            if InProcedure then
                raise Error (Keyword, 'A procedure cannot exit a value.');

            Value := Expression();
        end

        Consume(TOKEN_SEMICOLON, 'Expect '';'' after exit value.');
        Exit ReturnStmt(Keyword, Value);
    end

    /// Records the names a 'private' declaration introduces.
    ///
    /// An enum contributes its members as well as its type name: they bind as
    /// bare names, so leaving them exported would export the type in all but
    /// spelling.
    ///
    /// ⚠️ EVERY declaration kind, and the list has to be complete: a kind
    /// missing here is not a name that fails to be private, it is a name that
    /// is SILENTLY PUBLIC.  ObjectStmt was missing, so a 'private object' was
    /// reachable from any importing file -- 'secret' where 'Undefined
    /// variable' is the correct answer.
    ///
    /// ⚠️ It had a second symptom that made it worse than a leak.  Because the
    /// object never reached PrivateNames, the emitter's export set kept it, so a
    /// private object shadowing an import was refused as 'Two modules exporting
    /// ''Solo''' -- a message that is false on its face, since that unit does
    /// not export Solo.  No gate could see either half: comparing output needs
    /// a test with a private object in it, and comparing emitted C says
    /// nothing when the program is refused before any C exists.
    ///
    procedure RecordPrivate (Decl : Any);
    begin
        if Decl is FunctionStmt or Decl is ClassStmt or Decl is ObjectStmt
                                or Decl is VarStmt then
        begin
            PrivateNames.Add (Str (Decl.Name.Lexeme));
            Exit;
        end

        if Decl is VarGroupStmt then
        begin
            for var I := 0; I < Decl.Names.Length; I := I + 1 do
                PrivateNames.Add (Str (Decl.Names[I].Lexeme));

            Exit;
        end

        if Decl is EnumStmt then
        begin
            PrivateNames.Add (Str (Decl.Name.Lexeme));

            for var I := 0; I < Decl.Members.Length; I := I + 1 do
                PrivateNames.Add (Str (Decl.Members[I].Lexeme));

            Exit;
        end

        // ⚠️ And a declaration kind that is not any of these is an ERROR rather
        // than a silent no-op, which is the other half of the same hole: this
        // procedure used to fall off the end, so 'private WriteLn(...)' was
        // accepted and quietly ignored.
        raise Error (Previous(), '''private'' must precede a declaration.');
    end

    /// The directory part of a path, or '' when there is none.
    ///
    /// String work rather than a path library, because the language has no
    /// such library -- and this is the whole of what module resolution needs.
    ///
    function DirectoryOf (Path : String) : String;
    var
        Cut : Integer := -1;

    begin
        for var I := 0; I < Length (Path); I := I + 1 do
            if Path[I] = '/' then Cut := I;

        if Cut < 0 then Exit '';

        Exit Copy (Path, 0, Cut);
    end

    /// Finds the file for a module.
    ///
    /// ⚠️ Beside the importing file FIRST, then the working directory.  That
    /// order is what lets two directories hold two copies of the same file
    /// names without either reaching the other's.
    ///
    function ResolveModule (Where : Token, ModuleName : String) : String;
    var
        TheFile : String;
        Dir     : String;

    begin
        TheFile := ModuleName + '.a24';
        Dir := DirectoryOf (FileName);

        if Dir <> '' then
        begin
            var Beside := Dir + '/' + TheFile;
            if FileExists (Beside) then Exit Beside;
        end

        if FileExists (TheFile) then Exit TheFile;

        var Searched := 'the working directory';
        if Dir <> '' then Searched := '''' + Dir + ''' or the working directory';

        raise Error (Where, 'Could not find module ''' + ModuleName
                          + ''': no ' + TheFile + ' in ' + Searched + '.');
    end

    /// Loads the file named by a 'uses' clause as a module.  Nil when it has
    /// already been loaded.
    ///
    function UsesStatement () : Stmt;
    var
        ModuleName : String;
        Where      : Token;

    begin
        if Match (TOKEN_STRING) then ModuleName := Str (Previous().Literal);
        else ModuleName := Str (Consume (TOKEN_IDENTIFIER, 'Expected identifier.').Lexeme);

        Where := Previous();
        Consume (TOKEN_SEMICOLON, 'Expected '';''');

        var Path := ResolveModule (Where, ModuleName);

        // Keyed by the resolved file rather than the written name, so one
        // module reached two ways loads once.
        // ⚠️ A file already loaded yields a module node with NO statements
        // rather than nothing at all.  Loading and visibility are different
        // questions: the file is read once, but every file that says 'uses' for
        // it must see it, or the second importer silently gets nothing.
        if Loaded.Contains (Path) then
        begin
            var Seen := ModuleStmt (Where, Nil, List());
            Seen.FileName := Path;
            Seen.UnitName := UnitStem (Path);

            Exit Seen;
        end
        Loaded.Put (Path, True);

        var SubScanner := Scanner (ReadWholeFile (Path));
        var SubParser  := Parser (SubScanner.ScanTokens());

        SubParser.FileName := Path;

        // The SAME map, not a copy -- a copy would let a diamond load its
        // shared dependency twice, once down each arm.
        SubParser.Loaded := Loaded;

        var Result := SubParser.Parse();

        var TheModule := ModuleStmt (Where, Result, SubParser.PrivateNames);
        TheModule.FileName := Path;
        TheModule.UnitName := UnitStem (Path);

        Exit TheModule;
    end

    /// Parses a single 'const N := 5;'.
    ///
    /// The section form goes through DeclarationSection; this is the statement
    /// form, which is what a top-level constant uses.
    ///
    /// # Errors
    ///
    /// A constant without a value is an error rather than nil: the whole point
    /// of the binding is that it cannot be set later.
    ///
    function ConstDeclaration () : Stmt;
    var
        Name : Token;

    begin
        Name := Consume (TOKEN_IDENTIFIER, 'Expect constant name.');

        var TypeName := '';
        var Generic  := '';

        if Match (TOKEN_COLON) then
        begin
            TypeName := CanonicalType (Consume (TOKEN_IDENTIFIER, 'Expect type name.').Lexeme);

            if IsCollectionType (TypeName) and Match (TOKEN_OF) then
                Generic := Str (Consume (TOKEN_IDENTIFIER, 'Expect generic type.').Lexeme);
        end

        if Not Match (TOKEN_ASSIGN) then
            raise Error (Name, 'A constant must be given a value.');

        var Initializer := Expression ();
        Consume (TOKEN_SEMICOLON, 'Expect '';'' after constant declaration.');

        var TheVar := VarStmt (Name, Initializer);
        TheVar.TypeName := TypeName;
        TheVar.Generic := Generic;
        TheVar.IsConstant := True;

        Exit TheVar;
    end

    /// Consumes a 'private:' or 'public:' marker, if one is here.
    ///
    /// ⚠️ The COLON is what separates this from the module-level 'private',
    /// which prefixes a single top-level declaration and has nothing to do
    /// with classes.  Without the lookahead, 'private function F()' inside a
    /// class body would read as a section marker.
    ///
    function MatchVisibility () : Boolean;
    begin
        if Check (TOKEN_PRIVATE) and PeekNext().TypeOfToken = TOKEN_COLON then
        begin
            Advance (); Advance ();
            InPrivateSection := True;
            Exit True;
        end

        if Check (TOKEN_PUBLIC) and PeekNext().TypeOfToken = TOKEN_COLON then
        begin
            Advance (); Advance ();
            InPrivateSection := False;
            Exit True;
        end

        Exit False;
    end

    /// Whether a declaration section starts here.
    ///
    function IsDeclarationSection () : Boolean;
    begin
        Exit Check (TOKEN_VAR) or Check (TOKEN_CONST) or Check (TOKEN_TYPE);
    end

    /// Whether the current token ends the section being read.
    ///
    /// ⚠️ A section has no terminator of its own -- it runs until something
    /// that is plainly not another declaration.  So this list has to name
    /// everything that can follow one, and a member missing from it makes the
    /// section swallow whatever comes next.
    ///
    function IsNextSection () : Boolean;
    begin
        if IsAtEnd () then Exit True;

        Exit Check (TOKEN_END) or Check (TOKEN_BEGIN)
          or Check (TOKEN_FUNCTION) or Check (TOKEN_PROCEDURE)
          or Check (TOKEN_CONSTRUCTOR)
          or Check (TOKEN_VAR) or Check (TOKEN_CONST) or Check (TOKEN_TYPE);
    end

    /// A 'var' or 'const' section: one declaration per line, no repeated
    /// keyword, running until the next section or the body.
    ///
    ///     var
    ///         Source : String;
    ///         Current, Start, Line : Integer;
    ///
    /// The two differ only in whether an initializer is required and whether
    /// the names may later be reassigned, so they share this.
    ///
    function DeclarationSection (IsConstant : Boolean) : List;
    var
        Stmts : List;
        Noun  : String;

    begin
        Stmts := List();

        Noun := 'variable';
        if IsConstant then Noun := 'constant';

        while Not IsNextSection () do
        begin
            // A marker may stand between two fields of one var section, not
            // only between sections.  A loop rather than a skip, because the
            // language has no 'continue' -- and two markers may sit together.
            while MatchVisibility () do
            begin
            end

            // Markers may also run right up to the end of the section.
            if IsNextSection () then break;

            var Names := List();
            Names.Add (Consume (TOKEN_IDENTIFIER, 'Expect ' + Noun + ' name.'));

            while Match (TOKEN_COMMA) do
                Names.Add (Consume (TOKEN_IDENTIFIER, 'Expect ' + Noun + ' name.'));

            // ⚠️ Recorded HERE rather than by the caller, which sees the
            // section only once it is fully parsed -- and so would read
            // whichever marker came last and hide every field in the section
            // behind it.
            if InPrivateSection then
                for var I := 0; I < Names.Length; I := I + 1 do
                    ClassPrivates.Add (Str (Names[I].Lexeme));

            var TypeName := '';
            var Generic  := '';

            if Match (TOKEN_COLON) then
            begin
                TypeName := CanonicalType (Consume (TOKEN_IDENTIFIER, 'Expect type name.').Lexeme);

                if IsCollectionType (TypeName) and Match (TOKEN_OF) then
                    Generic := Str (Consume (TOKEN_IDENTIFIER, 'Expect generic type.').Lexeme);
            end

            var Initializer := Nil as Expr;
            if Match (TOKEN_ASSIGN) then Initializer := Expression ();
            else if IsConstant then
                raise Error (Names[0], 'A constant must be given a value.');

            Consume (TOKEN_SEMICOLON, 'Expect '';'' after ' + Noun + ' declaration.');

            // One name is an ordinary declaration.  Several sharing an
            // initializer stay together, so the expression runs once.
            if Names.Length = 1 then
            begin
                var TheVar := VarStmt (Names[0], Initializer);
                TheVar.TypeName := TypeName;
                TheVar.Generic := Generic;
                TheVar.IsConstant := IsConstant;

                Stmts.Add (TheVar);
            end
            else
            begin
                var TheGroup := VarGroupStmt (Names, Initializer);
                TheGroup.TypeName := TypeName;
                TheGroup.Generic := Generic;
                TheGroup.IsConstant := IsConstant;

                Stmts.Add (TheGroup);
            end
        end

        Exit Stmts;
    end

    /// Reads every declaration section standing before a body, appending them
    /// to it -- so a function's locals are ordinary statements at the top of
    /// its own block.
    ///
    procedure ReadDeclarationSections (Body : List);
    begin
        ReadDeclarationSections (Body, False);
    end

    /// The same, with visibility markers allowed between sections.
    ///
    /// ⚠️ Only a class or object header passes True.  A marker in a FUNCTION
    /// header means nothing, and silently accepting one there would invent
    /// syntax the language does not have.
    ///
    procedure ReadDeclarationSections (Body : List, AllowVisibility : Boolean);
    begin
        while True do
        begin
            if AllowVisibility then
                while MatchVisibility () do
                begin
                end

            if not IsDeclarationSection () then break;

            if Match (TOKEN_VAR) then
            begin
                var Section := DeclarationSection (False);
                for var I := 0; I < Section.Length; I := I + 1 do
                    Body.Add (Section[I]);
            end
            else if Match (TOKEN_CONST) then
            begin
                var Section := DeclarationSection (True);
                for var I := 0; I < Section.Length; I := I + 1 do
                    Body.Add (Section[I]);
            end
            else
            begin
                Advance ();
                while Not IsNextSection () do
                    Body.Add (EnumDeclaration ());
            end
        end
    end

    /// Parses the rest of 'for var X in C do ...', the name already read.
    ///
    function ForInStatement (Name : Token) : Stmt;
    var
        Iterable : Expr;
        Body     : Stmt;

    begin
        Iterable := Expression ();
        Consume (TOKEN_DO, 'Expect ''do'' after ''for ... in'' clause.');

        LoopDepth := LoopDepth + 1;
        Body := BodyStatement ();
        LoopDepth := LoopDepth - 1;

        Exit ForInStmt (Name, Iterable, Body);
    end

    /// Parses 'break;'.
    ///
    /// # Errors
    ///
    /// Raises an error when written outside a loop.  A run-time check would
    /// have to wait for the branch to be taken, and a 'break' with no loop to
    /// leave is wrong however the program runs.
    ///
    function BreakStatement () : Stmt;
    var
        Keyword : Token;

    begin
        Keyword := Previous();

        if LoopDepth = 0 then
            raise Error (Keyword, 'Must be inside a loop to use ''break''.');

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after ''break''.');
        Exit BreakStmt (Keyword);
    end

    /// Parses 'raise Expr;'.
    ///
    function RaiseStatement () : Stmt;
    var
        Keyword : Token;
        Value   : Expr;

    begin
        Keyword := Previous();
        Value := Expression();

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after raised value.');
        Exit RaiseStmt (Keyword, Value);
    end

    /// Parses 'try ... except ... end'.
    ///
    ///     try
    ///         Risky();
    ///     except
    ///         on E : String do WriteLn(E);
    ///         on E do WriteLn('anything else');
    ///     end
    ///
    /// Handlers are collected into a Map keyed by type name, with an untyped
    /// 'on E do' and any trailing statements both keyed 'default' -- an
    /// untyped handler IS the catch-all, and keying it by its absent type
    /// would make it unreachable.
    ///
    /// ⚠️ There are three ways to catch everything and one to catch nothing:
    /// an untyped 'on E do', statements after the handlers, or an except block
    /// with no 'on' handlers at all -- which includes an empty one, where
    /// 'try ... except end' deliberately discards the error.  But when typed
    /// handlers are present and none matches, the value keeps unwinding rather
    /// than being swallowed here.
    ///
    /// # Errors
    ///
    /// A repeated handler is an error rather than a silent overwrite: two for
    /// one type, two untyped ones, or an untyped one beside a trailing block.
    /// The map would quietly keep the last and that branch would never run.
    ///
    function TryStatement () : Stmt;
    var
        Statements  : List;
        Handlers    : Map;
        HasHandlers : Boolean;
        Variable    : Token;
        TheType     : Token;
        Key         : String;
        Trailing    : Token;
        ExceptStmts : List;

    begin
        Statements := List();
        while Not Check (TOKEN_EXCEPT) and Not IsAtEnd () do
            Statements.Add (Statement ());

        Consume (TOKEN_EXCEPT, 'Expect ''except'' after try block.');

        Handlers := Map();
        HasHandlers := False;

        while CheckWord ('on') do
        begin
            HasHandlers := True;
            Advance ();

            Variable := Consume (TOKEN_IDENTIFIER, 'Expected variable name.');

            // Kept as a Token rather than a lexeme so a duplicate can be
            // reported against the type that was written twice.
            TheType := Nil;
            if Match (TOKEN_COLON) then
                TheType := Consume (TOKEN_IDENTIFIER, 'Expected type.');

            Consume (TOKEN_DO, 'Expected ''do''.');

            Key := 'default';
            if TheType <> Nil then Key := Str (TheType.Lexeme);

            if Handlers.Contains (Key) then
            begin
                if TheType = Nil then
                    raise Error (Variable, 'A handler for any exception is already given.');

                raise Error (TheType, 'Duplicate handler for ''' + Key + '''.');
            end

            Handlers.Put (Key, ExceptHandler (Str (Variable.Lexeme), Statement ()));
        end

        Trailing := Peek ();

        ExceptStmts := List();
        while Not Check (TOKEN_END) and Not IsAtEnd () do
            ExceptStmts.Add (Statement ());

        if Not HasHandlers or Not ExceptStmts.IsEmpty then
        begin
            if Not ExceptStmts.IsEmpty and Handlers.Contains ('default') then
                raise Error (Trailing,
                    'A handler for any exception is already given by an untyped ''on''.');

            Handlers.Put ('default', ExceptHandler ('Any', BlockStmt (ExceptStmts)));
        end

        Consume (TOKEN_END, 'Expect ''end'' after except block.');
        Exit TryStmt (BlockStmt (Statements), Handlers);
    end

    /// Parses a var declaration.
    ///
    /// # Errors
    /// 
    /// Raises an error if no variable name.
    /// Raises an error if no semicolon after variable declaration.
    ///
    function VarDeclaration () : Stmt;
    begin
        Exit VarDeclaration (Consume (TOKEN_IDENTIFIER, 'Expect variable name.'));
    end

    /// The rest of a variable declaration, the name already consumed.
    ///
    /// ⚠️ Split from the above so 'for var X in C' can read the name and let
    /// the NEXT token decide which kind of loop it is -- the two forms agree
    /// exactly that far and nowhere after it.  An overload rather than a flag.
    ///
    function VarDeclaration (Name : Token) : Stmt;
    var 
       Initializer : Expr;

    begin
        var TypeName := '';
        var Generic  := '';

        if Match (TOKEN_COLON) then
        begin
            TypeName := CanonicalType (Consume (TOKEN_IDENTIFIER, 'Expect type name.').Lexeme);

            // ⚠️ 'of' is honoured only after 'List'.  It is
            // a keyword already -- 'case X of' -- so anywhere else it has to
            // keep meaning what it meant, and a Map or a Set does not take one.
            if IsCollectionType (TypeName) and Match (TOKEN_OF) then
                Generic := Str (Consume (TOKEN_IDENTIFIER, 'Expect generic type.').Lexeme);
        end

        if Match (TOKEN_ASSIGN) then
        begin
            Initializer := Expression();
        end 

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after variable declaration.');

        var TheVar := VarStmt (Name, Initializer);
        TheVar.TypeName := TypeName;
        TheVar.Generic  := Generic;

        Exit TheVar;
    end

    /// Parses an expression statement
    ///
    /// # Errors
    /// 
    /// Raises an error if no semicolon after expression.
    ///
    function ExpressionStatement () : Stmt;
    var
       TheExpr : Expr;
    
    begin
        TheExpr := Expression();
        Consume(TOKEN_SEMICOLON, 'Expect '';'' after expression.');

        Exit ExpressionStmt (TheExpr);
    end

    // Parse a function statement.
    //
    // # Errors
    //
    // Raises an error if no function name.
    // Raises an error if no parenthesis after name.
    // Raises an error if missing parameter name.
    // Raises an error if more than 255 parameters.
    // Raises an error if no closing parenthesis after parameters.
    // Raises an error if no opening brace before body.
    // 
    function ParseFunction (Kind : String) : Stmt;
    var
        Name   : Token;
        Params : List of Token;
        Body   : List of Stmt;

    begin
        Name := Consume (TOKEN_IDENTIFIER, 'Expect ' + Kind + ' name.');
        Consume (TOKEN_LEFT_PAREN, 'Expect ''('' after ' + Kind + ' name.');
        Params := List();
        var ParamTypes := List();
        var ParamGenerics := List();

        if Not Check (TOKEN_RIGHT_PAREN) then
        begin
            Params.Add (Consume (TOKEN_IDENTIFIER, 'Expect parameter name.'));
            ParamTypes.Add (ParameterType ());
            ParamGenerics.Add (LastGeneric);

            while Match (TOKEN_COMMA) do
            begin
                if Params.Length >= 255 then
                begin
                    raise 'Can''t have more than 255 parameters.';
                    //Error (Peek(), 'Can''t have more than 255 parameters.');
                end
                Params.Add (Consume (TOKEN_IDENTIFIER, 'Expect parameter name.'));
                ParamTypes.Add (ParameterType ());
                ParamGenerics.Add (LastGeneric);
            end
        end
        Consume (TOKEN_RIGHT_PAREN, 'Expect '')'' after parameters.');

        var ReturnType := '';
        var ReturnGeneric := '';
        if Match (TOKEN_COLON) then
            ReturnType := CanonicalType (Consume (TOKEN_IDENTIFIER, 'Expect return type.').Lexeme);

            // ⚠️ A return type is a Type too, so it carries an element type --
            // 'function Make () : List of Integer' [TYP-002].
            if IsCollectionType (ReturnType) and Match (TOKEN_OF) then
                ReturnGeneric := Str (Consume (TOKEN_IDENTIFIER, 'Expect generic type.').Lexeme);

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after ' + Kind + ' signature.');

        // ⚠️ Locals are read BEFORE 'begin' and prepended to the body, so they
        // are ordinary statements at the top of the block.  Nothing downstream
        // needs to know a var section existed.
        Body := List();
        ReadDeclarationSections (Body);

        Consume (TOKEN_BEGIN, 'Expect ''begin'' before ' + Kind + ' body.');

        // ⚠️ Saved and restored, not merely set: a function declared inside a
        // procedure may exit a value, and the enclosing procedure still may not
        // once its own body resumes.
        var WasInProcedure := InProcedure;
        InProcedure := Kind = 'procedure';

        var Rest := Block ();

        InProcedure := WasInProcedure;

        for var I := 0; I < Rest.Length; I := I + 1 do
            Body.Add (Rest[I]);

        var TheFunction := FunctionStmt (Name, Params, Body);
        TheFunction.ReturnType := ReturnType;
        TheFunction.ReturnGeneric := ReturnGeneric;
        TheFunction.ParamTypes := ParamTypes;
        TheFunction.ParamGenerics := ParamGenerics;

        Exit TheFunction;
    end
    
    // An optional ': Type' after a parameter name, or '' when none was written.
    //
    // ⚠️ A parameter takes the SAME Type as a declaration does [TYP-002],
    // element type and all.  It did not, and 'Items : List of Integer' was
    // 'Expect '')'' after parameters.' -- a form the grammar in Annex A has
    // always described, refused by the parser alone.
    //
    // ⚠️ The element type is left in LastGeneric rather than returned, because
    // this answers the TYPE and the caller wants both.  One out-parameter for
    // one call site beats a second function that re-parses.
    //
    function ParameterType () : String;
    begin
        LastGeneric := '';

        if not Match (TOKEN_COLON) then Exit '';

        var TypeName := CanonicalType (Consume (TOKEN_IDENTIFIER, 'Expect type name.').Lexeme);

        if IsCollectionType (TypeName) and Match (TOKEN_OF) then
            LastGeneric := Str (Consume (TOKEN_IDENTIFIER, 'Expect generic type.').Lexeme);

        Exit TypeName;
    end

    // Parses a block of statements.
    //
    // Raises an error if no semicolon after block.
    // 
    function Block () : List;
    var
       Statements : List of Statement;

    begin
        Statements := List();

        // 'and Not IsAtEnd()', or an unterminated block runs off the end of the
        // input and reports whatever the next statement rule fails on -- 'Expect
        // expression!' -- instead of the missing 'end'.
        while Not Check (TOKEN_END) and Not IsAtEnd () do
        begin
            Statements.Add (Declaration ());
        end 
        
        Consume (TOKEN_END, 'Expect ''end'' after block.');
        Exit Statements;
    end

    // Parses an assignment.
    //
    // # Errors
    //
    // Raises an error if invalid assignment target.
    //
    function Assignment () : Expr;
    var
       TheExpr : Expr;
       Equals  : Token;
       Value   : Expr;
    
    begin
        TheExpr := ParseOr ();

        if Match (TOKEN_ASSIGN) then
        begin
            Equals := Previous ();
            Value  := Assignment ();

            if TheExpr.ClassName = 'VariableExpr' then
                Exit AssignExpr (TheExpr.Name, Value);
            else if TheExpr.ClassName = 'GetExpr' then
                Exit SetExpr (TheExpr.Obj, TheExpr.Name, Value);
            else if TheExpr.ClassName = 'SubscriptExpr' then
                Exit SetSubscriptExpr (TheExpr.Obj, TheExpr.Index, Value, TheExpr.Bracket);

            raise 'Invalid assignment target.';
        end
        Exit TheExpr;
    end

    // Parses an or expression.
    //
    function ParseOr () : Expr;
    var
       TheExpr : Expr;
       Op      : Token;
       Right   : Expr;

    begin
        TheExpr := ParseAnd ();

        while Match (TOKEN_OR) do
        begin
            Op := Previous ();
            Right := ParseAnd ();
            TheExpr := LogicalExpr (TheExpr, Op, Right);
        end
       
        Exit TheExpr;
    end

     // Parses an and expression.
    //
    function ParseAnd () : Expr;
    var
       TheExpr : Expr;
       Op      : Token;
       Right   : Expr;

    begin
        TheExpr := Equality ();

        while Match (TOKEN_AND) do
        begin
            Op := Previous ();
            Right := Equality ();
            TheExpr := LogicalExpr (TheExpr, Op, Right);
        end
       
        Exit TheExpr;
    end   

    // Parses an expression.  Calls Equality.
    /// Parses an expression, and the optional cast that may follow it.
    ///
    /// ⚠️ The cast is read HERE, above assignment and therefore above 'and'
    /// and 'or' -- so 'A and B as C' casts the whole conjunction, not B.  That
    /// is the shape, and the reason 'is' could not be put beside it: 'as'
    /// consumes nothing after itself, so it cannot be followed by an operator,
    /// while 'A is Dog and B is Cat' has to parse.
    ///
    function Expression() : Expr;
    var
        TheExpr : Expr;

    begin
        TheExpr := Assignment ();

        Exit TheExpr;
    end

    
    // Parses a declaration.
    //
    function Declaration();
    begin
        //try 
            if IsTestBlock () then Exit TestDeclaration ();

            Exit Statement ();
        //except
        //    on e : String do 
        //        begin
        //           Synchronize ();
        //        end
        //end
    end

    // Parses an enum declaration: type Colour = (Red, Green, Blue);
    //
    // # Errors
    //
    // Raises an error if no enum name, no '=', no '(' , no member name, or no
    // closing parenthesis or semicolon.
    //
    // Is the parser looking at a test block?
    //
    // 'test' is CONTEXT-SENSITIVE, not a keyword: an identifier spelled 'test'
    // followed by a string.  Making it a real keyword would stop anything else
    // being called 'test', and the Lox sources in this file's own tests use it
    // as a variable name constantly.
    //
    function IsTestBlock () : Boolean;
    begin
        if not Check (TOKEN_IDENTIFIER) then Exit False;
        if Peek().Lexeme <> 'test' then Exit False;

        // ⚠️ Either quoted form.  A one-character name is a Char and not a
        // String [LEX-023], so 'test ''X'';' used to be an identifier followed
        // by a Char and failed with 'Expect '';'' after expression.' -- a
        // diagnostic naming neither tests nor names [TST-001].
        Exit PeekNext().TypeOfToken = TOKEN_STRING
          or PeekNext().TypeOfToken = TOKEN_CHAR;
    end

    // Parses a test block:
    //
    //     test 'Some Name';
    //     begin
    //         ...
    //     end
    //
    // It desugars into a FunctionStmt whose NAME TOKEN IS THE STRING LITERAL,
    // which is also how the runner tells a test from a function: a test's name
    // token carries a literal and an identifier's does not.
    //
    function TestDeclaration () : Stmt;
    var
        Name : Token;
        Body : List;

    begin
        Advance ();

        if Check (TOKEN_CHAR) then Name := Advance();
        else Name := Consume (TOKEN_STRING, 'Expect a test name.');
        Consume (TOKEN_SEMICOLON, 'Expect '';'' after test name.');
        Consume (TOKEN_BEGIN, 'Expect ''begin'' before test body.');

        Body := Block ();
        Exit FunctionStmt (Name, List(), Body);
    end

    /// 'type X = ...' declares an enumeration or a subrange, and which is
    /// decided by the character after the '='.
    ///
    function EnumDeclaration () : Stmt;
    var
        Name    : Token;
        Members : List;

    begin
        Name := Consume (TOKEN_IDENTIFIER, 'Expect enum name.');
        Consume (TOKEN_EQUAL, 'Expect ''='' after enum declaration.');

        if not Check (TOKEN_LEFT_PAREN) then Exit SubrangeDeclaration (Name);

        Consume (TOKEN_LEFT_PAREN, 'Expect ''('' before enum members.');

        Members := List();
        Members.Add (Consume (TOKEN_IDENTIFIER, 'Expect member name.'));

        while Match (TOKEN_COMMA) do
            Members.Add (Consume (TOKEN_IDENTIFIER, 'Expect member name.'));

        Consume (TOKEN_RIGHT_PAREN, 'Expect '')'' after enum members.');
        Consume (TOKEN_SEMICOLON, 'Expect '';'' after enum declaration.');

        Exit EnumStmt (Name, Members);
    end

    /// 'type Digit = 0 .. 9;' -- a subrange of Integer [TYP-016].
    ///
    /// ⚠️ The bounds are LITERALS, optionally signed, rather than expressions.
    /// A subrange is hoisted like a class and an enum, so its bounds must be
    /// known before anything runs -- and an expression would have to be
    /// evaluated, which needs the declaration to have run already.
    ///
    function SubrangeDeclaration (Name : Token) : Stmt;
    var
        Low  : Integer;
        High : Integer;

    begin
        Low := SubrangeBound ();
        Consume (TOKEN_DOT_DOT, 'Expect ''..'' between subrange bounds.');
        High := SubrangeBound ();

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after subrange declaration.');

        // ⚠️ Refused where it is READ.  An empty subrange admits no value at
        // all, so every assignment through it would fail and the declaration
        // is the only place that can say why.
        if Low > High then
            Error (Name, 'A subrange must not be empty: ' + Str (Low)
                       + ' is above ' + Str (High) + '.');

        Exit SubrangeStmt (Name, Low, High);
    end

    /// One bound: an integer literal, optionally preceded by '-'.
    ///
    /// ⚠️ There is no negative literal [LEX-019], so the sign is read here
    /// rather than being part of the number -- the same rule the rest of the
    /// language follows, applied where an expression cannot be.
    ///
    function SubrangeBound () : Integer;
    var
        Negative : Boolean;

    begin
        Negative := Match (TOKEN_MINUS);

        var Bound := Consume (TOKEN_INTEGER, 'Expect an integer bound.');

        if Negative then Exit 0 - (Bound.Literal as Integer);

        Exit Bound.Literal as Integer;
    end

    function ClassDeclaration ();
    begin
        Exit ClassDeclaration ('class');
    end

    /// Parses a class or an object.
    ///
    /// ⚠️ ONE rule for both, differing only in the noun in its messages and in
    /// which node it builds at the end.  An object is a class in every respect
    /// but what its name evaluates to, and two copies of this would be two
    /// places for a class feature to be added and an object feature to be
    /// forgotten.
    ///
    function ClassDeclaration (Kind : String);
    var
        Name       : Token;
        Methods    : List;
        Fields     : List;
        Superclass : VariableExpr;

    begin
        Name := Consume (TOKEN_IDENTIFIER, 'Expect ' + Kind + ' name.');
        Superclass := Nil as VariableExpr;

        // A superclass is named in parentheses -- 'class Dog(Animal);' -- where
        // Lox wrote 'class Dog < Animal'.
        if Match (TOKEN_LEFT_PAREN) then
        begin
           Consume (TOKEN_IDENTIFIER, 'Expect superclass name.');
           Superclass := VariableExpr (Previous ());
           Consume (TOKEN_RIGHT_PAREN, 'Expect '')'' after superclass name.');
        end

        Consume (TOKEN_SEMICOLON, 'Expect '';'' after ' + Kind + ' declaration.');

        // ⚠️ The header and the body are separate blocks: a marker runs to the
        // next one WITHIN the block it is in, so the body starts public again
        // however the header ended.
        ClassPrivates := List();
        InPrivateSection := False;

        // The declaration sections standing before the body, with visibility
        // markers allowed between them.
        //
        // ⚠️ A comma group is FLATTENED here into one field per name, unlike
        // in a function body where it stays together.  A field's initializer
        // runs once per instance in SeedFields anyway, so there is no shared
        // evaluation to preserve -- and every later stage, from MapType to the
        // instance's slot list, wants one entry per field.
        Fields := List();
        var Section := List();
        ReadDeclarationSections (Section, True);

        for var I := 0; I < Section.Length; I := I + 1 do
        begin
            var Each := Section[I];

            if Each is VarGroupStmt then
            begin
                for var J := 0; J < Each.Names.Length; J := J + 1 do
                begin
                    var Field := VarStmt (Each.Names[J], Each.Initializer);
                    Field.TypeName := Each.TypeName;
                    Field.Generic := Each.Generic;

                    Fields.Add (Field);
                end
            end
            else Fields.Add (Each);
        end

        Consume (TOKEN_BEGIN, 'Expect ''begin'' before ' + Kind + ' body.');

        // ⚠️ The header and the body are separate blocks, so a marker's reach
        // stops here: the body starts public again however the header ended.
        InPrivateSection := False;

        // Every member carries its own keyword, unlike Lox where a method is a
        // bare name.  A constructor is spelled 'constructor', not named 'init'.
        Methods := List();
        while Not Check (TOKEN_END) and Not IsAtEnd () do
        begin
            while MatchVisibility () do
            begin
            end

            if Check (TOKEN_END) or IsAtEnd () then break;

            // Stmt, not FunctionStmt: ParseFunction is declared to return
            // the base, and the checker holds it to that.
            var Method : Stmt;

            if Match (TOKEN_CONSTRUCTOR) then
                Method := ParseFunction ('constructor');
            else if Match (TOKEN_PROCEDURE) then
                Method := ParseFunction ('procedure');
            else
            begin
                Consume (TOKEN_FUNCTION,
                    'Expect ''function'', ''procedure'' or ''constructor'' in class body.');
                Method := ParseFunction ('method');
            end

            if InPrivateSection then ClassPrivates.Add (Str (Method.Name.Lexeme));

            Methods.Add (Method);
        end

        Consume (TOKEN_END, 'Expect ''end'' after ' + Kind + ' body.');

        if Kind = 'object' then
        begin
            var TheObject := ObjectStmt (Name, Superclass, Methods, Fields);
            TheObject.PrivateMembers := ClassPrivates;

            Exit TheObject;
        end

        var TheClass := ClassStmt (Name, Superclass, Methods, Fields);
        TheClass.PrivateMembers := ClassPrivates;

        Exit TheClass;
    end

    // Parses an equality (!= ==).  Calls Comparison if no match.
    //
    function Equality() : Expr;
    var 
       TheExpr  : Expr;
       Operator : Token;
       Right    : Expr;
       
    begin
       TheExpr := Comparison();

       while Match (TOKEN_NOT_EQUAL) or Match (TOKEN_EQUAL) do
       begin
           Operator := Previous();
           Right := Comparison();

           TheExpr := BinaryExpr(TheExpr, Operator, Right); 
       end

       Exit TheExpr;
    end

    // Parses a comparison (> >= < <=).  Calls Term if no match.
    //
    function Comparison() : Expr;
    var
        TheExpr : Expr;
        Operator : Token;
        Right : Expr;

    begin
        TheExpr := Term();

        // 'is' sits with the relational operators, so 'A is Dog and B is Cat'
        // parses -- binding it tighter than 'and' is the whole point of putting
        // it here rather than beside the unary operators.
        while True do
        begin
            if Match (TOKEN_IS) then
            begin
                TheExpr := IsExpr (TheExpr,
                    Consume (TOKEN_IDENTIFIER, 'Expect type name after ''is''.'));
            end
            // 'in' sits with the relational operators, as it does in Pascal.
            else if Match (TOKEN_GREATER) or Match (TOKEN_GREATER_EQUAL) or
                    Match (TOKEN_LESS)    or Match (TOKEN_LESS_EQUAL) or
                    Match (TOKEN_IN) then
            begin
                Operator := Previous();
                Right := Term();
                TheExpr := BinaryExpr(TheExpr, Operator, Right);
            end
            else Exit TheExpr;
        end
        Exit TheExpr;
    end

    // Parses a term (- +).  Calls Factor if no match.
    //
    function Term() : Expr;
    var
        TheExpr : Expr;
        Operator : Token;
        Right : Expr;

    begin
        TheExpr := Factor();
       
        // ⚠️ Factor(), not Term().  Recursing into Term made '-' and '+'
        // RIGHT-associative: 'a - b - c' parsed as 'a - (b - c)', so
        // '2 - 1 - 1' was 2 rather than 0.  The accumulator loop is what makes
        // it left-associative, and it only works if the right operand is one
        // rung down.
        while Match (TOKEN_MINUS) or Match (TOKEN_PLUS) do
        begin
            Operator := Previous();
            Right := Factor();
            TheExpr := BinaryExpr(TheExpr, Operator, Right);
        end
        Exit TheExpr;
    end

    // Parses a term expression (/ *).  Calls Unary if no match.
    //
    function Factor() : Expr;
    var
        TheExpr  : Expr;
        Operator : Token;
        Right    : Expr;

    begin
        TheExpr := Unary();
        // ⚠️ Accumulate and keep going -- this used to Exit on the first
        // operator, so '20 / 2 / 5' consumed '20 / 2' and left '/ 5' behind,
        // which the caller reported as a missing ';'.  Repeated '*' or '/' did
        // not parse at all.
        // ⚠️ 'div' binds as '*' and '/' do.  It is a different OPERATION,
        // not a different precedence: 'A + B div C' groups the way
        // 'A + B / C' does, which is the only grouping a reader expects.
        while Match(TOKEN_SLASH) or Match(TOKEN_STAR) or Match(TOKEN_DIV) do
        begin
            Operator := Previous();
            Right := Unary();

            TheExpr := BinaryExpr(TheExpr, Operator, Right);
        end
        Exit TheExpr;
    end

    // Parses an unary expression (! -).  Calls Primary if no match.
    //
    /// ⚠️ 'as' binds HERE, at the unary level, and applies to the operand
    /// beside it and nothing further: 'A and B as C' is 'A and (B as C)', and
    /// 'A as Integer > 3' is '(A as Integer) > 3' [EXP-003].
    ///
    /// It used to bind below 'or', in Expression, which had two consequences.
    /// 'A and B as C' cast the whole conjunction -- an oddity while a cast had
    /// no runtime effect, and a live fault once it raises [VAL-007].  And
    /// 'A as Integer > 3' did not parse AT ALL: the cast consumed the
    /// expression and the comparison had nothing to attach to, giving
    /// 'Expect '')'' after arguments.'
    ///
    function Unary() : Expr;
    var
       Operator : Token;
       Right    : Expr;
       TheExpr  : Expr;

    begin
        if Match (TOKEN_NOT) or Match (TOKEN_MINUS) then
        begin
            Operator := Previous();
            Right    := Unary();

            Exit UnaryExpr(Operator, Right);
        end

        TheExpr := Call();

        // ⚠️ A field on the expression rather than a node of its own, which is
        // what lets Evaluate check every cast in one place.
        if Match (TOKEN_AS) then
            TheExpr.Cast := CanonicalType (Consume (TOKEN_IDENTIFIER,
                'Expect typecast identifier.').Lexeme);

        Exit TheExpr;
    end

    // Parses a List or Map literal, the opening bracket already consumed.
    //
    // '[:]' is the empty Map and '[]' the empty List -- without the colon there
    // would be no way to tell them apart.  Otherwise a colon after the first
    // element is what decides, and every element after it must have one too.
    //
    function CollectionLiteral () : Expr;
    var
        Keys   : List;
        Values : List;
        IsMap  : Boolean;

    begin
        Keys := List();
        Values := List();
        IsMap := False;

        if Match (TOKEN_COLON) then
        begin
            IsMap := True;
            Consume (TOKEN_RIGHT_BRACKET, 'Expect '']'' after map.');

            Exit CollectionExpr (True, Keys, Values);
        end

        if Match (TOKEN_RIGHT_BRACKET) then Exit CollectionExpr (False, Keys, Values);

        var First := Expression ();
        if Match (TOKEN_COLON) then
        begin
            IsMap := True;
            Keys.Add (First);
            Values.Add (Expression ());
        end
        else Values.Add (First);

        while Match (TOKEN_COMMA) do
        begin
            if IsMap then
            begin
                Keys.Add (Expression ());
                Consume (TOKEN_COLON, 'Expect '':'' after key.');
                Values.Add (Expression ());
            end
            else Values.Add (Expression ());
        end

        Consume (TOKEN_RIGHT_BRACKET, 'Expect '']'' after list.');
        Exit CollectionExpr (IsMap, Keys, Values);
    end

    // Parses a call expression.
    //
    function Call () : Expr;
    var
       TheExpr : Expr;
       Name    : Token;

    begin
        TheExpr := Primary();
      
        while True do
        begin
            if Match (TOKEN_LEFT_PAREN) then
                TheExpr := FinishCall (TheExpr);
            else if Match (TOKEN_LEFT_BRACKET) then
                begin
                    var Bracket := Previous ();
                    var Index   := Expression ();

                    Consume (TOKEN_RIGHT_BRACKET, 'Expect '']'' after subscript.');
                    TheExpr := SubscriptExpr (TheExpr, Index, Bracket);
                end
            else if Match (TOKEN_DOT) then
                begin
                    Name := Consume (TOKEN_IDENTIFIER, 'Expect property name after ''.''.');
                    TheExpr := GetExpr (TheExpr, Name);
                end
            else  
                Break;
        end
        Exit TheExpr;
    end

    // Finishes parsing a call.
    //
    // # Errors
    //
    // Raises an error if more than 255 arguments.
    // Raises an error if no closing parenthesis after arguments.
    //
    function FinishCall (Callee : Expr) : Expr;
    var
        Arguments : List of Expr;
        Names     : List of String;
        Paren     : Token;

    begin
        Arguments := List();
        Names     := List();

        if Not Check (TOKEN_RIGHT_PAREN) then
        begin
            Argument (Arguments, Names);
            while Match (TOKEN_COMMA) do
            begin
                if Arguments.Length >= 255 then
                    //Error (Peek(), 'Can''t have more than 255 arguments.');
                    raise 'Can''t have more than 255 arguments.';

                Argument (Arguments, Names);
            end
        end
        Paren := Consume(TOKEN_RIGHT_PAREN, 'Expect '')'' after arguments.');

        var TheCall := CallExpr (Callee, Paren, Arguments);
        TheCall.ArgumentNames := Names;

        Exit TheCall;
    end

    // One argument, positional or naming the parameter it fills [EXP-013].
    //
    // ⚠️ IDENTIFIER then COLON, one token of lookahead -- the same shape the
    // Map literal uses to tell '[k : v]' from '[v]' [COL-001], and the same
    // meaning: a name on the left, a value on the right.  It is decided BEFORE
    // parsing rather than after, because a parameter name is not an expression.
    //
    // ⚠️ The colon collides with nothing.  A ':' in expression position would
    // normally meet a conditional expression's '? :', and this language has no
    // conditional expression because '?' is an identifier mark [LEX-008] and
    // 'Gate?' is one word.  The ':' in 'case ... of' is a statement's.
    //
    procedure Argument (Arguments : List, Names : List);
    begin
        if Check (TOKEN_IDENTIFIER) and PeekNext().TypeOfToken = TOKEN_COLON then
        begin
            var TheName := Str (Advance().Lexeme);
            Advance ();

            Names.Add (TheName);
            Arguments.Add (Expression ());

            Exit;
        end

        // ⚠️ Positional arguments come FIRST and named ones after -- Python's
        // rule.  It is also what spares absorption a rule of its own [FUN-005]:
        // gathering takes trailing POSITIONAL arguments, and positional
        // arguments end exactly where naming begins.
        //
        // ⚠️ The LAST entry is what decides, not whether Names is empty: it
        // holds '' for every positional argument too, so a length test would
        // refuse the second positional argument of every call.  Checking the
        // last one is enough, because this check is what keeps the named
        // arguments contiguous at the end.
        if Names.Length > 0 and Str (Names[Names.Length - 1]) <> '' then
            raise 'A positional argument cannot follow a named one.';

        Names.Add ('');
        Arguments.Add (Expression ());
    end

    // Parses a primary expression:  True, False, Nil, Number, String or Grouping.
    //
    // # Errors
    // 
    // Raises an error if grouping has no closing parenthesis.
    // Raises an error if no dot after ''super''.
    // Raises an error if no superclass method name.
    // Raises an error if no expression matched.
    //
    function Primary() : Expr;
    var 
        TheExpr : Expr;
        Keyword : Token;
        Method  : Token;

    begin
        if Match (TOKEN_FALSE) then Exit LiteralExpr(False);
        if Match (TOKEN_TRUE) then Exit LiteralExpr(True);
        if Match (TOKEN_NIL) then Exit LiteralExpr(nil);

        if Match (TOKEN_LEFT_BRACKET) then Exit CollectionLiteral ();

        if Match (TOKEN_INTEGER) or Match (TOKEN_NUMBER)
        or Match (TOKEN_STRING)  or Match (TOKEN_CHAR) then
        begin
            Exit LiteralExpr (Previous().Literal);
        end

        if Match (TOKEN_SUPER) then
        begin
           Keyword := Previous();
           Consume (TOKEN_DOT, 'Expect ''.'' after ''super''.');  
           Method := Consume (TOKEN_IDENTIFIER, 'Expect superclass method name.');
           Exit SuperExpr (Keyword, Method);  
        end

        if Match (TOKEN_THIS) then Exit ThisExpr (Previous());

        if Match (TOKEN_IDENTIFIER) then
        begin
           Exit VariableExpr (Previous());
        end

        if Match (TOKEN_LEFT_PAREN) then
        begin
            TheExpr := Expression();
            Consume (TOKEN_RIGHT_PAREN, 'Expect '')'' after expression.');
        
            Exit GroupingExpr (TheExpr);
        end
        raise 'Expect expression!';
    end

    // If token type matches, advances and returns True, otherwise False.
    //
    function Match(TheType : TokenType) : Boolean;
    begin
        if Check (TheType) then
        begin
            Advance();
            Exit True;
        end
        Exit False;
    end

    // Returns an error.
    //
    // Reports a parse error and returns the message to raise.
    //
    // ⚠️ Reporting and raising are SEPARATE: this prints the position and the
    // caret, and the caller raises the message so the parse unwinds.  Doing
    // only one of them is how a run ends with no output at all, which has
    // happened more than once.
    //
    // The message alone is returned, without position, because algc's own
    // tests assert on it and a raised value is all a handler sees.  The
    // position reaches the reader through Console, not through the string.
    //
    function Error(TheToken: Token, Message : String) : Any;
    begin
        Console.Error (TheToken, Message);

        Exit Message;
    end

    // If current token matches a type then advance, otherwise throw an error.
    //
    // # Errors
    //
    // Raises an error if token not matched.
    //
    function Consume (TypeOfToken : TokenType, Message : String) : Token;
    begin
        if Check (TypeOfToken) then Exit Advance();

        // Previous(), not Peek(): the error belongs on the token before the
        // missing one -- 'var A := 1' with no ';' points at the 1, not at
        // whatever begins the next line.
        raise Error (Previous(), Message);
    end

    // Checks if current token matches a type.
    //
    function Check(TheType : TokenType) : Boolean;
    begin
       if IsAtEnd() then Exit False;
       
       Exit Peek().TypeOfToken = TheType;
    end

    /// Whether the next token is a particular identifier.
    ///
    /// 'on' is context-sensitive rather than a keyword, exactly as 'test' is,
    /// so a program may still call a variable 'on'.  Matched without regard to
    /// case, as the real keywords are.
    ///
    function CheckWord (Word : String) : Boolean;
    begin
        if Not Check (TOKEN_IDENTIFIER) then Exit False;

        Exit ToLower (Str (Peek().Lexeme)) = Word;
    end

    // Returns the current token, and moves to next.
    //
    function Advance() : Token;
    begin
       if Not IsAtEnd() then Current := Current + 1;

       Exit Previous();
    end

    // Is at end of source?
    //
    function IsAtEnd() : Boolean;
    begin
       Exit Peek().TypeOfToken = EOF;
    end

    // Gets the current token.
    //
    function Peek() : Token;
    begin
       Exit Tokens[Current];
    end

    // Gets the previous token.
    //
    // The token after the current one, for the two-token lookahead a test block
    // needs.  Clamped at the end rather than running off it.
    //
    function PeekNext() : Token;
    begin
       if Current + 1 >= Tokens.Length then Exit Tokens[Tokens.Length - 1];

       Exit Tokens[Current + 1];
    end

    function Previous() : Token;
    begin
       Exit Tokens[Current - 1];
    end
end

// Parsing a false token should return a false literal.
//
test 'Parse False';
begin
    var TheScanner := Scanner ('false');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Primary();

    AssertEqual(False, Result.Value);
end

// Parsing a true token should return a true literal.
//
test 'Parse True';
begin
    var TheScanner := Scanner ('true');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Primary();

    AssertEqual(True, Result.Value);
end

// Parsing a nil token should return a literal of nil.
//
test 'Parse Nil';
begin
    var TheScanner:= Scanner ('nil');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Primary();

    AssertEqual(Nil, Result.Value);
end


// Parsing a number token should return a number literal
//
test 'Parse Number';
begin
    var TheScanner:= Scanner ('3.14');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Primary();

    AssertEqual(3.14, Result.Value);
end

// Parsing a string token should return a String literal.
//
test 'Parse String';
begin
    var TheScanner:= Scanner ('''ABC''');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Primary();

    AssertEqual('ABC', Result.Value);
end

// Parsing a token of paranthesis should return a Grouping expression.
//
test 'Parse Parenthesis';
begin
    var TheScanner:= Scanner ('(1)');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Primary();

    AssertEqual(1.0, Result.Expression.Value);
end

// When parsing parenthesis, primary should return an error when there is an unmatched closing parenthesis.
// 
test 'Parse Parenthesis Error';
begin
    var TheScanner:= Scanner ('(1');
    var TheParser := Parser (TheScanner.ScanTokens());

    try 
       TheParser.Primary();
    except
        on e : String do 
            begin 
               AssertEqual ('Expect '')'' after expression.', e);
               Exit;
            end
    end       
    Fail('No error raised');
end

// Should fail if reaches the end and a valid primary expression is not matched.
// 
test 'Parse Primary Error';
begin
    var TheScanner:= Scanner ('-1');
    var TheParser := Parser (TheScanner.ScanTokens());

    try 
       TheParser.Primary();
    except
        on e : String do 
            begin 
                AssertEqual ('Expect expression!', e);
                Exit;
            end
    end       
    Fail('No error raised');
end

// Negative numbers should return a unary with token type of Minus.
//
test 'Parse Unary Minus';
begin
    var TheScanner := Scanner ('-1');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Unary();

    AssertEqual(TOKEN_MINUS, Result.Op.TypeOfToken);
    AssertEqual(1.0, Result.Right.Value);
end

// Parsing ! should return a Unary
//
test 'Parse Unary Bang';
begin
    var TheScanner := Scanner ('not true');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Unary();

    AssertEqual(TOKEN_NOT, Result.Op.TypeOfToken);
    AssertEqual(True, Result.Right.Value);
end

// Parsing != should return a Binary expression.
//
test 'Parse Comparison Bang Equal';
begin
    var TheScanner := Scanner ('1 <> 2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Equality();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_NOT_EQUAL, Result.Op.TypeOfToken);
end

// Parsing == should return a Binary expression.
//
test 'Parse Comparison Equal Equal';
begin
    var TheScanner := Scanner ('1 = 2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Equality();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_EQUAL, Result.Op.TypeOfToken);
end

    
// Parsing / should return a Binary.
//
test 'Parse Factor Slash';
begin
    var TheScanner := Scanner ('1/2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Factor();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_SLASH, Result.Op.TypeOfToken);
end

// Parsing * should return a Binary.
//
test 'Parse Factor Star';
begin
    var TheScanner := Scanner ('1*2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Factor();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_STAR, Result.Op.TypeOfToken);
end

// Parsing + should return a Binary.
//
test 'Parse Term Plus';
begin
    var TheScanner := Scanner ('1+2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Term();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_PLUS, Result.Op.TypeOfToken);
end

// Parsing - should return a Binary.
//
test 'Parse Term Minus';
begin
    var TheScanner := Scanner ('1-2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Term();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_MINUS, Result.Op.TypeOfToken);
end

// Parsing > should return a Binary.
//
test 'Parse Comparison Greater';
begin
    var TheScanner := Scanner ('1 > 2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Comparison();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_GREATER, Result.Op.TypeOfToken);
end

// Parsing >= should return a Binary.
//
test 'Parse Comparison Greater Equal';
begin
    var TheScanner := Scanner ('1 >= 2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Comparison();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_GREATER_EQUAL, Result.Op.TypeOfToken);
end

// Parsing < should return a Binary.
//
test 'Parse Comparison Less';
begin
    var TheScanner := Scanner ('1 < 2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Comparison();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_LESS, Result.Op.TypeOfToken);
end

// Parsing <= should return a Binary.
//
test 'Parse Comparison Less Equal';
begin
    var TheScanner := Scanner ('1 <= 2');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Comparison();

    AssertEqual(1.0, Result.Left.Value);
    AssertEqual(2.0, Result.Right.Value);
    AssertEqual(TOKEN_LESS_EQUAL, Result.Op.TypeOfToken);
end

// ⚠️ 'print' is an ORDINARY NAME, and these two tests replace a pair that
// asserted it was a statement.  It was a thirty-eighth keyword with a statement
// of its own, and neither is part of this language: 'var print := 7;' was
// refused with 'Expect variable name.' [LEX-010, STM-022].
//
test 'Parse Print Is An Ordinary Name';
begin
    var TheScanner := Scanner ('var print := 7;');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertEqual('VarStmt', Result.ClassName);
    AssertEqual('print', Result.Name.Lexeme);
end

// And usable as one, not merely declarable.
//
test 'Parse Print Is Callable As A Name';
begin
    var TheScanner := Scanner ('print (123);');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertEqual('ExpressionStmt', Result.ClassName);
    AssertEqual('CallExpr', Result.Expression.ClassName);
end

// Test parsing an expression statement.
//
test 'Parse Expression Statement';
begin
    var TheScanner := Scanner ('a := 1;');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertEqual('ExpressionStmt', Result.ClassName);
end

// Should not be able to assign to a rvalue.
//
test 'Parse Expression Invalid Assignment';
begin
    var TheScanner := Scanner ('1 := 1;');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
               AssertEqual('Invalid assignment target.', e);
               Exit;
            end
    end
    Fail('No exception thrown.');
end

