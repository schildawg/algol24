// Tests getters!!
//
test 'Parse Getter';
begin
    var TheScanner := Scanner ('egg.scramble(3).with(cheddar);');

    var TheParser := Parser (TheScanner.ScanTokens());
    TheParser.Statement();
end

// Tests setters!!
//
test 'Parse Setter';
begin
    var TheScanner := Scanner ('eggs.count := 42;');

    var TheParser := Parser (TheScanner.ScanTokens());
    TheParser.Statement();
end

// A try block runs to 'except', and the handlers are keyed by type.
//
test 'Parse Try With A Typed Handler';
begin
    // ⚠️ 'Er' rather than 'E': a one-character literal is a Char, Name is a
    // String, and the two are never equal however identically they print.
    var TheScanner := Scanner ('try 1; except on Er : String do 2; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertTrue (Result is TryStmt);
    AssertEqual (1, Result.Handlers.Length);
    AssertTrue (Result.Handlers.Contains ('String'));
    AssertEqual ('Er', Result.Handlers.Get ('String').Name);
end

// An untyped 'on E do' IS the catch-all, so it is keyed 'default' -- keying it
// by its absent type would make it unreachable.
//
test 'Parse Untyped Handler Is The Catch All';
begin
    var TheScanner := Scanner ('try 1; except on E do 2; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertEqual (1, Result.Handlers.Length);
    AssertTrue (Result.Handlers.Contains ('default'));
end

// Statements after the handlers are the catch-all too, alongside the typed
// ones.
//
test 'Parse Trailing Statements Are The Catch All';
begin
    var TheScanner := Scanner ('try 1; except on E : String do 2; 3; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertEqual (2, Result.Handlers.Length);
    AssertTrue (Result.Handlers.Contains ('String'));
    AssertTrue (Result.Handlers.Contains ('default'));
end

// An except block with no handlers at all is itself the catch-all, including
// when it is empty -- 'try ... except end' deliberately discards.
//
test 'Parse Empty Except Is The Catch All';
begin
    var TheScanner := Scanner ('try 1; except end');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertEqual (1, Result.Handlers.Length);
    AssertTrue (Result.Handlers.Contains ('default'));
end

// ⚠️ A repeated handler is an error rather than a silent overwrite.  The map
// would quietly keep the last one and that branch would never run.
//
test 'Parse Duplicate Typed Handler';
begin
    var TheScanner := Scanner ('try 1; except on E : String do 2; on E : String do 3; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
                AssertEqual ('Duplicate handler for ''String''.', e);
                Exit;
            end
    end
    Fail ('No exception raised.');
end

test 'Parse Duplicate Untyped Handler';
begin
    var TheScanner := Scanner ('try 1; except on E do 2; on F do 3; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
                AssertEqual ('A handler for any exception is already given.', e);
                Exit;
            end
    end
    Fail ('No exception raised.');
end

// An untyped handler and a trailing block are two spellings of the catch-all,
// so writing both is the same duplicate.
//
test 'Parse Untyped Handler Beside A Trailing Block';
begin
    var TheScanner := Scanner ('try 1; except on E do 2; 3; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
                AssertEqual ('A handler for any exception is already given by an untyped ''on''.', e);
                Exit;
            end
    end
    Fail ('No exception raised.');
end

// ⚠️ Reached only at end of input.  With anything else sitting where 'except'
// should be, the try-block loop tries to parse THAT as a statement and fails
// there instead -- 'try 1; end' reports 'Expect expression!' against the
// 'end'.
//
test 'Parse Try Expects Except';
begin
    var TheScanner := Scanner ('try 1;');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
                AssertEqual ('Expect ''except'' after try block.', e);
                Exit;
            end
    end
    Fail ('No exception raised.');
end

// 'on' is context-sensitive, not a keyword, so a program may still use it as
// an ordinary name.
//
test 'Parse On Is Not A Keyword';
begin
    var TheScanner := Scanner ('var on := 1;');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Declaration();

    AssertEqual ('on', Result.Name.Lexeme);
end

test 'Parse Raise';
begin
    var TheScanner := Scanner ('raise ''boom'';');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertTrue (Result is RaiseStmt);
    AssertEqual ('boom', Result.Value.Value);
end

test 'Parse Raise Expects Semicolon';
begin
    var TheScanner := Scanner ('raise ''boom''');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
                AssertEqual ('Expect '';'' after raised value.', e);
                Exit;
            end
    end
    Fail ('No exception raised.');
end

test 'Parse Break Inside A While';
begin
    var TheScanner := Scanner ('while True do begin break; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Statement();

    AssertTrue (Result is WhileStmt);
    AssertTrue (Result.Body.Statements[0] is BreakStmt);
end

test 'Parse Break Inside A For';
begin
    var TheScanner := Scanner ('for var I := 0; I < 3; I := I + 1 do begin break; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    // A for desugars into a block holding the initializer and a while, so the
    // break is reached through the while's body rather than directly.
    AssertTrue (TheParser.Statement() is BlockStmt);
end

// ⚠️ Rejected where it is written.  A run-time check would have to wait for
// the branch to be taken, and a break with no loop to leave is wrong however
// the program runs.
//
test 'Parse Break Outside A Loop';
begin
    var TheScanner := Scanner ('break;');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
                AssertEqual ('Must be inside a loop to use ''break''.', e);
                Exit;
            end
    end
    Fail ('No exception raised.');
end

// ⚠️ The depth has to come back DOWN.  Leaving it raised would accept a break
// written after the loop it is not in, which is the same error one line later.
//
test 'Parse Break After A Loop Has Closed';
begin
    var TheScanner := Scanner ('begin while True do begin break; end break; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
                AssertEqual ('Must be inside a loop to use ''break''.', e);
                Exit;
            end
    end
    Fail ('No exception raised.');
end

test 'Parse Break Expects Semicolon';
begin
    var TheScanner := Scanner ('while True do begin break end');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Statement();
    except
        on e : String do
            begin
                AssertEqual ('Expect '';'' after ''break''.', e);
                Exit;
            end
    end
    Fail ('No exception raised.');
end

test 'Parse A Function Local Var Section';
begin
    var TheScanner := Scanner ('function F(); var X : Integer; Y; begin Exit X; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Declaration();

    // ⚠️ Locals are PREPENDED to the body, so they are ordinary statements at
    // the top of the block and nothing downstream needs to know a section was
    // written.  Two declarations plus the Exit.
    AssertEqual (3, Result.Body.Length);
    AssertTrue (Result.Body[0] is VarStmt);
    AssertTrue (Result.Body[1] is VarStmt);
    AssertEqual ('Integer', Result.Body[0].TypeName);
    AssertEqual ('', Result.Body[1].TypeName);
end

// ⚠️ Several names stay ONE statement.  Splitting them here would run the
// initializer once per name, which is a different program.
test 'Parse A Comma Group Stays A Group';
begin
    var TheScanner := Scanner ('function F(); var A, B, C : Integer := 0; begin Exit A; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Declaration();

    AssertTrue (Result.Body[0] is VarGroupStmt);
    AssertEqual (3, Result.Body[0].Names.Length);
    AssertEqual ('Integer', Result.Body[0].TypeName);
end

test 'Parse A Single Name Is Not A Group';
begin
    var TheScanner := Scanner ('function F(); var A : Integer; begin Exit A; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    AssertTrue (TheParser.Declaration().Body[0] is VarStmt);
end

test 'Parse A Const Section';
begin
    var TheScanner := Scanner ('function F(); const N := 1; begin Exit N; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Declaration();

    AssertTrue (Result.Body[0].IsConstant);
end

test 'Parse Var And Const Sections Together';
begin
    var TheScanner := Scanner ('function F(); const N := 1; var X : Integer; begin Exit X; end');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Declaration();

    AssertEqual (3, Result.Body.Length);
    AssertTrue (Result.Body[0].IsConstant);
    AssertTrue (not Result.Body[1].IsConstant);
end

test 'Parse A Constant Must Be Given A Value';
begin
    var TheScanner := Scanner ('const N;');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Declaration();
    except
        on e : String do
            begin
                AssertEqual ('A constant must be given a value.', e);
                Exit;
            end
    end
    Fail ('No exception raised.');
end

// ⚠️ A class member must carry its keyword.  Ignoring the result of the match
// that reads it accepts a missing one by accident -- and a real typo,
// 'IsDigit(C : Char);', sat in Scanner.a24 unseen for exactly as long as that
// was so.
test 'Parse A Class Member Needs A Keyword';
begin
    var TheScanner := Scanner ('class C; begin Bare() : Integer; begin Exit 7; end end');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Declaration();
    except
        on e : String do
            begin
                AssertEqual ('Expect ''function'', ''procedure'' or ''constructor'' in class body.', e);
                Exit;
            end
    end
    Fail ('No exception raised.');
end

test 'Parse A Class Header Flattens A Comma Group';
begin
    var TheScanner := Scanner ('class P; var X, Y : Integer := 0; begin end');
    var TheParser := Parser (TheScanner.ScanTokens());

    var Result := TheParser.Declaration();

    // Flattened, unlike in a function body: one field per name.
    AssertEqual (2, Result.Fields.Length);
    AssertTrue (Result.Fields[0] is VarStmt);
    AssertEqual ('Integer', Result.Fields[1].TypeName);
end
