/// Objects at run time: an instance of a class, and the single instance an
/// 'object' declaration binds its name to.
unit ObjInstance;

uses ObjClass;
uses ObjFunction;
uses Token;

/// One object: its class, and the values of the fields that class declared.
class ObjInstance;
var
    /// The class this is an instance of.
    Klass  : ObjClass;

    /// Field values, keyed by the folded field name.
    Fields : Map;

begin
    /// Makes an instance of a class, with the fields the class declared.
    constructor Init (Klass : ObjClass);
    begin
       this.Klass := Klass;
       this.Fields := Map();
    end

    /// Gets a property: a field's value, a method bound to this receiver, or
    /// ClassName.
    ///
    /// A method read without being called answers a BOUND method [TYP-012],
    /// which is what makes a property readable without parentheses and a method
    /// passable as a value.
    ///
    /// # Raises
    ///
    /// 'Undefined property ''X''.' when the class declares no such field or
    /// method.
    ///
    /// # Satisfies
    ///
    /// [CLS-007], [CLS-008], [CLS-010], [TYP-012]
    function Get (Name : Token) : Any;
    var
        Method : ObjFunction;

    begin
        if FoldCase (Name.Lexeme) = 'classname' then Exit Klass.Name;

        if Fields.Contains (FoldCase (Name.Lexeme)) then
        begin
           Exit Fields.Get (FoldCase (Name.Lexeme));
        end

        Method := Klass.FindMethod (FoldCase (Name.Lexeme));
        if Method <> Nil then Exit Method.Bind(this);

        raise 'Undefined property ''' + Name.Lexeme + '''.';
    end

    /// Stores a value in a field the class declared.
    ///
    /// AN INSTANCE IS CLOSED: a field must be one the class declared.  This used
    /// to accept any name at all, which is Lox's arrangement -- a field appeared
    /// the moment something assigned to it.  The C back end never had it: an
    /// instance there is a fixed array of slots taken from the 'var' section, so
    /// 'B.Undeclared := 1' was accepted interpreted and refused compiled.  A
    /// divergence older than the properties that found it, and covered by no
    /// case.
    ///
    /// # Raises
    ///
    /// 'Undefined property ''X''.' when the class declares no such field.
    ///
    /// # Satisfies
    ///
    /// [CLS-018]
    procedure Set (Name : Token, Value : Any);
    begin
        if not Fields.Contains (FoldCase (Name.Lexeme)) then
            raise 'Undefined property ''' + Name.Lexeme + '''.';

        Fields.Put (FoldCase (Name.Lexeme), Value);
    end

    /// Prints the instance as its class name followed by ' instance'.
    function ToString () : String;
    begin
        Exit Klass.Name + ' instance';
    end
end

/// The single instance of an 'object' declaration.
///
/// Declaring 'object Console;' binds Console to one of these, so the NAME is the
/// instance -- 'Console.WriteLn (...)' rather than a lookup through a registry.
///
/// A subclass of ObjInstance rather than a peer, so every place asking "is this
/// an instance" keeps working.  That is why those places test with 'is' and not
/// against a class name.
class ObjSingleton (ObjInstance);
var
    /// The interpreter, needed to construct the instance on first use.
    TheInterpreter : Any;

    /// The one instance, Nil until first use.
    TheInstance : ObjInstance := Nil;

begin
    /// Makes the singleton for a class, without constructing it yet.
    constructor Init (Klass : ObjClass, TheInterpreter : Any);
    begin
        this.Klass := Klass;
        this.Fields := Map();
        this.TheInterpreter := TheInterpreter;
    end

    /// Gets the one instance, constructing it on first use.
    ///
    /// Creation is DEFERRED so an object may refer to another declared later in
    /// the file.  Every access after the first reaches the same instance, which
    /// is what makes mutation stick.
    function Instance () : ObjInstance;
    begin
        if TheInstance = Nil then
            TheInstance := Klass.Call (TheInterpreter, List()) as ObjInstance;

        Exit TheInstance;
    end

    /// Gets a property from the one instance, constructing it if needed.
    function Get (Name : Token) : Any;
    begin
        Exit Instance().Get (Name);
    end

    /// Stores a value in the one instance, constructing it if needed.
    procedure Set (Name : Token, Value : Any);
    begin
        Instance().Set (Name, Value);
    end

    /// Prints the singleton as its bare name, since the name IS the instance.
    function ToString () : String;
    begin
        Exit Klass.Name;
    end
end
