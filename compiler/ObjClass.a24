/// A class at run time: its methods, its parent, and the fields it seeds onto
/// every instance.
unit ObjClass;

uses Token;
uses ObjFunction;
uses ObjInstance;

/// A class, which is also what a program calls to construct an instance.
class ObjClass;
var
    /// The class name, as the program spelled it.
    Name       : String;

    /// Methods, keyed by folded name.  A name may hold several overloads.
    Methods    : Map;

    /// The parent, or Nil for a class that declares none.
    Superclass : ObjClass;

    /// Whether this stands for a built-in type rather than a declared class.
    ///
    /// TypeOf answers one of these for an Integer or a String, and nothing
    /// constructs it: without the guard in Call, `TypeOf (42) ()` would answer
    /// an 'Integer instance' -- a wrong answer rather than a refusal.
    IsType : Boolean := False;

    /// Declared field names, in the order written.
    ///
    /// Seeded onto every instance so a field a class declares exists before
    /// anything assigns to it -- which is what makes an instance CLOSED.
    Fields     : List;

begin
    /// Makes a class from its name, parent, methods and declared fields.
    constructor Init (Name : String, Superclass : ObjClass, Methods : Map, Fields : List);
    begin
       this.Name := Name;
       this.Methods := Methods;
       this.Superclass := Superclass;
       this.Fields := Fields;
    end

    /// Gets the method of this name taking exactly this many arguments, or Nil.
    ///
    /// How a STRUCTURAL PROTOCOL is recognized, and the reason FindMethod cannot
    /// do it: that answers the first method of a name whatever its shape.  A
    /// protocol is a name AND a shape -- 'Elements' taking none, 'Contains'
    /// taking one, 'ToString' taking none -- and a method of the right name and
    /// the wrong shape does not implement it.
    ///
    /// Asking FindMethod instead let three protocols accept a method they then
    /// could not call.  The worst was 'in': '1 in B' on a class declaring
    /// 'Contains ()' answered TRUE interpreted -- a wrong answer, not an error --
    /// while the compiled program raised.  The runtime's has_method had the same
    /// hole from the other side.
    function MethodOfArity (Name : String, TheArity : Integer) : ObjFunction;
    begin
        if Methods.Contains (Name) then
        begin
            var Found := Methods.Get (Name);

            for var Each in Found do
                if Each.Arity () = TheArity then Exit Each as ObjFunction;
        end

        if Superclass <> Nil then Exit Superclass.MethodOfArity (Name, TheArity);
    end

    /// Whether this class or one above it declares a field of this name.
    ///
    /// Asked of the CLASS rather than of an instance's map, so that a singleton
    /// -- whose instance is not built until something reads it -- can be asked
    /// the question without being built [EXP-022].  An instance is closed, so
    /// what the class declares is what it has.
    function DeclaresField (Name : String) : Boolean;
    begin
        for var Field in Fields do
            if FoldCase (Field.Name.Lexeme) = Name then Exit True;

        if Superclass <> Nil then Exit Superclass.DeclaresField (Name);

        Exit False;
    end

    /// Finds a method by name alone, searching up the inheritance chain.
    ///
    /// For property access: 'X.M' has no arguments yet, so the first of that
    /// name is handed back and the call site re-selects once it knows them.
    ///
    /// # Satisfies
    ///
    /// [CLS-004], [CLS-011]
    function FindMethod (Name : String) : ObjFunction;
    begin
        if Methods.Contains (Name) then
        begin
            var Found := Methods.Get (Name);
            if Found.Length > 0 then Exit Found[0] as ObjFunction;
        end

        if Superclass <> Nil then
        begin
            Exit Superclass.FindMethod(Name);
        end
    end

    /// Finds the overload of this name that these arguments fit.
    ///
    /// Three passes, exact before widening before absorbing, so an exact match
    /// always wins over one that would have to convert.
    ///
    /// # Satisfies
    ///
    /// [EXP-013], [EXP-014], [FUN-007]
    function FindOverload (Name : String, Arguments : List) : ObjFunction;
    begin
        for var Pass := EXACT; Pass <= ABSORBING; Pass := Pass + 1 do
        begin
            var Found := Fitting (Name, Arguments, Pass);

            if Found <> Nil then Exit Found;
        end
    end

    /// Runs one pass of overload selection, up the whole chain.
    ///
    /// A failed match must FALL THROUGH to the superclass rather than return.
    /// Returning would let a class declaring Take (String) hide an inherited
    /// Take (Integer) entirely, which overloading across a hierarchy has to
    /// allow.
    function Fitting (Name : String, Arguments : List, Pass : Integer) : ObjFunction;
    begin
        if Methods.Contains (Name) then
        begin
            var Candidates := Methods.Get (Name);

            for var Candidate in Candidates do
                if Candidate.Selects (Arguments, Pass) then
                    Exit Candidate as ObjFunction;
        end

        if Superclass <> Nil then Exit Superclass.Fitting (Name, Arguments, Pass);
    end

    /// Puts every declared field onto a new instance, parent's first.
    ///
    /// The parent runs first so a subclass redeclaring a name wins, and so an
    /// inherited field exists whether or not the subclass mentions it.  A field
    /// with an initializer is evaluated and WIDENED against its declared type
    /// here, because a declaration is one of the contexts where a value meets a
    /// written type.
    ///
    /// # Satisfies
    ///
    /// [CLS-005], [CLS-006]
    procedure SeedFields (Instance : ObjInstance, TheInterpreter : Any);
    begin
        if Superclass <> Nil then Superclass.SeedFields (Instance, TheInterpreter);

        for var I := 0; I < Fields.Length; I := I + 1 do
        begin
            var Field := Fields[I];
            var Value := Nil;

            if Field.Initializer <> Nil then
                Value := TheInterpreter.Widen (TheInterpreter.Evaluate (Field.Initializer),
                                               Str (Field.TypeName));

            Instance.Fields.Put (FoldCase (Field.Name.Lexeme), Value);
        end
    end

    /// Adds this class's declared fields to a Map, name to declared type.
    ///
    /// Parent-first, so a subclass's own fields follow what it inherited --
    /// the order SeedFields already seeds in and the order a serializer needs,
    /// since a Map iterates in insertion order [COL-007]. The name is the one
    /// written rather than the folded key an instance stores under, because it
    /// is what a program reading a class back will print.
    ///
    /// # Satisfies
    /// [COL-007]
    procedure FieldsInto (Into : Map);
    begin
        if Superclass <> Nil then Superclass.FieldsInto (Into);

        for var I := 0; I < Fields.Length; I := I + 1 do
        begin
            var Field := Fields[I];

            Into.Put (Str (Field.Name.Lexeme),
                      CanonicalType (Str (Field.TypeName)));
        end
    end

    /// How many arguments constructing an instance takes -- the initializer's
    /// arity, or zero when the class declares none.
    function Arity () : Integer;
    var
       Initializer : ObjFunction;

    begin
        Initializer := FindMethod('init');
        if Initializer = Nil then Exit 0;

        Exit Initializer.Arity() as Integer;
    end

    /// Whether construction would GATHER its trailing arguments.
    ///
    /// A constructor is a member and absorbs on the same terms a method does
    /// [FUN-005], so this has to be answerable about the CLASS: the
    /// interpreter asks it before checking the count, and a class is not an
    /// ObjFunction.  Without it a variadic constructor was the one subprogram
    /// in the language that did not gather -- `C ('a', 1, 2, 3)` where Init
    /// declares `Rest : list of Integer` reported
    /// `Expected 2 arguments but got 4.` while the same signature on a method
    /// and on a top-level function gathered.
    ///
    /// # Satisfies
    ///
    /// [FUN-005]
    function Absorbs (Arguments : List) : Boolean;
    var
       Initializer : ObjFunction;

    begin
        Initializer := FindOverload ('init', Arguments);

        if Initializer = Nil then Initializer := FindMethod ('init');
        if Initializer = Nil then Exit False;

        Exit Initializer.Absorbs (Arguments) as Boolean;
    end

    /// Whether construction GATHERS its trailing arguments into a collection.
    ///
    /// A class is not an ObjFunction, so the question has to be answerable
    /// about it: the interpreter asks before counting arguments, and a
    /// variadic callee is past that count whichever way it failed [FUN-005].
    function Variadic () : Boolean;
    var
       Initializer : ObjFunction;

    begin
        Initializer := FindMethod ('init');

        if Initializer = Nil then Exit False;

        Exit Initializer.Variadic () as Boolean;
    end

    /// Prints the class as its bare name.
    function ToString () : String;
    begin
        Exit Name;
    end

    /// Constructs an instance: seed its fields, then run the initializer that
    /// the arguments select.
    ///
    /// Selection falls back to FindMethod when no overload fits, so a class with
    /// a single initializer is reached whatever the arguments look like and the
    /// arity error comes from the call rather than from selection.
    function Call (TheInterpreter, Arguments) : Any;
    var
       Instance    : ObjInstance;
       Initializer : ObjFunction;

    begin
        if IsType then
            raise Str (Name)
                + ' is a type rather than a class, and cannot be constructed.';

        Instance := ObjInstance (this);

        SeedFields (Instance, TheInterpreter);

        Initializer := FindOverload('init', Arguments);

        if Initializer = Nil then
        begin
            // ⚠️ A CONSTRUCTOR'S DECLARED TYPES ARE CHECKED, as a
            // subprogram's and a method's are: [EXP-013] puts even a lone
            // candidate through selection, and FindOverload above walks every
            // candidate of the name through all three passes.
            //
            // This fell straight through to FindMethod, which asks nothing
            // about types -- so `Holder (7)` where `Init` declares
            // `V : Thing` ran, in all three processors, and compiler/Expr.a24
            // carried a field declared `Expr` that held a literal's VALUE
            // with nothing to catch it.
            //
            // The fallback stands only for a count no candidate takes, which
            // reports the COUNTS rather than a selection failure [0049] --
            // and reports them from ObjFunction.Call, where a subprogram's
            // wrong count is reported too.
            Initializer := FindMethod('init');

            //
            // ⚠️ The split MIRRORS the one a plain call makes, rather than
            // inventing a second rule: a wrong count on a FIXED-arity
            // constructor reports the counts [0049], and anything else -- the
            // right count, or any count on a VARIADIC one -- is a selection
            // failure, because an element type replaces the arity check and is
            // stricter than it [FUN-005, 0158].
            if Initializer <> Nil then
                if Initializer.Variadic ()
                       or Arguments.Length = Initializer.Arity () then
                    raise 'No matching signature for function.';
        end

        if Initializer <> Nil then
        begin
            Initializer.Bind(Instance).Call(TheInterpreter, Arguments);
        end

        Exit Instance;
    end
end
