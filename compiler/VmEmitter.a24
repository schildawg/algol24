/// The bytecode back end: an AST in, a chunk of bytecode out.
///
/// The third processor, beside the tree-walking Interpreter and the CEmitter.
/// It shares the front end with both, which is the invariant the whole
/// arrangement rests on -- a program that fails to parse or type-check must
/// fail identically whichever back end is asked for.
///
/// It walks the AST the way the TypeChecker does, by asking for a node's
/// ClassName rather than by importing the node classes, which is what lets it
/// take a node as Any.
///
/// It lives here rather than in `vm/` because it is a back end, and it is
/// reached from `vm/run.a24` rather than from Main.a24 -- so it is checked by
/// docs.sh and is deliberately NOT in the seed, and a change to an opcode
/// needs no reseed.  The import of `vm/Chunk` makes that a cycle between the
/// two directories, which the language allows and which dissolves the moment
/// there is a bytecode FILE format: this will write bytes and the machine will
/// read them, and neither will name the other.
///
/// Like the CEmitter it REFUSES by name what it cannot emit yet, rather than
/// emitting nothing.  A silent gap would produce a chunk that disagrees with
/// the interpreter, and the two are meant to be compared.
///
/// It carries no tests of its own, for the reason the CEmitter carries none:
/// a back end is judged by the corpus rather than by unit tests, because the
/// thing worth checking is that it agrees with the other processors on a whole
/// program.  `vm/conform.sh` is that check.
unit VmEmitter;

uses Token;
uses 'vm/OpCode';
uses 'vm/Chunk';
uses 'vm/VmFunction';
uses 'vm/VmClass';
uses 'vm/VmEnum';

/// What the emitter is building, for the duration of one CompileProgram.
var Into : Chunk := Nil;

/// The OUTERMOST chunk, which owns the program's global slots.
///
/// A global slot has to mean the same thing in every chunk of one program, and
/// a table per chunk does not: a subprogram resolving its own name got slot 0
/// of its own table where the caller had put it in slot 2 of the script's, so
/// recursion read the wrong variable and answered 28 where 55 was right.
/// Every global therefore resolves against this one, whichever chunk is being
/// written into.
var Script : Chunk := Nil;

/// Refuses a construct by name.
///
/// # Raises
///
/// '<X> is not supported by the bytecode back end yet.' always, which is the
/// CEmitter's wording with its own back end named.
procedure Refuse (What : Any);
begin
    raise Str (What) + ' is not supported by the bytecode back end yet.';
end

/// The node's class name, for dispatching on the kind of expression.
///
/// The TypeChecker and the Interpreter each have one of these as a METHOD on
/// their own class rather than a shared top-level function, so a third walker
/// needs its own.  Answers '' for anything with no ClassName rather than
/// raising, which keeps the dispatch below a chain of comparisons.
function KindOf (Node : Any) : Any;
begin
    try
        Exit Node.ClassName;
    except
        on e : String do Exit '';
    end
end

/// The text of a token, folded, so an operator or keyword can be matched
/// without importing TokenType.
///
/// Folded because a keyword operator -- `div`, `mod`, `and` -- may be written
/// in any case [SRC-011], where a symbol has only one spelling.
///
/// Every one-character operator it is compared against is wrapped in Str,
/// because a one-character literal is a CHAR and a Char never equals a String
/// [TYP-003].  Leaving them bare is quiet rather than fatal: `'<>'`, `'>='`
/// and `'and'` are Strings and match, while `'+'` and `'*'` silently do not,
/// so arithmetic is refused by name while the comparisons work.
function Spelling (Op : Any) : Any;
begin
    Exit ToLower (Str (Op.Lexeme));
end

/// Each declared class's parent, keyed by lowercased name.
///
/// Kept so that `except` can order its handlers MOST DERIVED FIRST, which
/// [STM-018] requires however the program wrote them: the chain of type tests
/// an except compiles to runs in order, so the order is the selection.
var CLASS_PARENTS := Map ();

/// The enumerations this program declares, lowercased.
///
/// Kept so that `X is Colour` can be emitted: the machine answers `is` for the
/// five primitive type names and for an enumeration, and refuses everything
/// else -- so the emitter has to know which names are which.
var ENUM_NAMES := List ();

/// The return type of the subprogram being compiled, or '' at the top level.
///
/// Held so that `Exit X` can widen to it -- a declared return type is an
/// assignment context [VAL-001] like a parameter and a declaration.
var Returning : Any := '';

/// The locals in scope, in the order their slots were taken.
///
/// A local's slot IS its position here, because the emitter pushes a value for
/// each declaration and never reorders them -- so the stack and this list have
/// the same shape and the name resolves to an index without a map.
var Locals : List := List ();

/// The scope depth each local was declared at, parallel to Locals.
var Depths : List := List ();

/// How many scopes are open.  Zero is the top level, where a `var` is global.
var Depth : Integer := 0;

/// How many modules deep the emitter is, so a nested `uses` can be refused.
var ModuleDepth : Integer := 0;

/// Opens a scope.
procedure PushScope ();
begin
    Depth := Depth + 1;
end

/// Closes a scope, discarding the locals it declared.
///
/// One OP_POP per local, because the values are on the stack and the stack is
/// where they lived -- which is also what keeps the stack balanced across a
/// block, the invariant Vm.a24's tests assert SP for.
procedure PopScope ();
begin
    Depth := Depth - 1;

    while Locals.Length > 0 and (Depths[Locals.Length - 1] as Integer) > Depth do
    begin
        Into.Emit (OP_POP);

        Locals.RemoveAt (Locals.Length - 1);
        Depths.RemoveAt (Depths.Length - 1);
    end
end

/// Declares a local and answers its slot.
///
/// # Raises
///
/// 'A scope holds 256 locals.' once a slot will not fit in an operand byte.
function AddLocal (Name : Any) : Integer;
begin
    if Locals.Length > 255 then raise 'A scope holds 256 locals.';

    Locals.Add (ToLower (Str (Name)));
    Depths.Add (Depth);

    Exit Locals.Length - 1;
end

/// The slot a name has as a local, or -1 when it is not one.
///
/// Searched from the INNERMOST outward, so an inner declaration shadows an
/// outer one of the same name -- which the Resolver already permits, recording
/// every name rather than only the constants so that a `var` may shadow a
/// `const`.
function LocalSlot (Name : Any) : Integer;
var
    Wanted : Any;

begin
    Wanted := ToLower (Str (Name));

    for var I : Integer := Locals.Length - 1; I >= 0; I := I - 1 do
        if Locals[I] = Wanted then Exit I;

    Exit -1;
end

/// Every built-in this back end can call, lowercased.
var BUILTIN_NAMES := ['array', 'assertequal', 'asserttrue', 'buffer', 'chdir', 'char', 'copy', 'fail', 'fileexists', 'getdir', 'halt', 'length', 'list', 'map', 'mkdir', 'ord', 'paramcount', 'paramstr', 'pos', 'pred', 'rmdir', 'set', 'stack', 'str', 'succ', 'textfile', 'tolower', 'toupper', 'val', 'write', 'writeln', 'clock'];

/// Whether a name is one of the language's built-ins.
///
/// The list is Annex B's, and `spec/spec.sh` checks that against
/// `Interpreter.a24` -- so a built-in added there and not here is refused by
/// name rather than read from a global slot nothing defines.  `Foreign` is
/// deliberately absent: it is a foreign call and wants an opcode of its own.
function IsBuiltin (Name : Any) : Boolean;
var
    Wanted : Any;

begin
    Wanted := ToLower (Str (Name));

    for var Known in BUILTIN_NAMES do
        if Known = Wanted then Exit True;

    Exit False;
end

/// Refuses a name that is neither a local nor a claimed global.
///
/// The three things it catches, and all three used to be emitted as a read of
/// a slot nothing defines: a BUILT-IN, which has no opcode yet; a variable of
/// an ENCLOSING subprogram, which wants upvalues; and a name belonging to an
/// OVERLOAD SET, which wants selection at the call.  Each is work to do, and
/// naming it is what keeps it work to do instead of a wrong answer.
///
/// # Raises
///
/// Whatever Refuse raises, naming the identifier.
procedure RequireGlobal (Name : Any);
begin
    if Script.KnownGlobal (Name.Lexeme) then Exit;

    Refuse ('A reference to ''' + Str (Name.Lexeme) + '''');
end

/// Compiles a subprogram's body into a chunk of its own.
///
/// The emitter's state -- the chunk being written, the locals, the depth -- is
/// saved and restored around it, which is clox's chain of Compiler structs
/// written as a save and a restore instead.  A subprogram therefore compiles
/// as though it were the only thing being compiled, which is what lets a jump
/// inside it be measured against its own chunk.
///
/// The parameters are declared as the first locals, in order, because that is
/// where the calling convention leaves the arguments: slot 0 is the first one.
///
/// # Raises
///
/// Whatever the body raises, and the arity limit through AddLocal.
function CompileFunction (TheStmt : Any) : VmFunction;
var
    Made : VmFunction;

    SavedInto   : Chunk;
    SavedLocals : List;
    SavedDepths : List;
    SavedDepth  : Integer;
    SavedReturn : Any;

begin
    Made := VmFunction (Str (TheStmt.Name.Lexeme), TheStmt.Params.Length);

    SavedInto   := Into;
    SavedLocals := Locals;
    SavedDepths := Depths;
    SavedDepth  := Depth;
    SavedReturn := Returning;

    Into   := Made.Body;
    Locals := List ();
    Depths := List ();
    Depth  := 1;
    Returning := TheStmt.ReturnType;

    for var Param in TheStmt.Params do AddLocal (Param.Lexeme);

    WidenParameters (TheStmt);

    for var Inner in TheStmt.Body do EmitStmt (Inner);

    // A body that runs off the end answers nil, as a procedure does and as a
    // function without an Exit does.
    Into.Emit (OP_NIL);
    Into.Emit (OP_RETURN);

    Into   := SavedInto;
    Locals := SavedLocals;
    Depths := SavedDepths;
    Depth  := SavedDepth;
    Returning := SavedReturn;

    Exit Made;
end

/// Emits the widening a declared type calls for, if any.
///
/// Integer to Double and Char to String are the whole of it [VAL-001], and
/// both are the machine's job because the value is not known until it runs.
///
/// A SUBRANGE is refused: widening one is a range check against bounds held in
/// the compiler's own table, which a chunk cannot reach -- and emitting
/// nothing would let `var B : Byte := 300` through silently.
///
/// # Raises
///
/// Whatever Refuse raises, for a subrange annotation.
procedure EmitWidening (Declared : Any);
begin
    var Named := ToLower (Str (Declared));

    if Named = '' or Named = 'any' then Exit;

    if IsSubrange (Named) then
        Refuse ('The subrange ' + Str (Declared) + ' as a declared type');

    // Only the two that convert anything; a class or any other name widens
    // nothing and needs no instruction.
    if Named <> 'double' and Named <> 'string' then Exit;

    var At := Into.AddConstant (Str (Declared));

    if At > 255 then Refuse ('A chunk with more than 256 constants');

    Into.EmitWith (OP_WIDEN, At);
end

/// Widens each parameter that was declared with a type, in place.
///
/// A parameter is an assignment context [VAL-001], so `function F (X : Double)`
/// called with 1 must see 1.0.  Done on entry rather than at the call, because
/// the caller does not know the callee's declared types -- overload selection
/// is at run time [EXP-013] and a call site may not know which one it reaches.
procedure WidenParameters (TheStmt : Any);
begin
    for var I : Integer := 0; I < TheStmt.Params.Length; I := I + 1 do
        if I < TheStmt.ParamTypes.Length then
        begin
            var Declared := TheStmt.ParamTypes[I];

            // A CONDITION and not an early Exit: `Exit` leaves the whole
            // procedure, so an untyped parameter stopped every later one from
            // being widened rather than merely skipping itself.
            if ToLower (Str (Declared)) <> '' then
            begin
                Into.EmitWith (OP_GET_LOCAL, I);
                EmitWidening (Declared);
                Into.EmitWith (OP_SET_LOCAL, I);
                Into.Emit (OP_POP);
            end
        end
end

/// How many classes lie between a name and the root of its hierarchy.
///
/// A name that is not a declared class answers 0, which puts a primitive and
/// an enumeration alongside a base class -- none of them can be a subclass of
/// another handler's type, so their relative order cannot matter.
function Derivation (Named : Any) : Integer;
var
    Depth : Integer;
    Where : Any;

begin
    Depth := 0;
    Where := ToLower (Str (Named));

    while CLASS_PARENTS.Contains (Where) do
    begin
        var Parent := CLASS_PARENTS.Get (Where);

        if Parent = '' then Exit Depth;

        Depth := Depth + 1;
        Where := ToLower (Str (Parent));
    end

    Exit Depth;
end

/// The handler type names, most derived first.
///
/// A plain insertion sort on Derivation, because [STM-018] asks only that a
/// subclass be tested before its superclass -- and the chain of tests runs in
/// whatever order this answers, so the order IS the selection rule.
function HandlersInOrder (Handlers : Map) : List;
var
    Ordered : List;

begin
    Ordered := List ();

    for var Named in Handlers do
    begin
        var At := 0;

        while At < Ordered.Length
          and Derivation (Ordered[At]) >= Derivation (Named) do At := At + 1;

        Ordered.Insert (At, Named);
    end

    Exit Ordered;
end

/// Emits one expression, leaving its value on the stack, and applies the cast
/// written on it if any.
///
/// A wrapper rather than a case in the walker, because `as` binds at the unary
/// level and so can appear on ANY node -- and EmitBare has an Exit per kind,
/// so there is no one place inside it to put this.  Dropping the cast silently
/// was a wrong answer: `'text' as Integer` simply answered 'text'.
procedure EmitExpr (TheExpr : Any);
begin
    EmitBare (TheExpr);

    if TheExpr = Nil then Exit;
    if Str (TheExpr.Cast) = '' then Exit;

    var Named := ToLower (Str (TheExpr.Cast));

    // The machine tests primitives, enumerations and classes; a subrange is a
    // RANGE check against bounds it cannot reach.
    var Known := Named = 'integer' or Named = 'double' or Named = 'string'
              or Named = 'char'    or Named = 'boolean';

    for var Declared in ENUM_NAMES do
        if Declared = Named then Known := True;

    if CLASS_PARENTS.Contains (Named) then Known := True;

    if not Known then Refuse ('as ' + Str (TheExpr.Cast));

    // AddConstant directly: Cast is a STRING where ClassNameConstant takes a
    // Token and reads its Lexeme.
    var At := Into.AddConstant (Str (TheExpr.Cast));

    if At > 255 then Refuse ('A chunk with more than 256 constants');

    Into.EmitWith (OP_CAST, At);
end

/// Emits one expression, ignoring any cast written on it.
procedure EmitBare (TheExpr : Any);
begin
    if TheExpr = Nil then
    begin
        Into.Emit (OP_NIL);
        Exit;
    end

    var Kind := KindOf (TheExpr);

    if Kind = 'LiteralExpr' then
    begin
        var V := TheExpr.Value;

        // The three literals with opcodes of their own, so that the commonest
        // constants cost no table slot.
        if V = Nil then Into.Emit (OP_NIL);
        else if V = True then Into.Emit (OP_TRUE);
        else if V = False then Into.Emit (OP_FALSE);
        else Into.EmitConstant (V);

        Exit;
    end

    if Kind = 'GroupingExpr' then
    begin
        EmitExpr (TheExpr.Expression);
        Exit;
    end

    if Kind = 'VariableExpr' then
    begin
        var Slot := LocalSlot (TheExpr.Name.Lexeme);

        if Slot >= 0 then Into.EmitWith (OP_GET_LOCAL, Slot);
        else
        begin
            // Only a name the pre-pass CLAIMED is a global.  Anything else is
            // a built-in, or a variable of an enclosing subprogram, or a name
            // this back end has no opcodes for -- and each has to be refused
            // rather than read from a slot nothing defines.
            RequireGlobal (TheExpr.Name);

            Into.EmitWith (OP_GET_GLOBAL, Script.GlobalSlot (TheExpr.Name.Lexeme));
        end

        Exit;
    end

    if Kind = 'AssignExpr' then
    begin
        EmitExpr (TheExpr.Value);
        EmitWidening (TheExpr.Declared);

        var Slot := LocalSlot (TheExpr.Name.Lexeme);

        if Slot >= 0 then Into.EmitWith (OP_SET_LOCAL, Slot);
        else
        begin
            RequireGlobal (TheExpr.Name);

            Into.EmitWith (OP_SET_GLOBAL, Script.GlobalSlot (TheExpr.Name.Lexeme));
        end

        Exit;
    end

    if Kind = 'UnaryExpr' then
    begin
        var Op := Spelling (TheExpr.Op);

        EmitExpr (TheExpr.Right);

        if Op = Str ('-') then Into.Emit (OP_NEGATE);
        else if Op = 'not' then Into.Emit (OP_NOT);
        else if Op = Str ('~') then Into.Emit (OP_BIT_NOT);
        else Refuse ('Unary ''' + Op + '''');

        Exit;
    end

    if Kind = 'BinaryExpr' then
    begin
        EmitBinary (TheExpr);
        Exit;
    end

    // `and` and `or` are their own node, not a BinaryExpr, because they
    // short-circuit -- which is exactly why they are emitted as control flow.
    if Kind = 'ThisExpr' then
    begin
        Into.Emit (OP_THIS);

        Exit;
    end

    if Kind = 'SetExpr' then
    begin
        if Str (TheExpr.Unit) <> '' then Refuse ('A write through a unit qualifier');

        EmitExpr (TheExpr.Obj);
        EmitExpr (TheExpr.Value);

        // A field is an assignment context too [VAR-017], and the TypeChecker
        // has already recorded what it was declared as.
        EmitWidening (TheExpr.Declared);

        Into.EmitWith (OP_SET_FIELD, ClassNameConstant (TheExpr.Name));

        Exit;
    end

    if Kind = 'SubscriptExpr' then
    begin
        EmitExpr (TheExpr.Obj);
        EmitExpr (TheExpr.Index);
        Into.Emit (OP_SUBSCRIPT_GET);

        Exit;
    end

    if Kind = 'SetSubscriptExpr' then
    begin
        EmitExpr (TheExpr.Obj);
        EmitExpr (TheExpr.Index);
        EmitExpr (TheExpr.Value);
        Into.Emit (OP_SUBSCRIPT_SET);

        Exit;
    end

    if Kind = 'GetExpr' then
    begin
        // A unit qualifier is a different thing wearing the same syntax --
        // `Unit.Name` rather than a property of a value -- and the Resolver
        // has already decided which.
        if Str (TheExpr.Unit) <> '' then Refuse ('A read through a unit qualifier');
        if Str (TheExpr.Extension) <> '' then Refuse ('An extension member');

        var Named := ToLower (Str (TheExpr.Name.Lexeme));

        // One of the runtime's five properties, or a FIELD of an instance.
        // The two cannot be told apart here -- the receiver's type is not
        // always known -- so the property names win and everything else is
        // emitted as a field read, which refuses at run time if the receiver
        // turns out not to be an instance.
        if Named <> 'length' and Named <> 'text' and Named <> 'eof'
                             and Named <> 'isempty' and Named <> 'address' then
        begin
            EmitExpr (TheExpr.Obj);
            Into.EmitWith (OP_GET_FIELD, ClassNameConstant (TheExpr.Name));

            Exit;
        end

        EmitExpr (TheExpr.Obj);

        var At := Into.AddConstant (Str (TheExpr.Name.Lexeme));

        if At > 255 then Refuse ('A chunk with more than 256 constants');

        Into.EmitWith (OP_PROPERTY, At);

        Exit;
    end

    if Kind = 'CollectionExpr' then
    begin
        if TheExpr.IsMap then
        begin
            if TheExpr.Keys.Length > 255 then Refuse ('A Map literal above 255 pairs');

            for var I : Integer := 0; I < TheExpr.Keys.Length; I := I + 1 do
            begin
                EmitExpr (TheExpr.Keys[I]);
                EmitExpr (TheExpr.Values[I]);
            end

            Into.EmitWith (OP_MAP, TheExpr.Keys.Length);

            Exit;
        end

        if TheExpr.Values.Length > 255 then Refuse ('A List literal above 255 elements');

        for var Element in TheExpr.Values do EmitExpr (Element);

        Into.EmitWith (OP_LIST, TheExpr.Values.Length);

        Exit;
    end

    if Kind = 'IsExpr' then
    begin
        // Only a primitive type name, and the reason is in Vm.a24's DoIs: the
        // machine answers `is` by comparing TypeNameOf, which is right for
        // these five and wrong for a subrange (a RANGE test) and for a class
        // (inheritance-aware).  Emitting it for those would be a quiet wrong
        // answer where a refusal is wanted.
        var Named := ToLower (Str (TheExpr.TypeName.Lexeme));

        var Known := Named = 'integer' or Named = 'double' or Named = 'string'
                  or Named = 'char'    or Named = 'boolean';

        // An enumeration too: `RED is Colour` is a test the machine can answer
        // because a member carries its own type's name [ENU-006].
        for var Declared in ENUM_NAMES do
            if Declared = Named then Known := True;

        // And a declared class, which the machine answers by walking the
        // instance's own chain [STM-017].
        if CLASS_PARENTS.Contains (Named) then Known := True;

        if not Known then
            Refuse ('''is ' + Str (TheExpr.TypeName.Lexeme) + '''');

        EmitExpr (TheExpr.Obj);

        // AddConstant and not EmitConstant: the latter emits an OP_CONSTANT to
        // push the name, where OP_IS wants the INDEX as its own operand.
        var At := Into.AddConstant (Str (TheExpr.TypeName.Lexeme));

        if At > 255 then Refuse ('A chunk with more than 256 constants');

        Into.EmitWith (OP_IS, At);

        Exit;
    end

    if Kind = 'LogicalExpr' then
    begin
        EmitLogical (TheExpr);
        Exit;
    end

    if Kind = 'CallExpr' then
    begin
        EmitCall (TheExpr);
        Exit;
    end

    Refuse (Kind);
end

/// Emits `and` or `or`, which get no opcodes and must not.
///
/// They yield an OPERAND rather than a Boolean [EXP-010] -- `6 and 3` is 3 and
/// `0 and 3` is 0 -- and a jump that leaves the tested value on the stack
/// answers exactly that.  So the operand semantics and the short-circuiting
/// fall out of one shape, and OP_JUMP_IF_FALSE not popping is what makes it
/// work.
///
/// # Raises
///
/// Whatever Refuse raises, for an operator that is neither.
procedure EmitLogical (TheExpr : Any);
var
    Op : Any;

begin
    Op := Spelling (TheExpr.Op);

    if Op = 'and' then
    begin
        EmitExpr (TheExpr.Left);

        var Short := Into.EmitJump (OP_JUMP_IF_FALSE);
        Into.Emit (OP_POP);
        EmitExpr (TheExpr.Right);
        Into.PatchJump (Short);

        Exit;
    end

    if Op = 'or' then
    begin
        EmitExpr (TheExpr.Left);

        var Falsey := Into.EmitJump (OP_JUMP_IF_FALSE);
        var Done   := Into.EmitJump (OP_JUMP);

        Into.PatchJump (Falsey);
        Into.Emit (OP_POP);
        EmitExpr (TheExpr.Right);
        Into.PatchJump (Done);

        Exit;
    end

    Refuse ('Logical ''' + Str (Op) + '''');
end

/// Emits a binary expression.
procedure EmitBinary (TheExpr : Any);
var
    Op : Any;

begin
    Op := Spelling (TheExpr.Op);

    EmitExpr (TheExpr.Left);
    EmitExpr (TheExpr.Right);

    if Op = Str ('+')  then Into.Emit (OP_ADD);
    else if Op = Str ('-')  then Into.Emit (OP_SUBTRACT);
    else if Op = Str ('*')  then Into.Emit (OP_MULTIPLY);
    else if Op = Str ('/')  then Into.Emit (OP_DIVIDE);
    else if Op = Str ('=')  then Into.Emit (OP_EQUAL);
    else if Op = Str ('>')  then Into.Emit (OP_GREATER);
    else if Op = Str ('<')  then Into.Emit (OP_LESS);

    else if Op = 'div' then Into.Emit (OP_DIV);
    else if Op = 'mod' then Into.Emit (OP_MOD);

    else if Op = Str ('&') then Into.Emit (OP_BIT_AND);
    else if Op = Str ('|') then Into.Emit (OP_BIT_OR);
    else if Op = Str ('^') then Into.Emit (OP_BIT_XOR);
    else if Op = '<<' then Into.Emit (OP_SHIFT_LEFT);
    else if Op = '>>' then Into.Emit (OP_SHIFT_RIGHT);

    // The three the machine does not have, each one instruction and a negation
    // -- which is what clox does, and costs a byte rather than three opcodes.
    else if Op = '<>' then
    begin
        Into.Emit (OP_EQUAL);
        Into.Emit (OP_NOT);
    end
    else if Op = '>=' then
    begin
        Into.Emit (OP_LESS);
        Into.Emit (OP_NOT);
    end
    else if Op = '<=' then
    begin
        Into.Emit (OP_GREATER);
        Into.Emit (OP_NOT);
    end
    else Refuse ('Binary ''' + Op + '''');
end

/// Emits a call.
///
/// Only `WriteLn` so far, which is the one built-in with an opcode.  Everything
/// else is refused by name until there is a call frame to put it in.
procedure EmitCall (TheExpr : Any);
var
    Name : Any;

begin
    // `Receiver.Method (args)` parses as a call whose CALLEE is a GetExpr, so
    // it is caught here rather than in the GetExpr branch -- which handles a
    // property read and would otherwise try to read the method as one.
    if KindOf (TheExpr.Callee) = 'GetExpr' then
    begin
        var Member := TheExpr.Callee;

        if Str (Member.Unit) <> '' then Refuse ('A call through a unit qualifier');
        if Str (Member.Extension) <> '' then Refuse ('An extension call');

        for var Written in TheExpr.ArgumentNames do
            if Str (Written) <> '' then Refuse ('A call with named arguments');

        EmitExpr (Member.Obj);

        for var Argument in TheExpr.Arguments do EmitExpr (Argument);

        var Slot := Into.AddConstant (Str (Member.Name.Lexeme));

        if Slot > 255 then Refuse ('A chunk with more than 256 constants');

        Into.Write (OP_INVOKE);
        Into.Write (Slot);
        Into.Write (TheExpr.Arguments.Length);

        Exit;
    end

    if KindOf (TheExpr.Callee) <> 'VariableExpr' then
        Refuse ('A call through an expression');

    Name := ToLower (Str (TheExpr.Callee.Name.Lexeme));

    if Name = 'writeln' then
    begin
        if TheExpr.Arguments.Length <> 1 then
            Refuse ('WriteLn with ' + Str (TheExpr.Arguments.Length) + ' arguments');

        EmitExpr (TheExpr.Arguments[0]);
        Into.Emit (OP_PRINT);

        // Every expression leaves a value, and a call is an expression, so the
        // statement above this one expects one to pop.  OP_PRINT consumed it.
        Into.Emit (OP_NIL);

        Exit;
    end

    // ArgumentNames carries an entry per argument, EMPTY for a positional
    // one, so the count is not the question -- whether any was written is.
    for var Written in TheExpr.ArgumentNames do
        if Str (Written) <> '' then Refuse ('A call with named arguments');

    // A built-in is called by NAME rather than through a slot, because a
    // built-in has no slot: it is not a global the program declared.  A
    // locally declared name of the same spelling shadows it, which is what
    // checking the locals first does.
    if LocalSlot (TheExpr.Callee.Name.Lexeme) < 0 and IsBuiltin (Name) then
    begin
        for var Argument in TheExpr.Arguments do EmitExpr (Argument);

        var At := Into.AddConstant (Str (TheExpr.Callee.Name.Lexeme));

        if At > 255 then Refuse ('A chunk with more than 256 constants');

        Into.Write (OP_BUILTIN);
        Into.Write (At);
        Into.Write (TheExpr.Arguments.Length);

        Exit;
    end

    // The callee first and the arguments after it, which is the order OP_CALL
    // reads them back in.
    EmitExpr (TheExpr.Callee);

    for var Argument in TheExpr.Arguments do EmitExpr (Argument);

    Into.EmitWith (OP_CALL, TheExpr.Arguments.Length);

    Exit;
end

/// Emits one `except` arm, with the raised value bound to its name.
///
/// The value is already on the stack, so the binding is a local in the arm's
/// own scope -- which PopScope then discards, leaving the stack where the
/// `try` left it.
procedure EmitHandlerArm (Arm : Any);
begin
    PushScope ();

    AddLocal (Arm.Name);

    EmitStmt (Arm.Body);

    PopScope ();
end

/// Emits the inheritance a class declaration asks for, where it is WRITTEN.
///
/// Separate from the class itself because the class is HOISTED -- it has to be
/// callable above its own declaration [0044] -- while its parent is an
/// ordinary global that may be assigned below the hoisted position.  Binding
/// the parent early reported 'Undefined variable' for a name the program had
/// declared perfectly well [0112], so the two halves run at different times:
/// the class is made early and its parent attached in source order.
///
/// # Raises
///
/// Whatever RequireGlobal raises, for a parent that is not a known global.
procedure EmitInheritance (TheStmt : Any);
begin
    if TheStmt.Superclass = Nil then Exit;

    RequireGlobal (TheStmt.Superclass.Name);

    Into.EmitWith (OP_GET_GLOBAL, Script.GlobalSlot (TheStmt.Name.Lexeme));
    Into.EmitWith (OP_GET_GLOBAL,
                   Script.GlobalSlot (TheStmt.Superclass.Name.Lexeme));
    Into.EmitWith (OP_INHERIT, ClassNameConstant (TheStmt.Superclass.Name));
    Into.Emit (OP_POP);
end

/// Emits a class declaration.
///
/// The class is built on the stack -- OP_CLASS, then an OP_FIELD per field and
/// an OP_METHOD per method -- and then bound like any other declaration, which
/// is what lets a method find its own class through a global.
///
/// The FIELD INITIALIZERS are compiled into the constructor rather than stored
/// on the class, because they are expressions and have to run per instance.  A
/// class with no constructor gets a synthesized one so there is always exactly
/// one place they run.
///
/// # Raises
///
/// Whatever Refuse raises, for a private member, a property or an overloaded
/// method -- each of which the machine has no answer for yet.
procedure EmitClass (TheStmt : Any);
begin
    if TheStmt.PrivateMembers.Length > 0 then Refuse ('A private member');

    Into.EmitWith (OP_CLASS, ClassNameConstant (TheStmt.Name));

    for var TheField in TheStmt.Fields do
        Into.EmitWith (OP_FIELD, ClassNameConstant (TheField.Name));

    var Seen := Map ();

    for var TheMethod in TheStmt.Methods do
    begin
        if TheMethod.IsProperty then Refuse ('A property');

        var Key := ToLower (Str (TheMethod.Name.Lexeme));

        // Two methods of one name are an OVERLOAD SET selecting on the whole
        // signature [FUN-013], which one entry in the method table cannot
        // hold -- so it is refused rather than silently keeping the last.
        if Seen.Contains (Key) then
            Refuse ('An overloaded method ''' + Str (TheMethod.Name.Lexeme) + '''');

        Seen.Put (Key, True);

        Into.EmitConstant (CompileMethod (TheMethod, TheStmt, Key = 'init'));
        Into.EmitWith (OP_METHOD, ClassNameConstant (TheMethod.Name));
    end

    // A constructor is where the field initializers run, so one is synthesized
    // when the class declares none.
    if not Seen.Contains ('init') then
    begin
        Into.EmitConstant (SynthesizedInit (TheStmt));
        Into.EmitWith (OP_METHOD, Into.AddConstant ('Init'));
    end

    if Depth > 0 then
    begin
        AddLocal (TheStmt.Name.Lexeme);

        Exit;
    end

    Into.EmitWith (OP_DEFINE_GLOBAL, Script.GlobalSlot (TheStmt.Name.Lexeme));
end

/// Adds a name to the constants and answers its index.
///
/// # Raises
///
/// 'A chunk with more than 256 constants' once an index will not fit.
function ClassNameConstant (Name : Any) : Integer;
begin
    var At := Into.AddConstant (Str (Name.Lexeme));

    if At > 255 then Refuse ('A chunk with more than 256 constants');

    Exit At;
end

/// Compiles a method's body into a chunk of its own.
///
/// Like CompileFunction, with two differences that matter.  A method's frame
/// has its RECEIVER one below the base rather than a callee, so slot 0 is
/// still the first parameter and `this` is reached by OP_THIS.  And a
/// constructor runs the class's FIELD INITIALIZERS first and answers `this`
/// instead of nil, which is what makes `Foo ()` evaluate to the instance.
function CompileMethod (TheStmt : Any, Owner : Any, IsInit : Boolean) : VmFunction;
var
    Made : VmFunction;

    SavedInto   : Chunk;
    SavedLocals : List;
    SavedDepths : List;
    SavedDepth  : Integer;
    SavedReturn : Any;

begin
    Made := VmFunction (Str (TheStmt.Name.Lexeme), TheStmt.Params.Length);

    SavedInto   := Into;
    SavedLocals := Locals;
    SavedDepths := Depths;
    SavedDepth  := Depth;
    SavedReturn := Returning;

    Into   := Made.Body;
    Locals := List ();
    Depths := List ();
    Depth  := 1;
    Returning := TheStmt.ReturnType;

    for var Param in TheStmt.Params do AddLocal (Param.Lexeme);

    WidenParameters (TheStmt);

    if IsInit then EmitFieldInitializers (Owner);

    for var Inner in TheStmt.Body do EmitStmt (Inner);

    // A constructor answers the instance; anything else answers nil when it
    // runs off the end.
    if IsInit then Into.Emit (OP_THIS);
    else Into.Emit (OP_NIL);

    Into.Emit (OP_RETURN);

    Into   := SavedInto;
    Locals := SavedLocals;
    Depths := SavedDepths;
    Depth  := SavedDepth;
    Returning := SavedReturn;

    Exit Made;
end

/// Emits the field initializers into whatever chunk is being written.
///
/// A field with no initializer is skipped rather than assigned nil, because
/// the instance already begins with every field nil [CLS-006] -- assigning it
/// again would cost an instruction to say the same thing.
procedure EmitFieldInitializers (Owner : Any);
begin
    for var TheField in Owner.Fields do
        if TheField.Initializer <> Nil then
        begin
            Into.Emit (OP_THIS);
            EmitExpr (TheField.Initializer);
            EmitWidening (TheField.TypeName);
            Into.EmitWith (OP_SET_FIELD, ClassNameConstant (TheField.Name));
            Into.Emit (OP_POP);
        end
end

/// Builds a constructor for a class that declares none.
///
/// It takes no arguments and does nothing but run the field initializers and
/// answer `this`, which is what keeps instantiation one shape whether or not
/// the program wrote a constructor.
function SynthesizedInit (Owner : Any) : VmFunction;
var
    Made : VmFunction;

    SavedInto   : Chunk;
    SavedLocals : List;
    SavedDepths : List;
    SavedDepth  : Integer;
    SavedReturn : Any;

begin
    Made := VmFunction ('Init', 0);

    SavedInto   := Into;
    SavedLocals := Locals;
    SavedDepths := Depths;
    SavedDepth  := Depth;
    SavedReturn := Returning;

    Into   := Made.Body;
    Locals := List ();
    Depths := List ();
    Depth  := 1;
    Returning := '';

    EmitFieldInitializers (Owner);

    Into.Emit (OP_THIS);
    Into.Emit (OP_RETURN);

    Into   := SavedInto;
    Locals := SavedLocals;
    Depths := SavedDepths;
    Depth  := SavedDepth;
    Returning := SavedReturn;

    Exit Made;
end

/// Emits a subprogram declaration.
///
/// The callable goes in the constant table and the declaration binds it, so a
/// subprogram is a value in a slot like any other -- which is what lets one
/// recurse by reading its own global.
procedure EmitFunction (TheStmt : Any);
begin
    if TheStmt.Symbol <> '' then Refuse ('An external subprogram');
    if TheStmt.IsExtension then Refuse ('An extension');
    if TheStmt.IsProperty then Refuse ('A property');

    Into.EmitConstant (CompileFunction (TheStmt));

    if Depth > 0 then
    begin
        AddLocal (TheStmt.Name.Lexeme);

        Exit;
    end

    Into.EmitWith (OP_DEFINE_GLOBAL, Script.GlobalSlot (TheStmt.Name.Lexeme));

end

/// Emits one statement, leaving the stack as it found it.
procedure EmitStmt (TheStmt : Any);
begin
    if TheStmt = Nil then Exit;

    var Kind := KindOf (TheStmt);

    if Kind = 'ExpressionStmt' then
    begin
        EmitExpr (TheStmt.Expression);
        Into.Emit (OP_POP);

        Exit;
    end

    if Kind = 'VarStmt' then
    begin
        EmitExpr (TheStmt.Initializer);
        EmitWidening (TheStmt.TypeName);

        // Inside a scope the value STAYS on the stack and that slot is the
        // local -- there is no define instruction, because the push was it.
        if Depth > 0 then
        begin
            AddLocal (TheStmt.Name.Lexeme);

            Exit;
        end

        // At the top level a declaration is what DEFINES a global, so one with
        // no initializer defines it as nil rather than leaving it undefined.
        Into.EmitWith (OP_DEFINE_GLOBAL, Script.GlobalSlot (TheStmt.Name.Lexeme));

        Exit;
    end

    if Kind = 'ClassStmt' then
    begin
        EmitClass (TheStmt);

        Exit;
    end

    if Kind = 'FunctionStmt' then
    begin
        EmitFunction (TheStmt);

        Exit;
    end

    if Kind = 'ReturnStmt' then
    begin
        // `Exit` with no value answers nil, which is what a procedure's Exit
        // does and what a function running off its end does.
        EmitExpr (TheStmt.Value);

        // A declared return type is an assignment context too [VAL-001].
        if TheStmt.Value <> Nil then EmitWidening (Returning);

        Into.Emit (OP_RETURN);

        Exit;
    end

    if Kind = 'BlockStmt' then
    begin
        PushScope ();

        for var Inner in TheStmt.Statements do EmitStmt (Inner);

        PopScope ();

        Exit;
    end

    if Kind = 'IfStmt' then
    begin
        EmitExpr (TheStmt.Condition);

        var Otherwise := Into.EmitJump (OP_JUMP_IF_FALSE);
        Into.Emit (OP_POP);
        EmitStmt (TheStmt.ThenBranch);

        var Done := Into.EmitJump (OP_JUMP);

        Into.PatchJump (Otherwise);
        Into.Emit (OP_POP);
        EmitStmt (TheStmt.ElseBranch);

        Into.PatchJump (Done);

        Exit;
    end

    if Kind = 'TryStmt' then
    begin
        var Opened := Into.EmitJump (OP_TRY);

        EmitStmt (TheStmt.TryBlock);

        Into.Emit (OP_UNTRY);

        var Survived := Into.EmitJump (OP_JUMP);

        // The handlers begin here, and the raised value is on the stack --
        // Unwind left it there.
        Into.PatchJump (Opened);

        var Leaving := List ();
        var CatchAll : Any := Nil;

        for var Named in HandlersInOrder (TheStmt.Handlers) do
        begin
            var Arm := TheStmt.Handlers.Get (Named);

            // The untyped handler is keyed 'default' by the Parser, which is
            // also where a trailing statement with no `on` at all ends up --
            // both are the catch-all [STM-019].  It goes LAST however the
            // program wrote it, because an earlier arm would make every later
            // one unreachable.
            if ToLower (Str (Named)) = 'default' then CatchAll := Arm;
            else
            begin
                Into.Emit (OP_DUP);
                Into.EmitWith (OP_IS, Into.AddConstant (Str (Named)));

                var Next := Into.EmitJump (OP_JUMP_IF_FALSE);
                Into.Emit (OP_POP);

                EmitHandlerArm (Arm);

                Leaving.Add (Into.EmitJump (OP_JUMP));

                Into.PatchJump (Next);
                Into.Emit (OP_POP);
            end
        end

        if CatchAll <> Nil then EmitHandlerArm (CatchAll);
        else
        begin
            // Nothing matched, so the raise continues outward -- which is what
            // makes a handler for the wrong type transparent rather than a
            // silent swallow.
            Into.Emit (OP_RAISE);
        end

        for var Hole in Leaving do Into.PatchJump (Hole);

        Into.PatchJump (Survived);

        Exit;
    end

    if Kind = 'RaiseStmt' then
    begin
        EmitExpr (TheStmt.Value);
        Into.Emit (OP_RAISE);

        Exit;
    end

    if Kind = 'EnumStmt' then
    begin
        Into.EmitWith (OP_ENUM, ClassNameConstant (TheStmt.Name));

        // Each member is pushed by OP_ENUM_MEMBER and bound immediately, so
        // the bare name and the qualified one reach the one interned object
        // [ENU-002].  The enumeration stays beneath them throughout.
        for var Member in TheStmt.Members do
        begin
            Into.EmitWith (OP_ENUM_MEMBER, ClassNameConstant (Member));

            if Depth > 0 then Refuse ('An enumeration inside a block');

            Into.EmitWith (OP_DEFINE_GLOBAL, Script.GlobalSlot (Member.Lexeme));
        end

        Into.EmitWith (OP_DEFINE_GLOBAL, Script.GlobalSlot (TheStmt.Name.Lexeme));

        Exit;
    end

    if Kind = 'ForInStmt' then
    begin
        if Str (TheStmt.Label) <> '' then Refuse ('A labelled loop');

        // Desugared into a counted loop over the materialized sequence, which
        // needs three locals: what to walk, where in it, and the loop
        // variable.  They are the loop's OWN scope, so PopScope discards all
        // three and the stack is where it was [the SP invariant].
        PushScope ();

        EmitExpr (TheStmt.Iterable);
        Into.Emit (OP_ITER);
        var Over := AddLocal (' for-in sequence ');

        Into.EmitConstant (0);
        var At := AddLocal (' for-in index ');

        // The loop variable is declared ONCE and assigned per iteration.  A
        // fresh one each time would want a scope per iteration, and nothing
        // in this language can observe the difference -- there are no closures
        // over it yet, which is the only thing that could.
        Into.Emit (OP_NIL);
        var Each := AddLocal (TheStmt.Name.Lexeme);

        var Top := Into.Count;

        Into.EmitWith (OP_GET_LOCAL, At);
        Into.EmitWith (OP_GET_LOCAL, Over);
        Into.EmitWith (OP_PROPERTY, Into.AddConstant ('Length'));
        Into.Emit (OP_LESS);

        var Done := Into.EmitJump (OP_JUMP_IF_FALSE);
        Into.Emit (OP_POP);

        Into.EmitWith (OP_GET_LOCAL, Over);
        Into.EmitWith (OP_GET_LOCAL, At);
        Into.Emit (OP_SUBSCRIPT_GET);
        Into.EmitWith (OP_SET_LOCAL, Each);
        Into.Emit (OP_POP);

        EmitStmt (TheStmt.Body);

        Into.EmitWith (OP_GET_LOCAL, At);
        Into.EmitConstant (1);
        Into.Emit (OP_ADD);
        Into.EmitWith (OP_SET_LOCAL, At);
        Into.Emit (OP_POP);

        Into.EmitLoop (Top);

        Into.PatchJump (Done);
        Into.Emit (OP_POP);

        PopScope ();

        Exit;
    end

    if Kind = 'WhileStmt' then
    begin
        var Top := Into.Count;

        EmitExpr (TheStmt.Condition);

        var Done := Into.EmitJump (OP_JUMP_IF_FALSE);
        Into.Emit (OP_POP);
        EmitStmt (TheStmt.Body);

        // The counted form carries its step here rather than in the body, so
        // 'for var I := 0; I < N; I := I + 1' and 'while' are one node.
        if TheStmt.Increment <> Nil then
        begin
            EmitExpr (TheStmt.Increment);
            Into.Emit (OP_POP);
        end

        Into.EmitLoop (Top);

        Into.PatchJump (Done);
        Into.Emit (OP_POP);

        Exit;
    end

    if Kind = 'ModuleStmt' then
    begin
        // A nested `uses` is refused, exactly as the C back end refuses it.
        //
        // The reason here is visibility: one flat table of global slots keyed
        // by name cannot say that a declaration is visible to the module that
        // imported it and not to the module that imported THAT, which is what
        // `uses` not being transitive requires [MOD-005].  A transitively
        // imported module's declarations still have to RUN, so skipping them
        // is not an answer either -- and emitting them made DeepName callable
        // from a file with no `uses` for it.
        if ModuleDepth > 0 then Refuse ('A nested ''uses''');

        ModuleDepth := ModuleDepth + 1;

        if TheStmt.Statements <> Nil then
            for var Inner in TheStmt.Statements do EmitStmt (Inner);

        ModuleDepth := ModuleDepth - 1;

        Exit;
    end

    Refuse (Kind);
end

/// Walks the declarations and gives every global a slot before any body is
/// emitted.
///
/// Not optional, and not an optimisation: a module-level subprogram may refer
/// to a global declared BELOW it, so a slot assigned as the declaration is
/// reached would be assigned too late.  GlobalSlot is idempotent, so the later
/// uses find the same slot.
procedure ClaimGlobalSlots (Statements : List, Reach : Integer);
begin
    for var TheStmt in Statements do
    begin
        var Kind := KindOf (TheStmt);

        if Kind = 'VarStmt' then Script.GlobalSlot (TheStmt.Name.Lexeme);

        // A subprogram's name is a global like any other, and it has to exist
        // before any BODY is emitted -- which is the case the pre-pass is for:
        // two subprograms that call each other, and one that calls itself.
        // An enumeration binds its own name AND every member as a bare global
        // [ENU-002], so all of them are claimed before any body is emitted.
        if Kind = 'EnumStmt' then
        begin
            Script.GlobalSlot (TheStmt.Name.Lexeme);
            ENUM_NAMES.Add (ToLower (Str (TheStmt.Name.Lexeme)));

            for var Member in TheStmt.Members do
            begin
                // Two enumerations sharing a member name make the BARE name
                // ambiguous, and the language raises when it is used --
                // naming both enumerations.  One global slot cannot hold
                // 'ambiguous', so it is refused by name instead.
                if Script.KnownGlobal (Member.Lexeme) then
                    Refuse ('The shared enum member name '''
                          + Str (Member.Lexeme) + '''');

                Script.GlobalSlot (Member.Lexeme);
            end
        end

        // A class's name is a global too, and it has to exist before any
        // METHOD body is emitted -- a method may name its own class, and two
        // classes may name each other.
        if Kind = 'ClassStmt' then
        begin
            if Script.KnownGlobal (TheStmt.Name.Lexeme) then
                Refuse ('A redeclaration of ''' + Str (TheStmt.Name.Lexeme) + '''');

            Script.GlobalSlot (TheStmt.Name.Lexeme);

            var Parent := '';
            if TheStmt.Superclass <> Nil then
                Parent := Str (TheStmt.Superclass.Name.Lexeme);

            CLASS_PARENTS.Put (ToLower (Str (TheStmt.Name.Lexeme)), Parent);
        end

        if Kind = 'FunctionStmt' then
        begin
            // Two declarations of one name are an OVERLOAD SET, which selects
            // at the call on the whole signature [FUN-013].  One global slot
            // cannot hold both, and silently keeping the last one made a call
            // report the wrong arity -- so it is refused by name.
            if Script.KnownGlobal (TheStmt.Name.Lexeme) then
                Refuse ('An overload of ''' + Str (TheStmt.Name.Lexeme) + '''');

            Script.GlobalSlot (TheStmt.Name.Lexeme);
        end

        // `uses` is NOT transitive: a name in a module this program's modules
        // import is not visible here, and claiming a slot for it made it
        // readable -- so 0085-uses-is-not-transitive printed 'from Deep' where
        // it should have refused the name.  Reach counts down, so the root's
        // own statements and its direct imports are claimed and nothing below.
        //
        // This is an approximation of the Resolver's answer rather than the
        // answer itself, and a private name [MOD-004] is the case it does not
        // yet get right.  The emitter re-resolving names it could be asking
        // the Resolver about is the thing to fix, not this arithmetic.
        if Kind = 'ModuleStmt' and Reach > 0 then
            if TheStmt.Statements <> Nil then
                ClaimGlobalSlots (TheStmt.Statements, Reach - 1);
    end
end

/// Whether a declaration is visible above where it is written.
///
/// A subprogram, a class and an enumeration are; a `var` is not, which is the
/// distinction 0044-variables-are-not-hoisted exists to draw.
function Hoisted (TheStmt : Any) : Boolean;
begin
    var Kind := KindOf (TheStmt);

    Exit Kind = 'FunctionStmt' or Kind = 'ClassStmt' or Kind = 'EnumStmt';
end

/// Compiles a parsed program into a chunk ending in OP_RETURN.
///
/// # Raises
///
/// Whatever Refuse raises, for a construct with no opcodes yet.
function CompileProgram (Statements : List) : Chunk;
begin
    Into   := Chunk ();
    Script := Into;

    Locals      := List ();
    Depths      := List ();
    Depth       := 0;
    ModuleDepth := 0;
    Returning   := '';
    ENUM_NAMES    := List ();
    CLASS_PARENTS := Map ();

    ClaimGlobalSlots (Statements, 1);

    // DECLARATIONS FIRST, because a function is visible above its own
    // declaration and so is a class [0044, 0122].  Claiming the slot is not
    // enough: the slot has to be DEFINED before a statement above it runs, or
    // the call reports the name undefined.
    //
    // A `var` is not hoisted -- 'variables are not hoisted' is the other half
    // of 0044 -- so only subprograms, classes and enumerations move.
    for var TheStmt in Statements do
        if Hoisted (TheStmt) then EmitStmt (TheStmt);

    for var TheStmt in Statements do
    begin
        if not Hoisted (TheStmt) then EmitStmt (TheStmt);

        // A hoisted class's PARENT is attached here, in source order, for the
        // reason EmitInheritance gives.
        if KindOf (TheStmt) = 'ClassStmt' then EmitInheritance (TheStmt);
    end

    // Something must be on the stack for OP_RETURN to answer.
    Into.Emit (OP_NIL);
    Into.Emit (OP_RETURN);

    Exit Into;
end
