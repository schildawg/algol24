/// The driver: reads the command line and wires the one front end to whichever
/// back end was asked for.
///
///     Scanner -> Parser -> Resolver -> TypeChecker -> Interpreter
///                                                  -> CEmitter
///
/// Run, RunTests and Compile deliberately share that front end.  A program that
/// fails to parse or type-check must fail identically whichever back end is
/// asked for, or the two stop describing one language.
///
/// The 'uses' order matters: a module's functions close over the environment its
/// file was loaded in, so TypeChecker must come after Parser for its test blocks
/// to reach the parser.
unit Main;

uses Token;
uses TokenType;

uses Expr;
uses Stmt;

uses Environment;
uses ObjFunction;
uses ObjClass;
uses ObjInstance;
uses ObjEnum;
uses ObjCollection;
uses ObjBuffer;
uses ObjFile;
uses SourceCode;
uses Console;

uses Scanner;
uses Parser;

uses TypeChecker;

uses Resolver;
uses Interpreter;
uses CEmitter;

/// Reads a whole file.
///
/// ReadLn drops the terminator, so the lines are rejoined with #10 -- which is
/// what the language says a line ends with, and what the scanner counts.
function ReadSource(Name : String) : String;
begin
    var F := TextFile();
    F.Assign(Name);
    F.Reset();

    var Result := Buffer();

    while not F.Eof do
    begin
        Result.Append (F.ReadLn());
        Result.Append (#10);
    end

    F.Close();
    Exit Result.Text;
end

/// Fails the run if anything scanned badly.
///
/// A scan error is RECORDED rather than thrown: the Scanner sets HadError and
/// keeps the message, so every driver has to ask.  While none did,
/// 'var A @ := 1;' scanned to a token stream with the '@' silently dropped, and
/// algc ran and compiled a program it should have refused, with nothing able to
/// see it.
///
/// Called TWICE, and the two are not redundant.  After ScanTokens gets the
/// MESSAGE right: a damaged token stream often fails to parse, and the parse
/// error raises first, so an unterminated string was reported as
/// 'Expect expression!' while the scanner knew exactly what was wrong.  After
/// Parse gets the COVERAGE: HadError belongs to the Scanner MODULE rather than
/// to an instance, so it is one flag for the whole run, and the scanner a 'uses'
/// clause builds for an imported module sets the same one -- which the first
/// call cannot see.
///
/// It RAISES rather than halting, because a scan error is a diagnostic with a
/// message to print.  The test-failure path halts instead, which is a different
/// thing: there the report has already been printed and an exit status is all
/// that is left to choose.
///
/// # Raises
///
/// The scanner's own message, unchanged.
///
/// # Satisfies
///
/// [INI-006]
procedure CheckScanned ();
begin
    if HadError then raise Str (LastError);
end

/// Scans, parses and resolves, then runs the test blocks instead of the
/// program.  The main block is never executed.
///
/// Answers the number of failures, so the caller can exit non-zero.
function RunTests(Source : String, FileName : String) : Integer;
var
   TheScanner     : Scanner;
   TheParser      : Parser;
   TheResolver    : Resolver;
   TheInterpreter : Interpreter;

   Stmts : List;

begin
    SourceCode.Begins (FileName);

    TheScanner := Scanner(Source);
    TheParser := Parser(TheScanner.ScanTokens());
    CheckScanned ();

    TheParser.FileName := FileName;

    Stmts := TheParser.Parse();
    CheckScanned ();

    TheInterpreter := Interpreter();

    TheResolver := Resolver(TheInterpreter);
    TheResolver.ResolveAll(Stmts);

    TypeChecker().Resolve(Stmts);

    Exit TheInterpreter.RunTests(Stmts, FileName);
end

/// Scans, parses, resolves, type-checks and interprets one program.
///
/// An uncaught value is reported and ends the run: a program that fails is a
/// diagnostic and an exit status, not a trace.
///
/// # Satisfies
///
/// [ERR-001], [ERR-002], [ERR-008], [INI-001]
procedure Run(Source : String, FileName : String);
var
   TheScanner     : Scanner;
   TheParser      : Parser;
   TheResolver    : Resolver;
   TheInterpreter : Interpreter;

   Tokens : List;
   Stmts  : List;

begin
    SourceCode.Begins (FileName);

    TheScanner := Scanner(Source);
    Tokens := TheScanner.ScanTokens();
    CheckScanned ();

    TheParser := Parser(Tokens);
    TheParser.FileName := FileName;

    Stmts := TheParser.Parse();
    CheckScanned ();

    TheInterpreter := Interpreter();
    TheInterpreter.RootFile := FileName;

    TheResolver := Resolver(TheInterpreter);
    TheResolver.ResolveAll(Stmts);

    TypeChecker().Resolve(Stmts);

    TheInterpreter.Interpret(Stmts);
end

/// Collects the interpreted program's own arguments, starting with its name.
///
/// From index First onward, so what the program sees is what it would see run
/// directly.  'algc --test Files.a24' has to give that suite ParamCount () = 0
/// and ParamStr (0) = 'Files.a24', not algc's own two arguments.
///
/// # Satisfies
///
/// [INI-007]
function ArgumentsFrom (First : Integer) : List;
var
    Result : List := [];

begin
    for var I := First; I <= ParamCount(); I := I + 1 do
        Result.Add (ParamStr (I));

    Exit Result;
end

/// Scans, parses, resolves and type-checks, then emits C instead of running.
///
/// The same front end as Run, deliberately: a program that fails to parse or
/// type-check must fail identically whichever back end is asked for, or the two
/// stop describing one language.
///
/// The runtime is copied in beside the emitted files, so the directory is
/// self-contained and 'cc -std=c11 -O2 -o prog DIR/*.c' is the whole build.
///
/// # Raises
///
/// Whatever the emitter refuses by name.
procedure Compile (Source : String, FileName : String, WantTests : Boolean,
                   OutDir : String);
var
   TheScanner : Scanner;
   TheParser  : Parser;
   Stmts      : List;

begin
    SourceCode.Begins (FileName);

    TheScanner := Scanner(Source);
    TheParser := Parser(TheScanner.ScanTokens());
    CheckScanned ();

    TheParser.FileName := FileName;

    Stmts := TheParser.Parse();
    CheckScanned ();

    var TheInterpreter := Interpreter();
    Resolver(TheInterpreter).ResolveAll(Stmts);
    TypeChecker().Resolve(Stmts);

    var TheEmitter := CEmitter();
    TheEmitter.CompilingFile (FileName);

    if WantTests then TheEmitter.WithTests();

    var TheFiles := TheEmitter.Emit (Stmts, TheEmitter.UnitNameOf (FileName));

    for var Name in TheFiles.Keys() do
    begin
        var Out := TextFile();

        Out.Assign (OutDir + '/' + Str (Name));
        Out.Rewrite();
        Out.Write (Str (TheFiles.Get (Name)));
        Out.Close();
    end

    var Runtime := RuntimeFolder ();

    if Runtime = '' then
        WriteLn ('[WARN] algol.c and algol.h were not found, so ' + OutDir
               + ' will not compile on its own.');
    else
    begin
        CopyFile (Runtime + '/algol.c', OutDir + '/algol.c');
        CopyFile (Runtime + '/algol.h', OutDir + '/algol.h');
    end
end

/// The release this compiler reports for '--version'.
const VERSION := '0.1.2';

/// Gets the directory part of a path, or '' when there is none.
function FolderOf (Path : String) : String;
var
    Cut : Integer := -1;

begin
    for var I := 0; I < Length (Path); I := I + 1 do
        if Path[I] = '/' then Cut := I;

    if Cut < 0 then Exit '';

    Exit Copy (Path, 0, Cut);
end

/// Copies one file, answering whether it worked.
function CopyFile (FromPath : String, ToPath : String) : Boolean;
var
    Source : TextFile;
    Target : TextFile;

begin
    Source := TextFile ();
    Source.Assign (FromPath);

    try Source.Reset (); except on E : String do Exit False; end

    Target := TextFile ();
    Target.Assign (ToPath);
    Target.Rewrite ();

    while not Source.Eof do
        Target.WriteLn (Source.ReadLn ());

    Source.Close ();
    Target.Close ();

    Exit True;
end

/// Finds the runtime to copy beside emitted C.
///
/// Three places, in order: beside the binary, then 'bin/../share/algol24' for a
/// package manager, then 'bootstrap/' relative to the working directory.  The
/// language has no way to be told its own install prefix, so the search is the
/// answer.
///
/// Without this an INSTALLED algc emitted a directory that would not compile:
/// the emitter writes an include for the runtime and never wrote the runtime,
/// while '--help' said the output was self-contained.
function RuntimeFolder () : String;
var
    Own : String;

begin
    Own := FolderOf (ParamStr (0));

    if Own <> '' then
    begin
        if FileExists (Own + '/algol.h') then Exit Own;
        if FileExists (Own + '/../share/algol24/algol.h') then
            Exit Own + '/../share/algol24';
    end

    if FileExists ('bootstrap/algol.h') then Exit 'bootstrap';

    Exit '';
end

/// Prints how to invoke the compiler.
procedure Usage();
begin
    WriteLn ('algc -- the Algol-24 compiler.');
    WriteLn ('');
    WriteLn ('Usage:');
    WriteLn ('  algc <file.a24>                    run a program');
    WriteLn ('  algc --test <file.a24>             run its test blocks');
    WriteLn ('  algc --compile [--out=DIR] <file>  emit C into DIR (default: out)');
    WriteLn ('  algc --compile --test <file>       emit the tests and a runner');
    WriteLn ('  algc --version                     the version');
    WriteLn ('  algc --help                        this');
    WriteLn ('');
    WriteLn ('The emitted directory carries the runtime with it, so:');
    WriteLn ('  cc -std=c11 -O2 -o <name> <dir>/*.c');
end

/// The entry point: reads the arguments and chooses a driver.
///
///   algc                          -- prints the usage
///   algc <file>                   -- runs that file
///   algc --test <file>            -- runs that file's test blocks
///   algc --compile --out=DIR <f>  -- emits C into DIR
///
/// A failing test run exits 70 through Halt rather than raising, so a failing
/// suite prints the report and nothing else -- through either processor.
///
/// # Satisfies
///
/// [ERR-009], [INI-005], [STM-021]
procedure Main();
var
    Name : String;

begin
    // A bare 'algc' says how to invoke it.  It used to run a built-in sample
    // program instead, which reads as the compiler having done something to a
    // file that was never named -- surprising in a terminal, and more so
    // straight after an install.
    if ParamCount() = 0 then
    begin
        Usage();
        Exit;
    end

    if ParamStr(1) = '--help' then
    begin
        Usage();
        Exit;
    end

    if ParamStr(1) = '-h' then
    begin
        Usage();
        Exit;
    end

    if ParamStr(1) = '--version' then
    begin
        WriteLn ('algc ' + VERSION);
        Exit;
    end

    if ParamStr(1) = '--compile' then
    begin
        var WantTests := False;
        var OutDir    := 'out';

        Name := '';

        for var I := 2; I <= ParamCount(); I := I + 1 do
        begin
            var Arg := ParamStr(I);

            if Arg = '--test' then WantTests := True;
            else
            begin
                if Copy(Arg, 0, 6) = '--out=' then
                    OutDir := Copy(Arg, 6, Length(Arg) - 6);
                else Name := Arg;
            end
        end

        if not FileExists(Name) then
        begin
            raise 'algc: cannot open ' + Name;
        end

        Compile(ReadSource(Name), Name, WantTests, OutDir);
        Exit;
    end

    if ParamStr(1) = '--test' then
    begin
        Name := ParamStr(2);
        if not FileExists(Name) then
        begin
            raise 'algc: cannot open ' + Name;
        end

        SetProgramArguments (ArgumentsFrom (2));

        if RunTests(ReadSource(Name), Name) > 0 then Halt (70);

        Exit;
    end

    Name := ParamStr(1);
    if not FileExists(Name) then
    begin
        raise 'algc: cannot open ' + Name;
    end

    SetProgramArguments (ArgumentsFrom (1));

    Run(ReadSource(Name), Name);
end

Main();
