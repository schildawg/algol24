/// The type checker, which is GRADUAL: an unknown type answers '' and that is
/// normal rather than an error.
///
/// A rule bites only where a type was written down.  Writing none stays entirely
/// permissive -- 'var A := M.Get (1);' is ordinary and unremarkable.
unit TypeChecker;

uses Console;
uses Interpreter;
uses Parser;
uses Scanner;
uses SourceCode;
uses Token;
uses TokenType;

/// A scoped symbol-to-type map.
///
/// An absent symbol answers '' rather than raising: not knowing a type is the
/// normal case in a gradually typed language, not an error.
class TypeLookup;
var
    /// The scopes now open, innermost last.
    Scopes   : List := [];

    /// Types declared at the top level, where there is no scope to push.
    Types    : Map  := [:];

    /// Class name to the class it inherits from.
    ///
    /// Flat rather than scoped, because classes are declared at the top level
    /// and never go out of scope, so scoping them would gain nothing.
    Parents  : Map  := [:];

    /// Deduced types, for a name declared without one.
    ///
    /// SCOPED, for the same reason Generics is, and it was a flat Map until
    /// Reduce started consulting it.  While only one helper read it, a stale
    /// entry could only lose checking; the moment an ordinary variable's type
    /// comes from here, a leftover 'String' from another function's C makes a
    /// correct program fail to check -- the one kind of wrong answer that is not
    /// harmless.
    Inferred : TypeLookup := Nil;

    /// Every name that denotes a type, FOLDED [SRC-011].
    ///
    /// A type name must denote a declared type, and this is what 'is' checks its
    /// right-hand side against.
    ///
    /// A set of its own rather than a test on Types.  Types maps a name to its
    /// type and a class registers itself under its own name, so 'GetType (N) = N'
    /// nearly works -- and answers true for 'var Dog : Dog;' too, which is a
    /// variable rather than a type.  Three lines of registration cost less than
    /// reasoning about that.
    ///
    /// NOT program-wide by accident: MapType walks into every ModuleStmt, so a
    /// type declared in any loaded file is registered before any expression is
    /// reduced, and declaration order across files does not matter.
    ///
    /// # Satisfies
    ///
    /// [TYP-013]
    DeclaredTypes : Set := Set();

    /// Declared element types -- 'List of Token' -- keyed by variable name.
    ///
    /// A TypeLookup of its own rather than a flat Map beside Parents, because
    /// this has to be SCOPED.  A stale element type is the one kind of wrong
    /// answer that is not harmless: '' and 'Any' mean "not known" and can only
    /// lose checking, while a leftover 'Token' from another function's L makes a
    /// correct program fail to check.
    Generics : TypeLookup := Nil;

    /// Whose body is being checked, so a bare method call can be resolved.
    /// '' outside a class.
    CurrentClassName : String := '';

begin
    /// Records a symbol's type in the innermost scope.
    procedure SetType (Symbol : String, TheType : String);
    begin
        if Scopes.IsEmpty then Types.Put (Symbol, TheType);
        else Scopes[Scopes.Length - 1].Put (Symbol, TheType);
    end

    /// Gets the type of a symbol, innermost scope first, or '' when unknown.
    function GetType (Symbol : String) : String;
    begin
        for var I := Scopes.Length - 1; I >= 0; I := I - 1 do
            if Scopes[I].Contains (Symbol) then Exit Str (Scopes[I].Get (Symbol));

        if Types.Contains (Symbol) then Exit Str (Types.Get (Symbol));

        Exit '';
    end

    /// Opens a scope, and the matching scope of Generics and Inferred.
    procedure BeginScope ();
    begin
        Scopes.Add ([:]);

        if Generics <> Nil then Generics.BeginScope ();
        if Inferred <> Nil then Inferred.BeginScope ();
    end

    /// Closes the innermost scope, discarding what it recorded.
    procedure EndScope ();
    begin
        Scopes.RemoveAt (Scopes.Length - 1);

        if Generics <> Nil then Generics.EndScope ();
        if Inferred <> Nil then Inferred.EndScope ();
    end
end

/// The gradual type checker.
///
/// Two passes over the top-level statements: every declaration is mapped first,
/// so the order they are written in does not matter, and then the bodies are
/// checked.
///
/// 'Any' means "not known" and is compatible in BOTH directions.  That rule is
/// easy to break one caller at a time, so there is exactly one helper --
/// Assignable -- and every check goes through it.  Add a caller rather than
/// another copy.
///
/// Reduction lives here rather than on the Expr nodes.  Nothing depends on the
/// placement -- Reduce is called from the checker and from nowhere else -- and
/// one dispatch is easier to keep correct than fifteen methods spread across a
/// file of node declarations.
class TypeChecker;
var
    /// The symbol table: types, parents, deduced types and element types.
    Lookup : TypeLookup;

    /// The return type of the subprogram being checked, so an 'Exit' can be
    /// measured against it.  '' outside one, which makes every Exit acceptable.
    CurrentReturn : String := '';

    /// Class name to the list of members a 'private:' section covered.
    PrivateMembers : Map := [:];

    /// Class name to the list of members declared 'property'.
    ///
    /// Kept so that ASSIGNMENT to one can be refused where the receiver's type
    /// is known.  Reading is the runtime's business -- it knows the class -- but
    /// assignment is the only thing a read-only member forbids, and the checker
    /// is the only pass that can say so without a run-time cost.
    PropertyMembers : Map := [:];

    /// The built-ins' return types, kept apart from Lookup and never written to
    /// again.
    ///
    /// A user declaration of the same name OVERWRITES the entry in Lookup --
    /// which is right, since the bare name now means the declaration -- and it
    /// is exactly why a qualified 'System.Mod' cannot read its type from there.
    ///
    /// # Satisfies
    ///
    /// [RT-010]
    BuiltinTypes : Map := [:];

    /// Top-level name to how many subprograms share it, which is what decides
    /// whether a call binds at run time.
    Overloads : Map := [:];

    /// Every signature already declared, so a duplicate can be refused.
    Signatures : Set := [];

    /// Call sites already warned about, keyed by line and name, so one call
    /// warns once.
    Warned : Set := [];

begin
    /// Makes a checker with the built-ins' types already known.
    constructor Init ();
    begin
        this.Lookup := TypeLookup();
        this.Lookup.Generics := TypeLookup();
        this.Lookup.Inferred := TypeLookup();

        for var Kind in ['List', 'Map', 'Set', 'Stack', 'Array'] do
        begin
            Lookup.SetType (Kind + '::Length',   'Integer');
            Lookup.SetType (Kind + '::IsEmpty',  'Boolean');
            Lookup.SetType (Kind + '::Contains', 'Boolean');
        end

        Lookup.SetType ('List::IndexOf',  'Integer');
        Lookup.SetType ('Array::IndexOf', 'Integer');

        Lookup.SetType ('Map::Keys',   'List');
        Lookup.SetType ('Map::Values', 'List');
        Lookup.SetType ('Set::ToList', 'List');

        Lookup.SetType ('TextFile::ReadLn', 'String');
        Lookup.SetType ('TextFile::Eof',    'Boolean');

        Lookup.SetType ('Buffer::Text',    'String');
        Lookup.SetType ('Buffer::Length',  'Integer');
        Lookup.SetType ('Buffer::IsEmpty', 'Boolean');
        Lookup.SetType ('Buffer::GetInt',  'Integer');

        Lookup.SetType ('Length', 'Integer');
        Lookup.SetType ('Pos',    'Integer');
        Lookup.SetType ('Copy',   'String');
        Lookup.SetType ('Str',    'String');
        Lookup.SetType ('Array',  'Array');
        Lookup.SetType ('List',   'List');
        Lookup.SetType ('Map',    'Map');
        Lookup.SetType ('Set',    'Set');
        Lookup.SetType ('Stack',  'Stack');

        Lookup.SetType ('Buffer',     'Buffer');
        Lookup.SetType ('TextFile',   'TextFile');
        Lookup.SetType ('FileExists', 'Boolean');
        Lookup.SetType ('ParamCount', 'Integer');
        Lookup.SetType ('ParamStr',   'String');

        Lookup.SetType ('Write',   'Nil');
        Lookup.SetType ('WriteLn', 'Nil');

        Lookup.SetType ('Ord',  'Integer');
        Lookup.SetType ('Char', 'Char');
        Lookup.SetType ('Mod',  'Integer');

        Lookup.SetType ('clock',  'Double');

        Lookup.SetType ('Copy',    'String');
        Lookup.SetType ('Str',     'String');
        Lookup.SetType ('ParamStr', 'String');
        Lookup.SetType ('Length',  'Integer');
        Lookup.SetType ('Pos',     'Integer');
        Lookup.SetType ('Ord',     'Integer');
        Lookup.SetType ('ParamCount', 'Integer');
        Lookup.SetType ('FileExists', 'Boolean');

        for var Name in ['Length', 'Pos', 'Copy', 'Str', 'Array', 'List', 'Map',
                         'Set', 'Stack', 'Buffer', 'TextFile', 'FileExists',
                         'ParamCount', 'ParamStr', 'Write', 'WriteLn', 'Ord',
                         'Val', 'Char', 'Mod', 'clock'] do
            BuiltinTypes.Put (Name, Lookup.GetType (Name));

        for var Name in ['Any', 'Boolean', 'Integer', 'Double', 'String', 'Char',
                         'List', 'Set', 'Stack', 'Array', 'Map',
                         'TextFile', 'Buffer', 'Pointer',
                         'Byte', 'Word', 'Short'] do
            Lookup.DeclaredTypes.Add (FoldCase (Name));
    end

    /// Gets the class that hid a member, walking the inheritance chain, or ''
    /// when nothing did.
    ///
    /// A subclass does not reach what its parent hid, so the search reports
    /// which ancestor made the member private.
    function HiddenBy (TheType : String, Member : String) : String;
    var
        At   : String;
        Seen : List;

    begin
        At := TheType;
        Seen := List();

        while At <> '' and At <> 'Any' and not Seen.Contains (At) do
        begin
            Seen.Add (At);

            if PrivateMembers.Contains (At) then
                if PrivateMembers.Get (At).Contains (Member) then Exit At;

            At := Str (Lookup.Parents.Get (At));
            if At = 'nil' then At := '';
        end

        Exit '';
    end

    /// Gets the type of the thing to the left of a dot, or '' when unknown.
    function TypeOfReceiver (Obj : Any) : String;
    var
        TheType : String;

    begin
        TheType := Reduce (Obj);

        if (TheType = '' or TheType = 'Any') and Obj is VariableExpr then
        begin
            var Deduced := Lookup.Inferred.GetType (Str (Obj.Name.Lexeme));
            if Deduced <> '' then Exit Deduced;
        end

        Exit TheType;
    end

    /// Gets the members a class declared with 'property'.
    function PropertiesOf (TheStmt : Any) : List;
    var
        Found : List;

    begin
        Found := List();

        for var I := 0; I < TheStmt.Methods.Length; I := I + 1 do
            if TheStmt.Methods[I].IsProperty then
                Found.Add (Str (TheStmt.Methods[I].Name.Lexeme));

        Exit Found;
    end

    /// Gets the class that declared a member as a property, walking the chain,
    /// or '' when none did.
    function DeclaresProperty (TheType : String, Member : String) : String;
    var
        At   : String;
        Seen : List;

    begin
        At := TheType;
        Seen := List();

        while At <> '' and At <> 'Any' and not Seen.Contains (At) do
        begin
            Seen.Add (At);

            if PropertyMembers.Contains (At) then
                if PropertyMembers.Get (At).Contains (Member) then Exit At;

            At := Str (Lookup.Parents.Get (At));
            if At = 'nil' then At := '';
        end

        Exit '';
    end

    /// Gets the declared element type of a collection, or '' when none was
    /// written.
    ///
    /// Available only for a plain NAME: there is nowhere to have written the
    /// element type of an arbitrary expression, so an insertion through one is
    /// unchecked.
    function ElementOf (Obj : Any) : String;
    begin
        if ClassNameOf (Obj) <> 'VariableExpr' then Exit '';

        Exit Lookup.Generics.GetType (Str (Obj.Name.Lexeme));
    end

    /// Refuses a value that does not fit a collection's declared element type.
    ///
    /// EVERY route in is covered, and there are five: Add, Push, Put, subscript
    /// assignment, and the collection literal at a declaration.  A check
    /// covering some of them would be worse than none -- a fence with a gate in
    /// it invites the declared type to be trusted, and a type trusted in four
    /// places and not the fifth is more dangerous than one trusted nowhere.
    ///
    /// It CHECKS and does not convert.  'D.Add (2)' into a 'List of Double' is
    /// accepted because an Integer widens to a Double, and the element stored is
    /// the Integer 2: widening happens where a value reaches a written type, and
    /// an element is not one.
    ///
    /// # Raises
    ///
    /// 'Expected T, found U.' against the token that inserted the value.
    ///
    /// # Satisfies
    ///
    /// [VAR-016]
    procedure CheckElement (Element : String, Actual : String, Where : Token);
    begin
        if Element = '' or Element = 'Any' then Exit;
        if Actual  = '' or Actual  = 'Any' then Exit;

        if not Assignable (Element, Actual) then
            raise Mismatch (Where, Element, Actual);
    end

    /// Gets which argument of an inserting member carries the element, or -1
    /// for a member that inserts nothing.
    ///
    /// 'Put' constrains its SECOND argument: a 'Map of T' declares the type of
    /// what is stored, and the key is not constrained.
    function InsertedAt (Member : String) : Integer;
    var
        Folded : String;

    begin
        Folded := FoldCase (Member);

        if Folded = 'add'  then Exit 0;
        if Folded = 'push' then Exit 0;
        if Folded = 'put'  then Exit 1;

        Exit -1;
    end

    /// Checks every element of a collection literal against a declared element
    /// type.
    ///
    /// The literal at a declaration is the fifth route in, and the only one that
    /// is not a member call.
    procedure CheckLiteral (Element : String, Initializer : Any, Where : Token);
    begin
        if Element = '' or Element = 'Any' then Exit;
        if Initializer = Nil then Exit;
        if ClassNameOf (Initializer) <> 'CollectionExpr' then Exit;

        for var I := 0; I < Initializer.Values.Length; I := I + 1 do
            CheckElement (Element, Reduce (Initializer.Values[I]), Where);
    end

    /// Refuses a read of a member a class marked private.
    ///
    /// Checked where the receiver's type is KNOWN, and nowhere else -- the same
    /// bargain the element types make.  Privacy belongs to the class rather than
    /// to the object, so a method may reach another instance's private members.
    ///
    /// # Raises
    ///
    /// A refusal naming the member and the class that hid it.
    ///
    /// # Satisfies
    ///
    /// [DCL-013], [DCL-014], [DCL-015]
    procedure CheckVisibility (Obj : Any, Member : Token);
    var
        TheType : String;

    begin
        TheType := TypeOfReceiver (Obj);

        var Owner := HiddenBy (TheType, Str (Member.Lexeme));

        if Owner = '' or Owner = Lookup.CurrentClassName then Exit;

        raise '''' + Member.Lexeme + ''' is private to ' + Owner + '.';
    end

    /// Whether a value of one type may reach a written type.
    ///
    /// THE ONE GATE.  Every type check in the language goes through this, because
    /// the rule it enforces -- that 'Any' means "not known" and is compatible in
    /// both directions -- is easy to break one caller at a time.  Add a caller
    /// rather than another copy.
    ///
    /// It widens: an Integer reaches a Double and a Char reaches a String, at
    /// every one of the six contexts where a value meets a written type.  It does
    /// not narrow.
    ///
    /// A value whose type could not be determined at all does NOT satisfy a
    /// written type; the conversion must be written, and 'as' is how to write it.
    /// That is the strict half of the gradual bargain, and it depends on the
    /// checker actually knowing the types it could know -- see DEF-35, where a
    /// declaration below its use is not yet recorded and a correct program is
    /// refused.
    ///
    /// # Satisfies
    ///
    /// [FUN-008], [TYP-004], [TYP-006], [VAL-001], [VAL-002], [VAR-003],
    /// [VAR-004], [VAR-005], [VAR-006], [VAR-017], [VAR-018]
    function Assignable (Expected : String, Actual : String) : Boolean;
    var
        Parent : String;

    begin
        Expected := UnderlyingType (Expected);
        Actual   := UnderlyingType (Actual);

        if Expected = '' or Actual = '' then Exit True;
        if Expected = 'Any' or Actual = 'Any' then Exit True;
        if Actual = 'Nil' then Exit True;
        if Expected = Actual then Exit True;

        if Expected = 'Double' and Actual = 'Integer' then Exit True;
        if Expected = 'String' and Actual = 'Char'    then Exit True;

        Parent := Str (Lookup.Parents.Get (Actual));
        while Parent <> '' and Parent <> 'nil' do
        begin
            if Expected = Parent then Exit True;

            Parent := Str (Lookup.Parents.Get (Parent));
        end

        Exit False;
    end

    /// Builds the message a type failure reports.
    ///
    /// One place, so every mismatch in the language reads the same way.
    ///
    /// # Satisfies
    ///
    /// [ERR-006]
    function Mismatch (Where : Token, Expected : String, Actual : String) : String;
    var
        Found   : String;
        Message : String;

    begin
        Found := Actual;
        if Actual = '' then Found := 'an untyped expression';

        Message := 'Expected ' + Expected + ', found ' + Found + '.';

        Console.Error (Where, Message);

        Exit Message;
    end

    /// Checks a whole program: map every declaration, then check every body.
    ///
    /// Two passes, so the order declarations are written in does not matter.
    procedure Resolve (Statements : List);
    begin
        for var I := 0; I < Statements.Length; I := I + 1 do
            MapType (Statements[I]);

        for var I := 0; I < Statements.Length; I := I + 1 do
            Check (Statements[I]);
    end

    /// Records what a declaration declares, before any body is checked.
    ///
    /// Walks into every ModuleStmt, so a type declared in any loaded file is
    /// registered before any expression is reduced.
    procedure MapType (TheStmt : Any);
    var
        Kind : String;

    begin
        Kind := ClassNameOf (TheStmt);

        if Kind = 'ClassStmt' then
        begin
            PrivateMembers.Put (Str (TheStmt.Name.Lexeme), TheStmt.PrivateMembers);
            PropertyMembers.Put (Str (TheStmt.Name.Lexeme), PropertiesOf (TheStmt));
            Lookup.SetType (TheStmt.Name.Lexeme, TheStmt.Name.Lexeme);
            Lookup.DeclaredTypes.Add (FoldCase (TheStmt.Name.Lexeme));

            if TheStmt.Superclass <> Nil then
                Lookup.Parents.Put (TheStmt.Name.Lexeme, TheStmt.Superclass.Name.Lexeme);

            for var I := 0; I < TheStmt.Fields.Length; I := I + 1 do
            begin
                Lookup.SetType (TheStmt.Name.Lexeme + '::' + TheStmt.Fields[I].Name.Lexeme,
                                TheStmt.Fields[I].TypeName);

                Lookup.Generics.SetType (Str (TheStmt.Fields[I].Name.Lexeme),
                                         TheStmt.Fields[I].Generic);
            end

            for var I := 0; I < TheStmt.Methods.Length; I := I + 1 do
                Lookup.SetType (TheStmt.Name.Lexeme + '::' + TheStmt.Methods[I].Name.Lexeme,
                                TheStmt.Methods[I].ReturnType);
        end

        if Kind = 'ObjectStmt' then
        begin
            PrivateMembers.Put (Str (TheStmt.Name.Lexeme), TheStmt.PrivateMembers);
            Lookup.SetType (TheStmt.Name.Lexeme, TheStmt.Name.Lexeme);
            Lookup.DeclaredTypes.Add (FoldCase (TheStmt.Name.Lexeme));

            if TheStmt.Superclass <> Nil then
                Lookup.Parents.Put (TheStmt.Name.Lexeme, TheStmt.Superclass.Name.Lexeme);

            for var I := 0; I < TheStmt.Fields.Length; I := I + 1 do
            begin
                Lookup.SetType (TheStmt.Name.Lexeme + '::' + TheStmt.Fields[I].Name.Lexeme,
                                TheStmt.Fields[I].TypeName);

                Lookup.Generics.SetType (Str (TheStmt.Fields[I].Name.Lexeme),
                                         TheStmt.Fields[I].Generic);
            end

            for var I := 0; I < TheStmt.Methods.Length; I := I + 1 do
                Lookup.SetType (TheStmt.Name.Lexeme + '::' + TheStmt.Methods[I].Name.Lexeme,
                                TheStmt.Methods[I].ReturnType);
        end

        if Kind = 'FunctionStmt' then
        begin
            var Folded := FoldCase (Str (TheStmt.Name.Lexeme));

            var Signature := Folded + '/' + Str (TheStmt.Params.Length);
            for var I := 0; I < TheStmt.ParamTypes.Length; I := I + 1 do
                Signature := Signature + '/' + FoldCase (Str (TheStmt.ParamTypes[I]));

            if not Signatures.Contains (Signature) then
            begin
                Signatures.Add (Signature);

                var Seen := 0;
                if Overloads.Contains (Folded) then Seen := Overloads.Get (Folded) as Integer;

                Overloads.Put (Folded, Seen + 1);
            end

            Lookup.SetType (TheStmt.Name.Lexeme, TheStmt.ReturnType);

            Lookup.Generics.SetType (Str (TheStmt.Name.Lexeme), TheStmt.ReturnGeneric);
        end

        if Kind = 'SubrangeStmt' then
            Lookup.DeclaredTypes.Add (FoldCase (TheStmt.Name.Lexeme));

        if Kind = 'EnumStmt' then
        begin
            Lookup.SetType (TheStmt.Name.Lexeme, TheStmt.Name.Lexeme);
            Lookup.DeclaredTypes.Add (FoldCase (TheStmt.Name.Lexeme));

            for var I := 0; I < TheStmt.Members.Length; I := I + 1 do
            begin
                Lookup.SetType (TheStmt.Members[I].Lexeme, TheStmt.Name.Lexeme);

                Lookup.SetType (TheStmt.Name.Lexeme + '::' + TheStmt.Members[I].Lexeme,
                                TheStmt.Name.Lexeme);
            end
        end

        if Kind = 'VarStmt' then
        begin
            Lookup.SetType (TheStmt.Name.Lexeme, TheStmt.TypeName);
            Lookup.Generics.SetType (Str (TheStmt.Name.Lexeme), TheStmt.Generic);
        end

        if Kind = 'VarGroupStmt' then
            for var I := 0; I < TheStmt.Names.Length; I := I + 1 do
            begin
                Lookup.SetType (TheStmt.Names[I].Lexeme, TheStmt.TypeName);
                Lookup.Generics.SetType (Str (TheStmt.Names[I].Lexeme), TheStmt.Generic);
            end

        if Kind = 'ModuleStmt' then
            if TheStmt.Statements <> Nil then
                for var I := 0; I < TheStmt.Statements.Length; I := I + 1 do
                    MapType (TheStmt.Statements[I]);
    end

    /// Checks one statement, and the expressions inside it.
    procedure Check (TheStmt : Any);
    var
        Kind : String;

    begin
        Kind := ClassNameOf (TheStmt);

        if Kind = 'VarStmt' then
        begin
            Lookup.SetType (TheStmt.Name.Lexeme, TheStmt.TypeName);
            Lookup.Generics.SetType (Str (TheStmt.Name.Lexeme), TheStmt.Generic);

            if TheStmt.Initializer <> Nil and TheStmt.TypeName = '' then
                Lookup.Inferred.SetType (Str (TheStmt.Name.Lexeme), Reduce (TheStmt.Initializer));

            CheckLiteral (Str (TheStmt.Generic), TheStmt.Initializer, TheStmt.Name);

            if TheStmt.Initializer <> Nil and TheStmt.TypeName <> '' then
            begin
                var Actual := Reduce (TheStmt.Initializer);

                if TheStmt.TypeName <> 'Any' then
                    if Actual = '' or Actual = 'Any' or not Assignable (TheStmt.TypeName, Actual) then
                        raise Mismatch (TheStmt.Name, TheStmt.TypeName, Actual);
            end
            Exit;
        end

        if Kind = 'VarGroupStmt' then
        begin
            for var I := 0; I < TheStmt.Names.Length; I := I + 1 do
            begin
                Lookup.SetType (TheStmt.Names[I].Lexeme, TheStmt.TypeName);
                Lookup.Generics.SetType (Str (TheStmt.Names[I].Lexeme), TheStmt.Generic);
            end

            if TheStmt.Initializer <> Nil and TheStmt.TypeName <> '' then
            begin
                var Actual := Reduce (TheStmt.Initializer);

                if TheStmt.TypeName <> 'Any' then
                    if Actual = '' or Actual = 'Any' or not Assignable (TheStmt.TypeName, Actual) then
                        raise Mismatch (TheStmt.Names[0], TheStmt.TypeName, Actual);
            end
            Exit;
        end

        if Kind = 'ExpressionStmt' then
        begin
            Reduce (TheStmt.Expression);
            Exit;
        end

        if Kind = 'BlockStmt' then
        begin
            Lookup.BeginScope();
            for var I := 0; I < TheStmt.Statements.Length; I := I + 1 do
                Check (TheStmt.Statements[I]);

            Lookup.EndScope();
            Exit;
        end

        if Kind = 'IfStmt' then
        begin
            Reduce (TheStmt.Condition);
            Check (TheStmt.ThenBranch);
            if TheStmt.ElseBranch <> Nil then Check (TheStmt.ElseBranch);
            Exit;
        end

        if Kind = 'ForInStmt' then
        begin
            Reduce (TheStmt.Iterable);

            Lookup.BeginScope();

            var Element := '';
            if TheStmt.Iterable is VariableExpr then
                Element := Lookup.Generics.GetType (Str (TheStmt.Iterable.Name.Lexeme));

            Lookup.SetType (TheStmt.Name.Lexeme, Element);

            Check (TheStmt.Body);
            Lookup.EndScope();
            Exit;
        end

        if Kind = 'WhileStmt' then
        begin
            Reduce (TheStmt.Condition);
            Check (TheStmt.Body);

            if TheStmt.Increment <> Nil then Reduce (TheStmt.Increment);
            Exit;
        end

        if Kind = 'LabelStmt' then
        begin
            Check (TheStmt.Inner);
            Exit;
        end

        if Kind = 'ReturnStmt' then
        begin
            if TheStmt.Value <> Nil then
            begin
                var Actual := Reduce (TheStmt.Value);

                if not Assignable (CurrentReturn, Actual) then
                    raise Mismatch (TheStmt.Keyword, CurrentReturn, Actual);
            end
            Exit;
        end

        if Kind = 'TryStmt' then
        begin
            Check (TheStmt.TryBlock);

            var Keys := TheStmt.Handlers.Keys();
            for var I := 0; I < Keys.Length; I := I + 1 do
                Check (TheStmt.Handlers.Get (Keys[I]).Body);

            Exit;
        end

        if Kind = 'BreakStmt' then Exit;

        if Kind = 'ModuleStmt' then
        begin
            if TheStmt.Statements = Nil then Exit;

            Lookup.BeginScope();

            for var Name in BuiltinTypes do
                Lookup.SetType (Name, Str (BuiltinTypes.Get (Name)));

            for var I := 0; I < TheStmt.Statements.Length; I := I + 1 do
                MapType (TheStmt.Statements[I]);

            for var I := 0; I < TheStmt.Statements.Length; I := I + 1 do
                Check (TheStmt.Statements[I]);

            Lookup.EndScope();
            Exit;
        end

        if Kind = 'RaiseStmt' then
        begin
            Reduce (TheStmt.Value);
            Exit;
        end

        if Kind = 'FunctionStmt' then
        begin
            CheckFunction (TheStmt);
            Exit;
        end

        if Kind = 'ObjectStmt' or Kind = 'ClassStmt' then
        begin
            var Enclosing := Lookup.CurrentClassName;
            Lookup.CurrentClassName := TheStmt.Name.Lexeme;

            Lookup.BeginScope();

            for var I := 0; I < TheStmt.Fields.Length; I := I + 1 do
            begin
                var Field := TheStmt.Fields[I];

                Lookup.SetType (Field.Name.Lexeme, Field.TypeName);
                Lookup.Generics.SetType (Str (Field.Name.Lexeme), Field.Generic);
            end

            for var I := 0; I < TheStmt.Methods.Length; I := I + 1 do
                CheckFunction (TheStmt.Methods[I]);

            Lookup.EndScope();

            Lookup.CurrentClassName := Enclosing;
            Exit;
        end
    end

    /// Checks a subprogram body against its declared parameter and return
    /// types.
    ///
    /// CurrentReturn is saved and restored around the body, because a
    /// subprogram may be declared inside another.
    procedure CheckFunction (TheFunction : Any);
    var
        Enclosing : String;

    begin
        Enclosing := CurrentReturn;
        CurrentReturn := TheFunction.ReturnType as String;

        Lookup.BeginScope();

        for var I := 0; I < TheFunction.Params.Length; I := I + 1 do
        begin
            Lookup.SetType (TheFunction.Params[I].Lexeme, Str (TheFunction.ParamTypes[I]));

            if I < TheFunction.ParamGenerics.Length then
                Lookup.Generics.SetType (Str (TheFunction.Params[I].Lexeme),
                                         Str (TheFunction.ParamGenerics[I]));
        end

        for var I := 0; I < TheFunction.Body.Length; I := I + 1 do
            if ClassNameOf (TheFunction.Body[I]) = 'FunctionStmt' then
                Lookup.SetType (TheFunction.Body[I].Name.Lexeme,
                                TheFunction.Body[I].ReturnType);

        for var I := 0; I < TheFunction.Body.Length; I := I + 1 do
            Check (TheFunction.Body[I]);

        Lookup.EndScope();
        CurrentReturn := Enclosing;
    end

    /// Warns that a call will select among overloads at run time.
    ///
    /// It reports a COST, not a fault: the program compiles and runs exactly as
    /// it would without the warning.
    ///
    /// It fires on whether the NAME is overloaded, and never consults the
    /// argument types -- because run-time selection is the language's rule and
    /// no static rule could replace it.  So inference cannot remove a warning;
    /// only naming the parameters can, since a name identifies one signature
    /// where values only describe something several signatures might accept.
    ///
    /// Warned keys on line and name, so one call warns once however many times
    /// the checker reaches it.
    ///
    /// # Satisfies
    ///
    /// [ERR-010]
    procedure WarnIfDynamic (TheExpr : Any);
    var
        Folded : String;
        Seen   : Integer;
        Key    : String;

    begin
        if ClassNameOf (TheExpr.Callee) <> 'VariableExpr' then Exit;

        for var I := 0; I < TheExpr.ArgumentNames.Length; I := I + 1 do
            if Str (TheExpr.ArgumentNames[I]) <> '' then Exit;

        Folded := FoldCase (Str (TheExpr.Callee.Name.Lexeme));
        if not Overloads.Contains (Folded) then Exit;

        Seen := Overloads.Get (Folded) as Integer;
        if Seen < 2 then Exit;

        Key := Str (TheExpr.Paren.LineNumber) + ':' + Folded;
        if Warned.Contains (Key) then Exit;
        Warned.Add (Key);

        Console.Warn (SourceCode.Name() + ':' + Str (TheExpr.Paren.LineNumber) + ': '''
                    + Str (TheExpr.Callee.Name.Lexeme) + ''' selects among '
                    + Str (Seen) + ' overloads at run time.');
    end

    /// Reduces an expression to the type it yields, or '' when that is not
    /// known.
    ///
    /// '' is the ordinary answer rather than a failure: this is a gradual
    /// checker, and most expressions in most programs have no written type.
    ///
    /// A written cast wins outright -- 'X as T' reduces to T without consulting
    /// anything, which is how a programmer tells the checker what it could not
    /// work out.
    ///
    /// Three blind spots had to close before an assignment could be checked as
    /// strictly as a declaration, and each was found by tightening the check and
    /// seeing what this compiler's own sources tripped on: a variable declared
    /// without a type did not carry its deduced type into an expression; a bare
    /// name inside a method that is really a field had none, since a field is
    /// registered under 'Class::Field'; and a Buffer held in a variable declared
    /// 'Any' gave its Text no type.
    ///
    /// # Satisfies
    ///
    /// [VAR-016]
    function Reduce (TheExpr : Any) : String;
    var
        Kind : String;

    begin
        if TheExpr = Nil then Exit '';

        if TheExpr.Cast <> '' then Exit TheExpr.Cast;

        Kind := ClassNameOf (TheExpr);

        if Kind = 'LiteralExpr' then Exit TypeOfValue (TheExpr.Value);
        if Kind = 'GroupingExpr' then Exit Reduce (TheExpr.Expression);
        if Kind = 'VariableExpr' then
        begin
            var Written := Lookup.GetType (TheExpr.Name.Lexeme);
            if Written <> '' then Exit Written;

            if Lookup.CurrentClassName <> '' then
            begin
                var Owner := Str (Lookup.CurrentClassName);

                while Owner <> '' do
                begin
                    var AsField := Lookup.GetType (Owner + '::' + Str (TheExpr.Name.Lexeme));
                    if AsField <> '' then Exit AsField;

                    if not Lookup.Parents.Contains (Owner) then Owner := '';
                    else Owner := Str (Lookup.Parents.Get (Owner));
                end
            end

            Exit Lookup.Inferred.GetType (Str (TheExpr.Name.Lexeme));
        end

        if Kind = 'UnaryExpr' then
        begin
            if TheExpr.Op.TypeOfToken = TOKEN_NOT then Exit 'Boolean';

            Exit Reduce (TheExpr.Right);
        end

        if Kind = 'IsExpr' then
        begin
            Reduce (TheExpr.Obj);

            if not Lookup.DeclaredTypes.Contains
                       (FoldCase (CanonicalType (TheExpr.TypeName.Lexeme))) then
            begin
                var Message := 'Unknown type ''' + Str (TheExpr.TypeName.Lexeme) + '''.';

                Console.Error (TheExpr.TypeName, Message);
                raise Message;
            end

            Exit 'Boolean';
        end

        if Kind = 'BinaryExpr' then Exit ReduceBinary (TheExpr);

        if Kind = 'LogicalExpr' then Exit Reduce (TheExpr.Left);

        if Kind = 'AssignExpr' then
        begin
            var Declared := Lookup.GetType (TheExpr.Name.Lexeme);
            var Actual   := Reduce (TheExpr.Value);

            if Declared <> '' and Declared <> 'Any' then
                if Actual = '' or Actual = 'Any' or not Assignable (Declared, Actual) then
                    raise Mismatch (TheExpr.Name, Declared, Actual);

            TheExpr.Declared := Declared;

            Exit Declared;
        end

        if Kind = 'CallExpr' then
        begin
            var ArgTypes := List ();

            for var I := 0; I < TheExpr.Arguments.Length; I := I + 1 do
                ArgTypes.Add (Reduce (TheExpr.Arguments[I]));

            WarnIfDynamic (TheExpr);

            if ClassNameOf (TheExpr.Callee) = 'GetExpr' then
            begin
                var At := InsertedAt (Str (TheExpr.Callee.Name.Lexeme));

                if At >= 0 and At < ArgTypes.Length then
                    CheckElement (ElementOf (TheExpr.Callee.Obj), Str (ArgTypes[At]),
                                  TheExpr.Callee.Name);
            end

            Exit Reduce (TheExpr.Callee);
        end

        if Kind = 'GetExpr' then
        begin
            if TheExpr.Unit = 'System' then
            begin
                if BuiltinTypes.Contains (Str (TheExpr.Name.Lexeme)) then
                    Exit Str (BuiltinTypes.Get (Str (TheExpr.Name.Lexeme)));

                Exit '';
            end

            if TheExpr.Unit <> '' then Exit Lookup.GetType (Str (TheExpr.Name.Lexeme));

            CheckVisibility (TheExpr.Obj, TheExpr.Name);

            var Owner := TypeOfReceiver (TheExpr.Obj);
            if Owner = '' or Owner = 'Any' then Exit '';

            Exit Lookup.GetType (Owner + '::' + TheExpr.Name.Lexeme);
        end

        if Kind = 'SetExpr' then
        begin
            if TheExpr.Unit <> '' then Exit Reduce (TheExpr.Value);

            CheckVisibility (TheExpr.Obj, TheExpr.Name);

            var Owner  := TypeOfReceiver (TheExpr.Obj);
            var Actual := Reduce (TheExpr.Value);

            if Owner = '' and TheExpr.Obj is ThisExpr then
                Owner := Str (Lookup.CurrentClassName);

            if Owner <> '' and Owner <> 'Any' then
            begin
                var Declaring := DeclaresProperty (Owner, Str (TheExpr.Name.Lexeme));

                if Declaring <> '' then
                    raise '''' + Str (TheExpr.Name.Lexeme) + ''' is a property of '
                        + Declaring + ' and cannot be assigned.';

                var Declared := Lookup.GetType (Owner + '::' + TheExpr.Name.Lexeme);

                if Declared <> '' and Declared <> 'Any' and Actual <> '' then
                    if Actual = 'Any' or not Assignable (Declared, Actual) then
                        raise Mismatch (TheExpr.Name, Declared, Actual);

                TheExpr.Declared := Declared;
            end

            Exit Actual;
        end

        if Kind = 'ThisExpr' then Exit '';

        if Kind = 'CollectionExpr' then
        begin
            for var I := 0; I < TheExpr.Values.Length; I := I + 1 do
                Reduce (TheExpr.Values[I]);

            if TheExpr.IsMap then Exit 'Map';

            Exit 'List';
        end

        if Kind = 'SubscriptExpr' then
        begin
            var Owner := Reduce (TheExpr.Obj);
            Reduce (TheExpr.Index);

            if IsTextType (Owner) then Exit 'Char';

            if ClassNameOf (TheExpr.Obj) = 'VariableExpr' then
                Exit Lookup.Generics.GetType (Str (TheExpr.Obj.Name.Lexeme));

            Exit '';
        end

        if Kind = 'SetSubscriptExpr' then
        begin
            Reduce (TheExpr.Obj);
            Reduce (TheExpr.Index);

            var Stored := Reduce (TheExpr.Value);

            CheckElement (ElementOf (TheExpr.Obj), Stored, TheExpr.Bracket);

            Exit Stored;
        end

        Exit '';
    end

    /// Reduces a binary operation to the type it yields.
    ///
    /// Arithmetic promotes: an Integer meeting a Double gives a Double.  A
    /// comparison gives a Boolean whatever it compared.
    function ReduceBinary (TheExpr : Any) : String;
    var
        Left  : String;
        Right : String;

    begin
        var Op := TheExpr.Op.TypeOfToken;

        if Op = TOKEN_GREATER or Op = TOKEN_GREATER_EQUAL
        or Op = TOKEN_LESS or Op = TOKEN_LESS_EQUAL
        or Op = TOKEN_EQUAL or Op = TOKEN_NOT_EQUAL then
        begin
            Reduce (TheExpr.Left);
            Reduce (TheExpr.Right);

            Exit 'Boolean';
        end

        Left  := Reduce (TheExpr.Left);
        Right := Reduce (TheExpr.Right);

        if Left = '' or Right = '' or Left = 'Any' or Right = 'Any' then Exit '';

        if Op = TOKEN_IN then Exit 'Boolean';

        if Op = TOKEN_PLUS and (IsTextType (Left) or IsTextType (Right)) then Exit 'String';

        if Left = 'Double' or Right = 'Double' then Exit 'Double';
        if Left = Right then Exit Left;

        Exit '';
    end

    /// Whether a type is String or Char, the two that '+' joins as text.
    function IsTextType (TheType : String) : Boolean;
    begin
        Exit TheType = 'String' or TheType = 'Char';
    end

    /// Gets the type of a literal value already built by the scanner.
    function TypeOfValue (Value : Any) : String;
    begin
        if Value = Nil then Exit 'Nil';

        if Value is Boolean then Exit 'Boolean';
        if Value is Integer then Exit 'Integer';
        if Value is Double  then Exit 'Double';
        if Value is Char    then Exit 'Char';
        if Value is String  then Exit 'String';

        Exit ClassNameOf (Value);
    end

    /// Gets the node's class name, for dispatching on the kind of expression.
    function ClassNameOf (Obj : Any) : String;
    begin
        try
            Exit Obj.ClassName;
        except
            on e : String do Exit '';
        end
    end
end

/// Whether the checker refuses a program, for the tests below.
///
/// It answers a Boolean rather than letting the failure escape, so a test can
/// assert that a program is refused without the refusal ending the run.
function Rejects (Source : String) : Boolean;
begin
    var TheScanner := Scanner (Source);
    var TheParser  := Parser (TheScanner.ScanTokens());

    try
        TypeChecker().Resolve (TheParser.Parse());
    except
        on e : String do Exit True;
    end

    Exit False;
end

// 'List of T' makes a subscript over it reduce to T.
//
test 'Generic Subscript Reduces To The Element Type';
begin
    AssertTrue (not Rejects ('var T : List of String := [''abc'']; var S : String := T[0];'));
    AssertTrue (not Rejects ('var T : List of Integer := [1]; var N : Integer := T[0];'));
end

test 'Generic Subscript Catches The Wrong Element Type';
begin
    AssertTrue (Rejects ('var T : List of Integer := [1]; var S : String := T[0];'));
end

// ⚠️ Without an element type a subscript is unknown, and a declared type is
// rejected against it rather than waved through.  That is the one place the
// gradual rule is deliberately traded for a diagnostic.
//
test 'Subscript With No Generic Is Rejected';
begin
    AssertTrue (Rejects ('var T : List := [''abc'']; var S : String := T[0];'));
end

// Subscripting text yields a Char, never a one-character String.
//
test 'String Subscript Reduces To Char';
begin
    AssertTrue (not Rejects ('var S : String := ''abc''; var C : Char := S[0];'));

    // ⚠️ Integer, not String.  This used to prove the subscript was a Char by
    // showing a String declaration REFUSED it -- and a Char widens to a String
    // now [VAR-004], so that proof accepts.  An Integer is the nearest type a
    // Char still does not reach.
    AssertTrue (Rejects ('var S : String := ''abc''; var N : Integer := S[0];'));
end

// 'of' is honored only after 'List'.  Anywhere else the type is whatever was
// written and the 'of' is not consumed -- which is what keeps 'case X of'
// meaning what it meant.
//
test 'Of Is Honored Only After List';
begin
    AssertTrue (not Rejects ('var M : Map := [''a'':1];'));
end

/// ⚠️ Element types are SCOPED, and this is the case that proves it.
///
/// The global L has no element type, so L[0] is unknown and the declaration
/// against it must be rejected.  With a flat map, F's 'List of Integer' would
/// still be sitting under the name L by the time G is checked, G would accept,
/// and a genuinely unknown subscript would have been given a type it never
/// had.  Verified by removing the push/pop and watching this one flip.
///
test 'An Element Type Does Not Escape Its Scope';
begin
    // ⚠️ The newlines are load-bearing.  Joined without them, '...end' and
    // 'procedure...' run together into the single identifier 'endprocedure',
    // and the source is rejected by the PARSER -- so the test passes without
    // the checker ever having an opinion.  Both of these did exactly that.
    AssertTrue (Rejects (
        'var L : List := [1];' + #10 +
        'procedure F(); begin var L : List of Integer := [1]; end' + #10 +
        'procedure G(); begin var N : Integer := L[0]; end'));
end

test 'An Element Type Is Not Inherited By A Plain List';
begin
    AssertTrue (Rejects (
        'procedure F(); begin var L : List of Integer := [1]; end' + #10 +
        'procedure G(); begin var L : List := [1]; var N : Integer := L[0]; end'));
end

// A class field may carry one too, so an implicit this.Field[0] reduces.
//
test 'A Class Field Carries An Element Type';
begin
    AssertTrue (not Rejects (
        'class Lexer;' + #10 +
        'var Tokens : List of String;' + #10 +
        'begin function First() : String; begin Exit Tokens[0]; end end'));
end

// ⚠️ A cast wins outright and stops the search.  That is the point of it: the
// programmer is overriding what would have been deduced, so deducing anyway
// and then comparing would defeat it.
//
test 'A Cast Overrides An Unknown Subscript';
begin
    // Without the cast this is the rejected case from the generics tests: a
    // plain List has no element type, so the subscript reduces to nothing.
    AssertTrue (Rejects ('var L : List := [''abc'']; var S : String := L[0];'));

    AssertTrue (not Rejects ('var L : List := [''abc'']; var S : String := L[0] as String;'));
end

test 'A Cast Overrides A Known Type';
begin
    AssertTrue (Rejects ('var N : Integer := 1; var S : String := N;'));

    AssertTrue (not Rejects ('var N : Integer := 1; var S : String := N as String;'));
end

test 'A Cast Overrides A Declared Element Type';
begin
    AssertTrue (Rejects ('var L : List of Integer := [1]; var S : String := L[0];'));

    AssertTrue (not Rejects ('var L : List of Integer := [1]; var S : String := L[0] as String;'));
end

// ⚠️ The cast is what gets checked, not the expression under it -- so casting
// to the WRONG thing is still caught when it disagrees with the declaration.
// A cast overrides deduction; it does not switch checking off.
//
test 'A Cast Is Itself Checked Against The Declaration';
begin
    AssertTrue (Rejects ('var S : String := ''abc'' as Integer;'));
    AssertTrue (Rejects ('var N : Integer := 1 as String;'));
end

// A cast to a subclass still satisfies a parent annotation, because Assignable
// walks the chain whatever the type came from.
//
test 'A Cast To A Subclass Satisfies A Parent';
begin
    AssertTrue (not Rejects (
        'class Animal; begin end' + #10 +
        'class Dog(Animal); begin end' + #10 +
        'var A : Animal := Nil as Dog;'));
end

test 'A Cast Needs A Type Name';
begin
    var TheScanner := Scanner ('var X := 1 as ;');
    var TheParser := Parser (TheScanner.ScanTokens());

    try
        TheParser.Declaration();
    except
        on e : String do
            begin
                AssertEqual ('Expect typecast identifier.', e);
                Exit;
            end
    end
    Fail ('No exception raised.');
end

/// A class with a private field, as source text, for the visibility tests.
const HIDER :=
    'class Counter;'                                     + #10 +
    'private:'                                           + #10 +
    '    var Count : Integer := 0;'                      + #10 +
    'begin'                                              + #10 +
    '    procedure Bump();'                              + #10 +
    '    begin'                                          + #10 +
    '        Count := Count + 1;'                        + #10 +
    '    end'                                            + #10 +
    'private:'                                           + #10 +
    '    procedure Advance();'                           + #10 +
    '    begin'                                          + #10 +
    '    end'                                            + #10 +
    'end'                                                + #10;

test 'A Private Field Is Not Readable From Outside';
begin
    AssertTrue (Rejects (HIDER + 'begin var C := Counter(); WriteLn (C.Count); end'));
end

test 'A Private Field Is Not Writable From Outside';
begin
    AssertTrue (Rejects (HIDER + 'begin var C := Counter(); C.Count := 1; end'));
end

test 'A Private Method Is Not Callable From Outside';
begin
    AssertTrue (Rejects (HIDER + 'begin var C := Counter(); C.Advance(); end'));
end

test 'A Public Member Is Reachable From Outside';
begin
    AssertTrue (not Rejects (HIDER + 'begin var C := Counter(); C.Bump(); end'));
end

/// ⚠️ Caught through a DECLARED receiver and a deduced one alike.  A
/// VariableExpr reduces from the declared types only, so without the deduced
/// type the ordinary 'var C := Counter()' would put every private member of
/// the language's most common receiver out of reach of the rule.
test 'A Private Member Is Caught Through A Declared Receiver';
begin
    AssertTrue (Rejects (HIDER + 'begin var C : Counter := Counter(); WriteLn (C.Count); end'));
end

/// ⚠️ It is caught in EVERY statement kind, not only the ones that happen to
/// resolve their expressions.  A 'WriteLn' that does nothing and a 'var' that
/// reduces without resolving let a read slip past through either, while the
/// same read one line later in a WriteLn was caught.
test 'A Private Member Is Caught In Every Statement Kind';
begin
    AssertTrue (Rejects (HIDER + 'begin var C := Counter(); var X := C.Count; end'));
    AssertTrue (Rejects (HIDER + 'begin var C := Counter(); WriteLn(C.Count); end'));
    AssertTrue (Rejects (HIDER + 'begin var C := Counter(); WriteLn (C.Count + 1); end'));
end

/// A private member belongs to the class that DECLARED it, not to one object
/// of it -- so another instance of the same class reaches it.
test 'Another Instance Of The Same Class Reaches Its Privates';
begin
    AssertTrue (not Rejects (
        'class Counter;'                                 + #10 +
        'private:'                                       + #10 +
        '    var Count : Integer := 0;'                  + #10 +
        'begin'                                          + #10 +
        '    function Beats(Other : Counter) : Boolean;' + #10 +
        '    begin'                                      + #10 +
        '        Exit Count > Other.Count;'              + #10 +
        '    end'                                        + #10 +
        'end'));
end

/// ⚠️ What a parent hid stays hidden.  There is no 'protected'.
test 'A Subclass Does Not Reach What Its Parent Hid';
begin
    AssertTrue (Rejects (HIDER +
        'class Sub(Counter);'                            + #10 +
        'begin'                                          + #10 +
        '    function Reach(C : Counter) : Integer;'     + #10 +
        '    begin'                                      + #10 +
        '        Exit C.Count;'                          + #10 +
        '    end'                                        + #10 +
        'end'));
end

/// ⚠️ 'this' is deliberately an untyped receiver, which is what keeps a
/// class's own code -- and a subclass's -- free of the rule.
test 'This Is Never Caught';
begin
    AssertTrue (not Rejects (HIDER +
        'class Sub(Counter);'                            + #10 +
        'begin'                                          + #10 +
        '    function Reach() : Integer;'                + #10 +
        '    begin'                                      + #10 +
        '        Exit this.Count;'                       + #10 +
        '    end'                                        + #10 +
        'end'));
end

/// The header and the body are separate blocks, so a marker's reach stops at
/// 'begin' and the body starts public again.
test 'The Body Starts Public However The Header Ended';
begin
    AssertTrue (not Rejects (
        'class Blocks;'                                  + #10 +
        'private:'                                       + #10 +
        '    var Hidden : Integer := 1;'                 + #10 +
        'begin'                                          + #10 +
        '    function Visible() : Integer;'              + #10 +
        '    begin'                                      + #10 +
        '        Exit Hidden;'                           + #10 +
        '    end'                                        + #10 +
        'end'                                            + #10 +
        'begin WriteLn (Blocks().Visible()); end'));
end

/// A marker may stand between two fields of one var section.
test 'A Marker May Stand Inside A Var Section';
begin
    AssertTrue (Rejects (
        'class Mixed;'                                   + #10 +
        'var'                                            + #10 +
        '    Open : String := ''o'';'                    + #10 +
        'private:'                                       + #10 +
        '    Shut : String := ''s'';'                    + #10 +
        'begin'                                          + #10 +
        'end'                                            + #10 +
        'begin var M := Mixed(); WriteLn (M.Shut); end'));

    AssertTrue (not Rejects (
        'class Mixed;'                                   + #10 +
        'var'                                            + #10 +
        '    Open : String := ''o'';'                    + #10 +
        'private:'                                       + #10 +
        '    Shut : String := ''s'';'                    + #10 +
        'begin'                                          + #10 +
        'end'                                            + #10 +
        'begin var M := Mixed(); WriteLn (M.Open); end'));
end

/// An object takes sections on the same terms as a class.
test 'An Object Takes Visibility Sections';
begin
    AssertTrue (Rejects (
        'object Registry;'                               + #10 +
        'private:'                                       + #10 +
        '    var Items : List := [];'                    + #10 +
        'begin'                                          + #10 +
        'end'                                            + #10 +
        'begin WriteLn (Registry.Items); end'));
end

/// ⚠️ The COLON is what separates this from the module-level 'private', which
/// prefixes a single top-level declaration and has nothing to do with classes.
test 'Module Private Is Not A Section Marker';
begin
    AssertTrue (not Rejects ('private var Hidden := 1;' + #10 + 'begin WriteLn (Hidden); end'));
end

/// ⚠️ Both spellings of one member type as the enum.
///
/// algc registered only the bare name, so 'Color.Red' reduced to nothing and
/// a declaration against it was a mismatch -- while the same value written
/// 'Red' was fine.  Enum comparison is identity, so the two spellings are one
/// value; they had better also be one type.
test 'Both Spellings Of An Enum Member Type As The Enum';
begin
    AssertTrue (not Rejects (
        'type Color = (Red, Green);' + #10 +
        'var A : Color := Red;'));

    AssertTrue (not Rejects (
        'type Color = (Red, Green);' + #10 +
        'var B : Color := Color.Green;'));
end

test 'An Enum Member Does Not Satisfy Another Enum';
begin
    AssertTrue (Rejects (
        'type Color = (Red, Green);' + #10 +
        'type Size = (Small, Large);' + #10 +
        'var A : Size := Red;'));

    AssertTrue (Rejects (
        'type Color = (Red, Green);' + #10 +
        'type Size = (Small, Large);' + #10 +
        'var A : Size := Color.Red;'));
end

test 'An Enum Type Name Types As Itself';
begin
    AssertTrue (not Rejects (
        'type Color = (Red, Green);' + #10 +
        'var C : Color := Color.Red;'));
end
