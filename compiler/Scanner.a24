/// The scanner: source text in, a list of tokens out.
///
/// It records errors rather than raising them, so one bad character does not
/// cost the diagnostics for the rest of the file.  A driver must ask -- see
/// HadError.
unit Scanner;

uses SourceCode;
uses Token;
uses TokenType;

/// The decimal digits, whose position in this string is also the digit's value.
const DIGITS    := '0123456789';

/// The hexadecimal digits, lower case, matched without regard to case.
const HEXDIGITS := '0123456789abcdef';

/// The binary digits.
const BINDIGITS := '01';

/// The upper-case letters, position for position with LOWERCASE.
const UPPERCASE := 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';

/// The lower-case letters, position for position with UPPERCASE.
const LOWERCASE := 'abcdefghijklmnopqrstuvwxyz';

/// Lower-cases a string.
///
/// Written out because the language has no LowerCase, and Ord cannot give a
/// code point here -- it parses its argument as a number, which is what
/// ScanNumber needs.  Pos and Copy are enough: find the letter in one alphabet
/// and take the same position from the other.
function ToLower(Text : String) : String;
var
   Result : String := '';

begin
    for var I := 0; I < Length(Text); I := I + 1 do
    begin
        var C  := Copy(Text, I, 1);
        var At := Pos(UPPERCASE, C);

        if At >= 0 then Result := Result + Copy(LOWERCASE, At, 1);
        else Result := Result + C;
    end

    Exit Result;
end

/// Reads a run of decimal digits as an Integer.
///
/// Pos hands back an Integer, and a digit's position in DIGITS IS its value, so
/// accumulating that way keeps the whole computation in Integer arithmetic.
///
/// Neither obvious built-in will do.  Ord answers a CODE POINT [RT-007], so
/// 'Ord (''9'')' is 57 rather than 9.  Val does parse text to a number, but it
/// answers an Integer or a Double depending on what it reads [RT-009], so it
/// reduces to no type at all and 'Exit Val (Text)' cannot fill a return
/// declared Integer [VAR-006].
function ToInteger(Text : String) : Integer;
var
   Result : Integer := 0;

begin
    for var I := 0; I < Length(Text); I := I + 1 do
        Result := Result * 10 + Pos(DIGITS, Copy(Text, I, 1));

    Exit Result;
end

/// Reads a run of digits in a base as an Integer.
///
/// The separators are already gone by the time this is called.
///
/// Hexadecimal digits are matched WITHOUT REGARD TO CASE [SRC-011], as every
/// other name in the language is, so '0xff' and '0xFF' are one literal.  Pos
/// searches a folded alphabet against a folded character for exactly that.
function ToRadix(Text : String, Alphabet : String) : Integer;
var
   Result : Integer := 0;

begin
    for var I := 0; I < Length(Text); I := I + 1 do
        Result := Result * Length(Alphabet)
                + Pos(Alphabet, ToLower(Copy(Text, I, 1)));

    Exit Result;
end

/// The keywords, mapped to the token each becomes.
///
/// Looked up on the LOWER-CASED lexeme, because Algol-24's keywords are
/// case-insensitive -- 'begin', 'Begin' and 'BEGIN' are one token.
///
/// 'unit', 'test' and 'on' are deliberately absent.  They are ordinary
/// identifiers the grammar recognizes by position, so a program may still name
/// a variable after any of them [LEX-011].
///
/// # Satisfies
///
/// [LEX-010], [LEX-011], [LEX-014]
var  Keywords := [
    'and':TOKEN_AND, 'as':TOKEN_AS, 'begin':TOKEN_BEGIN, 'break':TOKEN_BREAK,
    'continue':TOKEN_CONTINUE, 'goto':TOKEN_GOTO,
    'case':TOKEN_CASE, 'class':TOKEN_CLASS,
    'const':TOKEN_CONST, 'constructor':TOKEN_CONSTRUCTOR,
    'div':TOKEN_DIV, 'do':TOKEN_DO, 'else':TOKEN_ELSE,
    'end':TOKEN_END, 'except':TOKEN_EXCEPT, 'exit':TOKEN_EXIT,
    'false':TOKEN_FALSE, 'for':TOKEN_FOR,
    'function':TOKEN_FUNCTION, 'if':TOKEN_IF, 'in':TOKEN_IN, 'is':TOKEN_IS,
    'nil':TOKEN_NIL,
    'not':TOKEN_NOT, 'object':TOKEN_OBJECT, 'of':TOKEN_OF, 'or':TOKEN_OR,
    'private':TOKEN_PRIVATE, 'procedure':TOKEN_PROCEDURE,
    'property':TOKEN_PROPERTY, 'operator':TOKEN_OPERATOR,
    'external':TOKEN_EXTERNAL,
    'public':TOKEN_PUBLIC,
    'raise':TOKEN_RAISE, 'super':TOKEN_SUPER, 'uses':TOKEN_USES,
    'then':TOKEN_THEN, 'try':TOKEN_TRY,
    'this':TOKEN_THIS, 'true':TOKEN_TRUE, 'type':TOKEN_TYPE, 'var':TOKEN_VAR,
    'while':TOKEN_WHILE];

/// Whether any scan has recorded an error.
///
/// MODULE-level rather than per instance, and set rather than raised, so one
/// unexpected character does not cost the diagnostics for the rest of the file.
/// A driver has to ask: Main's CheckScanned is called twice, once after scanning
/// for the right message and once after parsing so that modules pulled in by
/// 'uses' are covered too.
///
/// # Satisfies
///
/// [ERR-004]
var HadError := False;

/// The most recent error recorded, as the text a driver will print.
var LastError;

/// Turns one file's source text into tokens.
class Scanner;
var
    /// The source being scanned.
    Source : String;

    /// The tokens produced so far, in order.
    Tokens : List of Token;

    /// Current is the position about to be read, Start the beginning of the
    /// token being scanned, and Line the line Current sits on.
    Current, Start, Line : Integer;

    /// Where the current line begins, so a token's Offset is a column rather
    /// than a position in the whole source.
    LineStart : Integer;

begin
    /// Makes a scanner over a file's source text.
    constructor Init(Source);
    begin
        this.Source  := Str(Source);
        this.Current := 0;
        this.Start   := 0;
        this.Line    := 1;
        this.LineStart := 0;

        this.Tokens := List();
    end

    /// Scans the whole source and answers its tokens, ending with EOF.
    ///
    /// The last line is recorded here rather than by the newline handling,
    /// because a file need not end with one [SRC-001].
    ///
    /// # Examples
    ///
    /// See test 'Scan Tokens'.
    ///
    /// # Satisfies
    ///
    /// [LEX-004], [SRC-001]
    function ScanTokens() : List;
    begin
        while not IsAtEnd() do
        begin
           Start := Current;
           ScanToken();
        end

        SourceCode.Add (Line, Copy (Source, LineStart, Length(Source) - LineStart));

        Tokens.Add(Token(EOF, '', nil, Line));
        exit Tokens;
    end

    /// Scans one token, dispatching on the character it begins with.
    ///
    /// An unexpected character is RECORDED and scanning continues, so a file
    /// with several bad characters reports the first rather than only ever the
    /// one that stopped it.
    ///
    /// A comment runs to the end of the line or to end of file [LEX-001], and
    /// '///' is not a distinct form -- it is a comment whose first character
    /// happens to be '/' [LEX-002].  There are no block comments, so '{' and
    /// '}' are unexpected characters rather than delimiters [LEX-003].
    ///
    /// # Satisfies
    ///
    /// [LEX-001], [LEX-002], [LEX-003], [LEX-005], [LEX-006], [LEX-012],
    /// [LEX-013], [LEX-019], [SRC-000], [SRC-002], [SRC-006], [SRC-007],
    /// [SRC-008]
    procedure ScanToken();
    var
        C : Char;

    begin
        C := Advance();
        case C of
            '(' : AddToken(TOKEN_LEFT_PAREN);
            ')' : AddToken(TOKEN_RIGHT_PAREN);
            '[' : AddToken(TOKEN_LEFT_BRACKET);
            ']' : AddToken(TOKEN_RIGHT_BRACKET);
            ',' : AddToken(TOKEN_COMMA);
            '.' : if Match('.') then AddToken(TOKEN_DOT_DOT); else AddToken(TOKEN_DOT);
            '-' : AddToken(TOKEN_MINUS);
            '+' : AddToken(TOKEN_PLUS);
            ';' : AddToken(TOKEN_SEMICOLON);
            '*' : AddToken(TOKEN_STAR);

            '=' : AddToken(TOKEN_EQUAL);
            ':' : if Match('=') then AddToken(TOKEN_ASSIGN); else AddToken(TOKEN_COLON);
            '>' : if Match('=') then AddToken(TOKEN_GREATER_EQUAL); else AddToken(TOKEN_GREATER);

            '<' :
                if Match('>') then AddToken(TOKEN_NOT_EQUAL);
                else if Match('=') then AddToken(TOKEN_LESS_EQUAL);
                else AddToken(TOKEN_LESS);

            '/':
                if Match('/') then
                   while Peek() <> #10 and not IsAtEnd() do Advance();
                else
                   AddToken(TOKEN_SLASH);

            #9, #13, ' ' : Exit;

            #10 :
                begin
                   SourceCode.Add (Line, Copy (Source, LineStart, Current - LineStart - 1));

                   Line := Line + 1;
                   LineStart := Current;
                   Exit;
                end
            #39 : ScanString();
            '#' : ScanChar();
        else
            if IsAlpha(C) then
                ScanIdentifier();
            else if IsDigit(C) then
                ScanNumber();
            else
                begin
                    HadError := True;
                    LastError := '[line ' + Line + '] Error: Unexpected character: ' + C;
                end
        end
    end

    /// Scans an identifier, or the keyword it turns out to be.
    ///
    /// The lexeme is kept as written and the KEYWORD LOOKUP is folded, which is
    /// the same split Token.FoldCase makes: a diagnostic echoes the spelling the
    /// program used, and matching ignores case.
    ///
    /// # Examples
    ///
    /// See test 'Scan Identifier With A Question Mark'.
    ///
    /// # Satisfies
    ///
    /// [LEX-007], [LEX-009], [SRC-010]
    procedure ScanIdentifier();
    var
       Text        : String;
       TypeOfToken : TokenType;

    begin
        while IsAlphaNumeric(Peek()) do Advance();

        Text := Copy(Source, Start, Current - Start);
        TypeOfToken := TOKEN_IDENTIFIER;

        var Lowered := ToLower(Text);
        if Keywords.Contains(Lowered) then
        begin
            TypeOfToken := Keywords.Get(Lowered) as TokenType;
        end

        AddToken(TypeOfToken);
    end

    /// Scans a number: decimal, hexadecimal or binary, with an optional
    /// fractional part, an optional exponent, and separators between digits.
    ///
    /// The DIGITS are collected rather than the span sliced, because a separator
    /// must not reach the value: '1_000' and '1000' are one literal and print
    /// alike.  Slicing the source and stripping afterwards would work too, and
    /// would put the rule in two places.
    ///
    /// # Examples
    ///
    /// See test 'Scan Integer Is Not A Double'.
    ///
    /// # Satisfies
    ///
    /// [LEX-015], [LEX-016], [LEX-017], [LEX-020], [LEX-021], [LEX-022]
    procedure ScanNumber();
    var
       IsInteger : Boolean;
       Digits    : String;

    begin
        if Source[Start] = '0' and (Peek() = 'x' or Peek() = 'X') then
            if IsHexDigit(PeekNext()) then
            begin
                Advance();
                ScanRadix(HEXDIGITS);
                Exit;
            end

        if Source[Start] = '0' and (Peek() = 'b' or Peek() = 'B') then
            if PeekNext() = '0' or PeekNext() = '1' then
            begin
                Advance();
                ScanRadix(BINDIGITS);
                Exit;
            end

        IsInteger := True;
        Digits := Str (Source[Start]);

        Digits := Digits + ScanDigits();

        if Peek() = '.' and IsDigit(PeekNext()) then
        begin
            IsInteger := False;
            Advance();

            Digits := Digits + '.' + ScanDigits();
        end

        if Peek() = 'e' or Peek() = 'E' then
            if IsExponent() then
            begin
                IsInteger := False;
                Advance();

                Digits := Digits + 'e';
                if Peek() = '+' or Peek() = '-' then
                begin
                    Digits := Digits + Str (Peek());
                    Advance();
                end

                Digits := Digits + ScanDigits();
            end

        if IsInteger then
        begin
            AddToken(TOKEN_INTEGER, ToInteger(Digits));
        end
        else AddToken(TOKEN_NUMBER, Val(Digits));
    end

    /// Consumes a run of digits with separators between them, and answers the
    /// digits alone.
    ///
    /// A separator is consumed only when a DIGIT follows it, so '100_' ends the
    /// literal at '100' and leaves '_' to start an identifier -- which is what
    /// '_' does [SRC-005].  The rule is that a separator separates two digits,
    /// and this is the whole of it.
    function ScanDigits() : String;
    var
        Digits : String;

    begin
        Digits := '';

        while True do
        begin
            if IsDigit(Peek()) then
            begin
                Digits := Digits + Str (Peek());
                Advance();
            end
            else if Peek() = '_' and IsDigit(PeekNext()) then Advance();
            else Exit Digits;
        end

        Exit Digits;
    end

    /// The same as ScanDigits, for a base whose digits are not decimal.
    ///
    /// The prefix has been consumed and at least one digit is known to follow.
    procedure ScanRadix(Alphabet : String);
    var
        Digits : String;

    begin
        Digits := '';

        while True do
        begin
            if InAlphabet(Alphabet, Peek()) then
            begin
                Digits := Digits + Str (Peek());
                Advance();
            end
            else if Peek() = '_' and InAlphabet(Alphabet, PeekNext()) then Advance();
            else
            begin
                AddToken(TOKEN_INTEGER, ToRadix(Digits, Alphabet));
                Exit;
            end
        end
    end

    /// Whether a character is one of a base's digits, without regard to case.
    function InAlphabet(Alphabet : String, C : Char) : Boolean;
    begin
        Exit Pos(Alphabet, ToLower(Str(C))) >= 0;
    end

    /// Whether a character is a hexadecimal digit.
    function IsHexDigit(C : Char) : Boolean;
    begin
        Exit InAlphabet(HEXDIGITS, C);
    end

    /// Whether what follows 'e' is an exponent rather than an identifier.
    ///
    /// Asked BEFORE consuming the 'e', because '1eight' is the integer 1
    /// followed by the identifier 'eight' and must stay that way.  An exponent
    /// needs a digit, optionally behind one sign.
    function IsExponent() : Boolean;
    var
        At : Integer;

    begin
        At := Current + 1;

        if At < Length(Source) then
            if Source[At] = '+' or Source[At] = '-' then At := At + 1;

        if At >= Length(Source) then Exit False;

        Exit IsDigit(Source[At]);
    end

    /// Scans a single-quoted string, where a doubled quote is one quote.
    ///
    /// A one-character literal is a CHAR rather than a String, and the two are
    /// never equal, so the length is measured on the SOURCE span: '''' is two
    /// characters of source between the quotes and one of value, and is a Char.
    ///
    /// An unterminated string is reported against the line it OPENED on.
    ///
    /// # Examples
    ///
    /// See test 'Scan Doubled Quote'.
    ///
    /// # Satisfies
    ///
    /// [LEX-023], [LEX-027], [LEX-028], [LEX-029], [LEX-030], [LEX-031],
    /// [SRC-003]
    procedure ScanString();
    var
       Value : String;

       Opened : Integer;

    begin
        Value := '';
        Opened := Line;

        while not IsAtEnd() do
        begin
            if Peek() = #39 then
            begin
                if PeekNext() <> #39 then Break;

                Advance();
            end

            if Peek() = #10 then Line := Line + 1;

            Value := Value + Advance();
        end

        if IsAtEnd() then
        begin
            HadError := True;
            LastError := '[line ' + Opened + '] Error: Unterminated string.';
            Exit;
        end
        Advance();

        if Length(Value) = 1 then AddToken(TOKEN_CHAR, Value[0]);
        else AddToken(TOKEN_STRING, Value);
    end

    /// Scans a character written by code point -- '#65', '#10'.
    ///
    /// A Char is a Unicode CODE POINT, not a byte, so the value runs to 10FFFF
    /// [LEX-025].  'Char (0)' is legal and buildable, which matters because the
    /// scanner's own end-of-file sentinel is one.
    ///
    /// # Examples
    ///
    /// See test 'Scan Char By Code Point'.
    ///
    /// # Satisfies
    ///
    /// [LEX-024], [LEX-025], [LEX-032]
    procedure ScanChar();
    begin
        if not IsDigit(Peek()) then
        begin
            HadError := True;
            LastError := '[line ' + Line + '] Error: Invalid character: ' + Peek();
            Exit;
        end

        while IsDigit(Peek()) do Advance();

        var Code := ToInteger(Copy(Source, Start + 1, Current - Start - 1));

        if Code = 0 then
        begin
            HadError := True;
            LastError := '[line ' + Line + '] Error: ''#0'' is not a Char.';
            Exit;
        end

        if Code > 1114111 or (Code >= 55296 and Code <= 57343) then
        begin
            HadError := True;
            LastError := '[line ' + Line
                + '] Error: Char is limited to 0..10FFFF, excluding D800..DFFF: #' + Code;
            Exit;
        end

        AddToken(TOKEN_CHAR, Char(Code));
    end

    /// Consumes the next character when it is the one expected, and answers
    /// whether it did.
    function Match(Expected : Char) : Boolean;
    begin
        if IsAtEnd() then Exit False;
        if Source[Current] <> Expected then Exit False;

        Current := Current + 1;
        Exit True;
    end

    /// Gets the next character without consuming it, or the sentinel at end of
    /// source.
    function Peek();
    begin
        if IsAtEnd() then exit Char(0);

        exit Source[Current];
    end

    /// Gets the character after the next one without consuming either.
    function PeekNext() : Char;
    begin
       if Current + 1 >= Length(Source) then exit Char(0);

       exit Source[Current + 1];
    end

    /// Adds a token of a category, carrying no literal value.
    procedure AddToken(TypeOfToken : TokenType);
    begin
        AddToken(TypeOfToken, nil);
    end

    /// Adds a token of a category, carrying the value a literal scanned to.
    ///
    /// The lexeme is the source span from Start, and the Offset is measured from
    /// LineStart so a diagnostic can draw its caret at a column.
    procedure AddToken(TypeOfToken : TokenType, Literal : Any);
    var
       Text     : String;
       TheToken : Token;

    begin
        Text := Copy(Source, Start, Current - Start);

        TheToken := Token(TypeOfToken, Text, Literal, Line);
        TheToken.Offset := Start - LineStart;

        Tokens.Add(TheToken);
    end

    /// Whether the scan has reached the end of the source.
    ///
    /// # Satisfies
    ///
    /// [SRC-009]
    function IsAtEnd();
    begin
        Exit Current >= Length(Source);
    end

    /// Consumes the next character and answers it.
    function Advance() : Char;
    var
       ReturnValue : Char;

    begin
        ReturnValue := Source[Current];
        Current := Current + 1;

        Exit ReturnValue;
    end

    /// A letter, for the purpose of starting or continuing an identifier.
    ///
    /// EVERY character above 127 counts, and that is the rule rather than an
    /// approximation of it.  An identifier may hold any Unicode character at all
    /// -- the mangling escapes whatever C cannot spell as 'U' followed by six
    /// hexadecimal digits -- so there is nothing to exclude.
    ///
    /// This briefly asked a table of Unicode LETTER categories instead, on the
    /// reading that [SRC-005] meant letters literally.  It does not: the
    /// restriction excluded '🙂' and '💩', which are identifiers here, and the
    /// table it needed answered a question the language does not ask.
    ///
    /// '?' is not a letter, and used not to be excluded.  Classing it as one so
    /// that 'Gate?' scans as a single word also let it BEGIN an identifier, and
    /// 'var ? := 7;' declared a variable named '?'.
    ///
    /// ASCII IS ANSWERED FIRST.  This runs once per character of every file the
    /// compiler reads, itself included, and almost every one is ASCII.
    ///
    /// # Satisfies
    ///
    /// [SRC-005]
    function IsAlpha(C : Char) : Boolean;
    begin
        if C >= 'a' and C <= 'z' then Exit True;
        if C >= 'A' and C <= 'Z' then Exit True;
        if C = '_' then Exit True;

        Exit Ord (C) > 127;
    end

    /// An identifier MARK: may continue an identifier, may not begin one.
    ///
    /// 'Gate?' asks and 'Send!' does; neither '?' nor '!' alone is a name.  A
    /// trailing mark reads as punctuation on a word, and a leading one reads as
    /// an operator the language does not have.
    ///
    /// # Satisfies
    ///
    /// [LEX-008]
    function IsMark(C : Char) : Boolean;
    begin
        Exit (C = '?') or (C = '!');
    end

    /// Whether a character may continue an identifier -- a letter, a decimal
    /// digit or a mark.
    function IsAlphaNumeric(C : Char) : Boolean;
    begin
        Exit IsAlpha(C) or IsDigit(C) or IsMark(C);
    end

    /// Whether a character is a decimal digit.
    ///
    /// ASCII only, deliberately: a Unicode digit is not an identifier character
    /// and does not spell a number here either [SRC-005].
    function IsDigit(C : Char) : Boolean;
    begin
       Exit C >= '0' and C <= '9';
    end
end

// Scans each of the single character tokens, verifying the correct token types are returned, and ends
// with an EOF.
//
test 'Scan Tokens';
begin
    // '{' and '}' are gone -- blocks are begin/end, and neither brace is a
    // token in Algol-24 at all.
    var Uut := Scanner('(),.-+;*:');

    Uut.ScanTokens();

    AssertEqual(TOKEN_LEFT_PAREN,  Uut.Tokens[0].TypeOfToken);
    AssertEqual(TOKEN_RIGHT_PAREN, Uut.Tokens[1].TypeOfToken);

    AssertEqual(TOKEN_COMMA, Uut.Tokens[2].TypeOfToken);
    AssertEqual(TOKEN_DOT,   Uut.Tokens[3].TypeOfToken);
    AssertEqual(TOKEN_MINUS, Uut.Tokens[4].TypeOfToken);
    AssertEqual(TOKEN_PLUS,  Uut.Tokens[5].TypeOfToken);

    AssertEqual(TOKEN_SEMICOLON, Uut.Tokens[6].TypeOfToken);
    AssertEqual(TOKEN_STAR,      Uut.Tokens[7].TypeOfToken);
    AssertEqual(TOKEN_COLON,     Uut.Tokens[8].TypeOfToken);

    AssertEqual(EOF, Uut.Tokens[9].TypeOfToken);
end

// Scans the two character operators, verifying the correct token types are returned.  Also checks that
// the individual characters continue to be scanned properly.  Implicitly checks that whitespace is ignored.
//
test 'Scan Operators';
begin
    var Uut := Scanner('= := < > <> <= >=');

    Uut.ScanTokens();

    // '=' is equality and ':=' is assignment -- the opposite of C, and the
    // reverse of what this scanner did as a Lox scanner.
    AssertEqual(TOKEN_EQUAL,  Uut.Tokens[0].TypeOfToken);
    AssertEqual(TOKEN_ASSIGN, Uut.Tokens[1].TypeOfToken);

    AssertEqual(TOKEN_LESS,    Uut.Tokens[2].TypeOfToken);
    AssertEqual(TOKEN_GREATER, Uut.Tokens[3].TypeOfToken);

    AssertEqual(TOKEN_NOT_EQUAL,     Uut.Tokens[4].TypeOfToken);
    AssertEqual(TOKEN_LESS_EQUAL,    Uut.Tokens[5].TypeOfToken);
    AssertEqual(TOKEN_GREATER_EQUAL, Uut.Tokens[6].TypeOfToken);

    AssertEqual(EOF, Uut.Tokens[7].TypeOfToken);
end

// '<' opens three tokens, so the order the scanner tries them in matters:
// '<>' must be tested before '<=' and both before a bare '<'.
//
test 'Scan Less Is Not Greedy';
begin
    var Uut := Scanner('<<><=<');

    Uut.ScanTokens();

    AssertEqual(TOKEN_LESS,       Uut.Tokens[0].TypeOfToken);
    AssertEqual(TOKEN_NOT_EQUAL,  Uut.Tokens[1].TypeOfToken);
    AssertEqual(TOKEN_LESS_EQUAL, Uut.Tokens[2].TypeOfToken);
    AssertEqual(TOKEN_LESS,       Uut.Tokens[3].TypeOfToken);
    AssertEqual(EOF,              Uut.Tokens[4].TypeOfToken);
end

// Tests that a comment is ignored until the end of a line.
//
test 'Scan Comment';
begin
    var Uut := Scanner('// This is a comment.');

    Uut.ScanTokens();

    AssertEqual(EOF, Uut.Tokens[0].TypeOfToken);
end

// A comment ends at the newline, and what follows it is still scanned.
//
// The whole point of the case above is that it does NOT reach here: it has no
// newline, so it passed just as well when a comment ran to #13 -- a character
// no LF-terminated file contains, which meant a comment swallowed the rest of
// the source and every token after one was silently lost.
//
test 'Scan Comment Ends At Newline';
begin
    var Uut := Scanner('// This is a comment.' + #10 + 'abc');

    Uut.ScanTokens();

    AssertEqual(2, Uut.Tokens.Length);
    AssertEqual(TOKEN_IDENTIFIER, Uut.Tokens[0].TypeOfToken);
    AssertEqual(2, Uut.Tokens[0].LineNumber);
end

// Test that the line counter is increased when scanning an end-of-line character (\n).
//
test 'Scan Newline';
begin
    var Uut := Scanner('test ' + #10 +  'test2');

    Uut.ScanTokens();

    AssertEqual(1, Uut.Tokens[0].LineNumber);
    AssertEqual(2, Uut.Tokens[1].LineNumber);
end

// Test that quotation mark returns a String token type, with a lexeme including the quotation marks, and
// the literal value a String object without them.
//
test 'Scan String';
begin
    // Single quotes now.  #39 is one, written by code point because a literal
    // quote inside a quoted string would have to be doubled and that is what
    // the next test is about.
    var Uut := Scanner(#39 + 'ABC' + #39);

    Uut.ScanTokens();

    var Token := Uut.Tokens[0];

    AssertEqual(TOKEN_STRING, Token.TypeOfToken);
    AssertEqual(#39 + 'ABC' + #39, Token.Lexeme);
    AssertEqual('ABC', Token.Literal);
end

// A doubled quote is the only escape there is, so the lexeme and the literal
// are different lengths -- which is why the literal is built a character at a
// time rather than sliced out of the source.
//
test 'Scan Doubled Quote';
begin
    var Uut := Scanner(#39 + 'it' + #39 + #39 + 's' + #39);

    Uut.ScanTokens();

    AssertEqual(TOKEN_STRING, Uut.Tokens[0].TypeOfToken);
    AssertEqual('it' + #39 + 's', Uut.Tokens[0].Literal);
end

// An empty string is a String, and scans to a literal of length zero.
//
test 'Scan Empty String';
begin
    var Uut := Scanner(#39 + #39);

    Uut.ScanTokens();

    AssertEqual(TOKEN_STRING, Uut.Tokens[0].TypeOfToken);
    AssertEqual('', Uut.Tokens[0].Literal);
end

// If the end of the file is reached without a terminating quotation mark, an error should be sent to
// Lox.
//
test 'Scan Unterminated String';
begin
    var Uut := Scanner(#39 + 'ABC');

    Uut.ScanTokens();

    AssertTrue(HadError);
    AssertEqual('[line 1] Error: Unterminated string.', LastError);
end

// ⚠️ An unrecognized character is RECORDED here and nowhere else: it produces
// no token, so nothing downstream can notice it.  Main's CheckScanned is what
// asks, and while it did not, 'var A @ := 1;' ran and compiled under algc with
// the '@' silently dropped.
//
test 'Scan Unrecognized Character Is Recorded';
begin
    var Uut := Scanner('var A @ := 1;');

    Uut.ScanTokens();

    AssertTrue(HadError);
    AssertEqual('[line 1] Error: Unexpected character: @', LastError);
end

// Tests that scanning a series of numbers returns a Number object, with the String value in lexeme.
//
test 'Scan Number';
begin
    var Uut := Scanner('123');

    Uut.ScanTokens();

    var Token := Uut.Tokens[0];

    // No fractional part, so an Integer -- and the literal is an Integer too,
    // which is what keeps '7 / 2' at three.
    AssertEqual(TOKEN_INTEGER, Token.TypeOfToken);
    AssertEqual('123', Token.Lexeme);
    AssertEqual(123, Token.Literal);
end

// The two literal types are genuinely different, not merely printed
// differently: '1' and '1.0' scan to different tokens carrying different types.
//
test 'Scan Integer Is Not A Double';
begin
    var Whole := Scanner('1');
    Whole.ScanTokens();

    var Real := Scanner('1.0');
    Real.ScanTokens();

    AssertEqual(TOKEN_INTEGER, Whole.Tokens[0].TypeOfToken);
    AssertEqual(TOKEN_NUMBER,  Real.Tokens[0].TypeOfToken);

    // Str(1) rather than '1' for the expected value: a one-character literal is
    // a Char and Str returns a String, and the two are never equal.  The
    // printed form is what distinguishes the types here, since AssertEqual
    // promotes and would find 1 equal to 1.0.
    AssertEqual(Str(1), Str(Whole.Tokens[0].Literal));
    AssertEqual('1.0',  Str(Real.Tokens[0].Literal));
end

// A one-character literal is a Char, and a Char is never equal to a String.
//
test 'Scan One Character Is A Char';
begin
    var Uut := Scanner(#39 + 'a' + #39);

    Uut.ScanTokens();

    AssertEqual(TOKEN_CHAR, Uut.Tokens[0].TypeOfToken);
    AssertTrue(Uut.Tokens[0].Literal = 'a');
end

// ⚠️ '''' is an escaped quote: two characters of source between the quotes and
// one of value.  The rule reads the SOURCE, so this is a String of length one
// rather than a Char -- and that is the reason the length is measured on the
// raw span instead of on the built value.
//
// ⚠️ A doubled quote is a CHAR, not a String.  This test asserted the opposite
// and was pinning a defect: the scanner measured the source SPAN, so '''' was
// two characters of source and came out a String, while #39 -- the same
// character -- was a Char.  A quote was not equal to itself [LEX-023].
//
test 'Scan An Escaped Quote Is A Char';
begin
    var Uut := Scanner(#39 + #39 + #39 + #39);

    Uut.ScanTokens();

    AssertEqual(TOKEN_CHAR, Uut.Tokens[0].TypeOfToken);
    AssertEqual(#39, Uut.Tokens[0].Literal);
end

// A Char written by code point.
//
test 'Scan Char By Code Point';
begin
    var Uut := Scanner('#65 #10');

    Uut.ScanTokens();

    AssertEqual(TOKEN_CHAR, Uut.Tokens[0].TypeOfToken);
    AssertTrue(Uut.Tokens[0].Literal = 'A');

    AssertEqual(TOKEN_CHAR, Uut.Tokens[1].TypeOfToken);
    AssertTrue(Uut.Tokens[1].Literal = #10);
end

// A '#' with no digits after it is an error rather than a token.
//
test 'Scan Char Without Digits';
begin
    HadError := False;

    var Uut := Scanner('#x');
    Uut.ScanTokens();

    AssertTrue(HadError);
end

// A trailing dot is not a fractional part -- '1.' is the Integer 1 followed by
// a dot, because a digit has to follow the point.
//
test 'Scan Integer Then Dot';
begin
    var Uut := Scanner('1.');

    Uut.ScanTokens();

    AssertEqual(TOKEN_INTEGER, Uut.Tokens[0].TypeOfToken);
    AssertEqual(1,             Uut.Tokens[0].Literal);
    AssertEqual(TOKEN_DOT,     Uut.Tokens[1].TypeOfToken);
end

// If a period is encountered while scanning numbers, it should scan for additional numbers for a decimal
// value.  Returns a Number with the String value in lexeme.
//
test 'Scan Number Decimal';
begin
    var Uut := Scanner('3.14');

    Uut.ScanTokens();

    var Token := Uut.Tokens[0];

    AssertEqual(TOKEN_NUMBER, Token.TypeOfToken);
    AssertEqual('3.14', Token.Lexeme);
    AssertEqual(3.14, Token.Literal);
end

// Test scanning an identifier.  The lexeme should contain the name, and the literal value should be None.
//
test 'Scan Identifier';
begin
    var Uut := Scanner('test');

    Uut.ScanTokens();

    var Token := Uut.Tokens[0];

    AssertEqual(TOKEN_IDENTIFIER, Token.TypeOfToken);
    AssertEqual('test', Token.Lexeme);

    // TODO: Add AssertNil
    AssertEqual(nil, Token.Literal);
end

// ⚠️ '?' is an identifier character -- the whole name, and nothing left over.  This scanner used to reject it, and because a
// scan error went unreported it read 'Ready' and dropped the '?' in silence.
//
test 'Scan Identifier With A Question Mark';
begin
    var Uut := Scanner('Ready? Empty?()');

    Uut.ScanTokens();

    AssertEqual(TOKEN_IDENTIFIER, Uut.Tokens[0].TypeOfToken);
    AssertEqual('Ready?', Uut.Tokens[0].Lexeme);

    AssertEqual(TOKEN_IDENTIFIER, Uut.Tokens[1].TypeOfToken);
    AssertEqual('Empty?', Uut.Tokens[1].Lexeme);

    AssertEqual(TOKEN_LEFT_PAREN, Uut.Tokens[2].TypeOfToken);
end

// Tests that all of Lox's keywords are properly distinguished from identifiers.
//
test 'Scan Keywords';
begin
    var Uut := Scanner('and begin class constructor do else end exit false for '
                     + 'function if nil not or procedure super then this '
                     + 'true var while');

    Uut.ScanTokens();

    AssertEqual(TOKEN_AND,         Uut.Tokens[0].TypeOfToken);
    AssertEqual(TOKEN_BEGIN,       Uut.Tokens[1].TypeOfToken);
    AssertEqual(TOKEN_CLASS,       Uut.Tokens[2].TypeOfToken);
    AssertEqual(TOKEN_CONSTRUCTOR, Uut.Tokens[3].TypeOfToken);
    AssertEqual(TOKEN_DO,          Uut.Tokens[4].TypeOfToken);
    AssertEqual(TOKEN_ELSE,        Uut.Tokens[5].TypeOfToken);
    AssertEqual(TOKEN_END,         Uut.Tokens[6].TypeOfToken);
    AssertEqual(TOKEN_EXIT,        Uut.Tokens[7].TypeOfToken);
    AssertEqual(TOKEN_FALSE,       Uut.Tokens[8].TypeOfToken);
    AssertEqual(TOKEN_FOR,         Uut.Tokens[9].TypeOfToken);
    AssertEqual(TOKEN_FUNCTION,    Uut.Tokens[10].TypeOfToken);
    AssertEqual(TOKEN_IF,          Uut.Tokens[11].TypeOfToken);
    AssertEqual(TOKEN_NIL,         Uut.Tokens[12].TypeOfToken);
    AssertEqual(TOKEN_NOT,         Uut.Tokens[13].TypeOfToken);
    AssertEqual(TOKEN_OR,          Uut.Tokens[14].TypeOfToken);
    AssertEqual(TOKEN_PROCEDURE,   Uut.Tokens[15].TypeOfToken);
    AssertEqual(TOKEN_SUPER,       Uut.Tokens[16].TypeOfToken);
    AssertEqual(TOKEN_THEN,        Uut.Tokens[17].TypeOfToken);
    AssertEqual(TOKEN_THIS,        Uut.Tokens[18].TypeOfToken);
    AssertEqual(TOKEN_TRUE,        Uut.Tokens[19].TypeOfToken);
    AssertEqual(TOKEN_VAR,         Uut.Tokens[20].TypeOfToken);
    AssertEqual(TOKEN_WHILE,       Uut.Tokens[21].TypeOfToken);
    AssertEqual(EOF,               Uut.Tokens[22].TypeOfToken);
end

// Should report an error to Lox if an unexpected character is scanned.
///
test 'Scan Unexpected String';
begin
    var Uut := Scanner(Str('%'));

    Uut.ScanTokens();

    AssertTrue(HadError);
    AssertEqual('[line 1] Error: Unexpected character: %', LastError);
end

// The whole scanner, over a realistic program, in one assertion.
//
// Every other test in this file feeds a single line, which is how #10 and #13
// stayed swapped for so long: with no newline anywhere in the input, a comment
// that ran to the wrong character still stopped at the end of the source, and
// a line counter that never advanced was never asked to.  This one has a
// comment on its own line and another at the end of a line, a CRLF, and eight
// lines to count.
//
// Literals are not rendered, only lexemes.  A literal's representation is the
// easiest thing for two scanners to disagree about -- whether a number keeps
// its text or Ord of it -- while they agree on every lexeme.  Lexemes are also
// what catches a Copy that takes an end where it should take a length.
//
test 'Scan A Whole Program';
begin
    var Source :=
        '// leading comment'                        + #10 +
        'class Greeter;'                            + #10 +
        'begin'                                     + #10 +
        '  function Greet(Name);'                   + #10 +
        '  begin'                                   + #10 +
        '    WriteLn (''hi, '' + Name); // trailing' + #10 +
        '  end'                                     + #10 +
        'end'                                       + #13 + #10 +
        'var N := 3.5;'                             + #10 +
        'if N >= 1 and N <> 2 then WriteLn (not true);' + #10;

    var Uut := Scanner(Source);
    Uut.ScanTokens();

    var Actual := '';
    for var T in Uut.Tokens do
        Actual := Actual + Str(T.LineNumber) + ':' + Str(T.TypeOfToken) + ':' + T.Lexeme + #10;

    // Line 1 is a comment and contributes nothing, so the first token is on 2.
    // The 'end' on 8 is followed by a CR, which is whitespace and does not
    // count, so 'var' is on 9.  EOF is on 11, after the final newline.
    var Expected :=
        '2:TOKEN_CLASS:class'        + #10 +
        '2:TOKEN_IDENTIFIER:Greeter' + #10 +
        '2:TOKEN_SEMICOLON:;'        + #10 +
        '3:TOKEN_BEGIN:begin'        + #10 +
        '4:TOKEN_FUNCTION:function'  + #10 +
        '4:TOKEN_IDENTIFIER:Greet'   + #10 +
        '4:TOKEN_LEFT_PAREN:('       + #10 +
        '4:TOKEN_IDENTIFIER:Name'    + #10 +
        '4:TOKEN_RIGHT_PAREN:)'      + #10 +
        '4:TOKEN_SEMICOLON:;'        + #10 +
        '5:TOKEN_BEGIN:begin'        + #10 +
        '6:TOKEN_IDENTIFIER:WriteLn' + #10 +
        '6:TOKEN_LEFT_PAREN:('       + #10 +
        '6:TOKEN_STRING:''hi, '''    + #10 +
        '6:TOKEN_PLUS:+'             + #10 +
        '6:TOKEN_IDENTIFIER:Name'    + #10 +
        '6:TOKEN_RIGHT_PAREN:)'      + #10 +
        '6:TOKEN_SEMICOLON:;'        + #10 +
        '7:TOKEN_END:end'            + #10 +
        '8:TOKEN_END:end'            + #10 +
        '9:TOKEN_VAR:var'            + #10 +
        '9:TOKEN_IDENTIFIER:N'       + #10 +
        '9:TOKEN_ASSIGN::='          + #10 +
        '9:TOKEN_NUMBER:3.5'         + #10 +
        '9:TOKEN_SEMICOLON:;'        + #10 +
        '10:TOKEN_IF:if'             + #10 +
        '10:TOKEN_IDENTIFIER:N'      + #10 +
        '10:TOKEN_GREATER_EQUAL:>='  + #10 +
        '10:TOKEN_INTEGER:1'          + #10 +
        '10:TOKEN_AND:and'           + #10 +
        '10:TOKEN_IDENTIFIER:N'      + #10 +
        '10:TOKEN_NOT_EQUAL:<>'      + #10 +
        '10:TOKEN_INTEGER:2'          + #10 +
        '10:TOKEN_THEN:then'         + #10 +
        '10:TOKEN_IDENTIFIER:WriteLn' + #10 +
        '10:TOKEN_LEFT_PAREN:('      + #10 +
        '10:TOKEN_NOT:not'           + #10 +
        '10:TOKEN_TRUE:true'         + #10 +
        '10:TOKEN_RIGHT_PAREN:)'     + #10 +
        '10:TOKEN_SEMICOLON:;'       + #10 +
        '11:EOF:'                    + #10;

    AssertEqual(41, Uut.Tokens.Length);
    AssertEqual(Expected, Actual);
end
