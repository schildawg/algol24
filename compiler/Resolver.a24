/// The resolver: the pass between parsing and running that binds every name to
/// the scope it came from, and refuses what no later pass could catch.
unit Resolver;

uses Expr;
uses Interpreter;
uses Parser;
uses Scanner;
uses Stmt;
uses Token;

/// What kind of subprogram the resolver is inside, so a statement that only
/// makes sense in one of them can be refused where it is written.
///
/// FUN_NONE is first, and therefore falsey, so being inside no subprogram at
/// all is the falsey state.
type FunctionType = (FUN_NONE, FUN_FUNCTION, FUN_METHOD, FUN_INITIALIZER);

/// What kind of class the resolver is inside, which is what lets 'this' outside
/// a class and 'super' outside a subclass both be refused.
type ClassType = (CLASS_NONE, CLASS_CLASS, CLASS_SUBCLASS);

/// Walks the tree once before it runs, binding names to scope depth.
class Resolver;
var
   /// The interpreter this pass records its bindings into.
   TheInterpreter  : Interpreter;

   /// The scopes now open, innermost on top.  Each maps a name to whether its
   /// declaration has finished.
   Scopes          : Stack;

   /// Whether each declared name is constant, pushed and popped in lockstep
   /// with Scopes.
   ///
   /// EVERY name is recorded, not only the constant ones, so that an inner
   /// 'var' shadowing an outer 'const' is still assignable.  Recording only the
   /// constants would leave the inner name unmentioned and the search would walk
   /// out to the outer one and refuse.
   Constants       : Stack;

   /// The same, for names declared at the top level, where there is no scope to
   /// push.
   GlobalConstants : Map;

   /// The kind of subprogram being walked, or FUN_NONE outside one.
   CurrentFunction : FunctionType;

   /// The kind of class being walked, or CLASS_NONE outside one.
   CurrentClass    : ClassType;

   /// The units this file may qualify against.
   ///
   /// 'System' is in every file's -- it is the built-ins, and no file imports
   /// it.  A 'uses' adds the file it named, and only to the importer: the set is
   /// saved and replaced around a module's own statements, which is what keeps
   /// qualification as non-transitive as the import it follows.
   ///
   /// # Satisfies
   ///
   /// [MOD-011]
   Units    : Set;

   /// Every top-level name that could answer a dot, program-wide: an object, an
   /// enum type, a file-scope var or const.
   ///
   /// These OUTRANK a unit of the same name, because they mean something today
   /// and a unit qualifier would silently take it over.
   ///
   /// Classes and functions are deliberately absent.  Neither can answer a dot
   /// -- 'Thing.Get ()' on a bare class is 'Only instances have properties.' --
   /// so the syntactic slot is free, and that is what lets
   /// 'Scanner.ScanTokens ()' work in a file whose unit and primary class share
   /// the name.  Eighteen of algc's units are exactly that shape.
   Dottable : Set;

   /// Set once the pre-pass has run, since ResolveAll is both the entry point
   /// and the recursive step.
   Collected : Boolean := False;

   /// The labels each enclosing block declares, innermost last.
   ///
   /// Emptied for a function body rather than pushed to, because a goto may not
   /// leave the subprogram it is written in.
   LabelScopes : List := [];

begin
    /// Makes a resolver that will record its bindings in an interpreter.
    ///
    /// 'System' is seeded into Units because the built-ins are a unit no file
    /// imports.
    constructor Init(TheInterpreter : Interpreter);
    begin
        this.TheInterpreter := TheInterpreter;
        this.Scopes := Stack();
        this.Constants := Stack();
        this.GlobalConstants := Map();
        this.CurrentFunction := FUN_NONE;
        this.CurrentClass := CLASS_NONE;
        this.Units := Set();
        this.Units.Add ('system');
        this.Dottable := Set();
    end

    /// Fills Dottable before anything is resolved.
    ///
    /// A pre-pass rather than a running tally, for the reason CEmitter collects
    /// its globals up front: a function declared above an object still reaches
    /// it, so a set filled in resolution order would let a unit win where the
    /// object should.
    ///
    /// Program-wide rather than per file, which over-approximates across module
    /// boundaries -- an 'object Console' in one file stops another file
    /// qualifying its own unit of that name.  That direction is the safe one: it
    /// only ever declines to qualify, and never changes what a name already
    /// meant.
    procedure CollectDottable (Statements : List);
    begin
        for var I := 0; I < Statements.Length; I := I + 1 do
        begin
            var TheStmt := Statements[I];

            if TheStmt is ObjectStmt then Dottable.Add (FoldCase (TheStmt.Name.Lexeme));
            if TheStmt is EnumStmt   then Dottable.Add (FoldCase (TheStmt.Name.Lexeme));
            if TheStmt is VarStmt    then Dottable.Add (FoldCase (TheStmt.Name.Lexeme));

            if TheStmt is VarGroupStmt then
                for var J := 0; J < TheStmt.Names.Length; J := J + 1 do
                    Dottable.Add (FoldCase (TheStmt.Names[J].Lexeme));

            if TheStmt is ModuleStmt and TheStmt.Statements <> Nil then
                CollectDottable (TheStmt.Statements);
        end
    end

    /// Whether the left of a dot names a unit rather than a value.
    ///
    /// The order is the whole rule, and it is the order every other name in this
    /// language follows -- nearest binding first, the outermost thing last:
    ///
    ///   1. a local or a parameter, which shadows everything;
    ///   2. a top-level name that can answer a dot (Dottable);
    ///   3. a unit.
    ///
    /// So a variable named Console shadows the unit Console exactly as it
    /// shadows anything else, and the Parser could not have decided this: 'A.B'
    /// is the same three tokens either way, and only scope tells them apart.
    function IsUnitQualifier (Obj : Any) : Boolean;
    begin
        if not (Obj is VariableExpr) then Exit False;

        var Name := Str (Obj.Name.Lexeme);

        if not Units.Contains (FoldCase (Name))  then Exit False;
        if Dottable.Contains (FoldCase (Name))   then Exit False;

        for var I := Scopes.Length - 1; I >= 0; I := I - 1 do
            if Scopes[I].Contains (FoldCase (Name)) then Exit False;

        Exit True;
    end

    /// Resolves a block in a scope of its own.
    procedure VisitBlockStmt (Stmt : BlockStmt);
    begin
        BeginScope();
        ResolveAll(Stmt.Statements);
        EndScope();
    end

    /// Resolves a class: its parent, then a scope holding 'super', then a scope
    /// holding 'this', then the methods.
    ///
    /// A class inheriting from itself is refused here, at the DECLARATION,
    /// rather than at construction.
    ///
    /// # Raises
    ///
    /// 'A class can''t inherit from itself.'
    ///
    /// # Satisfies
    ///
    /// [CLS-013]
    procedure VisitClassStmt (Stmt : ClassStmt);
    var
        EnclosingClass : ClassType;

    begin
        EnclosingClass := CurrentClass;
        CurrentClass := CLASS_CLASS;

        Declare (Stmt.Name);
        Define (Stmt.Name);

        if Stmt.Superclass <> Nil and Stmt.Name.Lexeme = Stmt.Superclass.Name.Lexeme then
        begin
            raise 'A class can''t inherit from itself.';
        end

        if Stmt.Superclass <> Nil then
        begin
            CurrentClass := CLASS_SUBCLASS;
            Resolve (Stmt.Superclass);
        end

        if Stmt.Superclass <> Nil then
        begin
           BeginScope();
           Scopes.Peek().Put('super', True);
        end

        BeginScope();
        Scopes.Peek().Put ('this', true);

        for var I := 0; I < Stmt.Methods.Length; I := I + 1 do
        begin
            var Declaration := FUN_FUNCTION;
            if FoldCase (Stmt.Methods[I].Name.Lexeme) = 'init' then
            begin
                Declaration := FUN_INITIALIZER;
            end
            ResolveFunction (Stmt.Methods[I], Declaration);
        end

        EndScope();

        if Stmt.Superclass <> Nil then EndScope();

        CurrentClass := EnclosingClass;
    end

    /// Resolves an object, which is a class in every respect the resolver cares
    /// about.
    procedure VisitObjectStmt (Stmt : ObjectStmt);
    begin
        VisitClassStmt (ClassStmt (Stmt.Name, Stmt.Superclass, Stmt.Methods, Stmt.Fields));
    end

    /// Records a subrange's bounds, so every later pass can find them.
    ///
    /// The resolver is the last pass to see every declaration before the
    /// checker, the interpreter and the emitter each need the bounds.
    ///
    /// # Satisfies
    ///
    /// [TYP-016]
    procedure VisitSubrangeStmt (Stmt : SubrangeStmt);
    begin
        Declare (Stmt.Name);
        Define (Stmt.Name);

        DefineSubrange (Stmt.Name.Lexeme, Stmt.Low, Stmt.High);
    end

    /// Resolves an enumeration, declaring its type name and every member as a
    /// bare name.
    procedure VisitEnumStmt (Stmt : EnumStmt);
    begin
        Declare (Stmt.Name);
        Define (Stmt.Name);

        for var I := 0; I < Stmt.Members.Length; I := I + 1 do
        begin
            Declare (Stmt.Members[I]);
            Define (Stmt.Members[I]);
        end
    end

    /// Resolves an expression statement.
    procedure VisitExpressionStmt (Stmt : ExpressionStmt);
    begin
        Resolve (Stmt.Expression);
    end

    /// Resolves an if, both branches included.
    ///
    /// Both are resolved whichever way the condition would go, because
    /// resolution is static and does not know.
    procedure VisitIfStmt (Stmt : IfStmt);
    begin
        Resolve (Stmt.Condition);
        Resolve (Stmt.ThenBranch);
        if (Stmt.ElseBranch <> Nil) then Resolve (Stmt.ElseBranch);
    end

    /// Resolves a try and each handler, with the handler's name bound in a
    /// scope of its own.
    procedure VisitTryStmt (Stmt : TryStmt);
    var
        Keys : List;

    begin
        Resolve (Stmt.TryBlock);

        Keys := Stmt.Handlers.Keys();
        for var I := 0; I < Keys.Length; I := I + 1 do
            Resolve (Stmt.Handlers.Get (Keys[I]).Body);
    end

    /// Resolves an imported file's statements with that file's unit set.
    ///
    /// Units is SAVED and REPLACED around the module rather than added to,
    /// which is what keeps qualification non-transitive: a file may qualify
    /// against what it imported, and not against what its imports imported.
    procedure VisitModuleStmt (Stmt : ModuleStmt);
    var
        Enclosing : Set;

    begin
        if Stmt.Statements = Nil then
        begin
            Units.Add (FoldCase (Stmt.UnitName));
            Exit;
        end

        Enclosing := Units;
        Units := Set();
        Units.Add ('system');

        ResolveAll (Stmt.Statements);

        Units := Enclosing;
        Units.Add (FoldCase (Stmt.UnitName));
    end

    /// Resolves 'for X in C do', with the loop variable in a scope of its own.
    ///
    /// # Satisfies
    ///
    /// [DCL-008]
    procedure VisitForInStmt (Stmt : ForInStmt);
    begin
        Resolve (Stmt.Iterable);

        BeginScope ();
        Declare (Stmt.Name);
        Define (Stmt.Name);
        Resolve (Stmt.Body);
        EndScope ();
    end

    /// Resolves a 'break', which binds no names.
    procedure VisitBreakStmt (Stmt : BreakStmt);
    begin
    end

    /// Resolves a 'continue', which binds no names.
    procedure VisitContinueStmt (Stmt : ContinueStmt);
    begin
    end

    /// Resolves a labelled statement, and marks the label if a goto names it.
    ///
    /// The mark is set here because this is the pass that pairs a goto with its
    /// label anyway; the emitter reads it so a C label is written only where
    /// something jumps to it, an unused one being a warning under -Wall.
    procedure VisitLabelStmt (Stmt : LabelStmt);
    begin
        Resolve (Stmt.Inner);
    end

    /// Resolves the value a 'raise' throws.
    procedure VisitRaiseStmt (Stmt : RaiseStmt);
    begin
        Resolve (Stmt.Value);
    end

    /// Resolves an 'Exit', refusing one outside a subprogram and a value from a
    /// constructor.
    ///
    /// # Raises
    ///
    /// 'Can''t return from top-level code.' and
    /// 'Can''t return a value from an initializer.' -- a constructor must answer
    /// 'this'.
    ///
    /// # Satisfies
    ///
    /// [STM-015]
    procedure VisitReturnStmt (Stmt : ReturnStmt);
    begin
        if CurrentFunction = FUN_NONE then
        begin
            raise 'Can''t return from top-level code.';
        end

        if (Stmt.Value <> Nil) then
        begin
            if CurrentFunction = FUN_INITIALIZER then
            begin
                raise 'Can''t return a value from an initializer.';
            end

            Resolve (Stmt.Value);
        end
    end

    /// Resolves a while, its body and its step.
    procedure VisitWhileStmt (Stmt : WhileStmt);
    begin
        Resolve (Stmt.Condition);
        Resolve (Stmt.Body);
    end

    /// Resolves a subprogram declaration.
    ///
    /// The name is declared AND defined before the body is walked, so a
    /// function may call itself.
    procedure VisitFunctionStmt (Stmt : FunctionStmt);
    begin
        Declare (Stmt.Name);
        Define (Stmt.Name);

        ResolveFunction (Stmt, FUN_FUNCTION);
    end

    /// Resolves a 'var' or 'const': its initializer, then the name it binds.
    procedure VisitVarStmt (Stmt : VarStmt);
    begin
        DeclareBinding (Stmt.Name, Stmt.IsConstant);
        if (Stmt.Initializer <> Nil) then
        begin
            Resolve (Stmt.Initializer);
        end
        Define (Stmt.Name);
    end

    /// Resolves a group declaration, binding every name to the one initializer.
    procedure VisitVarGroupStmt (Stmt : VarGroupStmt);
    begin
        for var I := 0; I < Stmt.Names.Length; I := I + 1 do
            DeclareBinding (Stmt.Names[I], Stmt.IsConstant);

        if Stmt.Initializer <> Nil then Resolve (Stmt.Initializer);

        for var I := 0; I < Stmt.Names.Length; I := I + 1 do
            Define (Stmt.Names[I]);
    end

    /// Resolves an assignment, refusing one to a constant.
    ///
    /// # Raises
    ///
    /// A refusal naming the constant being assigned to.
    ///
    /// # Satisfies
    ///
    /// [VAR-013]
    procedure VisitAssignExpr (TheExpr : AssignExpr);
    begin
        if IsConstant (TheExpr.Name) then
            raise 'Can''t assign to constant ''' + TheExpr.Name.Lexeme + '''.';

        Resolve (TheExpr.Value);
        ResolveLocal (TheExpr, TheExpr.Name);
    end

    /// Resolves both operands of a binary operation.
    procedure VisitBinary (TheExpr : BinaryExpr);
    begin
        Resolve (TheExpr.Left);
        Resolve (TheExpr.Right);
    end

    /// Resolves both operands of an 'and' or 'or'.
    procedure VisitLogical (TheExpr : LogicalExpr);
    begin
        Resolve (TheExpr.Left);
        Resolve (TheExpr.Right);
    end

    /// Resolves the operand of a prefix operator.
    procedure VisitUnary (TheExpr : UnaryExpr);
    begin
        Resolve (TheExpr.Right);
    end

    /// Resolves the callee and every argument.
    procedure VisitCall (TheExpr : CallExpr);
    begin
        Resolve (TheExpr.Callee);
        for var I := 0; I < TheExpr.Arguments.Length; I := I + 1 do
        begin
            Resolve(TheExpr.Arguments[I]);
        end
    end

    /// Resolves a property read, deciding whether the left of the dot is a unit
    /// qualifier or a receiver.
    ///
    /// The Parser could not decide it -- see IsUnitQualifier.
    procedure VisitGetExpr (TheExpr : GetExpr);
    begin
        if IsUnitQualifier (TheExpr.Obj) then
        begin
            TheExpr.Unit := Str (TheExpr.Obj.Name.Lexeme);

            Exit;
        end

        Resolve(TheExpr.Obj);
    end

    /// Resolves a property write, deciding the qualifier the same way a read
    /// does.
    procedure VisitSetExpr (TheExpr : SetExpr);
    begin
        if IsUnitQualifier (TheExpr.Obj) then
        begin
            TheExpr.Unit := Str (TheExpr.Obj.Name.Lexeme);
            Resolve(TheExpr.Value);
            Exit;
        end

        Resolve(TheExpr.Value);
        Resolve(TheExpr.Obj);
    end

    /// Resolves 'super', refusing it outside a subclass.
    ///
    /// # Raises
    ///
    /// 'Can''t use ''super'' outside a class.' and its no-superclass variant.
    ///
    /// # Satisfies
    ///
    /// [DCL-010]
    procedure VisitSuperExpr (TheExpr : SuperExpr);
    begin
        if CurrentClass = CLASS_NONE then
           raise 'Can''t use ''super'' outside a class.';
        else if CurrentClass <> CLASS_SUBCLASS then
           raise 'Can''t use ''super'' in a class with no superclass.';

        ResolveLocal(TheExpr, TheExpr.Keyword);
    end

    /// Resolves 'this', refusing it outside a class.
    ///
    /// # Raises
    ///
    /// 'Can''t use ''this'' outside a class.'
    ///
    /// # Satisfies
    ///
    /// [DCL-009]
    procedure VisitThisExpr (TheExpr : ThisExpr);
    begin
        if CurrentClass = CLASS_NONE then
        begin
            raise 'Can''t use ''this'' outside a class.';
        end

        ResolveLocal (TheExpr, TheExpr.Keyword);
    end

    /// Resolves the value an 'is' asks about.  The type name is not a binding.
    procedure VisitIsExpr (TheExpr : IsExpr);
    begin
        Resolve (TheExpr.Obj);
    end

    /// Resolves the expression inside a group.
    procedure VisitGrouping (TheExpr : GroupingExpr);
    begin
        Resolve (TheExpr.Expression);
    end

    /// Resolves a subscript read: the receiver and the index.
    procedure VisitSubscriptExpr (TheExpr : SubscriptExpr);
    begin
        Resolve (TheExpr.Obj);
        Resolve (TheExpr.Index);
    end

    /// Resolves a subscript write: the receiver, the index and the value.
    procedure VisitSetSubscriptExpr (TheExpr : SetSubscriptExpr);
    begin
        Resolve (TheExpr.Obj);
        Resolve (TheExpr.Index);
        Resolve (TheExpr.Value);
    end

    /// Resolves every key and value of a collection literal.
    procedure VisitCollectionExpr (TheExpr : CollectionExpr);
    begin
        for var I := 0; I < TheExpr.Keys.Length; I := I + 1 do
            Resolve (TheExpr.Keys[I]);

        for var I := 0; I < TheExpr.Values.Length; I := I + 1 do
            Resolve (TheExpr.Values[I]);
    end

    /// Resolves a literal, which binds nothing.
    procedure VisitLiteral (TheExpr : LiteralExpr);
    begin
    end

    /// Resolves a bare name to the scope it came from.
    function VisitVariableExpr (TheExpr : VariableExpr);
    begin
        if Not Scopes.IsEmpty and Scopes.Peek().Get(FoldCase (TheExpr.Name.Lexeme)) = False then
        begin
           raise 'Can''t read local variable in its own initializer.';
        end

        ResolveLocal (TheExpr, TheExpr.Name);
    end

    /// Refuses two declarations of one name in a single scope.
    ///
    /// Two enumerations may share a MEMBER name -- that is not a duplicate, and
    /// only an unresolvable bare use of it is an error.
    ///
    /// # Raises
    ///
    /// A refusal naming the redeclared name.
    ///
    /// # Satisfies
    ///
    /// [ENU-003], [VAR-007]
    procedure CheckDuplicates (Statements : List);
    var
        Seen        : Set;
        MemberOwner : Map;
        Signatures  : Map;

    begin
        Seen := Set();
        MemberOwner := Map();
        Signatures := Map();

        for var I := 0; I < Statements.Length; I := I + 1 do
        begin
            var TheStmt := Statements[I];

            if TheStmt is ModuleStmt then
            begin
                if TheStmt.Statements <> Nil then CheckDuplicates (TheStmt.Statements);
            end
            else
            begin
                var TheName := '';

                var Written := '';

                if TheStmt is FunctionStmt then
                begin
                    var FnName := FoldCase (TheStmt.Name.Lexeme);
                    var Signature := SignatureOf (TheStmt);

                    if Seen.Contains (FnName) or MemberOwner.Contains (FnName) then
                        raise '''' + Str (TheStmt.Name.Lexeme) + ''' is already defined.';

                    if not Signatures.Contains (FnName) then
                        Signatures.Put (FnName, List());

                    var Taken := Signatures.Get (FnName);
                    for var J := 0; J < Taken.Length; J := J + 1 do
                        if Str (Taken[J]) = Signature then
                            raise '''' + Str (TheStmt.Name.Lexeme)
                                + ''' is already defined.';

                    Taken.Add (Signature);
                end

                if TheStmt is ClassStmt  then TheName := FoldCase (TheStmt.Name.Lexeme);
                if TheStmt is ObjectStmt then TheName := FoldCase (TheStmt.Name.Lexeme);
                if TheStmt is VarStmt    then TheName := FoldCase (TheStmt.Name.Lexeme);

                if TheName <> '' then Written := Str (TheStmt.Name.Lexeme);

                if TheStmt is EnumStmt then
                begin
                    var Owner := FoldCase (TheStmt.Name.Lexeme);

                    for var J := 0; J < TheStmt.Members.Length; J := J + 1 do
                    begin
                        var Member  := FoldCase (TheStmt.Members[J].Lexeme);
                        var AsWritten := Str (TheStmt.Members[J].Lexeme);

                        if Seen.Contains (Member) then
                            raise '''' + AsWritten + ''' is already defined.';

                        if MemberOwner.Contains (Member) then
                            if Str (MemberOwner.Get (Member)) = Owner then
                                raise '''' + AsWritten + ''' is already defined.';

                        MemberOwner.Put (Member, Owner);
                    end

                    TheName := FoldCase (TheStmt.Name.Lexeme);
                    Written := Str (TheStmt.Name.Lexeme);
                end

                if TheStmt is VarGroupStmt then
                    for var J := 0; J < TheStmt.Names.Length; J := J + 1 do
                    begin
                        var Each := FoldCase (TheStmt.Names[J].Lexeme);

                        if Seen.Contains (Each) then
                            raise '''' + Str (TheStmt.Names[J].Lexeme) + ''' is already defined.';

                        if MemberOwner.Contains (Each) then
                            raise '''' + Str (TheStmt.Names[J].Lexeme) + ''' is already defined.';

                        if Signatures.Contains (Each) then
                            raise '''' + Str (TheStmt.Names[J].Lexeme) + ''' is already defined.';

                        Seen.Add (Each);
                    end

                if TheName <> '' then
                begin
                    if Seen.Contains (TheName) then
                        raise '''' + Written + ''' is already defined.';

                    if MemberOwner.Contains (TheName) then
                        raise '''' + Written + ''' is already defined.';

                    if Signatures.Contains (TheName) then
                        raise '''' + Written + ''' is already defined.';

                    Seen.Add (TheName);
                end
            end
        end
    end

    /// Gets a subprogram's signature as text, for detecting a duplicate.
    ///
    /// Two subprograms with the same signature are a duplicate rather than an
    /// overload, because a call could never tell them apart.
    ///
    /// # Satisfies
    ///
    /// [FUN-013]
    function SignatureOf (TheStmt : Any) : String;
    var
        Text : String;

    begin
        Text := Str (TheStmt.Params.Length);

        for var I := 0; I < TheStmt.Params.Length; I := I + 1 do
        begin
            var Declared := Str (TheStmt.ParamTypes[I]);
            if Declared = '' then Declared := 'Any';

            Text := Text + '/' + FoldCase (Declared);
        end

        Exit Text;
    end

    /// Refuses a class whose declared parent is not a class.
    ///
    /// Checked at the DECLARATION rather than at construction, which is where
    /// a reader would look for it.
    ///
    /// # Raises
    ///
    /// A refusal naming the superclass.
    ///
    /// # Satisfies
    ///
    /// [CLS-014]
    procedure CheckInheritance (Statements : List);
    var
        Parent : Map;

    begin
        Parent := Map();

        for var I := 0; I < Statements.Length; I := I + 1 do
            if Statements[I] is ClassStmt then
                if Statements[I].Superclass <> Nil then
                    Parent.Put (FoldCase (Statements[I].Name.Lexeme),
                                FoldCase (Statements[I].Superclass.Name.Lexeme));

        for var Name in Parent.Keys() do
        begin
            var Seen := Set();
            var At := Str (Name);

            while Parent.Contains (At) do
            begin
                if Seen.Contains (At) then
                    raise 'A class can''t inherit from itself.';

                Seen.Add (At);
                At := Str (Parent.Get (At));
            end
        end
    end

    /// Resolves a whole list of statements, running the pre-passes first.
    ///
    /// Both the entry point and the recursive step, which is what Collected
    /// guards: the pre-passes must run once, not once per nested list.
    procedure ResolveAll (Statements : List);
    begin
        if not Collected then
        begin
            Collected := True;
            CollectDottable (Statements);
            CheckDuplicates (Statements);
            CheckInheritance (Statements);
        end

        PushLabels (Statements);

        for var I := 0; I < Statements.Length; I := I + 1 do
        begin
            Resolve(Statements[I]);
        end

        PopLabels ();
    end

    /// Opens a label scope holding the labels this block declares.
    procedure PushLabels (Statements : List);
    var
        Found : List;

    begin
        Found := List();

        for var I := 0; I < Statements.Length; I := I + 1 do
            if Statements[I] is LabelStmt then Found.Add (Statements[I]);

        LabelScopes.Add (Found);
    end

    /// Closes the innermost label scope.
    procedure PopLabels ();
    begin
        LabelScopes.RemoveAt (LabelScopes.Length - 1);
    end

    /// Finds a label in this block or an enclosing one, or Nil.
    function FindLabel (Named : String) : Any;
    begin
        for var S := LabelScopes.Length - 1; S >= 0; S := S - 1 do
        begin
            var Scope := LabelScopes[S];

            for var I := 0; I < Scope.Length; I := I + 1 do
                if FoldCase (Str (Scope[I].Name.Lexeme)) = FoldCase (Named) then
                    Exit Scope[I];
        end

        Exit Nil;
    end

    /// Resolves a goto, refusing one that names no reachable label.
    ///
    /// A goto may name a label in the same block or an enclosing one, and may
    /// not jump into a nested block or leave the subprogram.  That is not a
    /// restriction chosen here: an exception can travel outward through blocks
    /// and has no way to travel inward, and C is exactly as unwilling.
    ///
    /// # Raises
    ///
    /// A refusal naming the label when nothing reachable declares it.
    ///
    /// # Satisfies
    ///
    /// [STM-024]
    procedure VisitGotoStmt (Stmt : GotoStmt);
    var
        Target : Any;

    begin
        Target := FindLabel (Stmt.Label);

        if Target = Nil then
            raise 'No label ''' + Stmt.Label + ''' is in scope.';

        Target.Targeted := True;
    end

    /// Resolves any node, dispatching through its Accept.
    procedure Resolve (TheExpr : Any);
    begin
        TheExpr.Accept (this);
    end

    /// Resolves a subprogram body in a scope holding its parameters.
    ///
    /// CurrentFunction is saved and restored rather than set, because a
    /// subprogram may be declared inside another.
    procedure ResolveFunction (TheFunction : FunctionStmt, TypeOfFunction : FunctionType);
    var
       EnclosingFunction : FunctionType;

    begin
        EnclosingFunction := CurrentFunction;
        CurrentFunction := TypeOfFunction as FunctionType;

        BeginScope ();
        for var I := 0; I < TheFunction.Params.Length; I := I + 1 do
        begin
            var Param  := TheFunction.Params[I];
            Declare (Param);
            Define (Param);
        end
        var EnclosingLabels := LabelScopes;
        LabelScopes := List();

        ResolveAll (TheFunction.Body);

        LabelScopes := EnclosingLabels;
        EndScope();

        CurrentFunction := EnclosingFunction;
    end

    /// Opens a scope, and the matching frame of constant flags.
    ///
    /// # Satisfies
    ///
    /// [DCL-001]
    procedure BeginScope ();
    begin
        Scopes.Push (Map());
        Constants.Push (Map());
    end

    /// Closes a scope, popping both stacks together.
    procedure EndScope ();
    begin
        Scopes.Pop ();
        Constants.Pop ();
    end

    /// Declares a name in the innermost scope, not yet finished.
    ///
    /// The two-step declare-then-define is what makes 'var X := X;' an error:
    /// the name exists but is unfinished while its own initializer is resolved.
    ///
    /// # Satisfies
    ///
    /// [DCL-003]
    procedure Declare (Name : Token);
    begin
        DeclareBinding (Name, False);
    end

    /// Declares a name and records whether it is constant.
    ///
    /// A 'var' may shadow a 'const', and the inner name is then an ordinary
    /// variable -- which works only because every name is recorded here, not
    /// just the constant ones.
    ///
    /// # Satisfies
    ///
    /// [DCL-004]
    procedure DeclareBinding (Name : Token, IsConstant : Boolean);
    var
       Scope : Map;

    begin
        if Scopes.IsEmpty then
        begin
            GlobalConstants.Put (FoldCase (Name.Lexeme), IsConstant);
            Exit;
        end

        Scope := Scopes.Peek() as Map;
        if Scope.Contains (FoldCase (Name.Lexeme)) then
        begin
           raise 'Already a variable with this name in this scope.';
        end

        Scope.Put (FoldCase (Name.Lexeme), False);
        Constants.Peek().Put (FoldCase (Name.Lexeme), IsConstant);
    end

    /// Whether a name was declared constant, searching inner scopes first.
    function IsConstant (Name : Token) : Boolean;
    var
        Lexeme : String;

    begin
        Lexeme := Str (Name.Lexeme);

        for var I := Constants.Length - 1; I >= 0; I := I - 1 do
            if Constants[I].Contains (FoldCase (Lexeme)) then Exit Constants[I].Get (FoldCase (Lexeme));

        if GlobalConstants.Contains (FoldCase (Lexeme)) then Exit GlobalConstants.Get (FoldCase (Lexeme));

        Exit False;
    end

    /// Marks a declared name as finished, so it may now be read.
    procedure Define (Name : Token);
    var
       Scope : Map;

    begin
        if Scopes.IsEmpty then Exit;

        Scope := Scopes.Peek() as Map;
        Scope.Put (FoldCase (Name.Lexeme), True);
    end

    /// Binds a name to the number of scopes out that it was declared, and tells
    /// the interpreter.
    ///
    /// A name found nowhere is left unresolved rather than refused, because it
    /// may be a global that has not been declared yet -- a free name in a body
    /// resolves when the body runs.
    ///
    /// # Raises
    ///
    /// A refusal for a local read inside its own initializer.
    ///
    /// # Satisfies
    ///
    /// [DCL-002], [DCL-005]
    procedure ResolveLocal (TheExpr : Expr, Name : Token);
    begin
        for var I : Integer := Scopes.Length - 1; I >= 0; I := I - 1 do
        begin
            if Scopes[I].Contains (FoldCase (Name.Lexeme)) then
            begin
                TheInterpreter.Resolve (TheExpr, Scopes.Length - 1 - I);
                Exit;
            end
        end
    end
end

// Resolver should have zero hops if defined and used in same scope.
//
test 'Resolve Same Level';
begin
    var TheScanner := Scanner ('var test := true; test;');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    TheResolver.ResolveAll(Statements);

    var Result := TheInterpreter.Locals.Get (Statements[1].Expression);
    AssertTrue (Result = Nil);
end

// Resolver should have zero hops if defined and used in same scope.  Trying it two levels deep.
//
test 'Resolve Same Level Two Deep';
begin
    var TheScanner := Scanner (' begin var test := true; test; end');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    TheResolver.ResolveAll(Statements);

    // FIXME
    //var Key : VariableExpr := Statements[0].Statements[1].Expression;

    var Result := TheInterpreter.Locals.Get (Statements[0].Statements[1].Expression);
    AssertEqual (0, Result);
end

// Usage of variable in nested scope should have one hop.
//
test 'Resolve One Hop';
begin
    var TheScanner := Scanner (' begin var test := true; begin test; end end');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    TheResolver.ResolveAll(Statements);

    var Result := TheInterpreter.Locals.Get (Statements[0].Statements[1].Statements[0].Expression);
    AssertEqual (1, Result);
end

// Testing two hops.
//
test 'Resolve Two Hops';
begin
    var TheScanner := Scanner (' begin var test := true; begin begin test; end end end');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    TheResolver.ResolveAll(Statements);

    var Result := TheInterpreter.Locals.Get (Statements[0].Statements[1].Statements[0].Statements[0].Expression);
    AssertEqual (2, Result);
end

// Testing assignment resolves locals.
//
test 'Resolve Assignment';
begin
    var TheScanner := Scanner (' begin var test := true; begin test := false; end end');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    TheResolver.ResolveAll(Statements);

    var Result := TheInterpreter.Locals.Get (Statements[0].Statements[1].Statements[0].Expression);
    AssertEqual (1, Result);
end

// Testing logical resolves locals.
//
test 'Resolve Logical';
begin
    var TheScanner := Scanner (' begin var test := true; begin test := false or true; end end');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    TheResolver.ResolveAll(Statements);

    var Result := TheInterpreter.Locals.Get (Statements[0].Statements[1].Statements[0].Expression);
    AssertEqual (1, Result);
end

// Testing unary resolves locals.
//
test 'Resolve Unary';
begin
    var TheScanner := Scanner (' begin var test := true; var test2 := not test; end');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    TheResolver.ResolveAll(Statements);
end

// Testing binary resolves locals.
//
test 'Resolve Binary';
begin
    var TheScanner := Scanner (' begin var test := true; begin test := 1 > 2; end end');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    TheResolver.ResolveAll(Statements);

    var Result := TheInterpreter.Locals.Get (Statements[0].Statements[1].Statements[0].Expression);
    AssertEqual (1, Result);
end

// Testing grouping resolves locals.
//
test 'Resolve Grouping';
begin
    var TheScanner := Scanner (' begin var test := true; var test2 := (test); end');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    TheResolver.ResolveAll(Statements);
end

// Tests resolving function and call.
//
test 'Resolve Function and Call';
begin
    var TheScanner := Scanner ('
 begin
 function abc(a, b, c); begin
 test := 1 > 2;
 end
 abc(1, 2, 3);
 end
');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    TheResolver.ResolveAll(Statements);

    AssertEqual('[VariableExpr instance:0]', Str(TheInterpreter.Locals));
end

// Tests resolving if statements
//
test 'Resolve If';
begin
    var TheScanner := Scanner ('
 begin
 var test := 1;
 if test = 1 then begin
 test := 2;
 end
 else begin
 test := 3;
 end
 end
');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    TheResolver.ResolveAll(Statements);

    //AssertEqual('{AssignExpr instance=1, VariableExpr instance=0, AssignExpr instance=1}', Str(TheInterpreter.Locals));
end

// Tests resolving while statements
//
test 'Resolve While';
begin
    var TheScanner := Scanner ('
 begin
 var test := 1;

 while test < 10 do begin
 test := test + 1;
 end
 end
');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    TheResolver.ResolveAll(Statements);

    //AssertEqual('{VariableExpr instance=1, AssignExpr instance=1, VariableExpr instance=0}', Str(TheInterpreter.Locals));
end

// The resolver should report an error to Lox if a local variable is used in its own initializer.
//
test 'Resolve Local Variable Is Own Initializer';
begin
    var TheScanner := Scanner (' begin begin var test := test; end end');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    try
        TheResolver.ResolveAll(Statements);
    except
       on e : String do
            begin
               AssertEqual('Can''t read local variable in its own initializer.', e);
               Exit;
            end
    end
    Fail('No exception thrown.');
end

// The resolver should report an error to Lox if a local variable is declared twice in same scope.
//
test 'Resolve Duplicate Variable';
begin
    var TheScanner := Scanner ('
 function bad(); begin
 var a := ''first'';
 var a := ''second'';
 end
');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    try
        TheResolver.ResolveAll(Statements);
    except
       on e : String do
            begin
               AssertEqual('Already a variable with this name in this scope.', e);
               Exit;
            end
    end
    Fail('No exception thrown.');
end

// The resolver should report an error to Lox if a return value is not in a function block.
//
test 'Invalid Return';
begin
    var TheScanner := Scanner ('
 Exit ''not at top level'';
');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    try
        TheResolver.ResolveAll(Statements);
    except
       on e : String do
            begin
               AssertEqual('Can''t return from top-level code.', e);
               Exit;
            end
    end
    Fail('No exception thrown.');
end

// The resolver should report an error to Lox if a class tries to inherit from itself.
//
test 'Inherit From Self';
begin
    var TheScanner := Scanner ('class Pie(Pie); begin end');
    var TheParser := Parser (TheScanner.ScanTokens());
    var TheInterpreter := Interpreter();
    var TheResolver := Resolver(TheInterpreter);

    var Statements := TheParser.Parse();

    try
        TheResolver.ResolveAll(Statements);
    except
       on e : String do
            begin
               AssertEqual('A class can''t inherit from itself.', e);
               Exit;
            end
    end
    Fail('No exception thrown.');
end
