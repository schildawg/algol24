uses Scanner;
uses SourceCode;
uses Token;

/// Formatted output.
///
/// The shapes are fixed exactly, colour codes included, because an interpreted
/// report and a compiled one write to the same terminal and should be
/// indistinguishable.  A comparison may strip the colouring -- assertion carets
/// cannot be compared yet -- but that is not licence for the codes to differ.
///
const BAR := '------------------------------------------------------------------------';

const ESC := #27;

const ANSI_RESET  := ESC + '[0m';
const ANSI_RED    := ESC + '[31m';
const ANSI_GREEN  := ESC + '[32m';
const ANSI_YELLOW := ESC + '[33m';
const ANSI_BLUE   := ESC + '[34m';
const ANSI_CYAN   := ESC + '[36m';
const ANSI_WHITE  := ESC + '[37m';

/// The '[INFO] ' tag every report line opens with, colour and trailing space
///
/// ⚠️ Named INFO_TAG, not INFO, and ERROR_TAG rather than ERROR, because names
/// are matched WITHOUT REGARD TO CASE [SRC-011].  The object below has a
/// 'procedure Info' and a 'procedure Error'; under folded lookup a constant
/// spelled INFO is the same name as the method Info, which would shadow it
/// inside the method's own body.
/// included.
///
/// ⚠️ Here rather than spelled out at each site, because the test runner writes
/// report lines directly instead of going through Info -- it composes a dot
/// leader whose width is measured on the bare name -- and the C runtime spells
/// the same bytes a third time.  Two copies of this are unavoidable; three were
/// not.
///
const INFO_TAG := ANSI_WHITE + '[' + ANSI_BLUE + 'INFO' + ANSI_WHITE + '] ' + ANSI_RESET;

/// The '[ERROR] ' tag, on the same terms.
///
/// ⚠️ Only the first two of Error's three lines use it.  The third spells the
/// tag out because its ']' sits outside the white run, which is deliberate and
/// explained where it is written.
///
const ERROR_TAG := ANSI_WHITE + '[' + ANSI_RED + 'ERROR' + ANSI_WHITE + '] ' + ANSI_RESET;

/// The '[WARN] ' tag, on the same terms.
///
/// ⚠️ WARN_TAG rather than WARN, for the reason INFO_TAG carries: names are
/// matched WITHOUT REGARD TO CASE [SRC-011], and the object below has a
/// 'procedure Warn' that a constant spelled WARN would shadow inside its own
/// body.
///
const WARN_TAG := ANSI_WHITE + '[' + ANSI_YELLOW + 'WARN' + ANSI_WHITE + '] ' + ANSI_RESET;

object Console;
begin
    /// Repeats a character.  There is no builtin for it.
    function Repeat (What : Char, Times : Integer) : String;
    var
       Result : String := '';

    begin
        for var I := 0; I < Times; I := I + 1 do
            Result := Result + What;

        Exit Result;
    end

    /// [INFO] ------------------------------[ Program.a24 ]-----------------------
    procedure Header (Name : String);
    var
       Width : Integer;

    begin
        Width := Length(BAR) - 4 - Length(Name);
        Width := Width / 2;
        if Width < 0 then Width := 0;

        Info (Repeat('-', Width) + '[ ' + ANSI_CYAN + Name + ANSI_RESET + ' ]' + Repeat('-', Width));
    end

    /// [INFO] < Scanner.a24 >
    procedure Subheader (Name : String);
    begin
        Info ('< ' + ANSI_CYAN + Name + ANSI_RESET + ' >');
    end

    procedure Info (Text : String);
    begin
        WriteLn (INFO_TAG + Text);
    end

    /// [WARN] Main.a24:12: 'Log' selects among 3 overloads at run time.
    ///
    /// ⚠️ NON-BLOCKING, and that is the whole point.  It reports a cost, not a
    /// fault: the program compiles and runs exactly as it would without it.
    /// Run-time selection is the language's rule [FUN-013] and stays so; naming
    /// the parameters [EXP-013] is how a programmer avoids it in a particular
    /// call, and this is what makes that choice visible.  Without it the cost
    /// is real and invisible, and the remedy has nothing to point at.
    ///
    /// ⚠️ Refusal is for what the back end cannot express.  A construct that is
    /// legal and merely costly gets a warning instead, which is what keeps the
    /// twenty 'Unsupported (...)' sites meaning only one thing.
    ///
    procedure Warn (Text : String);
    begin
        WriteLn (WARN_TAG + Text);
    end

    /// [INFO] Program.a24 ................................. SUCCESS
    procedure Success (Name : String);
    var
       Width : Integer;

    begin
        Width := Length(BAR) - 10 - Length(Name);
        if Width < 0 then Width := 0;

        Info (Name + ' ' + Repeat('.', Width) + ANSI_GREEN + ' SUCCESS' + ANSI_RESET);
    end

    /// [INFO] Program.a24 ................................. FAILED
    procedure Fail (Name : String);
    var
       Width : Integer;

    begin
        Width := Length(BAR) - 10 - Length(Name);
        if Width < 0 then Width := 0;

        Info (Name + ' ' + Repeat('.', Width) + ANSI_RED + ' FAILED' + ANSI_RESET);
    end

    procedure Debug (Text : String);
    begin
        WriteLn (ANSI_WHITE + '[' + ANSI_YELLOW + 'DEBUG' + ANSI_WHITE + '] ' + ANSI_RESET + Text);
    end

    /// [ERROR] file: message
    /// [ERROR] 16 ║     AssertTrue(False);
    /// [ERROR]    ║                ^^^^^^
    ///
    /// The third line's ']' is outside the white run rather than inside it,
    /// which is deliberate: both reports write the same bytes or they do not
    /// match.
    ///
    procedure Error (Where : Token, Message : String);
    var
       Text  : String;
       Digits : Integer;

    begin
        // ⚠️ 'as String', not a bare assignment.  A Map's Get is untyped, and
        // a written type is a claim that has to be earned [VAR-006] -- the cast
        // is where an untyped value crosses into a typed one, and it is checked
        // [VAL-007].
        Text := SourceCode.Get (Where.LineNumber) as String;
        Digits := Length (Str (Where.LineNumber));

        WriteLn (ERROR_TAG + SourceCode.Name() + ': ' + Message);

        // ⚠️ '|', not a box-drawing #9553.
        //
        // The C runtime refuses a Char above 127, deliberately: a code point
        // that high would have to be encoded as UTF-8, and then Length and
        // subscripting would disagree with the interpreter, which yields a
        // UTF-16 unit.  It refuses rather than guessing -- and #9553 in algc's
        // own diagnostics is what made a COMPILED algc unable to compile
        // anything at all.
        //
        // Only [ERROR] lines carry it, and every comparison drops those, so
        // this costs a prettier caret and nothing else.
        WriteLn (ERROR_TAG + Str(Where.LineNumber) + ' | ' + Text);

        WriteLn (ANSI_WHITE + '[' + ANSI_RED + 'ERROR' + ANSI_RESET + '] ' + Repeat(' ', Digits)
                 + ' |' + ANSI_RED + Repeat(' ', Where.Offset + 1)
                 + Repeat('^', Length(Where.Lexeme)) + ANSI_RESET);
    end
end
