/// Formatted output: the tags, the colors and the report lines both processors
/// write.
///
/// The shapes are fixed exactly, color codes included, because an interpreted
/// report and a compiled one write to the same terminal and should be
/// indistinguishable.  A comparison may strip the coloring -- assertion carets
/// cannot be compared yet -- but that is not licence for the codes to differ.
unit Console;

uses Scanner;
uses SourceCode;
uses Token;

/// The rule a header is drawn from, at the width a report line uses.
const BAR := '------------------------------------------------------------------------';

/// The escape character that opens every color sequence.
///
/// Written as a code point because the language has no backslash escapes:
/// '#27' is ESC and a backslash form would be two characters.
const ESC := #27;

/// Returns the terminal to its default color.
const ANSI_RESET  := ESC + '[0m';

/// Red, for an error.
const ANSI_RED    := ESC + '[31m';

/// Green, for a passing test.
const ANSI_GREEN  := ESC + '[32m';

/// Yellow, for a warning.
const ANSI_YELLOW := ESC + '[33m';

/// Blue, for an informational tag.
const ANSI_BLUE   := ESC + '[34m';

/// Cyan, for the name inside a header.
const ANSI_CYAN   := ESC + '[36m';

/// White, for the brackets a tag sits in.
const ANSI_WHITE  := ESC + '[37m';

/// The '[INFO] ' tag every report line opens with, color and trailing space
/// included.
///
/// Named INFO_TAG rather than INFO because names are matched WITHOUT REGARD TO
/// CASE [SRC-011].  The object below has a 'procedure Info', and under folded
/// lookup a constant spelled INFO is the same name -- which would shadow the
/// method inside its own body.
///
/// Here rather than spelled out at each site, because the test runner writes
/// report lines directly instead of going through Info -- it composes a dot
/// leader whose width is measured on the bare name -- and the C runtime spells
/// the same bytes a third time.  Two copies of this are unavoidable; three were
/// not.
const INFO_TAG := ANSI_WHITE + '[' + ANSI_BLUE + 'INFO' + ANSI_WHITE + '] ' + ANSI_RESET;

/// The '[ERROR] ' tag, on the same terms as INFO_TAG.
///
/// Only the first two of Error's three lines use it.  The third spells the tag
/// out because its ']' sits outside the white run, which is deliberate and
/// explained where it is written.
const ERROR_TAG := ANSI_WHITE + '[' + ANSI_RED + 'ERROR' + ANSI_WHITE + '] ' + ANSI_RESET;

/// The '[WARN] ' tag, on the same terms as INFO_TAG.
///
/// WARN_TAG rather than WARN for the reason INFO_TAG carries: the object below
/// has a 'procedure Warn' that a constant spelled WARN would shadow inside its
/// own body.
const WARN_TAG := ANSI_WHITE + '[' + ANSI_YELLOW + 'WARN' + ANSI_WHITE + '] ' + ANSI_RESET;

/// The one place a report line is composed.
object Console;
begin
    /// Repeats a character.  There is no built-in for it.
    function Repeat (What : Char, Times : Integer) : String;
    var
       Result : String := '';

    begin
        for var I := 0; I < Times; I := I + 1 do
            Result := Result + What;

        Exit Result;
    end

    /// Writes a run-wide banner naming the file under test.
    ///
    ///     [INFO] ------------------------------[ Program.a24 ]-----------------------
    procedure Header (Name : String);
    var
       Width : Integer;

    begin
        Width := Length(BAR) - 4 - Length(Name);
        Width := Width div 2;
        if Width < 0 then Width := 0;

        Info (Repeat('-', Width) + '[ ' + ANSI_CYAN + Name + ANSI_RESET + ' ]' + Repeat('-', Width));
    end

    /// Writes the heading that groups a file's tests.
    ///
    ///     [INFO] < Scanner.a24 >
    procedure Subheader (Name : String);
    begin
        Info ('< ' + ANSI_CYAN + Name + ANSI_RESET + ' >');
    end

    /// Writes one informational line, behind the '[INFO] ' tag.
    ///
    /// # Satisfies
    ///
    /// [TST-010]
    procedure Info (Text : String);
    begin
        WriteLn (INFO_TAG + Text);
    end

    /// Writes the one warning the compiler raises.
    ///
    ///     [WARN] Main.a24:12: 'Log' selects among 3 overloads at run time.
    ///
    /// NON-BLOCKING, and that is the whole point.  It reports a cost, not a
    /// fault: the program compiles and runs exactly as it would without it.
    /// Run-time selection is the language's rule [FUN-013] and stays so; naming
    /// the parameters [EXP-013] is how a programmer avoids it in a particular
    /// call, and this is what makes that choice visible.  Without it the cost is
    /// real and invisible, and the remedy has nothing to point at.
    ///
    /// Refusal is for what the back end cannot express.  A construct that is
    /// legal and merely costly gets a warning instead, which is what keeps the
    /// emitter's 'Unsupported (...)' sites meaning only one thing.
    ///
    /// # Satisfies
    ///
    /// [ERR-010]
    procedure Warn (Text : String);
    begin
        WriteLn (WARN_TAG + Text);
    end

    /// Writes a passing test's line, with a dot leader out to the verdict.
    ///
    ///     [INFO] Program.a24 ................................. SUCCESS
    procedure Success (Name : String);
    var
       Width : Integer;

    begin
        Width := Length(BAR) - 10 - Length(Name);
        if Width < 0 then Width := 0;

        Info (Name + ' ' + Repeat('.', Width) + ANSI_GREEN + ' SUCCESS' + ANSI_RESET);
    end

    /// Writes a failing test's line, laid out exactly as Success is.
    ///
    ///     [INFO] Program.a24 ................................. FAILED
    procedure Fail (Name : String);
    var
       Width : Integer;

    begin
        Width := Length(BAR) - 10 - Length(Name);
        if Width < 0 then Width := 0;

        Info (Name + ' ' + Repeat('.', Width) + ANSI_RED + ' FAILED' + ANSI_RESET);
    end

    /// Writes a line meant for whoever is working on the compiler.
    procedure Debug (Text : String);
    begin
        WriteLn (ANSI_WHITE + '[' + ANSI_YELLOW + 'DEBUG' + ANSI_WHITE + '] ' + ANSI_RESET + Text);
    end

    /// Writes a diagnostic as three lines: the message, the source line it
    /// happened on, and a caret under the token at fault.
    ///
    ///     [ERROR] file: message
    ///     [ERROR] 16 |     AssertTrue(False);
    ///     [ERROR]    |                ^^^^^^
    ///
    /// The third line's ']' is outside the white run rather than inside it,
    /// which is deliberate: both reports write the same bytes or they do not
    /// match.
    ///
    /// A test failure does NOT come through here.  It prints exactly one
    /// '[ERROR]' line, and adding a source line and a caret to it would make the
    /// interpreted and compiled reports disagree.
    ///
    /// # Satisfies
    ///
    /// [ERR-005]
    procedure Error (Where : Token, Message : String);
    var
       Text  : String;
       Digits : Integer;

    begin

        Text := SourceCode.Get (Where.LineNumber);
        Digits := Length (Str (Where.LineNumber));

        WriteLn (ERROR_TAG + SourceCode.Name() + ': ' + Message);

        WriteLn (ERROR_TAG + Str(Where.LineNumber) + ' | ' + Text);

        WriteLn (ANSI_WHITE + '[' + ANSI_RED + 'ERROR' + ANSI_RESET + '] ' + Repeat(' ', Digits)
                 + ' |' + ANSI_RED + Repeat(' ', Where.Offset + 1)
                 + Repeat('^', Length(Where.Lexeme)) + ANSI_RESET);
    end
end
