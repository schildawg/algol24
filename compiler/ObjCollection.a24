/// The collections as the interpreter sees them: a List, a Map or an Array,
/// wrapping the host's.
unit ObjCollection;

uses Token;

/// A bound collection method: a receiver, a name, and an arity.
///
/// One class rather than one per method, because the interpreter's calling
/// protocol only asks for Arity and Call, and dispatching inside Call is far
/// less code than twenty near-identical classes.
class CollectionMethod;
var
    /// The collection the method is bound to.
    Receiver  : ObjCollection;

    /// The member name, as a TOKEN rather than the folded string.
    ///
    /// Dispatch wants the fold and a diagnostic wants the spelling the program
    /// wrote [SRC-011]; keeping the token keeps both without a second table.
    Name      : Token;

    /// How many arguments the member takes.
    TheArity  : Integer;

begin
    /// Makes a method bound to a collection.
    constructor Init (Receiver : ObjCollection, Name : Token, TheArity : Integer);
    begin
        this.Receiver := Receiver;
        this.Name := Name;
        this.TheArity := TheArity;
    end

    /// How many arguments the member takes.
    function Arity () : Integer;
    begin
        Exit TheArity;
    end

    /// Invokes the member on its receiver.
    function Call (TheInterpreter, Arguments) : Any;
    begin
        Exit Receiver.Invoke (FoldCase (Str (Name.Lexeme)), Arguments);
    end

    /// Prints the member as a bound method is printed [TYP-012].
    ///
    /// It is the same kind of thing: a member read without being called.
    /// This inherited ObjInstance's rendering and printed
    /// 'CollectionMethod instance', naming a class that exists only inside
    /// algc -- a program has no way to know it, and nothing in the language
    /// answers to it.
    function ToString () : String;
    begin
        Exit '<fn ' + Str (Name.Lexeme) + '>';
    end
end

/// A List, an Array, a Map, a Set or a Stack.
///
/// It WRAPS a host collection rather than being one.  A host List is not an
/// instance -- it has no class -- so ClassName raises on it and the interpreter
/// could not tell it from a number.  Wrapping gives it a class name to
/// recognize, and costs one field.
///
/// All five share this class because they share almost every method, and what
/// differs is checked where it matters -- see Get, whose member table is per
/// kind.  An Array is a List that starts full of nil and refuses to grow.
class ObjCollection;
var
    /// Which of the five this is: 'List', 'Array', 'Map', 'Set' or 'Stack'.
    ///
    /// # Satisfies
    ///
    /// [TYP-007]
    Kind  : String;

    /// The elements, for every kind but a Map.
    ///
    /// A Map keeps its entries in Pairs; the others are sequences, and a Set and
    /// a Stack are sequences with a narrower member table.
    ///
    /// # Satisfies
    ///
    /// [COL-007]
    Items : List;

    /// The entries, for a Map.
    Pairs : Map;

begin
    /// Makes an empty collection of a given kind.
    constructor Init (Kind : String);
    begin
        this.Kind := Kind;
        this.Items := List();
        this.Pairs := Map();
    end

    /// Gets a property.
    ///
    /// The member table is PER KIND, which is why this is a chain of Kind tests
    /// rather than one list.  A Map simply has no Add and reports 'Undefined
    /// property ''Add''.' -- where this file used to accept every name for every
    /// kind and then raise an invented 'Only a List has ''Add''.' from Invoke, a
    /// message nothing else could produce.
    ///
    /// Length and IsEmpty answer directly: they are properties in Algol-24,
    /// written without parentheses.
    ///
    /// # Raises
    ///
    /// 'Undefined property ''X''.' for a name this kind does not answer.
    ///
    /// # Satisfies
    ///
    /// [COL-003], [COL-004], [COL-005], [COL-006], [TYP-009]
    function Get (TheName : Token) : Any;
    var
       Member : String;

    begin
        Member := FoldCase (TheName.Lexeme);

        if Member = 'length'  then Exit Count();
        if Member = 'isempty' then Exit Count() = 0;

        if Member = 'contains' then Exit CollectionMethod (this, TheName, 1);

        if Kind = 'List' then
        begin
            if Member = 'get'      then Exit CollectionMethod (this, TheName, 1);
            if Member = 'add'      then Exit CollectionMethod (this, TheName, 1);
            if Member = 'insert'   then Exit CollectionMethod (this, TheName, 2);
            if Member = 'removeat' then Exit CollectionMethod (this, TheName, 1);
            if Member = 'indexof'  then Exit CollectionMethod (this, TheName, 1);
            if Member = 'sort'     then Exit CollectionMethod (this, TheName, 0);
            if Member = 'clear'    then Exit CollectionMethod (this, TheName, 0);
        end

        if Kind = 'Array' then
        begin
            if Member = 'get'     then Exit CollectionMethod (this, TheName, 1);
            if Member = 'set'     then Exit CollectionMethod (this, TheName, 2);
            if Member = 'fill'    then Exit CollectionMethod (this, TheName, 1);
            if Member = 'indexof' then Exit CollectionMethod (this, TheName, 1);
            if Member = 'sort'    then Exit CollectionMethod (this, TheName, 0);
        end

        if Kind = 'Map' then
        begin
            if Member = 'get'    then Exit CollectionMethod (this, TheName, 1);
            if Member = 'put'    then Exit CollectionMethod (this, TheName, 2);
            if Member = 'remove' then Exit CollectionMethod (this, TheName, 1);
            if Member = 'keys'   then Exit CollectionMethod (this, TheName, 0);
            if Member = 'values' then Exit CollectionMethod (this, TheName, 0);
            if Member = 'clear'  then Exit CollectionMethod (this, TheName, 0);
        end

        if Kind = 'Set' then
        begin
            if Member = 'add'    then Exit CollectionMethod (this, TheName, 1);
            if Member = 'remove' then Exit CollectionMethod (this, TheName, 1);
            if Member = 'tolist' then Exit CollectionMethod (this, TheName, 0);
            if Member = 'clear'  then Exit CollectionMethod (this, TheName, 0);
        end

        if Kind = 'Stack' then
        begin
            if Member = 'push'  then Exit CollectionMethod (this, TheName, 1);
            if Member = 'pop'   then Exit CollectionMethod (this, TheName, 0);
            if Member = 'peek'  then Exit CollectionMethod (this, TheName, 0);
            if Member = 'clear' then Exit CollectionMethod (this, TheName, 0);
        end

        raise 'Undefined property ''' + Str (TheName.Lexeme) + '''.';
    end

    /// Wraps a host list as a List collection, for a member that answers one.
    function AsList (From : List) : ObjCollection;
    var
        Result : ObjCollection;

    begin
        Result := ObjCollection ('List');

        for var I := 0; I < From.Length; I := I + 1 do
            Result.Items.Add (From[I]);

        Exit Result;
    end

    /// Calls a method on the host collection.
    ///
    /// Every one delegates, so ordering, the insertion order a Map keeps, and
    /// Sort's refusal of a mixed list come from the one implementation rather
    /// than from a second copy of the rules.
    ///
    /// # Raises
    ///
    /// 'Undefined method ''X''.' for a name this kind does not answer, and
    /// whatever the host raises for a use the rules forbid -- Sort on a mixed
    /// list among them.
    ///
    /// # Satisfies
    ///
    /// [COL-008], [COL-009], [COL-010], [COL-011], [COL-012], [COL-013],
    /// [VAL-013]
    function Invoke (Name : String, Arguments : List) : Any;
    begin
        if Name = 'contains' then
        begin
            if Kind = 'Map' then Exit Pairs.Contains (Arguments[0]);

            Exit Items.Contains (Arguments[0]);
        end

        if Name = 'get' then
        begin
            if Kind = 'Map' then Exit Pairs.Get (Arguments[0]);

            Exit Items.Get (Arguments[0]);
        end

        if Name = 'add' then
        begin
            if Kind = 'Set' then
            begin
                if Not Items.Contains (Arguments[0]) then Items.Add (Arguments[0]);

                Exit Arguments[0];
            end

            Items.Add (Arguments[0]);
            Exit Arguments[0];
        end

        if Name = 'set' then
        begin
            Items[Arguments[0]] := Arguments[1];
            Exit Arguments[1];
        end

        if Name = 'put' then
        begin
            Pairs.Put (Arguments[0], Arguments[1]);
            Exit Arguments[1];
        end

        if Name = 'insert' then Exit Items.Insert (Arguments[0], Arguments[1]);

        if Name = 'removeat' then Exit Items.RemoveAt (Arguments[0]);

        if Name = 'indexof' then Exit Items.IndexOf (Arguments[0]);

        if Name = 'sort' then
        begin
            Items.Sort();
            Exit Nil;
        end

        if Name = 'fill' then
        begin
            for var I := 0; I < Items.Length; I := I + 1 do
                Items[I] := Arguments[0];

            Exit Nil;
        end

        if Name = 'keys'   then Exit AsList (Pairs.Keys());
        if Name = 'values' then Exit AsList (Pairs.Values());
        if Name = 'tolist' then Exit AsList (Items);

        if Name = 'remove' then
        begin
            if Kind = 'Map' then
            begin
                if Not Pairs.Contains (Arguments[0]) then Exit Nil;

                Exit Pairs.Remove (Arguments[0]);
            end

            var At := Items.IndexOf (Arguments[0]);
            if At < 0 then Exit False;

            Items.RemoveAt (At);
            Exit True;
        end

        if Name = 'push' then
        begin
            Items.Add (Arguments[0]);
            Exit Arguments[0];
        end

        if Name = 'pop' then
        begin
            if Items.Length = 0 then raise 'Pop from an empty Stack.';

            Exit Items.RemoveAt (Items.Length - 1);
        end

        if Name = 'peek' then
        begin
            if Items.Length = 0 then raise 'Peek at an empty Stack.';

            Exit Items[Items.Length - 1];
        end

        if Name = 'clear' then
        begin
            if Kind = 'Map' then Pairs.Clear();
            else Items.Clear();

            Exit Nil;
        end

        raise 'Undefined method ''' + Name + '''.';
    end

    /// Reads an element, for 'C[I]'.
    ///
    /// A List and an Array take an Integer position; a Map takes a key of any
    /// type.
    ///
    /// # Raises
    ///
    /// A bounds failure for a position outside a List or an Array, and a missing
    /// key for a Map.
    ///
    /// # Satisfies
    ///
    /// [COL-014], [COL-015], [TYP-008]
    function At (Index : Any) : Any;
    begin
        if Kind = 'Map' then Exit Pairs.Get (Index);

        if Kind = 'Set' then raise 'Subscript target should be an ordinal.';

        Exit Items[Index];
    end

    /// Writes an element, for 'C[I] := V', and answers the value.
    function PutAt (Index : Any, Value : Any) : Any;
    begin
        if Kind = 'Map' then Pairs.Put (Index, Value);
        else if Kind = 'Set' then raise 'Subscript target should be an ordinal.';
        else Items[Index] := Value;

        Exit Value;
    end

    /// Fills an Array with Size nils, which is what makes it start full and
    /// refuse to grow.
    procedure Allocate (Size : Integer);
    begin
        for var I := 0; I < Size; I := I + 1 do
            Items.Add (Nil);
    end

    /// How many elements the collection holds, whichever kind it is.
    function Count () : Integer;
    begin
        if Kind = 'Map' then Exit Pairs.Length;

        Exit Items.Length;
    end

    /// Prints the collection the way the language writes its literal.
    function ToString () : String;
    begin
        if Kind = 'Map' then Exit Str (Pairs);

        Exit Str (Items);
    end
end
