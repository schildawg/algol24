/// Enumerations at run time: a member, and the type a member is dotted out of.
unit ObjEnum;

uses Token;

/// A single enum member.
///
/// Members are interned by their type, so the bare 'Red' and the qualified
/// 'Color.Red' are the same object and comparing them by identity succeeds.
/// A copy would make 'Color.Red = Red' false.
class ObjEnum;
var
    /// The enumeration this member belongs to.
    TypeName : String;

    /// The member's own name, as the program spelled it.
    Name     : String;

    /// Position within the type, and the reason this is carried: truthiness
    /// reads the ordinal, so the FIRST member of every enum is falsey.
    Ordinal  : Integer;

begin
    /// Makes a member of an enumeration at a given position.
    constructor Init (TypeName : String, Name : String, Ordinal : Integer);
    begin
        this.TypeName := TypeName;
        this.Name := Name;
        this.Ordinal := Ordinal;
    end

    /// Prints the member as its bare name.
    ///
    /// # Satisfies
    ///
    /// [ENU-007]
    function ToString () : String;
    begin
        Exit Name;
    end

    /// Gets the one property a member answers: its zero-based position.
    ///
    /// The position GOVERNS behavior -- truthiness reads it, so the first
    /// member of every enumeration is falsey [ENU-009] -- and a program used to
    /// have no way to read it, so it could discover whether a member was falsey
    /// only by testing it for truth.  It is also what a program needs in order
    /// to order members [ENU-008], to index by one, or to write one out and read
    /// it back.
    ///
    /// # Raises
    ///
    /// 'Undefined property ''X''.' for any name but Ordinal.
    ///
    /// # Satisfies
    ///
    /// [ENU-010]
    function Get (TheName : Token) : Any;
    begin
        if FoldCase (TheName.Lexeme) = 'ordinal' then Exit Ordinal;

        raise 'Undefined property ''' + Str (TheName.Lexeme) + '''.';
    end
end

/// An enum type, so the name can be dotted into.
///
/// # Satisfies
///
/// [ENU-002], [ENU-004]
class ObjEnumType;
var
    /// The type's name.
    Name    : String;

    /// Member name to the one ObjEnum bound under it.
    ///
    /// The same objects the bare names are bound to -- handing back a copy would
    /// break identity, and 'Color.Red = Red' with it.
    Members : Map;

begin
    /// Makes an empty enumeration of a given name.
    constructor Init (Name : String);
    begin
        this.Name := Name;
        this.Members := Map();
    end

    /// Adds a member and answers it, so the caller can bind the bare name to
    /// the very same object.
    ///
    /// The ordinal is the count of members already present, which is what makes
    /// positions run from zero in declaration order.
    function Add (MemberName : String) : ObjEnum;
    var
       Member : ObjEnum;

    begin
        Member := ObjEnum (Name, MemberName, Members.Length);
        Members.Put (FoldCase (MemberName), Member);

        Exit Member;
    end

    /// Gets a member by qualified access -- 'Color.Red'.
    ///
    /// # Raises
    ///
    /// 'Undefined enum member ''X''.' when the type has no such member.
    function Get (TheName : Token) : Any;
    begin
        if not Members.Contains (FoldCase (TheName.Lexeme)) then
            raise 'Undefined enum member ''' + TheName.Lexeme + '''.';

        Exit Members.Get (FoldCase (TheName.Lexeme));
    end

    /// Prints the type as its name.
    function ToString () : String;
    begin
        Exit Name;
    end
end
