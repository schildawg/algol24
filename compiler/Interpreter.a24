/// The tree-walking interpreter, its built-ins, and the test runner.
///
/// One of the language's two back ends.  The built-ins are wrappers over the
/// host's own operations, so interpreted 'Length' IS host 'Length' and the two
/// cannot disagree.
unit Interpreter;

uses Console;
uses Environment;
uses Expr;
uses ObjBuffer;
uses ObjClass;
uses ObjCollection;
uses ObjEnum;
uses ObjFile;
uses ObjFunction;
uses ObjInstance;
uses Parser;
uses Resolver;
uses Scanner;
uses Stmt;
uses Token;
uses TokenType;

/// The interpreted program's own arguments -- NOT algc's.
///
/// Delegating to the host's ParamStr would report algc's command line: running
/// 'algc --test Files.a24' would give ParamCount () = 2 where the same suite run
/// directly gives 0.  A program has to see its OWN arguments however it was
/// started, so Main hands them over here.
///
/// ParamStr (0) is the program and 1 upward are its arguments, as in Turbo
/// Pascal; ParamCount counts the arguments, not the program.
var ProgramArguments : List := [];

/// Hands the interpreted program its arguments.
procedure SetProgramArguments (Arguments : List);
begin
    ProgramArguments := Arguments;
end

/// Whether an interpreted program's output is being swallowed.
var OutputSuppressed : Boolean := False;

/// Turns a program's own output off, so it does not interleave with a test
/// report.
///
/// 'print' deliberately bypasses this and still reaches stdout, which is why
/// the two exist.
///
/// # Satisfies
///
/// [TST-006]
procedure SuppressOutput (Suppress : Boolean);
begin
    OutputSuppressed := Suppress;
end

/// Renders every argument and runs them together, with nothing between them.
///
/// Write and WriteLn take ANY number of values, and this is the one place that
/// says what several of them mean: 'WriteLn (A, B)' is
/// 'WriteLn (Str (A) + Str (B))', which is what Pascal has always done.  Str is
/// Stringify too, so the rendering cannot differ between the one-value form and
/// the many.
///
/// JOINED WITH '+', NOT THROUGH A BUFFER, and the difference is a zero byte.  A
/// Buffer refuses to hand back Text when it holds one, so 'Write (Char (0))'
/// raised interpreted where the compiled form printed the byte -- a divergence
/// in a legal program, since 'Char (0)' is legal and the scanner's own
/// end-of-input sentinel is one.  A String carries its own length and can hold a
/// zero byte perfectly well; it was the Buffer in the middle that could not.
///
/// '+' is not the quadratic trap it looks like.  Concatenation appends in place
/// into room reserved in advance, so joining is linear -- and Write takes a
/// handful of values, not thousands.
///
/// # Satisfies
///
/// [RT-001], [RT-015]
function Rendered (TheInterpreter : Any, Arguments : List) : String;
var
    Line : String;

begin
    Line := '';

    for var Argument in Arguments do
        Line := Line + Stringify (TheInterpreter, Argument);

    Exit Line;
end

/// Renders a value as text.
///
/// A class with a ToString () method decides how it prints, and algc did not
/// honor that at all -- 'Money ()' gave 'Money instance' rather than '$5'.
/// Delegating straight to the host worked only because at one level of
/// interpretation every value algc holds is a HOST value, whose own rendering
/// does the right thing.  The moment algc interprets algc, the collections it is
/// handed are interpreted instances and the host renders them as
/// 'ObjCollection instance'.
///
/// Recursive on the result, so a ToString that answers another object with a
/// ToString still resolves.
///
/// # Satisfies
///
/// [CLS-009], [RT-006]
function Stringify (TheInterpreter : Any, Value : Any) : String;
begin
    if Value = Nil then Exit 'nil';

    if Value is ObjInstance then
    begin
        var Method := Value.Klass.MethodOfArity ('tostring', 0);

        if Method <> Nil then
            Exit Stringify (TheInterpreter, Method.Bind (Value).Call (TheInterpreter, List()));
    end

    if Value is ObjCollection then
    begin
        var Result := '[';
        var First  := True;

        if Value.Kind = 'Map' then
            for var Key in Value.Pairs.Keys() do
            begin
                if not First then Result := Result + ', ';
                First := False;

                Result := Result + Stringify (TheInterpreter, Key) + ':'
                        + Stringify (TheInterpreter, Value.Pairs.Get (Key));
            end
        else
            for var Element in Value.Items do
            begin
                if not First then Result := Result + ', ';
                First := False;

                Result := Result + Stringify (TheInterpreter, Element);
            end

        Exit Result + ']';
    end

    Exit Str (Value);
end

/// The built-in functions, all of them, in one class.
///
/// ONE CLASS AND A CASE, where there used to be twenty-nine classes.  Every one
/// of them was the same few lines of Arity boilerplate wrapped around a single
/// expression, and the expression was almost always a call to the host built-in
/// of the same name.
///
/// That delegation is the point rather than a shortcut: interpreted 'Length' IS
/// host 'Length', so the two implementations of the language cannot disagree
/// about what a built-in does.
class Native;
var
    /// The built-in's name, which is what Call dispatches on.
    Name     : String;

    /// How many arguments it takes.
    TheArity : Integer;

begin
    /// Makes a built-in of a name and an arity.
    constructor Init (Name : String, TheArity : Integer);
    begin
        this.Name     := Name;
        this.TheArity := TheArity;
    end

    /// How many arguments this built-in takes.
    function Arity () : Integer;
    begin
        Exit TheArity;
    end

    /// Prints the built-in as '<fn Name>'.
    function ToString () : String;
    begin
        Exit '<fn ' + Name + '>';
    end

    /// Calls the built-in, dispatching on its name.
    ///
    /// Almost every arm hands straight to the host operation of the same name,
    /// so what a built-in means is decided once rather than twice.  The
    /// exceptions are the ones the host cannot answer: the program's own
    /// arguments, output a test run may be swallowing, and Halt.
    ///
    /// # Raises
    ///
    /// Whatever the host operation raises, unchanged -- which is what keeps the
    /// messages identical through both processors.
    ///
    /// # Satisfies
    ///
    /// [COL-002], [RT-003], [RT-004], [RT-005], [RT-007], [RT-008], [RT-011],
    /// [RT-012], [RT-013], [RT-014], [RT-015], [RT-018], [RT-020], [RT-025],
    /// [RT-026], [SRC-004], [TST-012], [TST-013]
    function Call (TheInterpreter, Arguments) : Any;
    begin
        case Name of
            'clock' : Exit clock ();

            'Length' : begin
                           if Arguments[0] is ObjCollection then
                               raise 'Length expects text; use .Length for a collection.';

                           Exit Length (Str (Arguments[0]));
                       end

            'Copy' : Exit Copy (Str (Arguments[0]), Arguments[1], Arguments[2]);
            'Pos' : begin
                        if Arguments.Length < 2 or Arguments.Length > 3 then
                            raise 'Expected 2 or 3 arguments but got '
                                + Str (Arguments.Length) + '.';

                        if Arguments.Length = 2 then
                            Exit Pos (Str (Arguments[0]), Str (Arguments[1]));

                        Exit Pos (Str (Arguments[0]), Str (Arguments[1]),
                                  Arguments[2]);
                    end

            // Not Str'd on the way in, unlike Length and Pos above.  Those
            // measure a RENDERING and answer an Integer, so widening the
            // argument costs nothing; these answer text, and folding a Char
            // through Str would hand back a String [TYP-003].
            'ToUpper' : Exit ToUpper (Arguments[0]);
            'ToLower' : Exit ToLower (Arguments[0]);
            'Str'  : Exit Stringify (TheInterpreter, Arguments[0]);

            'Array' : begin
                          var TheArray := ObjCollection ('Array');
                          TheArray.Allocate (Arguments[0]);
                          Exit TheArray;
                      end

            'List'  : Exit ObjCollection ('List');
            'Map'   : Exit ObjCollection ('Map');
            'Stack' : Exit ObjCollection ('Stack');

            'Set' : begin
                        if Arguments.Length > 1 then
                            raise 'Expected 0 or 1 arguments but got '
                                + Str (Arguments.Length) + '.';

                        var TheSet := ObjCollection ('Set');

                        if Arguments.Length = 1 then
                        begin
                            var From := Arguments[0];

                            if not (From is ObjCollection) or From.Kind <> 'List' then
                                raise 'Set expects (List) but got ('
                                    + TypeNameOf (From) + ').';

                            for var Item in From.Items do
                                TheSet.Invoke ('add', [Item]);
                        end

                        Exit TheSet;
                    end

            'Write' : begin
                          if not OutputSuppressed then
                              Write (Rendered (TheInterpreter, Arguments));
                          Exit Nil;
                      end

            'WriteLn' : begin
                            if not OutputSuppressed then
                                WriteLn (Rendered (TheInterpreter, Arguments));
                            Exit Nil;
                        end

            'Halt' : begin
                         Halt (Arguments[0]);
                         Exit Nil;
                     end

            'Foreign' : Exit Foreign (Arguments[0], Arguments[1], Arguments[2],
                                      Arguments[3], Arguments[4]);

            'Succ' : Exit Succ (Arguments[0]);
            'Pred' : Exit Pred (Arguments[0]);

            'Ord' : begin
                        if Arguments[0] is ObjEnum then Exit Arguments[0].Ordinal;

                        Exit Ord (Arguments[0]);
                    end

            'Val'  : Exit ParsedNumber (Str (Arguments[0]));
            'Char' : Exit Char (Arguments[0]);

            'TextFile'   : Exit ObjFile ();
            'FileExists' : Exit FileExists (Str (Arguments[0]));

            'MkDir'  : Exit MkDir (Str (Arguments[0]));
            'RmDir'  : Exit RmDir (Str (Arguments[0]));
            'ChDir'  : Exit ChDir (Str (Arguments[0]));
            'GetDir' : Exit GetDir ();

            'Buffer' : begin
                           if Arguments.Length > 1 then
                               raise 'Expected 0 or 1 arguments but got '
                                   + Str (Arguments.Length) + '.';

                           if Arguments.Length = 0 then Exit ObjBuffer (0);

                           Exit ObjBuffer (Arguments[0]);
                       end

            'ParamCount' : Exit ProgramArguments.Length - 1;

            'ParamStr' : begin
                             var At := Arguments[0] as Integer;

                             if At < 0 or At >= ProgramArguments.Length then Exit '';

                             Exit ProgramArguments[At];
                         end

            'AssertTrue' : begin
                               if not TheInterpreter.IsTruthy (Arguments[0]) then
                                   raise 'Assertion failed.  Expected true but got '''
                                       + Str (Arguments[0]) + '''.';
                               Exit Nil;
                           end

            'AssertEqual' : begin
                                if not TheInterpreter.IsEqual (Arguments[0], Arguments[1]) then
                                begin
                                    var Left  := Str (Arguments[0]);
                                    var Right := Str (Arguments[1]);

                                    if Left = Right then
                                        raise 'Assertion failed.  Expected '
                                            + TypeNameOf (Arguments[0]) + ' ''' + Left
                                            + ''' but got '
                                            + TypeNameOf (Arguments[1]) + ' ''' + Right + '''.';

                                    raise 'Assertion failed.  Expected ''' + Left
                                        + ''' but got ''' + Right + '''.';
                                end

                                Exit Nil;
                            end

            'Fail' : raise 'Failed.  ' + Str (Arguments[0]);
        end

        raise 'Undefined built-in ''' + Name + '''.';
    end
end

/// Reads text as a number, answering an Integer where the text spells one and a
/// Double otherwise.
///
/// This is what Val does, and Val is also the scanner's own number parser -- so
/// whatever this accepts is what a numeric literal means.
///
/// It follows C's strtod rather than the language's literal rules, which is
/// DEF-34: '0x1F' answers a Double where a hex literal is an Integer, '1_000' is
/// refused where a literal accepts it, and ' 42', '.5', '5.' and '+7' are
/// accepted where no literal spells them.  Any fix must keep the precision --
/// an Algol-24 rewrite got the acceptance right and read '1.0E300' back as
/// '1.0000000000000002E300'.
///
/// # Satisfies
///
/// [RT-009]
function ParsedNumber (Text : String) : Any;
var
    Digits : String;
    Result : Integer;
    Sign   : Integer;

begin
    var AsDouble := Val (Text);

    Sign   := 1;
    Digits := Text;
    if Length (Digits) > 0 and Digits[0] = '-' then
    begin
        Sign   := -1;
        Digits := Copy (Digits, 1, Length (Digits) - 1);
    end

    if Length (Digits) = 0 then Exit AsDouble;

    Result := 0;
    for var I := 0; I < Length (Digits); I := I + 1 do
    begin
        var C := Digits[I];
        if C < '0' or C > '9' then Exit AsDouble;

        Result := Result * 10 + (Ord (C) - Ord ('0'));
    end

    Exit Sign * Result;
end

/// Runs a program by walking its tree.
class Interpreter;
var
    /// The scope statements are executing in, which moves as blocks open and
    /// close.
    Env     : Environment;

    /// The outermost scope, holding the built-ins.  Nothing a program declares
    /// reaches it, so a program may shadow a built-in without losing it.
    Builtins : Environment;

    /// The program's own top-level scope, enclosed by Builtins.
    Globals : Environment;

    /// Where the Resolver said each name lives, as a number of scopes out.
    ///
    /// A name absent here is a global, looked up by name when the body runs.
    Locals  : Map;

    /// Each loaded module's environment, keyed by resolved path, so a file is
    /// run once however many times it is imported.
    Modules : Map;

    /// Classes already hoisted, so a second pass does not redeclare one.
    HoistedClasses : Set;

    /// The file handed to the driver, which every diagnostic names.
    RootFile : String;

    /// Unit name to that unit's environment, for a qualified access.
    UnitsByName : Map;

begin
    /// Makes an interpreter with the built-ins defined and a program scope
    /// inside them.
    constructor Init ();
    begin
        this.Builtins := Environment();
        this.Globals := Environment();
        this.Globals.Enclosing := Builtins;
        this.Locals := Map();
        this.Modules := Map();
        this.RootFile := '';
        this.HoistedClasses := Set();
        this.UnitsByName := Map();

        this.Env := Globals;

        Builtins.Define ('clock', Native ('clock', 0));

        Builtins.Define ('Length', Native ('Length', 1));
        Builtins.Define ('Copy', Native ('Copy', 3));
        // Variadic, and checked in its own arm, because Pos takes 2 or 3
        // [RT-005] -- the way Set and Buffer take 0 or 1.  It is NOT an
        // overload in the sense [FUN-013] means: one native answers to the
        // name, so no call to Pos selects among anything at run time and none
        // of them raises the [WARN] an overloaded name would [ERR-010].
        Builtins.Define ('Pos', Native ('Pos', -1));
        Builtins.Define ('ToUpper', Native ('ToUpper', 1));
        Builtins.Define ('ToLower', Native ('ToLower', 1));
        Builtins.Define ('Str', Native ('Str', 1));
        Builtins.Define ('Array', Native ('Array', 1));
        Builtins.Define ('List', Native ('List', 0));
        Builtins.Define ('Map', Native ('Map', 0));
        Builtins.Define ('Set', Native ('Set', -1));
        Builtins.Define ('Stack', Native ('Stack', 0));

        Builtins.Define ('Halt', Native ('Halt', 1));
        Builtins.Define ('Ord', Native ('Ord', 1));
        Builtins.Define ('Succ', Native ('Succ', 1));
        Builtins.Define ('Pred', Native ('Pred', 1));
        Builtins.Define ('Foreign', Native ('Foreign', 5));
        Builtins.Define ('Val', Native ('Val', 1));
        Builtins.Define ('Char', Native ('Char', 1));

        Builtins.Define ('Write', Native ('Write', -1));
        Builtins.Define ('WriteLn', Native ('WriteLn', -1));

        Builtins.Define ('Buffer', Native ('Buffer', -1));
        Builtins.Define ('TextFile', Native ('TextFile', 0));
        Builtins.Define ('FileExists', Native ('FileExists', 1));
        Builtins.Define ('MkDir', Native ('MkDir', 1));
        Builtins.Define ('RmDir', Native ('RmDir', 1));
        Builtins.Define ('ChDir', Native ('ChDir', 1));
        Builtins.Define ('GetDir', Native ('GetDir', 0));
        Builtins.Define ('ParamCount', Native ('ParamCount', 0));
        Builtins.Define ('ParamStr', Native ('ParamStr', 1));
    end

    /// Declares every class, enum and subprogram before any statement runs.
    ///
    /// A function or class is complete as soon as it is read and has nothing to
    /// execute, so hoisting it lets a file be read top-down and lets two
    /// subprograms call each other.  A 'var' is NOT hoisted: its initializer has
    /// effects that belong at the point it is written, and hoisting it would
    /// substitute nil for a value that does not exist yet.
    ///
    /// # Satisfies
    ///
    /// [DCL-006]
    procedure Hoist (Statements : List);
    begin
        var Names := Set();
        for var I : Integer := 0; I < Statements.Length; I := I + 1 do
            if Statements[I] is ClassStmt then
                Names.Add (FoldCase (Statements[I].Name.Lexeme));

        for var I : Integer := 0; I < Statements.Length; I := I + 1 do
            if Statements[I] is ClassStmt then
                Env.Define (Statements[I].Name.Lexeme,
                            ObjClass (Str (Statements[I].Name.Lexeme), Nil, Map(), List()));

        for var I : Integer := 0; I < Statements.Length; I := I + 1 do
            if Statements[I] is ClassStmt then
            begin
                var Parent := Statements[I].Superclass;
                var Ready := Parent = Nil;

                if not Ready then Ready := Names.Contains (FoldCase (Parent.Name.Lexeme));

                if Ready then
                begin
                    Execute (Statements[I]);
                    HoistedClasses.Add (FoldCase (Statements[I].Name.Lexeme));
                end
            end

        for var I : Integer := 0; I < Statements.Length; I := I + 1 do
            if Statements[I] is FunctionStmt then Execute (Statements[I]);
    end

    /// Gets a class already hoisted under this name, or Nil.
    function HoistedClass (Name : String) : Any;
    begin
        if not Env.Values.Contains (FoldCase (Name)) then Exit Nil;

        var Bound := Env.Values.Get (FoldCase (Name));
        if not (Bound is ObjClass) then Exit Nil;

        Exit Bound;
    end

    /// Registers the root file's own environment in Modules before its body
    /// runs.
    ///
    /// The root's environment ITSELF, not a copy, so a module importing the root
    /// back sees the same bindings.
    ///
    /// Needed in every driver, not only in Interpret.  An import-only node
    /// carries no statements, so a root that is not registered makes
    /// VisitModuleStmt take the not-yet-loaded branch and execute nothing at all.
    ///
    /// # Satisfies
    ///
    /// [MOD-014]
    procedure RegisterRoot ();
    begin
        if RootFile = '' then Exit;

        Modules.Put (RootFile, Globals);
    end

    /// Runs a program: hoist its declarations, then execute its statements in
    /// order.
    ///
    /// An uncaught value ends the run with a diagnostic rather than a trace.
    ///
    /// # Raises
    ///
    /// Nothing: an escaping value is reported and the run ends.
    ///
    /// # Satisfies
    ///
    /// [ERR-003], [INI-002]
    procedure Interpret (Statements : List);
    begin
        try
            RegisterRoot ();
            Hoist (Statements);

            var I : Integer := 0;
            while I < Statements.Length do
            begin
               var Done := Statements[I] is FunctionStmt;

               if Statements[I] is ClassStmt then
                   Done := HoistedClasses.Contains (FoldCase (Statements[I].Name.Lexeme));

               try
                   if not Done then Execute (Statements[I]);
                   I := I + 1;
               except
                   on g : Jumped do
                   begin
                       var At := LabelAt (Statements, g.Label);

                       if At < 0 then raise g;

                       I := At;
                   end
               end
            end
        except
            on e : Raised do raise Str (e.Value);
        end
    end

    /// Collects the test blocks reachable from a file, its imports included, and
    /// declares what they need.
    ///
    /// Tests are gathered from every module a program loads, which is why
    /// '--test Parser.a24' runs Scanner's and Token's too.  The narrowest thing
    /// runnable is a leaf module.
    ///
    /// Each test is recorded with the FILE it came from, so the report can group
    /// by file.
    ///
    /// # Satisfies
    ///
    /// [TST-002], [TST-004]
    procedure HoistTests (Statements : List, Tests : List, ByName : Map, Define : Boolean,
                          Scope : Environment, DeclaredIn : Map,
                          File : String, Files : List, ByFile : Map, Hoisted : Set,
                          Collect : Boolean);
    begin
        for var TheStmt in Statements do
        begin

            if TheStmt is ModuleStmt then
            begin
                if Define then Execute (TheStmt);

                if TheStmt.Statements <> Nil then
                begin
                    var Mine := not Hoisted.Contains (Str (TheStmt.FileName));
                    if Mine then Hoisted.Add (Str (TheStmt.FileName));

                    HoistTests (TheStmt.Statements, Tests, ByName, False,
                                Modules.Get (TheStmt.FileName) as Environment, DeclaredIn,
                                Str (TheStmt.FileName), Files, ByFile, Hoisted, Mine);
                end
            end

            else if TheStmt is FunctionStmt then
            begin
                if Define then Execute (TheStmt);

                if TheStmt.Name.Literal <> Nil and Collect then
                begin
                    Tests.Add (TheStmt.Name.Lexeme);
                    ByName.Put (TheStmt.Name.Lexeme, TheStmt);

                    DeclaredIn.Put (TheStmt.Name.Lexeme, Scope);

                    if not Files.Contains (File) then
                    begin
                        Files.Add (File);
                        ByFile.Put (File, List());
                    end
                    (ByFile.Get (File) as List).Add (TheStmt.Name.Lexeme);
                end
            end

            else if Define and (TheStmt is ClassStmt
                             or TheStmt is ObjectStmt
                             or TheStmt is EnumStmt
                             or TheStmt is VarGroupStmt
                             or TheStmt is VarStmt) then
                Execute (TheStmt);
        end
    end

    /// Runs every reachable test block instead of the program, and answers how
    /// many failed.
    ///
    /// The main block never executes.  A program's own output is swallowed for
    /// the duration so it does not interleave with the report.
    ///
    /// A failure prints exactly ONE '[ERROR]' line naming why it failed.  It
    /// does not go through Console.Error, which would add a source line and a
    /// caret and make the two processors' reports differ.
    ///
    /// It registers the root for the same reason Interpret does: a file in an
    /// import cycle with the root would otherwise execute nothing at all.
    ///
    /// # Satisfies
    ///
    /// [RT-002], [TST-003], [TST-005], [TST-007], [TST-011]
    function RunTests (Statements : List, FileName : String) : Integer;
    var
        Tests  : List;
        Passed : Integer;
        Failed : Integer;

    begin
        RootFile := Str (FileName);
        RegisterRoot ();

        Builtins.Define ('AssertTrue', Native ('AssertTrue', 1));
        Builtins.Define ('AssertEqual', Native ('AssertEqual', 2));
        Builtins.Define ('Fail', Native ('Fail', 1));

        SuppressOutput (True);

        Tests := List();
        var ByName := [:];
        var DeclaredIn := [:];
        var Files := List();
        var ByFile := [:];

        var Hoisted := Set();
        Hoisted.Add (FileName);

        HoistTests (Statements, Tests, ByName, True, Globals, DeclaredIn,
                    FileName, Files, ByFile, Hoisted, True);

        WriteLn (INFO_TAG + 'Running ' + Str(Tests.Length) + ' tests...');

        Passed := 0;
        Failed := 0;

        var Ordered := List();
        for var File in Files do
        begin
            var Group := ByFile.Get (File) as List;
            Group.Sort();

            Ordered.Add (File);
            for var Each in Group do Ordered.Add (Each);
        end

        for var I := 0; I < Ordered.Length; I := I + 1 do
        begin
            if not ByName.Contains (Ordered[I]) then
            begin
                if I > 0 then WriteLn (INFO_TAG);

                WriteLn (INFO_TAG + '< ' + ANSI_CYAN + Str (Ordered[I]) + ANSI_RESET + ' >');
            end
            else
            begin
            var TheTest := ByName.Get (Ordered[I]);
            var Name    := Str(TheTest.Name.Literal);

            try
                var Scope := Globals;
                if DeclaredIn.Contains (Ordered[I]) then
                    Scope := DeclaredIn.Get (Ordered[I]) as Environment;

                var Body := Scope.Get (TheTest.Name);
                Body.Call (this, List());

                Passed := Passed + 1;
                WriteLn (Report (Name, 'PASS'));
            except
                on e : String do
                    begin
                        Failed := Failed + 1;
                        WriteLn (Report (Name, 'FAIL'));
                        WriteLn (ERROR_TAG + FileName + ': ' + e);
                    end

                on e : Raised do
                    begin
                        Failed := Failed + 1;
                        WriteLn (Report (Name, 'FAIL'));
                        WriteLn (ERROR_TAG + FileName + ': ' + Str (e.Value));
                    end
            end
            end
        end

        WriteLn (INFO_TAG);

        if Failed = 0 then
            WriteLn (INFO_TAG + ANSI_GREEN + 'All ' + Str(Passed) + ' tests passed.' + ANSI_RESET);
        else
            WriteLn (INFO_TAG + ANSI_RED + Str(Failed) + ' of ' + Str(Passed + Failed)
                          + ' tests failed.' + ANSI_RESET);

        Exit Failed;
    end

    /// Builds one line of the test report: the name, a dot leader, and the
    /// verdict.
    ///
    /// The leader's width is measured on the bare name, and the compiled runner
    /// reproduces this exactly -- the two reports are compared line for line.
    ///
    /// # Satisfies
    ///
    /// [TST-008], [TST-009], [TST-014]
    function Report (Name : String, Status : String) : String;
    var
        Dots : Integer;

    begin
        Dots := 55 - Length(Name);
        if Dots < 1 then Dots := 1;

        var Leader := '';
        for var I := 0; I < Dots; I := I + 1 do
            Leader := Leader + '.';

        var Tint := ANSI_GREEN;
        if Status = 'FAIL' then Tint := ANSI_RED;

        Exit INFO_TAG + 'Test: ' + Name + ' ' + Leader + ' [ ' + Tint + Status + ANSI_RESET + ' ]';
    end

    /// Evaluates a literal to the value the scanner already built.
    function VisitLiteral (TheExpr : LiteralExpr) : Any;
    begin
        Exit TheExpr.Value;
    end

    /// Evaluates 'and' and 'or', without evaluating the right operand unless it
    /// has to.
    ///
    /// Answers the OPERAND rather than a Boolean, so 'A or B' gives whichever
    /// value decided it.
    ///
    /// # Satisfies
    ///
    /// [EXP-009]
    function VisitLogical (TheExpr : LogicalExpr) : Any;
    var
        Left : Any;

    begin
        Left := Evaluate (TheExpr.Left);

        if TheExpr.Op.TypeOfToken = TOKEN_OR then
            begin
                if IsTruthy (Left) then Exit Left;
            end
        else
            if Not IsTruthy (Left) then Exit Left;

        Exit Evaluate(TheExpr.Right);
    end

    /// Evaluates the expression inside a group.
    function VisitGrouping (TheExpr : GroupingExpr) : Any;
    begin
        Exit Evaluate (TheExpr.Expression);
    end

    /// Evaluates a prefix '-' or 'not', or the class's own unary operator.
    function VisitUnary (TheExpr : UnaryExpr);
    var
        Right : Any;

    begin
        Right := Evaluate (TheExpr.Right);

        case TheExpr.Op.TypeOfToken of
            TOKEN_MINUS :
                begin
                    if Right is ObjInstance then
                    begin
                        var Negate := Right.Klass.MethodOfArity ('-', 0);

                        if Negate <> Nil then Exit Negate.Bind (Right).Call (this, List());
                    end

                    Exit -Right;
                end
            TOKEN_NOT  : Exit Not IsTruthy(Right);
        end
    end

    /// Builds a List or a Map from a literal.
    function VisitCollectionExpr (TheExpr : CollectionExpr) : Any;
    var
        Result : ObjCollection;

    begin
        if TheExpr.IsMap then
        begin
            Result := ObjCollection ('Map');

            for var I := 0; I < TheExpr.Keys.Length; I := I + 1 do
                Result.Pairs.Put (Evaluate (TheExpr.Keys[I]), Evaluate (TheExpr.Values[I]));

            Exit Result;
        end

        Result := ObjCollection ('List');
        for var Value in TheExpr.Values do
            Result.Items.Add (Evaluate (Value));

        Exit Result;
    end

    /// Evaluates 'A[I]', including a class's own Get.
    ///
    /// A String yields the Char at that CHARACTER position, not that byte.  A
    /// Map looks up by key, a List or an Array by position, and a class
    /// instance goes through the Get it declares.
    ///
    /// # Satisfies
    ///
    /// [EXP-015], [EXP-016], [TYP-010]
    function VisitSubscriptExpr (TheExpr : SubscriptExpr) : Any;
    var
        Target : Any;
        Index  : Any;

    begin
        Target := Evaluate (TheExpr.Obj);
        Index  := Evaluate (TheExpr.Index);

        if Target is ObjCollection then Exit Target.At (Index);
        if Target is ObjBuffer     then Exit Target.At (Index);

        if Target is ObjInstance then
        begin
            var Reader := Target.Klass.MethodOfArity ('get', 1);

            if Reader <> Nil then Exit Reader.Bind (Target).Call (this, [Index]);
        end

        if IsText (Target) then Exit Str(Target)[Index];

        raise 'Subscript target should be an ordinal.';
    end

    /// Evaluates 'A[I] := V', including a class's own Put.
    function VisitSetSubscriptExpr (TheExpr : SetSubscriptExpr) : Any;
    var
        Target : Any;
        Index  : Any;
        Value  : Any;

    begin
        Target := Evaluate (TheExpr.Obj);
        Index  := Evaluate (TheExpr.Index);
        Value  := Evaluate (TheExpr.Value);

        if Target is ObjCollection then Exit Target.PutAt (Index, Value);
        if Target is ObjBuffer     then Exit Target.PutAt (Index, Value);

        if Target is ObjInstance then
        begin
            var Writer := Target.Klass.MethodOfArity ('put', 2);

            if Writer <> Nil then Exit Writer.Bind (Target).Call (this, [Index, Value]);
        end

        if IsText (Target) then raise 'Strings are immutable.';

        raise 'Subscript target should be an ordinal.';
    end

    /// Whether a value is a String or a Char, the two that '+' joins as text.
    function IsText (Obj : Any) : Boolean;
    begin
        Exit Obj is String or Obj is Char;
    end

    /// Whether a value falls within a named subrange's bounds.
    ///
    /// A subrange constrains an Integer rather than being a type, so this asks
    /// about the value and not about what it claims to be.
    ///
    /// # Satisfies
    ///
    /// [TYP-015]
    function InSubrange (Value : Any, TheName : String) : Boolean;
    var
        At : Integer;

    begin
        if not (Value is Integer) then Exit False;

        At := SubrangeIndex (TheName);

        Exit Value >= SUBRANGE_LOWS[At] and Value <= SUBRANGE_HIGHS[At];
    end

    /// Whether a value may be converted to a written type by 'as'.
    ///
    /// A cast is a CHECKED conversion, so this is what decides whether it
    /// succeeds or raises.
    ///
    /// # Satisfies
    ///
    /// [VAL-007]
    function SatisfiesType (Value : Any, TheName : String) : Boolean;
    begin
        if IsSubrange (TheName) then Exit InSubrange (Value, TheName);

        var Wanted := CanonicalType (TheName);

        if ToLower (TypeNameOf (Value)) = ToLower (Wanted) then Exit True;

        Exit InheritsFrom (Value, Wanted);
    end

    /// Evaluates 'X is T' -- whether a value's run-time type is T or inherits
    /// from it.
    ///
    /// # Satisfies
    ///
    /// [ENU-006], [TYP-005], [VAL-003], [VAL-004], [VAL-005], [VAL-006]
    function VisitIsExpr (TheExpr : IsExpr) : Boolean;
    var
        Value : Any;

    begin
        Value := Evaluate (TheExpr.Obj);
        if Value = Nil then Exit False;

        Exit SatisfiesType (Value, Str (TheExpr.TypeName.Lexeme));
    end

    /// Evaluates a bare name, including one that is really a field of 'this'.
    function VisitVariableExpr (TheExpr : VariableExpr);
    begin
        try
            Exit LookupVariable (TheExpr.Name, TheExpr);
        except
            on e : String do Exit ThisField (TheExpr.Name, e);
        end
    end

    /// Reads a bare name as a field of the receiver, for an implicit 'this'.
    function ThisField (Name : Token, Original : String) : Any;
    var
        Obj : Any;

    begin
        try
            Obj := Env.Get (Token (TOKEN_THIS, 'this', Nil, Name.LineNumber));
            Exit Obj.Get (Name);
        except
            on e : String do raise Original;
        end
    end

    /// Writes a bare name as a field of the receiver, for an implicit 'this'.
    procedure SetThisField (Name : Token, Value : Any, Original : String);
    var
        Obj : Any;

    begin
        try
            Obj := Env.Get (Token (TOKEN_THIS, 'this', Nil, Name.LineNumber));
            Obj.Set (Name, Value);
        except
            on e : String do raise Original;
        end
    end

    /// Reads a name at the depth the Resolver recorded, or from the globals.
    ///
    /// A free name in a body is resolved WHEN THE BODY RUNS rather than where it
    /// is written, which is what lets two subprograms call each other.
    ///
    /// # Raises
    ///
    /// 'Undefined variable ''X''.', sometimes with a suggested unit.
    ///
    /// # Satisfies
    ///
    /// [DCL-007], [MOD-009]
    function LookupVariable (Name : Token, TheExpr : Expr);
    var
        Distance : Integer;

    begin
        Distance := Locals.Get (TheExpr) As Integer;
        if Distance <> Nil then Exit Env.GetAt (Distance, Name.Lexeme);

        try
            Exit Env.Get (Name);
        except
            on e : String do raise SuggestUnit (Name, e);
        end
    end

    /// Adds 'Did you mean U.X?' to an undefined-name message when some unit
    /// exports it.
    function SuggestUnit (Name : Token, Message : String) : String;
    begin
        if Copy (Message, 0, 19) <> 'Undefined variable ' then Exit Str (Message);

        var Units := UnitsByName.Keys();

        for var TheUnit in Units do
        begin
            var ModuleEnv := UnitsByName.Get (TheUnit) as Environment;

            if ModuleEnv.Exports <> Nil and ModuleEnv.Exports.Contains (FoldCase (Name.Lexeme)) then
                Exit Str (Message) + ' Unit ''' + Str (ModuleEnv.UnitName)
                   + ''' exports it; this file has no ''uses'' for it.';
        end

        if Env <> Globals and Globals.Values.Contains (FoldCase (Name.Lexeme)) then
            Exit Str (Message)
               + ' The file the program started from declares it, and no file can ''uses'' that.';

        Exit Str (Message);
    end

    /// Divides two integers, truncating toward zero.
    ///
    /// # Raises
    ///
    /// A division-by-zero failure.
    ///
    /// # Satisfies
    ///
    /// [EXP-018]
    function IntegerDivide (Left : Any, Right : Any) : Integer;
    begin
        if not (Left is Integer) or not (Right is Integer) then
            raise 'div expects Integers.';

        if Right = 0 then raise 'Division by zero.';

        Exit Left div Right;
    end

    /// Answers the remainder of two integers, its sign following the dividend.
    ///
    /// # Raises
    ///
    /// A division-by-zero failure.
    ///
    /// # Satisfies
    ///
    /// [EXP-021]
    function Remainder (Left : Any, Right : Any) : Integer;
    begin
        if not (Left is Integer) or not (Right is Integer) then
            raise 'mod expects Integers.';

        if Right = 0 then raise 'Division by zero.';

        Exit Left mod Right;
    end

    /// Whether an operator token is an arithmetic one.
    function Arithmetic (Op : Any) : Boolean;
    begin
        Exit Op = TOKEN_PLUS or Op = TOKEN_MINUS or Op = TOKEN_STAR
          or Op = TOKEN_SLASH or Op = TOKEN_DIV or Op = TOKEN_MOD;
    end

    /// Whether an operator token is an ordering comparison.
    function Orders (Op : Any) : Boolean;
    begin
        Exit Op = TOKEN_LESS  or Op = TOKEN_LESS_EQUAL
          or Op = TOKEN_GREATER or Op = TOKEN_GREATER_EQUAL;
    end

    /// Evaluates a binary operation, including a class's own operator.
    ///
    /// Arithmetic promotes: an Integer meeting a Double gives a Double.  '+'
    /// joins text when either side is a String or a Char, and Char arithmetic
    /// gives Pascal's answers.  Ordering goes through Compare where a class
    /// defines it.
    ///
    /// An Integer is UNBOUNDED: arithmetic past the machine width grows rather
    /// than wrapping, and demotes again the moment a result fits.
    ///
    /// # Raises
    ///
    /// A type failure naming the operator, and a division by zero.
    ///
    /// # Satisfies
    ///
    /// [ENU-008], [EXP-004], [EXP-005], [EXP-006], [EXP-008], [EXP-019],
    /// [LEX-018], [VAL-014]
    function VisitBinary (TheExpr : BinaryExpr);
    var
        Left  : Any;
        Right : Any;

    begin
        Left  := Evaluate (TheExpr.Left);
        Right := Evaluate (TheExpr.Right);

        if Left is ObjInstance and Arithmetic (TheExpr.Op.TypeOfToken) then
        begin
            var Defined := Left.Klass.MethodOfArity (Str (TheExpr.Op.Lexeme), 1);

            if Defined <> Nil then Exit Defined.Bind (Left).Call (this, [Right]);
        end

        if Left is ObjInstance and Orders (TheExpr.Op.TypeOfToken) then
        begin
            var Ordering := Left.Klass.MethodOfArity ('compare', 1);

            if Ordering <> Nil then
            begin
                Left  := Ordering.Bind (Left).Call (this, [Right]);
                Right := 0;

                if not (Left is Integer) then raise 'Compare must answer an Integer.';
            end
        end

        case TheExpr.Op.TypeOfToken of
           TOKEN_GREATER       : Exit Left > Right;
           TOKEN_GREATER_EQUAL : Exit Left >= Right;
           TOKEN_LESS          : Exit Left < Right;
           TOKEN_LESS_EQUAL    : Exit Left <= Right;

           TOKEN_NOT_EQUAL    : Exit Not IsEqual (Left, Right);
           TOKEN_EQUAL   : Exit IsEqual (Left, Right);

           TOKEN_IN : Exit Contains (Right, Left);

           TOKEN_PLUS  : Exit Left + Right;
           TOKEN_MINUS : Exit Left - Right;
           TOKEN_SLASH : Exit Left / Right;

           TOKEN_DIV : Exit IntegerDivide (Left, Right);
           TOKEN_MOD : Exit Remainder (Left, Right);
           TOKEN_STAR  : Exit Left * Right;
        end
    end

    /// Puts named arguments into declaration order for the callee that was
    /// selected.
    ///
    /// # Satisfies
    ///
    /// [EXP-013]
    function Arranged (Callee : Any, Arguments : List, Names : List) : List;
    begin
        if not AnyNamed (Names) then Exit Arguments;

        if Callee is ObjFunction then
        begin
            var Fitted := Callee.Arrange (Arguments, Names);

            if Fitted = Nil then raise 'No matching signature for function.';

            Exit Fitted;
        end

        if Callee is ObjOverloads then
        begin
            for var Candidate in Callee.Candidates do
            begin
                var Fitted := Candidate.Arrange (Arguments, Names);

                if Fitted <> Nil then Exit Fitted;
            end

            raise 'No matching signature for function.';
        end

        if Callee is ObjClass then
        begin
            var Init := Callee.FindMethod ('init');

            if Init <> Nil then
            begin
                var Fitted := Init.Arrange (Arguments, Names);

                if Fitted <> Nil then Exit Fitted;
            end

            raise 'No matching signature for function.';
        end

        raise 'A built-in has no named parameters.';
    end

    /// Evaluates a call: the callee, then the arguments, then the call itself.
    ///
    /// Constructing an instance is a call too, since a class name evaluates to
    /// something callable.  An overloaded name selects from the values actually
    /// passed, which is why arity alone cannot decide it.
    ///
    /// # Raises
    ///
    /// 'Can only call functions and classes.', an arity failure, and
    /// 'No matching signature' when no overload fits.
    ///
    /// # Satisfies
    ///
    /// [CLS-003], [CLS-016], [EXP-011], [EXP-012], [FUN-006]
    function VisitCall (TheExpr : CallExpr) : Any;
    var
        Callee    : Any;
        Arguments : List;

    begin
        Callee := Evaluate (TheExpr.Callee);

        Arguments := List();
        for var Argument in TheExpr.Arguments do
        begin
            Arguments.Add (Evaluate (Argument));
        end

        Arguments := Arranged (Callee, Arguments, TheExpr.ArgumentNames);

        if not IsCallable (Callee) then
        begin
            raise 'Can only call functions and classes.';
        end

        if Callee is ObjFunction then
        begin
            if Callee.Owner <> Nil then
            begin
                var Better := Callee.Owner.FindOverload (FoldCase (Callee.Declaration.Name.Lexeme), Arguments);

                if Better = Nil then raise 'No matching signature for function.';

                Callee := Better.Bind (Callee.Bound);
            end

            else if not Callee.Fits (Arguments, True) and not Callee.Absorbs (Arguments) then
            begin
                if not Callee.Variadic () and Arguments.Length <> Callee.Arity() then
                    raise 'Expected ' + Callee.Arity() + ' arguments but got '
                        + Arguments.Length + '.';

                raise 'No matching signature for function.';
            end
        end

        var Gathering := False;
        if Callee is ObjFunction then Gathering := Callee.Absorbs (Arguments);

        if not Gathering and Callee.Arity() >= 0 and Arguments.Length <> Callee.Arity() then
        begin
            raise 'Expected ' + Callee.Arity() + ' arguments but got ' + Arguments.Length + '.';
        end

        Exit Callee.Call (this, Arguments);
    end

    /// Writes a name through its unit.
    ///
    /// System is refused rather than written.  Its names are the built-ins, and
    /// a program that could rebind one would be changing what every other file
    /// means by it -- the opposite of what qualification is for.
    procedure AssignQualified (Unit : String, Name : Token, Value : Any);
    var
        ModuleEnv : Environment;

    begin
        if FoldCase (Unit) = 'system' then
            raise 'Can''t assign to ''' + Str (Name.Lexeme) + ''' in unit ''System''.';

        if not UnitsByName.Contains (FoldCase (Unit)) then
            raise 'Undefined name ''' + Str (Name.Lexeme) + ''' in unit ''' + Unit + '''.';

        ModuleEnv := UnitsByName.Get (FoldCase (Unit)) as Environment;

        if ModuleEnv.Exports = Nil or not ModuleEnv.Exports.Contains (FoldCase (Name.Lexeme)) then
            raise 'Undefined name ''' + Str (Name.Lexeme) + ''' in unit ''' + Unit + '''.';

        ModuleEnv.Values.Put (FoldCase (Name.Lexeme), Value);
    end

    /// Reads a name through its unit.
    ///
    /// Only what the unit EXPORTS, which is what makes qualification respect
    /// 'private' rather than route around it.  'System' exports everything: the
    /// built-ins are the whole of it, and none of them is private.
    ///
    /// # Satisfies
    ///
    /// [MOD-007], [MOD-010]
    function Qualified (Unit : String, Name : Token) : Any;
    var
        ModuleEnv : Environment;

    begin
        if FoldCase (Unit) = 'system' then
        begin
            if not Builtins.Values.Contains (FoldCase (Name.Lexeme)) then
                raise 'Undefined name ''' + Str (Name.Lexeme) + ''' in unit ''System''.';

            Exit Builtins.Values.Get (FoldCase (Name.Lexeme));
        end

        if not UnitsByName.Contains (FoldCase (Unit)) then
            raise 'Undefined name ''' + Str (Name.Lexeme) + ''' in unit ''' + Unit + '''.';

        ModuleEnv := UnitsByName.Get (FoldCase (Unit)) as Environment;

        if ModuleEnv.Exports = Nil or not ModuleEnv.Exports.Contains (FoldCase (Name.Lexeme)) then
            raise 'Undefined name ''' + Str (Name.Lexeme) + ''' in unit ''' + Unit + '''.';

        Exit ModuleEnv.Values.Get (FoldCase (Name.Lexeme));
    end

    /// Evaluates a property read, on a receiver or through a unit.
    ///
    /// # Satisfies
    ///
    /// [RT-017]
    function VisitGetExpr (TheExpr : GetExpr) : Any;
    var
       Obj : Any;

    begin
        if TheExpr.Unit <> '' then Exit Qualified (TheExpr.Unit, TheExpr.Name);

        Obj := Evaluate (TheExpr.Obj);

        if Obj is String then
        begin
            if FoldCase (TheExpr.Name.Lexeme) = 'length' then Exit Length (Obj);

            raise 'Undefined property ''' + Str (TheExpr.Name.Lexeme) + '''.';
        end

        if Obj is Integer or Obj is Double then
        begin
            if FoldCase (TheExpr.Name.Lexeme) = 'tostring' then
                Exit NumberMethod (Obj, TheExpr.Name);

            raise 'Undefined property ''' + Str (TheExpr.Name.Lexeme) + '''.';
        end

        if not (Obj is ObjInstance or Obj is ObjEnumType or Obj is ObjEnum
             or Obj is ObjCollection or Obj is ObjFile
             or Obj is ObjBuffer) then
        begin
            raise 'Only instances have properties.';
        end

        if Obj is ObjInstance then
        begin
            var Member := Obj.Klass.MethodOfArity (FoldCase (TheExpr.Name.Lexeme), 0);

            if Member <> Nil and Member.Declaration.IsProperty
                             and not Obj.Fields.Contains (FoldCase (TheExpr.Name.Lexeme)) then
                Exit Member.Bind (Obj).Call (this, List());
        end

        Exit Obj.Get (TheExpr.Name);
    end

    /// Evaluates a property write, on a receiver or through a unit.
    function VisitSetExpr (TheExpr : SetExpr) : Any;
    var
       Obj : Any;
       Value  : Any;

    begin
        if TheExpr.Unit <> '' then
        begin
            Value := Evaluate (TheExpr.Value);
            AssignQualified (Str (TheExpr.Unit), TheExpr.Name, Value);

            Exit Value;
        end

        Obj := Evaluate (TheExpr.Obj);

        if not (Obj is ObjInstance) then
        begin
            raise 'Only instances have fields.';
        end

        Value := Widen (Evaluate (TheExpr.Value), Str (TheExpr.Declared));
        Obj.Set (TheExpr.Name, Value);

        Exit Value;
    end

    /// Evaluates 'super.M', finding the method on the parent rather than the
    /// override.
    ///
    /// # Satisfies
    ///
    /// [CLS-012]
    function VisitSuperExpr (TheExpr : SuperExpr) : Any;
    var
        Distance   : Integer;
        Superclass : ObjClass;
        Obj     : ObjInstance;
        Method     : ObjFunction;

    begin
        Distance := Locals.Get(TheExpr) as Integer;

        Superclass := Env.GetAt (Distance, 'super') as ObjClass;
        Obj := Env.GetAt (Distance - 1, 'this') as ObjInstance;
        Method := Superclass.FindMethod (FoldCase (TheExpr.Method.Lexeme));

        Exit Method.Bind(Obj);
    end

    /// Evaluates 'this' to the receiver the method was bound to.
    function VisitThisExpr (TheExpr : ThisExpr) : Any;
    begin
        Exit LookupVariable (TheExpr.Keyword, TheExpr);
    end

    /// Gets the class name of a value, or '' when it is not an instance.
    ///
    /// Asks what a value IS, where 'is' asks whether it is a given thing -- so
    /// this survives the operator rather than being replaced by it.  ClassName
    /// raises on anything that is not an instance, so it has to be a caught
    /// failure.
    function ClassNameOf (Obj : Any) : String;
    begin
        try
            Exit Obj.ClassName;
        except
            on e : String do Exit '';
        end
    end

    /// Whether a value counts as true.
    ///
    /// NOT Lox's rule: nil, False, the Integer 0 and an enum member of ordinal 0
    /// are false, while 0.0, '' and any Char are true.
    ///
    /// # Satisfies
    ///
    /// [ENU-009], [EXP-010], [VAL-008]
    function IsTruthy (Obj : Any) : Boolean;
    begin
        If Obj = Nil or Obj = False then Exit False;

        if Obj is Integer then Exit Obj <> 0;

        if Obj is ObjEnum then Exit Obj.Ordinal <> 0;

        Exit True;
    end

    /// Whether two values are equal.
    ///
    /// A Char and a String are never equal, however alike they look.  Enum
    /// members compare by IDENTITY, which is why a type binds one object per
    /// member and hands the same one to the bare name and the qualified form.
    ///
    /// # Satisfies
    ///
    /// [ENU-005], [LEX-026], [VAL-009], [VAL-010], [VAL-011], [VAL-012]
    function IsEqual (A : Any, B : Any) : Boolean;
    begin
       if A = Nil and B = Nil then Exit True;
       if A = Nil then Exit False;

       Exit A = B;
    end

    /// Converts a value to a declared type where the two differ by a widening,
    /// and hands it back unchanged otherwise.
    ///
    /// The CONVERSION, not merely the permission: the variable holds the wider
    /// type afterwards -- 'var X : Double := 1;' gives X the Double 1.0 -- so a
    /// declaration never misdescribes what it holds, and the C back end can rely
    /// on a declared type meaning what it says.
    function Widen (Value : Any, Declared : String) : Any;
    begin
        if Declared = '' or Value = Nil then Exit Value;

        if IsSubrange (Declared) then
        begin
            if not InSubrange (Value, Declared) then
                raise Str (Value) + ' is not in ' + Declared + '.';

            Exit Value;
        end

        if Declared = 'Double' and Value is Integer then Exit Value * 1.0;
        if Declared = 'String' and Value is Char    then Exit Str (Value);

        Exit Value;
    end

    /// Evaluates an expression, dispatching through its Accept.
    function Evaluate(TheExpr : Expr) : Any;
    var
        Value : Any;

    begin
        Value := TheExpr.Accept(this);

        if TheExpr.Cast <> '' and Value <> Nil then
        begin
            if not SatisfiesType (Value, TheExpr.Cast) then
                raise 'Cannot cast ' + TypeNameOf (Value) + ' to '
                    + TheExpr.Cast + '.';
        end

        Exit Value;
    end

    /// Runs one statement, dispatching through its Accept.
    procedure Execute (TheStmt : Stmt);
    begin
        TheStmt.Accept (this);
    end

    /// Records how many scopes out a name was found, as the Resolver decided.
    procedure Resolve (TheExpr : Expr, Depth : Integer);
    begin
        Locals.Put (TheExpr, Depth);
    end

    /// Runs a list of statements in a given scope, restoring the previous one
    /// afterwards.
    ///
    /// The restore happens however the block leaves -- normally, by a break, or
    /// through a raised value.
    procedure ExecuteBlock (Statements : List, NewEnv : Environment);
    var
        PreviousEnv : Environment;

    begin
        PreviousEnv := this.Env as Environment;

        try
            this.Env := NewEnv;

            var I := 0;
            while I < Statements.Length do
            begin
                try
                    Execute (Statements[I]);
                    I := I + 1;
                except
                    on g : Jumped do
                    begin
                        var At := LabelAt (Statements, g.Label);

                        if At < 0 then raise g;

                        I := At;
                    end
                end
            end
        except
            on e do
                begin
                    this.Env := PreviousEnv;
                    raise e;
                end
        end
        this.Env := PreviousEnv;
    end

    /// Runs a block in a scope of its own.
    ///
    /// # Satisfies
    ///
    /// [STM-001]
    procedure VisitBlockStmt (TheStmt : BlockStmt);
    begin
        var NewEnv : Environment := Environment();
        NewEnv.Enclosing := Env;

        ExecuteBlock (TheStmt.Statements, NewEnv);
    end

    /// Declares a class: its parent, its methods, and the fields it will seed.
    ///
    /// # Raises
    ///
    /// A refusal when the declared superclass is not a class.
    ///
    /// # Satisfies
    ///
    /// [CLS-014]
    procedure VisitClassStmt (TheStmt : ClassStmt);
    var
       Klass       : ObjClass;
       Superclass  : Any;
       Methods     : Map;
       TheFunction : ObjFunction;

    begin
        Superclass := Nil;
        if TheStmt.Superclass <> Nil then
        begin
            Superclass := Evaluate (TheStmt.Superclass);

            if not (Superclass is ObjClass) then
            begin
                raise '''' + Str (TheStmt.Superclass.Name.Lexeme)
                    + ''' is not a class.';
            end
        end

        var Shell := HoistedClass (Str (TheStmt.Name.Lexeme));

        if Shell = Nil then Env.Define (TheStmt.Name.Lexeme, Nil);

        if TheStmt.Superclass <> Nil then
        begin
            var Previous : Environment := Env;
            Env := Environment();
            Env.Enclosing := Previous;
            Env.Define ('super', Superclass);
        end

        Methods := Map();
        for var Method in TheStmt.Methods do
        begin

            TheFunction := ObjFunction (Method, Env, FoldCase (Method.Name.Lexeme) = 'init');

            var MethodKey := FoldCase (Method.Name.Lexeme);

            if not Methods.Contains (MethodKey) then
                Methods.Put (MethodKey, List());

            Methods.Get (MethodKey).Add (TheFunction);
        end

        if Shell <> Nil then
        begin
            Klass := Shell as ObjClass;

            Klass.Superclass := Superclass as ObjClass;
            Klass.Methods    := Methods;
            Klass.Fields     := TheStmt.Fields;
        end
        else Klass := ObjClass (TheStmt.Name.Lexeme, Superclass, Methods, TheStmt.Fields);

        for var Name in Methods.Keys() do
            for var Each in Methods.Get(Name) do
                Each.Owner := Klass;

        if Superclass <> Nil then
        begin
            Env := Env.Enclosing;
        end

        Env.Assign (TheStmt.Name, Klass);
    end

    /// Declares an object: one class, and its name bound to the single instance
    /// of it.
    ///
    /// Shares VisitClassStmt entirely -- an object is a class in every respect
    /// but what its name evaluates to.
    procedure VisitObjectStmt (TheStmt : ObjectStmt);
    var
        Klass : ObjClass;

    begin
        var HasId := False;
        for var Field in TheStmt.Fields do
            if FoldCase (Field.Name.Lexeme) = 'id' then HasId := True;

        if not HasId then
        begin
            var IdName := Token (TOKEN_IDENTIFIER, 'Id', Nil, TheStmt.Name.LineNumber);
            TheStmt.Fields.Add (VarStmt (IdName, LiteralExpr (Str (TheStmt.Name.Lexeme))));
        end

        VisitClassStmt (ClassStmt (TheStmt.Name, TheStmt.Superclass,
                                   TheStmt.Methods, TheStmt.Fields));

        Klass := Env.Get (TheStmt.Name) as ObjClass;
        Env.Assign (TheStmt.Name, ObjSingleton (Klass, this));
    end

    /// Declares a subrange, which is nothing to do at run time.
    ///
    /// The Resolver recorded the bounds before anything ran, and a subrange binds
    /// no VALUE -- it constrains one.  The statement is kept in the tree so the
    /// declaration has a place in the program's order and the emitter has
    /// something to walk.
    procedure VisitSubrangeStmt (TheStmt : SubrangeStmt);
    begin
    end

    /// Declares an enum: binds the type name, and each member both bare and
    /// under the type.
    ///
    /// Both bindings are the SAME object, because enum equality is identity --
    /// 'Color.Red = Red' has to be true.
    ///
    /// # Satisfies
    ///
    /// [ENU-003]
    procedure VisitEnumStmt (TheStmt : EnumStmt);
    var
        TheType : ObjEnumType;

    begin
        TheType := ObjEnumType (TheStmt.Name.Lexeme);

        for var TheMember in TheStmt.Members do
        begin
            var MemberName := Str (TheMember.Lexeme);
            var Member := TheType.Add (MemberName);

            var Clash := Env.Values.Contains (FoldCase (MemberName));
            if Clash then Clash := Env.Values.Get (FoldCase (MemberName)) is ObjEnum;
            if Clash then
                Clash := (Env.Values.Get (FoldCase (MemberName)) as ObjEnum).TypeName
                    <> TheType.Name;

            if Clash then
                Env.MarkAmbiguous (MemberName,
                    (Env.Values.Get (FoldCase (MemberName)) as ObjEnum).TypeName
                        + ' or ' + TheType.Name);
            else Env.Define (MemberName, Member);
        end

        Env.Define (TheStmt.Name.Lexeme, TheType);
    end

    /// Evaluates an expression for its effect and discards the value.
    procedure VisitExpressionStmt (Stmt : ExpressionStmt);
    begin
        Evaluate (Stmt.Expression);
    end

    /// Declares a subprogram, closing it over the scope it was written in.
    ///
    /// A second declaration of a name binds an overload SET rather than
    /// replacing the first, since the environment binds one name to one value.
    procedure VisitFunctionStmt (TheStmt : FunctionStmt);
    var
        TheFunction : ObjFunction;

    begin
        TheFunction := ObjFunction (TheStmt, Env, False);

        var Key := FoldCase (TheStmt.Name.Lexeme);

        if Env.Values.Contains (Key) then
        begin
            var Existing := Env.Values.Get (Key);

            if not (Existing is ObjFunction) and not (Existing is ObjOverloads) then
                raise '''' + Str (TheStmt.Name.Lexeme) + ''' is already defined.';

            var Overloads := Existing;

            if Existing is ObjFunction then
            begin
                Overloads := ObjOverloads (Str (TheStmt.Name.Lexeme));
                Overloads.Add (Existing);
            end

            for var Candidate in Overloads.Candidates do
                if SameSignature (Candidate.Declaration, TheStmt) then
                    raise '''' + Str (TheStmt.Name.Lexeme) + ''' is already defined.';

            Overloads.Add (TheFunction);
            Env.Define (TheStmt.Name.Lexeme, Overloads);

            Exit;
        end

        Env.Define (TheStmt.Name.Lexeme, TheFunction);
    end

    /// Runs an if, testing the condition for truthiness.
    ///
    /// # Satisfies
    ///
    /// [STM-003]
    procedure VisitIfStmt (Stmt : IfStmt);
    begin
        if IsTruthy (Evaluate (Stmt.Condition)) then
            Execute (Stmt.ThenBranch);
        else if Stmt.ElseBranch <> Nil then
            Execute (Stmt.ElseBranch);
    end

    /// Runs a while, and the counted for that desugars into one.
    ///
    /// A 'continue' is caught around the BODY and the step runs after it, so a
    /// continue still advances the loop.
    ///
    /// # Satisfies
    ///
    /// [STM-005]
    procedure VisitWhileStmt (Stmt : WhileStmt);
    begin
        try
            while IsTruthy (Evaluate (Stmt.Condition)) do
            begin
                try
                    Execute (Stmt.Body);
                except
                    on c : Continued do
                        if not Names (c.Label, Stmt.Label) then raise c;
                end

                if Stmt.Increment <> Nil then Evaluate (Stmt.Increment);
            end
        except
            on e : Broke do
                if not Names (e.Label, Stmt.Label) then raise e;
        end
    end

    /// Whether a collection holds a value, for the 'in' operator.
    function Contains (Collection : Any, Value : Any) : Boolean;
    begin
        if Collection is ObjCollection then Exit Collection.Invoke ('contains', [Value]);

        if Collection is ObjEnumType then Exit Collection.Members.Values().Contains (Value);

        if Collection is ObjInstance then
        begin
            var Method := Collection.Klass.MethodOfArity ('contains', 1);
            if Method <> Nil then
                Exit IsTruthy (Method.Bind (Collection).Call (this, [Value]));
        end

        if IsText (Collection) then
        begin
            if Value = Nil then Exit False;

            Exit Pos (Str (Collection), Str (Value)) >= 0;
        end

        raise 'Right operand of ''in'' must be a collection or a String.';
    end

    /// Whether a value may be called.
    function IsCallable (Value : Any) : Boolean;
    begin
        if Value = Nil then Exit False;

        try
            var TheArity := Value.Arity;
            Exit True;
        except
            on e : String do Exit False;
        end
    end

    /// Gets the elements a value offers to a 'for ... in'.
    ///
    /// A collection and a String answer directly; a class answers through its own
    /// Elements, which is a structural protocol rather than an interface.
    ///
    /// # Raises
    ///
    /// A refusal naming what cannot be iterated.
    ///
    /// # Satisfies
    ///
    /// [TYP-011]
    function ElementsOf (Where : Token, Target : Any) : List;
    var
        Result : List;

    begin
        Result := List();

        if Target is ObjCollection then
        begin
            if Target.Kind = 'Map' then Exit Target.Pairs.Keys();

            for var Item in Target.Items do
                Result.Add (Item);

            Exit Result;
        end

        if Target is ObjEnumType then Exit Target.Members.Values();

        if Target is ObjInstance then
        begin
            var Elements := Target.Klass.MethodOfArity ('elements', 0);
            if Elements <> Nil then
                Exit ElementsOf (Where, Elements.Bind (Target).Call (this, List()));
        end

        if IsText (Target) then
        begin
            var Text := Str (Target);
            for var I := 0; I < Length (Text); I := I + 1 do
                Result.Add (Text[I]);

            Exit Result;
        end

        raise 'Can only iterate a collection or a String.';
    end

    /// Runs 'for X in C do', with the loop variable in a scope of its own.
    ///
    /// # Satisfies
    ///
    /// [STM-007], [STM-008], [STM-009]
    procedure VisitForInStmt (TheStmt : ForInStmt);
    var
        Elements : List;

    begin
        Elements := ElementsOf (TheStmt.Name, Evaluate (TheStmt.Iterable));

        try
            for var Element in Elements do
            begin
                var Scope := Environment();
                Scope.Enclosing := Env;
                Scope.Define (TheStmt.Name.Lexeme, Element);

                try
                    ExecuteBlock ([TheStmt.Body], Scope);
                except
                    on c : Continued do
                        if not Names (c.Label, TheStmt.Label) then raise c;
                end
            end
        except
            on e : Broke do
                if not Names (e.Label, TheStmt.Label) then raise e;
        end
    end

    /// Leaves a loop, by raising a value the loop catches.
    procedure VisitBreakStmt (TheStmt : BreakStmt);
    begin
        raise Broke (TheStmt.Label);
    end

    /// Begins a loop's next iteration, by raising a value the loop catches.
    procedure VisitContinueStmt (TheStmt : ContinueStmt);
    begin
        raise Continued (TheStmt.Label);
    end

    /// Runs the statement a label names, catching a goto that jumps to it.
    procedure VisitLabelStmt (TheStmt : LabelStmt);
    begin
        Execute (TheStmt.Inner);
    end

    /// Jumps to a label, by raising a value the enclosing block catches.
    procedure VisitGotoStmt (TheStmt : GotoStmt);
    begin
        raise Jumped (TheStmt.Label);
    end

    /// Runs an imported file once, then MOVES its exported bindings into the
    /// importer's scope.
    ///
    /// 'uses' is not textual inclusion.  The file runs in an environment of its
    /// own, which is what leaves a private name behind while keeping it callable
    /// from inside the module -- the module's own functions closed over the
    /// environment it is still sitting in.
    ///
    /// A module already loaded is not run again, so a diamond initializes once
    /// and in dependency order.
    ///
    /// # Satisfies
    ///
    /// [INI-003], [INI-004], [MOD-005], [MOD-008]
    procedure VisitModuleStmt (TheStmt : ModuleStmt);
    var
        Importer  : Environment;
        ModuleEnv : Environment;
        Exported  : List;

    begin
        Importer := Env;

        if Modules.Contains (TheStmt.FileName) then
        begin
            var Already := Modules.Get (TheStmt.FileName) as Environment;
            if Already.UnitName = '' then Already.UnitName := Str (TheStmt.UnitName);

            Importer.Imports.Add (Modules.Get (TheStmt.FileName));
            UnitsByName.Put (FoldCase (TheStmt.UnitName), Modules.Get (TheStmt.FileName));
            Exit;
        end

        ModuleEnv := Environment();
        ModuleEnv.Enclosing := Builtins;
        ModuleEnv.UnitName := Str (TheStmt.UnitName);

        Modules.Put (TheStmt.FileName, ModuleEnv);

        ExecuteBlock (TheStmt.Statements, ModuleEnv);

        Exported := List();

        var Hidden := Set();
        for var PrivateName in TheStmt.PrivateNames do
            Hidden.Add (FoldCase (PrivateName));

        var Names := ModuleEnv.Values.Keys();
        for var TheName in Names do
        begin

            if not Hidden.Contains (TheName) then
                Exported.Add (TheName);
        end

        ModuleEnv.Exports := Set();
        for var Each in Exported do
            ModuleEnv.Exports.Add (Each);

        Importer.Imports.Add (ModuleEnv);
        UnitsByName.Put (FoldCase (TheStmt.UnitName), ModuleEnv);
    end

    /// Raises a value to the nearest matching handler.
    ///
    /// # Satisfies
    ///
    /// [STM-016]
    procedure VisitRaiseStmt (TheStmt : RaiseStmt);
    begin
        raise Raised (Evaluate (TheStmt.Value));
    end

    /// Finds the handler that catches a value: by class up the chain, then the
    /// catch-all.
    ///
    /// When typed handlers are present and none matches, the value keeps
    /// unwinding rather than being swallowed.
    function FindHandler (Handlers : Map, Value : Any) : ExceptHandler;
    var
        Klass : ObjClass;

    begin
        if Value is ObjInstance then
        begin
            Klass := Value.Klass as ObjClass;
            while Klass <> Nil do
            begin
                var TheName := Str (Klass.Name);
                if Handlers.Contains (TheName) then Exit Handlers.Get (TheName) as ExceptHandler;

                Klass := Klass.Superclass;
            end

            Exit Nil;
        end

        var TypeName := TypeNameOf (Value);
        if Handlers.Contains (TypeName) then Exit Handlers.Get (TypeName) as ExceptHandler;

        Exit Nil;
    end

    /// Runs the handler that caught a value, with the value bound to its name.
    procedure Handle (TheStmt : TryStmt, Value : Any, Original : Any);
    var
        Handler : ExceptHandler;

    begin
        Handler := FindHandler (TheStmt.Handlers, Value);

        if Handler = Nil and TheStmt.Handlers.Contains ('default') then
            Handler := TheStmt.Handlers.Get ('default') as ExceptHandler;

        if Handler = Nil then raise Original;

        Env.Define (Handler.Name, Value);

        Execute (Handler.Body);
    end

    /// Runs a try, and the handler that catches whatever it raised.
    ///
    /// A break, a continue, a goto and a return all travel as raised values too,
    /// so they must pass THROUGH a try rather than be caught by it.
    ///
    /// # Satisfies
    ///
    /// [ERR-007], [STM-017], [STM-018], [STM-019], [STM-020], [STM-023]
    procedure VisitTryStmt (TheStmt : TryStmt);
    begin
        try
            Execute (TheStmt.TryBlock);
        except
            on e : Return do raise e;
            on e : Raised do Handle (TheStmt, e.Value, e);
            on e : String do Handle (TheStmt, e, e);
        end
    end

    /// Returns from a subprogram, by raising a value the call catches.
    ///
    /// # Satisfies
    ///
    /// [FUN-002], [STM-014]
    procedure VisitReturnStmt (Stmt : ReturnStmt);
    var
        Value : Any;

    begin
        if Stmt.Value <> Nil then Value := Evaluate (Stmt.Value);

        raise Return (Value);
    end

    /// Declares a variable, widening its initializer to the declared type.
    ///
    /// A variable is NOT hoisted: it comes into being where it is written, so a
    /// name read before its declaration has run is an error rather than nil.
    ///
    /// # Satisfies
    ///
    /// [DCL-016], [VAR-002], [VAR-014]
    procedure VisitVarStmt (Stmt : VarStmt);
    var
        Value : Any;

    begin
        if Stmt.Initializer <> Nil then
        begin
            Value := Widen (Evaluate (Stmt.Initializer), Str (Stmt.TypeName));
        end

        Env.Define (Stmt.Name.Lexeme, Value);
    end

    /// Declares several names from one initializer, evaluated once.
    procedure VisitVarGroupStmt (TheStmt : VarGroupStmt);
    var
        Value : Any;

    begin
        if TheStmt.Initializer <> Nil then
            Value := Evaluate (TheStmt.Initializer);

        for var TheName in TheStmt.Names do
            Env.Define (TheName.Lexeme, Value);
    end

    /// Assigns to a name, widening the value to the type declared for it.
    ///
    /// # Satisfies
    ///
    /// [VAR-017]
    function VisitAssignExpr (Expr : AssignExpr) : Any;
    var
        Value    : Any;
        Distance : Integer;

    begin
        Value := Widen (Evaluate (Expr.Value), Str (Expr.Declared));
        Distance := Locals.Get (Expr) as Integer;

        if Distance <> Nil then
        begin
            try
                Env.AssignAt (Distance, Expr.Name, Value);
            except
                on e : String do SetThisField (Expr.Name, Value, e);
            end
        end
        else
        begin
            try
                Env.Assign (Expr.Name, Value);
            except
                on e : String do SetThisField (Expr.Name, Value, e);
            end
        end

        Exit Value;
    end
end

/// Carried by a 'break', naming the loop it leaves.
class Broke;
var
    /// The loop named by the jump, or '' for the innermost one.
    Label : String;

begin
    /// Makes the signal, naming a loop.
    constructor Init (Label : String);
    begin
        this.Label := Label;
    end
end

/// Carried by a 'continue', naming the loop whose next iteration begins.
class Continued;
var
    /// The loop named by the jump, or '' for the innermost one.
    Label : String;

begin
    /// Makes the signal, naming a loop.
    constructor Init (Label : String);
    begin
        this.Label := Label;
    end
end

/// Carried by a 'goto', naming the label it jumps to.
class Jumped;
var
    /// The loop named by the jump, or '' for the innermost one.
    Label : String;

begin
    /// Makes the signal, naming a loop.
    constructor Init (Label : String);
    begin
        this.Label := Label;
    end
end

/// Gets the position of a labelled statement in a list, or -1.
function LabelAt (Statements : List, Named : String) : Integer;
begin
    for var I := 0; I < Statements.Length; I := I + 1 do
        if Statements[I] is LabelStmt then
            if FoldCase (Str (Statements[I].Name.Lexeme)) = FoldCase (Named) then
                Exit I;

    Exit -1;
end

/// Whether a jump's label names this loop -- '' matches the innermost.
function Names (Wanted : String, Loop : String) : Boolean;
begin
    if Wanted = '' then Exit True;

    Exit FoldCase (Wanted) = FoldCase (Loop);
end

/// Carried by a 'raise', holding the value thrown.
class Raised;
var
    /// The value being raised.
    Value : Any;

begin
    /// Makes the signal, carrying a value.
    constructor Init (Value : Any);
    begin
        this.Value := Value;
    end
end

/// Carried by an 'Exit', holding the value returned.
class Return;
var
    /// The value being returned.
    Value : Any;

begin
    /// Makes the signal, carrying a value.
    constructor Init (Value : Any);
    begin
        this.Value := Value;
    end
end

// Evaluating a literal should return the value.
//
test 'Evaluate Literal';
begin
    // Arrange
    var TheInterpreter : Interpreter := Interpreter();

    var TheExpr : Expr := LiteralExpr(3.16);

    // Act
    var Value := TheInterpreter.Evaluate(TheExpr);

    // Assert
    AssertEqual(3.16, Value);
end

// Evaluating a grouping should return the value of the inside expression.
//
test 'Evaluate Grouping';
begin
    // Arrange
    var TheInterpreter : Interpreter := Interpreter();

    var TheExpr : Expr := LiteralExpr(3.16);
    TheExpr := GroupingExpr(TheExpr);

    // Act
    var Value := TheInterpreter.Evaluate(TheExpr);

    // Assert
    AssertEqual(3.16, Value);
end

// Evaluating an unary number with a minus operator should negate the number.
//
test 'Evaluate Unary Minus';
begin
    // Arrange
    var TheInterpreter : Interpreter := Interpreter();

    var TheExpr : Expr := LiteralExpr(3.16);
    TheExpr := UnaryExpr(Token(TOKEN_MINUS, '-', nil, 1), TheExpr);

    // Act
    var Value := TheInterpreter.Evaluate(TheExpr);

    // Assert
    AssertEqual(-3.16, Value);
end

// Should return a runtime error if expression of minus unary is not a number.
//
test 'Evaluate Unary Minus Not Number';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var TheExpr : Expr := LiteralExpr(True);
    TheExpr := UnaryExpr(Token(TOKEN_MINUS, '-', nil, 1), TheExpr);

    try
        TheInterpreter.Evaluate(TheExpr);
        // FIXME
        //var Value := TheInterpreter.Evaluate(TheExpr);
    except
       on e : String do
           begin
               AssertEqual ('Operand must be a number.', e);
               Exit;
           end
    end
    Fail('No error raised');
end

// Unary expression with bang operator of boolean true should return false.
//
test 'Evaluate Unary Bang True';
begin
    // Arrange
    var TheInterpreter : Interpreter := Interpreter();

    var TheExpr : Expr := LiteralExpr(True);
    TheExpr := UnaryExpr(Token(TOKEN_NOT, '!', nil, 1), TheExpr);

    // Act
    var Value := TheInterpreter.Evaluate(TheExpr);

    // Assert
    AssertEqual(False, Value);
end

// Unary expression with bang operator of boolean false should return true.
//
test 'Evaluate Unary Bang False';
begin
    // Arrange
    var TheInterpreter : Interpreter := Interpreter();

    var TheExpr : Expr := LiteralExpr(False);
    TheExpr := UnaryExpr(Token(TOKEN_NOT, '!', nil, 1), TheExpr);

    // Act
    var Value := TheInterpreter.Evaluate(TheExpr);

    // Assert
    AssertEqual(True, Value);
end

// Unary expression with bang operand with nil value should return true.  (Nil has truthy value of false)
//
test 'Evaluate Unary Bang Nil';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var TheExpr : Expr := LiteralExpr(Nil);
    TheExpr := UnaryExpr(Token(TOKEN_NOT, '!', nil, 1), TheExpr);

    // Act
    var Value := TheInterpreter.Evaluate(TheExpr);

    // Assert
    AssertEqual(True, Value);
end

// Unary expression with bang operator with any other value should return false.  (Non-nil has truthy value of true)
//
test 'Evaluate Unary Bang Non-Nil';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var TheExpr : Expr := LiteralExpr('Hi');
    TheExpr := UnaryExpr(Token(TOKEN_NOT, '!', nil, 1), TheExpr);

    // Act
    var Value := TheInterpreter.Evaluate(TheExpr);

    // Assert
    AssertEqual(False, Value);
end

// Minus binary expression should return the left minus right.
//
test 'Evaluate Binary Minus';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var Minus := Token(TOKEN_MINUS, '-', Nil, 1);
    var Left  := LiteralExpr(2.0);
    var Right := LiteralExpr(1.0);

    var TheExpr := BinaryExpr(Left, Minus, Right);

    // Act
    var Value := TheInterpreter.Evaluate(TheExpr);

    // Assert
    AssertEqual(1.0, Value);
end

// Minus should return a runtime error if left expression is not a number.
//
test 'Evaluate Minus Left Not Number';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var Minus := Token(TOKEN_MINUS, '-', Nil, 1);
    var Left  := LiteralExpr(True);
    var Right := LiteralExpr(1.0);

    var TheExpr := BinaryExpr(Left, Minus, Right);

    try
        TheInterpreter.Evaluate(TheExpr);
    except
       on e : String do
           begin
               AssertEqual ('Operands must be numbers.', e);
               Exit;
           end
    end
    Fail('No error raised');
end

// Minus should return a runtime error if right expression is not a number.
//
test 'Evaluate Minus Right Not Number';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var Minus := Token(TOKEN_MINUS, '-', Nil, 1);
    var Left  := LiteralExpr(3.0);
    var Right := LiteralExpr(False);

    var TheExpr := BinaryExpr(Left, Minus, Right);

    try
        TheInterpreter.Evaluate(TheExpr);
    except
       on e : String do
           begin
               AssertEqual ('Operands must be numbers.', e);
               Exit;
           end
    end
    Fail('No error raised');
end

// Slash binary expression should return the left divided by right.
//
test 'Evaluate Binary Slash';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var Slash := Token(TOKEN_SLASH, '/', Nil, 1);
    var Left  := LiteralExpr(4.0);
    var Right := LiteralExpr(2.0);

    var TheExpr := BinaryExpr(Left, Slash, Right);

    // Act
    var Value := TheInterpreter.Evaluate(TheExpr);

    // Assert
    AssertEqual(2.0, Value);
end

// Slash should return a runtime error if left expression is not a number.
//
test 'Evaluate Slash Left Not Number';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var Slash := Token(TOKEN_SLASH, '-', Nil, 1);
    var Left  := LiteralExpr(True);
    var Right := LiteralExpr(1.0);

    var TheExpr := BinaryExpr(Left, Slash, Right);

    try
        TheInterpreter.Evaluate(TheExpr);
    except
       on e : String do
           begin
               AssertEqual ('Operands must be numbers.', e);
               Exit;
           end
    end
    Fail('No error raised');
end

// Slash should return a runtime error if right expression is not a number.
//
test 'Evaluate Slash Right Not Number';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var Slash := Token(TOKEN_SLASH, '/', Nil, 1);
    var Left  := LiteralExpr(3.0);
    var Right := LiteralExpr(False);

    var TheExpr := BinaryExpr(Left, Slash, Right);

    try
        TheInterpreter.Evaluate(TheExpr);
    except
       on e : String do
           begin
               AssertEqual ('Operands must be numbers.', e);
               Exit;
           end
    end
    Fail('No error raised');
end

// Slash is REAL division, so two Integers still answer a Double.
//
test 'Evaluate Binary Slash Two Integers';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var Slash := Token(TOKEN_SLASH, '/', Nil, 1);
    var TheExpr := BinaryExpr(LiteralExpr(7), Slash, LiteralExpr(2));

    // Act
    var Value := TheInterpreter.Evaluate(TheExpr);

    // Assert
    AssertEqual(3.5, Value);
end

// Mod binary expression should return the remainder, its sign following the
// dividend.
//
test 'Evaluate Binary Mod';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var TheMod := Token(TOKEN_MOD, 'mod', Nil, 1);

    AssertEqual(1,  TheInterpreter.Evaluate(BinaryExpr(LiteralExpr(7), TheMod, LiteralExpr(3))));
    AssertEqual(-1, TheInterpreter.Evaluate(BinaryExpr(LiteralExpr(-7), TheMod, LiteralExpr(3))));
    AssertEqual(1,  TheInterpreter.Evaluate(BinaryExpr(LiteralExpr(7), TheMod, LiteralExpr(-3))));
    AssertEqual(0,  TheInterpreter.Evaluate(BinaryExpr(LiteralExpr(6), TheMod, LiteralExpr(3))));
end

// Mod refuses a Double rather than truncating it, on div's terms.
//
test 'Evaluate Binary Mod Not An Integer';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var TheMod := Token(TOKEN_MOD, 'mod', Nil, 1);
    var TheExpr := BinaryExpr(LiteralExpr(7.0), TheMod, LiteralExpr(2));

    try
        TheInterpreter.Evaluate(TheExpr);
    except
       on e : String do
           begin
               AssertEqual ('mod expects Integers.', e);
               Exit;
           end
    end
    Fail('No error raised');
end

// A zero divisor is a fault for mod, as it is for div.
//
test 'Evaluate Binary Mod By Zero';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var TheMod := Token(TOKEN_MOD, 'mod', Nil, 1);
    var TheExpr := BinaryExpr(LiteralExpr(7), TheMod, LiteralExpr(0));

    try
        TheInterpreter.Evaluate(TheExpr);
    except
       on e : String do
           begin
               AssertEqual ('Division by zero.', e);
               Exit;
           end
    end
    Fail('No error raised');
end

// Star binary expression should return the left divided by right.
//
test 'Evaluate Binary Star';
begin
    var TheInterpreter : Interpreter := Interpreter();

    var Star := Token(TOKEN_STAR, '*', Nil, 1);
    var Left  := LiteralExpr(2.0);
    var Right := LiteralExpr(2.0);

    var TheExpr := BinaryExpr(Left, Star, Right);

    // Act
    var Value := TheInterpreter.Evaluate(TheExpr);

    // Assert
    AssertEqual(4.0, Value);
end

// Star should return a runtime error if left expression is not a number.
//
