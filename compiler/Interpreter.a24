    var Greater := Token(TOKEN_GREATER, '>', Nil, 1);
    var Left  := LiteralExpr(4.0);
    var Right := LiteralExpr(3.0);

    var TheExpr := BinaryExpr(Left, Greater, Right);

    // Act
