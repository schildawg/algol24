uses Environment;
uses Interpreter;
uses ObjBuffer;
uses ObjClass;
uses ObjCollection;
uses ObjFile;
uses ObjInstance;
uses Stmt;
uses Token;

/// A function value: a declaration plus the environment it closed over.
///
/// Named Obj* to match the C runtime this compiles to -- ObjClass, ObjInstance,
/// ObjSeq -- and clox, which a later bytecode VM would be modelled on.  So the
/// tree-walker, the runtime it emits, and any VM that follows all say the same
/// word for the same thing.
///
/// Runtime type name of a value: 'Integer', 'Double', 'String', 'Char',
/// 'Boolean', 'nil', or the name of its class.
///
/// The same answers the C runtime's type_name gives, because overload
/// selection has to agree across the two back ends.
///
function TypeNameOf (Value : Any) : String;
begin
    if Value = Nil then Exit 'nil';

    if Value is Boolean then Exit 'Boolean';
    if Value is Integer then Exit 'Integer';
    if Value is Double  then Exit 'Double';
    if Value is String  then Exit 'String';
    if Value is Char    then Exit 'Char';

    // An interpreted value answers with the type the PROGRAM sees, not with
    // the wrapper this interpreter happens to hold it in -- 'Dog', 'List' and
    // 'Colour' rather than ObjInstance, ObjCollection and ObjEnum.  Overload
    // selection is about the interpreted language's types.
    //
    // ⚠️ The collections and enums were missing here, so a parameter
    // declared ': List' matched no argument at all and overloading on a
    // collection quietly never selected.  The C runtime's type_name had its
    // own version of that same hole, naming none of the five.  Two
    // implementations of one rule, wrong in two different ways.
    if Value is ObjInstance   then Exit Str (Value.Klass.Name);
    if Value is ObjCollection then Exit Value.Kind;
    if Value is ObjEnum       then Exit Value.TypeName;

    // ⚠️ And the two wrappers that are not collections, which the note above
    // predicted without naming: 'F is TextFile' was false here and true in
    // both other implementations, because this fell through to NameOfClass
    // and answered 'ObjFile'.  Buffer would have joined it -- the same rule,
    // wrong a fourth way.
    if Value is ObjFile       then Exit 'TextFile';
    if Value is ObjBuffer     then Exit 'Buffer';

    Exit NameOfClass (Value);
end

/// Class name of a value, or '' when it is not an instance.
///
/// Still a caught failure, because it asks for a name rather than testing one:
/// 'is' answers "is this a Dog?" and this answers "what is this?".  ClassName
/// raises on anything that is not an instance -- a number, a String, nil.
///
function NameOfClass (Obj : Any) : String;
begin
    try
        Exit Obj.ClassName;
    except
        on e : String do Exit '';
    end
end

/// Whether a value stands where a class of this name is declared.
///
/// Not replaceable by 'is', and the reason the operator does not make every
/// type test go away: the name here arrives as a String at run time, while
/// 'is' needs one written in the source.  This is the dynamic half.
///
/// Several top-level subprograms sharing one name [FUN-013].
///
/// ⚠️ The environment binds one name to one value, which is why two
/// subprograms of a name used to be refused outright.  This is the value that
/// holds both: the name binds to the SET, and the call selects from it exactly
/// as a method call selects from a class's methods.
///
/// ⚠️ Selection is at RUN TIME, from the values actually passed -- the same
/// rule methods have always followed [EXP-013].  A declared type may be Any,
/// and no static rule could reach the right overload from that.
///
class ObjOverloads;
var
    Name       : String;
    Candidates : List;

begin
    constructor Init (Name : String);
    begin
        this.Name := Name;
        this.Candidates := List();
    end

    procedure Add (TheFunction : Any);
    begin
        Candidates.Add (TheFunction);
    end

    /// ⚠️ -1, which means "checks its own" -- the caller's arity check is
    /// skipped and selection decides, because the candidates differ in arity.
    function Arity () : Integer;
    begin
        Exit -1;
    end

    /// ⚠️ THREE PASSES, exact then widening then absorbing, as
    /// ObjClass.FindOverload does and for the same reason [EXP-014]: one pass
    /// admitting widening would let declaration order decide which overload a
    /// Char reaches, and one admitting absorption would let a variadic
    /// signature take a call a fixed-arity one answers exactly.
    ///
    /// ⚠️ The passes are a LOOP BOUND rather than three unrolled walks, so the
    /// order that is the entire rule is written once and cannot be half
    /// changed.
    function Select (Arguments : List) : Any;
    begin
        for var Pass := EXACT; Pass <= ABSORBING; Pass := Pass + 1 do
            for var I := 0; I < Candidates.Length; I := I + 1 do
                if Candidates[I].Selects (Arguments, Pass) then Exit Candidates[I];

        Exit Nil;
    end

    function Call (TheInterpreter, Arguments) : Any;
    var
        Chosen : Any;

    begin
        Chosen := Select (Arguments);
        if Chosen = Nil then raise 'No matching signature for function.';

        Exit Chosen.Call (TheInterpreter, Arguments);
    end

    function ToString () : String;
    begin
        Exit '<fn ' + Name + '>';
    end
end

/// A bound member of a number -- '5.ToString' without the call.
///
/// ⚠️ The fourth of these wrappers, beside CollectionMethod, BufferMethod and
/// FileMethod.  A number's members come from the runtime rather than from a
/// class, so there is no method to bind and the name and arity are carried
/// instead -- which is what the C runtime's ObjBuiltinBound does with one
/// struct for all four.
///
/// ⚠️ It lives here rather than in an ObjNumber of its own because a number is
/// not wrapped: it is a host value, and this is only the callable it hands back.
///
class NumberMethod;
var
    Receiver : Any;
    Name     : Token;

begin
    constructor Init (Receiver : Any, Name : Token);
    begin
        this.Receiver := Receiver;
        this.Name := Name;
    end

    function Arity () : Integer;
    begin
        Exit 0;
    end

    function Call (TheInterpreter, Arguments) : Any;
    begin
        Exit Str (Receiver);
    end

    /// Printed as a bound method is [TYP-012], like every other member read
    /// without being called.
    function ToString () : String;
    begin
        Exit '<fn ' + Str (Name.Lexeme) + '>';
    end
end

/// Whether two declarations claim the same signature, and are therefore a
/// duplicate rather than an overload.
///
/// ⚠️ The PARAMETER types alone.  A return type does not distinguish an
/// overload -- selection happens from the arguments, and two subprograms
/// differing only in what they return could never be told apart at a call.
///
function SameSignature (Left : Any, Right : Any) : Boolean;
begin
    if Left.Params.Length <> Right.Params.Length then Exit False;

    // ⚠️ Compared THROUGH a subrange, so 'Take (B : Byte)' and
    // 'Take (I : Integer)' claim the SAME signature and are a duplicate rather
    // than an overload [FUN-013].  A call could never tell them apart -- which
    // is the argument this rule already makes about return types -- and the
    // range is checked when the argument arrives instead.
    for var I := 0; I < Left.Params.Length; I := I + 1 do
        if UnderlyingType (Left.ParamTypes[I]) <> UnderlyingType (Right.ParamTypes[I]) then
            Exit False;

    Exit True;
end

/// Whether a value of type Actual may be passed where Declared is written.
///
/// ⚠️ A parameter is an ASSIGNMENT CONTEXT [VAR-017], so the same two widenings
/// that hold at a declaration hold here: an Integer where a Double is written,
/// and a Char where a String is.  The value is converted on the way in by
/// ObjFunction.Call, so the parameter holds the wider type rather than one the
/// declaration misdescribes.
///
/// ⚠️ Selection had to learn this at the same moment top-level subprograms
/// started being matched on their signatures.  Without it 'F (1)' into
/// 'X : Double' -- correct, and printing 1.0 -- became
/// 'No matching signature for function.'
///
/// The three passes of overload selection, in the order they run [EXP-014].
///
/// ⚠️ The ORDER IS THE RULE, and there is no other.  "A fixed-arity signature
/// beats an absorbing one" is a sentence other languages have to write into
/// their specifications; here ABSORBING simply never runs when EXACT or
/// WIDENING found something.  That is why 'Log (''warn'', [1, 2])' passes the
/// list rather than gathering it into a second one holding it.
///
const EXACT     := 0;
const WIDENING  := 1;
const ABSORBING := 2;

function Widens (Actual : String, Declared : String) : Boolean;
begin
    if Declared = 'Double' and Actual = 'Integer' then Exit True;
    if Declared = 'String' and Actual = 'Char'    then Exit True;

    Exit False;
end

function InheritsFrom (Value : Any, TheName : String) : Boolean;
var
    Klass : ObjClass;

begin
    if not (Value is ObjInstance) then Exit False;

    // 'as', because Value is declared Any and a member of it reduces to
    // nothing -- a written type has to be earned [VAR-006].
    Klass := Value.Klass as ObjClass;
    while Klass <> Nil do
    begin
        // ⚠️ Folded [SRC-011].  SatisfiesType folds its DIRECT match and this
        // compared exactly, so 'Puppy() is Dog' was true and 'Puppy() is dog'
        // was false -- one operator disagreeing with itself about case, and the
        // C runtime folded both.  Found by conformance/0135, which exercises the
        // folded spelling for exactly this reason.
        if FoldCase (Klass.Name) = FoldCase (TheName) then Exit True;

        Klass := Klass.Superclass;
    end

    Exit False;
end

class ObjFunction;
var
    Declaration   : FunctionStmt;
    Closure       : Environment;
    IsInitializer : Boolean;

    /// The class this is a method of, and the instance it was bound to, so a
    /// call site can re-select an overload once it knows the argument types.
    /// Nil for a plain function.
    Owner : ObjClass    := Nil;
    Bound : ObjInstance := Nil;

begin
    /// Creates a new instance.
    ///
    constructor Init (Declaration : FunctionStmt, Closure : Environment, IsInitializer : Boolean);
    begin
       this.Closure := Closure;
       this.Declaration := Declaration;
       this.IsInitializer := IsInitializer;
    end

    /// Binds this method to an instance.
    ///
    function Bind (Instance : ObjInstance) : ObjFunction;
    var
        Env : Environment;

    begin
        Env := Environment();
        Env.Enclosing := Closure;
        Env.Define ('this', Instance);

        var Result := ObjFunction (Declaration, Env, IsInitializer);
        Result.Owner := Owner;
        Result.Bound := Instance;

        Exit Result;
    end

    /// Whether one argument stands where a parameter of this type is declared.
    ///
    /// ⚠️ Lifted out of Fits so that ABSORPTION asks the same question of a
    /// gathered argument that selection asks of a positional one.  Two copies
    /// would be two chances for an element type to start disagreeing with the
    /// parameter type it is an element type of.
    ///
    function FitsAt (Argument : Any, Declared : String, Widening : Boolean) : Boolean;
    begin
        // ⚠️ Seen through, so selection IGNORES a subrange's bounds [FUN-013]:
        // 'Take (B : Byte)' accepts whatever 'Take (I : Integer)' accepts.
        // Consulting the bounds here would send 'Take (200)' and 'Take (300)'
        // to different subprograms, and would let ADDING an overload steal
        // calls from one that was already there.
        var Wanted := UnderlyingType (Declared);

        if Wanted = '' or Wanted = 'Any' then Exit True;

        var Actual := TypeNameOf (Argument);

        if Actual = 'nil' or Actual = 'Any' or Actual = Wanted then Exit True;
        if InheritsFrom (Argument, Wanted) then Exit True;

        Exit Widening and Widens (Actual, Wanted);
    end

    /// Whether these arguments fit this signature.
    ///
    /// The rule is the C runtime's signature_matches, and the two have to stay
    /// identical: 'Any' compatible in both directions, nil inhabiting every
    /// type, a subclass standing where its parent is declared, and every
    /// parameter checked against the argument in its own position.
    ///
    /// ⚠️ 'Widening' is what separates the first two passes of selection.  An
    /// exact match is PREFERRED [EXP-014], so a Char argument takes a Char
    /// overload rather than a String one however they are ordered -- and
    /// admitting the widening in a single pass made declaration order decide,
    /// which conformance/0050 caught immediately.
    ///
    /// Inheritance is not widening: a Dog fits an Animal parameter in both
    /// passes, because that is the argument being what the parameter asks for
    /// rather than being converted into it.
    ///
    function Fits (Arguments : List, Widening : Boolean) : Boolean;
    begin
        if Arity () <> Arguments.Length then Exit False;

        for var I := 0; I < Arguments.Length; I := I + 1 do
            if not FitsAt (Arguments[I], Str (Declaration.ParamTypes[I]), Widening) then
                Exit False;

        Exit True;
    end

    /// Whether the last parameter may gather trailing arguments [FUN-005].
    ///
    /// ⚠️ An ELEMENT TYPE is what makes a parameter absorbing, so a bare 'List'
    /// does not absorb.  There would be nothing to check the gathered arguments
    /// against -- and it leaves 'List' as the spelling for a parameter that
    /// wants the list itself and nothing else.
    ///
    function Variadic () : Boolean;
    var
        Last : Integer;

    begin
        if Arity () = 0 then Exit False;

        Last := Arity () - 1;

        if Last >= Declaration.ParamTypes.Length    then Exit False;
        if Last >= Declaration.ParamGenerics.Length then Exit False;

        Exit Str (Declaration.ParamTypes[Last]) = 'List'
         and Str (Declaration.ParamGenerics[Last]) <> '';
    end

    /// Whether these arguments fit by gathering the trailing ones [FUN-005].
    ///
    /// ⚠️ The element type replaces the arity check, and is STRICTER than it.
    /// 'Log (''warn'', 1, 2, ''red'')' is still an error against
    /// 'List of Integer', because the stray argument fails the element type.
    /// What absorption gives up is given up only for 'List of Any', which is
    /// already the declaration that means anything.
    ///
    function Absorbs (Arguments : List) : Boolean;
    var
        Fixed   : Integer;
        Element : String;

    begin
        if not Variadic () then Exit False;

        Fixed := Arity () - 1;
        if Arguments.Length < Fixed then Exit False;

        // The parameters before the absorbing one are ordinary ones.
        for var I := 0; I < Fixed; I := I + 1 do
            if not FitsAt (Arguments[I], Str (Declaration.ParamTypes[I]), True) then
                Exit False;

        Element := Str (Declaration.ParamGenerics[Fixed]);

        for var I := Fixed; I < Arguments.Length; I := I + 1 do
            if not FitsAt (Arguments[I], Element, True) then Exit False;

        Exit True;
    end

    /// The arguments with the trailing ones gathered into a List [FUN-005].
    ///
    /// ⚠️ Asks the earlier passes again rather than trusting its caller, so a
    /// call that fits WITHOUT gathering is left alone [EXP-014].  Call is the
    /// one place every route into a subprogram passes through -- an overload
    /// set, a method found up a chain, a plain name -- and reshaping here is
    /// what spares all three from knowing that absorption exists.
    ///
    /// ⚠️ Gathering NOTHING yields the empty list, which is what makes
    /// 'WriteLn ()' an ordinary call rather than a special case.  The list is
    /// STRUCTURAL and not a default: gathering none gives [] by the same rule
    /// that gathering three gives a list of three.
    ///
    /// ⚠️ TWO KINDS OF LIST MEET HERE, and confusing them is the first thing
    /// this got wrong.  The argument vector is a HOST list -- this compiler's
    /// own -- while an element of it is an INTERPRETED value, so the gathered
    /// arguments have to arrive as an ObjCollection and not as a second host
    /// list.  A host list bound to a parameter reaches the program as something
    /// with no properties at all, and 'Items.Length' inside the body fails with
    /// 'Only instances have properties.'
    ///
    function Absorb (Arguments : List) : List;
    var
        Gathered : List;
        Rest     : ObjCollection;

    begin
        if Fits (Arguments, True)  then Exit Arguments;
        if not Absorbs (Arguments) then Exit Arguments;

        Gathered := List();
        Rest     := ObjCollection ('List');

        for var I := 0; I < Arity () - 1; I := I + 1 do
            Gathered.Add (Arguments[I]);

        for var I := Arity () - 1; I < Arguments.Length; I := I + 1 do
            Rest.Items.Add (Arguments[I]);

        Gathered.Add (Rest);

        Exit Gathered;
    end

    /// Whether this subprogram answers the call on the given pass [EXP-014].
    ///
    function Selects (Arguments : List, Pass : Integer) : Boolean;
    begin
        if Pass = ABSORBING then Exit Absorbs (Arguments);

        Exit Fits (Arguments, Pass = WIDENING);
    end

    /// Number of parameters in function signature.
    ///
    function Arity () : Integer;
    begin
        if Declaration.Params = Nil then Exit 0;
        
        Exit Declaration.Params.Length;
    end

    /// To String
    ///
    function ToString () : String;
    begin
        Exit '<fn ' + Declaration.Name.Lexeme + '>';
    end

    /// Runs the function.
    ///
    function Call (TheInterpreter, Arguments) : Any;
    var
        Env   : Environment;
        Count : Integer;

    begin
        Env := Environment();
        Env.Enclosing := Closure;

        // ⚠️ Absorption happens HERE, at the one gate every call goes through,
        // rather than at each of the three places that select a callee.
        Arguments := Absorb (Arguments);

        for var I := 0; I < Declaration.Params.Length; I := I + 1 do
        begin
            // ⚠️ A parameter is an assignment context [VAR-017], so an argument
            // widens on the way in and the parameter holds the wider type --
            // 'F (1)' into 'X : Double' binds 1.0, not 1.
            var Declared := '';
            if I < Declaration.ParamTypes.Length then
                Declared := Str (Declaration.ParamTypes[I]);

            Env.Define (Declaration.Params[I].Lexeme,
                        TheInterpreter.Widen (Arguments[I], Declared));
        end
        
        try 
           TheInterpreter.ExecuteBlock (Declaration.Body, Env);
        except
            on e : Return do
                begin
                    if IsInitializer then Exit Closure.GetAt (0, 'this');

                    // ⚠️ A declared return type is an assignment context too, so
                    // 'Exit 1' from a function declared ': Double' yields 1.0.
                    Exit TheInterpreter.Widen (e.Value, Str (Declaration.ReturnType));
                end
        end

        if IsInitializer then Exit Closure.GetAt(0, 'this');
    end   
end