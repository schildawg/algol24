/// Callable values, and the machinery that decides which one a call reaches.
///
/// Named Obj* to match the C runtime this compiles to -- ObjClass, ObjInstance,
/// ObjSeq -- and clox, which a later bytecode VM would be modelled on.  So the
/// tree-walker, the runtime it emits, and any VM that follows all say the same
/// word for the same thing.
unit ObjFunction;

uses Environment;
uses Interpreter;
uses ObjBuffer;
uses ObjClass;
uses ObjCollection;
uses ObjFile;
uses ObjInstance;
uses Stmt;
uses Token;

/// Gets the run-time type name of a value: 'Integer', 'Double', 'String',
/// 'Char', 'Boolean', 'nil', or the name of its class.
///
/// The same answers the C runtime's type_name gives, because overload selection
/// has to agree across the two back ends.
///
/// A subrange answers 'Integer'.  Nothing is ever "a Byte" at run time -- a
/// subrange constrains where a type is written, and does not become one.
///
/// # Satisfies
///
/// [TYP-001], [TYP-003], [TYP-017]
function TypeNameOf (Value : Any) : String;
begin
    if Value = Nil then Exit 'nil';

    if Value is Boolean then Exit 'Boolean';
    if Value is Integer then Exit 'Integer';
    if Value is Double  then Exit 'Double';
    if Value is String  then Exit 'String';
    if Value is Char    then Exit 'Char';

    if Value is ObjInstance   then Exit Str (Value.Klass.Name);
    if Value is ObjCollection then Exit Value.Kind;
    if Value is ObjEnum       then Exit Value.TypeName;

    if Value is ObjFile       then Exit 'TextFile';
    if Value is ObjBuffer     then Exit 'Buffer';

    if Value is Pointer       then Exit 'Pointer';

    Exit NameOfClass (Value);
end

/// Gets the class name of a value, or '' when it is not an instance.
///
/// A caught failure rather than a test, because it asks for a name rather than
/// checking one: 'is' answers "is this a Dog?" and this answers "what is this?".
/// ClassName raises on anything that is not an instance -- a number, a String,
/// nil.
function NameOfClass (Obj : Any) : String;
begin
    try
        Exit Obj.ClassName;
    except
        on e : String do Exit '';
    end
end

/// Several top-level subprograms sharing one name.
///
/// The environment binds one name to one value, which is why two subprograms of
/// a name used to be refused outright.  This is the value that holds both: the
/// name binds to the SET, and the call selects from it exactly as a method call
/// selects from a class's methods.
///
/// Selection is at RUN TIME, from the values actually passed -- the same rule
/// methods have always followed.  A declared type may be Any while the value has
/// a definite type, which no static rule could reach.
///
/// # Satisfies
///
/// [FUN-013]
class ObjOverloads;
var
    /// The shared name.
    Name       : String;

    /// The subprograms bound under it, in declaration order.
    Candidates : List;

begin
    /// Makes an empty overload set for a name.
    constructor Init (Name : String);
    begin
        this.Name := Name;
        this.Candidates := List();
    end

    /// Adds a subprogram to the set.
    procedure Add (TheFunction : Any);
    begin
        Candidates.Add (TheFunction);
    end

    /// Answers -1, meaning the arity is not fixed.
    ///
    /// A set has no one arity: its candidates may take different numbers of
    /// arguments, and which is called is decided by Select rather than by a
    /// count checked beforehand.
    function Arity () : Integer;
    begin
        Exit -1;
    end

    /// Selects the candidate these arguments fit, exact before widening
    /// before absorbing, or Nil when none does.
    function Select (Arguments : List) : Any;
    begin
        for var Pass := EXACT; Pass <= ABSORBING; Pass := Pass + 1 do
            for var I := 0; I < Candidates.Length; I := I + 1 do
                if Candidates[I].Selects (Arguments, Pass) then Exit Candidates[I];

        Exit Nil;
    end

    /// Selects a candidate from the arguments and calls it.
    ///
    /// # Raises
    ///
    /// 'No matching signature for function.' when no candidate fits.
    function Call (TheInterpreter, Arguments) : Any;
    var
        Chosen : Any;

    begin
        Chosen := Select (Arguments);
        if Chosen = Nil then raise 'No matching signature for function.';

        Exit Chosen.Call (TheInterpreter, Arguments);
    end

    /// Prints the subprogram as '<fn Name>'.
    function ToString () : String;
    begin
        Exit '<fn ' + Name + '>';
    end
end

/// A member read on a number -- '5.ToString ()'.
///
/// Numbers answer members the way C# has them, not the way Java does: Integer
/// is a type with members rather than a primitive a box wraps.  There is no
/// second type to confuse with the first, and no identity to go wrong.
///
/// # Satisfies
///
/// [RT-019]
class NumberMethod;
var
    /// The number the member was read on.
    Receiver : Any;

    /// The member name, kept as a token for the diagnostic.
    Name     : Token;

begin
    /// Makes a member bound to a number.
    constructor Init (Receiver : Any, Name : Token);
    begin
        this.Receiver := Receiver;
        this.Name := Name;
    end

    /// Answers 0: the only member a number has takes no arguments.
    function Arity () : Integer;
    begin
        Exit 0;
    end

    /// Calls the member, which is ToString and answers the number as text.
    function Call (TheInterpreter, Arguments) : Any;
    begin
        Exit Str (Receiver);
    end

    /// Prints the subprogram as '<fn Name>'.
    function ToString () : String;
    begin
        Exit '<fn ' + Str (Name.Lexeme) + '>';
    end
end

/// Whether two declarations claim the same signature, and are therefore a
/// duplicate rather than an overload.
///
/// Compared on the UNDERLYING type, so two subprograms differing only in a
/// subrange -- Byte against Integer -- are the same signature.  A range does not
/// distinguish an overload, for the reason a return type does not: selection
/// happens from the arguments, and two subprograms a call could never tell apart
/// are a duplicate.
function SameSignature (Left : Any, Right : Any) : Boolean;
begin
    if Left.Params.Length <> Right.Params.Length then Exit False;

    for var I := 0; I < Left.Params.Length; I := I + 1 do
        if UnderlyingType (Left.ParamTypes[I]) <> UnderlyingType (Right.ParamTypes[I]) then
            Exit False;

    Exit True;
end

/// Whether any argument at a call site named the parameter it fills.
function AnyNamed (Names : List) : Boolean;
begin
    for var I := 0; I < Names.Length; I := I + 1 do
        if Str (Names[I]) <> '' then Exit True;

    Exit False;
end

/// The first selection pass: every argument matches its parameter's type
/// exactly.
const EXACT     := 0;

/// The second pass: an argument may widen to reach its parameter.
const WIDENING  := 1;

/// The third pass: a variadic parameter may gather what is left over.
const ABSORBING := 2;

/// Whether a value of one type reaches a parameter of another by widening.
///
/// Two widenings only: Integer to Double, and Char to String.
function Widens (Actual : String, Declared : String) : Boolean;
begin
    if Declared = 'Double' and Actual = 'Integer' then Exit True;
    if Declared = 'String' and Actual = 'Char'    then Exit True;

    Exit False;
end

/// Whether a value stands where a class of this name is declared.
///
/// Not replaceable by 'is', and the reason that operator does not make every
/// type test go away: the name here arrives as a String at run time, while 'is'
/// needs one written in the source.  This is the dynamic half.
function InheritsFrom (Value : Any, TheName : String) : Boolean;
var
    Klass : ObjClass;

begin
    if not (Value is ObjInstance) then Exit False;

    Klass := Value.Klass as ObjClass;
    while Klass <> Nil do
    begin
        if FoldCase (Klass.Name) = FoldCase (TheName) then Exit True;

        Klass := Klass.Superclass;
    end

    Exit False;
end

/// A function value: a declaration plus the environment it closed over.
///
/// # Satisfies
///
/// [FUN-009], [FUN-011]
class ObjFunction;
var
    /// The declaration this was made from -- its parameters, types and body.
    Declaration   : FunctionStmt;

    /// The environment the declaration was written in, which is what makes this
    /// a closure rather than a plain subprogram.
    Closure       : Environment;

    /// Whether this is a constructor, which answers 'this' rather than its
    /// body's value.
    IsInitializer : Boolean;

    /// The class that declared this method, or Nil for a top-level subprogram.
    Owner : ObjClass    := Nil;

    /// The receiver this method is bound to, or Nil when it is unbound.
    Bound : ObjInstance := Nil;

begin
    /// Makes a function value from a declaration and the environment it closed
    /// over.
    constructor Init (Declaration : FunctionStmt, Closure : Environment, IsInitializer : Boolean);
    begin
       this.Closure := Closure;
       this.Declaration := Declaration;
       this.IsInitializer := IsInitializer;
    end

    /// Binds this method to a receiver, answering a copy closed over 'this'.
    ///
    /// A new environment holding 'this' rather than mutation, so the same
    /// method may be bound to many receivers at once.
    function Bind (Instance : ObjInstance) : ObjFunction;
    var
        Env : Environment;

    begin
        Env := Environment();
        Env.Enclosing := Closure;
        Env.Define ('this', Instance);

        var Result := ObjFunction (Declaration, Env, IsInitializer);
        Result.Owner := Owner;
        Result.Bound := Instance;

        Exit Result;
    end

    /// Whether one argument fits one declared parameter type.
    ///
    /// An undeclared parameter accepts anything, which is what makes the type
    /// system gradual rather than optional.
    function FitsAt (Argument : Any, Declared : String, Widening : Boolean) : Boolean;
    begin
        var Wanted := UnderlyingType (Declared);

        if Wanted = '' or Wanted = 'Any' then Exit True;

        var Actual := TypeNameOf (Argument);

        if Actual = 'nil' or Actual = 'Any' or Actual = Wanted then Exit True;
        if InheritsFrom (Argument, Wanted) then Exit True;

        Exit Widening and Widens (Actual, Wanted);
    end

    /// Whether every argument fits its parameter, with widening allowed or not.
    function Fits (Arguments : List, Widening : Boolean) : Boolean;
    begin
        if Arity () <> Arguments.Length then Exit False;

        for var I := 0; I < Arguments.Length; I := I + 1 do
            if not FitsAt (Arguments[I], Str (Declaration.ParamTypes[I]), Widening) then
                Exit False;

        Exit True;
    end

    /// Whether the last parameter gathers the arguments left over.
    function Variadic () : Boolean;
    var
        Last : Integer;

    begin
        if Arity () = 0 then Exit False;

        Last := Arity () - 1;

        if Last >= Declaration.ParamTypes.Length    then Exit False;
        if Last >= Declaration.ParamGenerics.Length then Exit False;

        Exit Str (Declaration.ParamTypes[Last]) = 'List'
         and Str (Declaration.ParamGenerics[Last]) <> '';
    end

    /// Whether these arguments fit by gathering the trailing ones.
    ///
    /// The element type replaces the arity check, and is STRICTER than it.
    /// 'Log (''warn'', 1, 2, ''red'')' is still an error against
    /// 'List of Integer', because the stray argument fails the element type.
    /// What absorption gives up is given up only for 'List of Any', which is
    /// already the declaration that means anything.
    ///
    /// # Satisfies
    ///
    /// [FUN-005]
    function Absorbs (Arguments : List) : Boolean;
    var
        Fixed   : Integer;
        Element : String;

    begin
        if not Variadic () then Exit False;

        Fixed := Arity () - 1;
        if Arguments.Length < Fixed then Exit False;

        for var I := 0; I < Fixed; I := I + 1 do
            if not FitsAt (Arguments[I], Str (Declaration.ParamTypes[I]), True) then
                Exit False;

        Element := Str (Declaration.ParamGenerics[Fixed]);

        for var I := Fixed; I < Arguments.Length; I := I + 1 do
            if not FitsAt (Arguments[I], Element, True) then Exit False;

        Exit True;
    end

    /// Gathers the trailing arguments into one collection for a variadic
    /// parameter, answering the argument list the call will actually use.
    function Absorb (Arguments : List) : List;
    var
        Gathered : List;
        Rest     : ObjCollection;

    begin
        if Fits (Arguments, True)  then Exit Arguments;
        if not Absorbs (Arguments) then Exit Arguments;

        Gathered := List();
        Rest     := ObjCollection ('List');

        for var I := 0; I < Arity () - 1; I := I + 1 do
            Gathered.Add (Arguments[I]);

        for var I := Arity () - 1; I < Arguments.Length; I := I + 1 do
            Rest.Items.Add (Arguments[I]);

        Gathered.Add (Rest);

        Exit Gathered;
    end

    /// Gets the position of a named parameter, or -1 when there is none.
    function ParameterAt (TheName : String) : Integer;
    begin
        for var I := 0; I < Declaration.Params.Length; I := I + 1 do
            if FoldCase (Str (Declaration.Params[I].Lexeme)) = FoldCase (TheName) then
                Exit I;

        Exit -1;
    end

    /// Puts named arguments into declaration order, or answers Nil when the
    /// names do not fit this signature.
    ///
    /// Nil rather than an error, because with an overload set a name that fits
    /// no candidate here may fit the next one.  Selection asks each candidate
    /// and the CALL reports the failure, which is the same division Fits already
    /// follows.
    ///
    /// Naming the absorbing parameter turns absorption OFF, and needs no rule to
    /// do it: an arrangement fills every slot exactly once, so the arranged list
    /// has precisely the declared arity and the exact pass takes it before
    /// absorption is ever reached.
    function Arrange (Arguments : List, Names : List) : List;
    var
        Slots  : List;
        Filled : List;

    begin
        if not AnyNamed (Names) then Exit Arguments;

        Slots  := List();
        Filled := List();

        for var I := 0; I < Arity (); I := I + 1 do
        begin
            Slots.Add (Nil);
            Filled.Add (False);
        end

        for var I := 0; I < Arguments.Length; I := I + 1 do
        begin
            var TheName := '';
            if I < Names.Length then TheName := Str (Names[I]);

            var At := I;
            if TheName <> '' then At := ParameterAt (TheName);

            if At < 0 or At >= Slots.Length then Exit Nil;
            if Filled[At] then Exit Nil;

            Slots[At]  := Arguments[I];
            Filled[At] := True;
        end

        for var I := 0; I < Filled.Length; I := I + 1 do
            if not Filled[I] then Exit Nil;

        Exit Slots;
    end

    /// Whether this candidate is chosen on a given pass of selection.
    function Selects (Arguments : List, Pass : Integer) : Boolean;
    begin
        if Pass = ABSORBING then Exit Absorbs (Arguments);

        Exit Fits (Arguments, Pass = WIDENING);
    end

    /// How many parameters this subprogram declares.
    function Arity () : Integer;
    begin
        if Declaration.Params = Nil then Exit 0;

        Exit Declaration.Params.Length;
    end

    /// Prints the subprogram as '<fn Name>'.
    function ToString () : String;
    begin
        Exit '<fn ' + Declaration.Name.Lexeme + '>';
    end

    /// Calls the subprogram: bind the parameters in a fresh environment, run the
    /// body, and answer what it returned.
    ///
    /// A constructor answers 'this' rather than its body's value, which is what
    /// makes 'Point (1, 2)' evaluate to the instance.
    ///
    /// # Raises
    ///
    /// An arity failure when the arguments do not fill the parameters, and
    /// whatever the body itself raises.
    function Call (TheInterpreter, Arguments) : Any;
    var
        Env   : Environment;
        Count : Integer;

    begin
        Env := Environment();
        Env.Enclosing := Closure;

        Arguments := Absorb (Arguments);

        if Declaration.Symbol <> '' then
            Exit Foreign (Declaration.Symbol, Declaration.Library,
                          Declaration.ParamTypes, Declaration.ReturnType, Arguments);

        for var I := 0; I < Declaration.Params.Length; I := I + 1 do
        begin
            var Declared := '';
            if I < Declaration.ParamTypes.Length then
                Declared := Str (Declaration.ParamTypes[I]);

            Env.Define (Declaration.Params[I].Lexeme,
                        TheInterpreter.Widen (Arguments[I], Declared));
        end

        try
           TheInterpreter.ExecuteBlock (Declaration.Body, Env);
        except
            on e : Return do
                begin
                    if IsInitializer then Exit Closure.GetAt (0, 'this');

                    Exit TheInterpreter.Widen (e.Value, Str (Declaration.ReturnType));
                end
        end

        if IsInitializer then Exit Closure.GetAt(0, 'this');
    end
end
