// Prints every (kind, member) pair the interpreter actually answers for, as
// machine-readable lines: "Kind Member".
//
// ⚠️ This is not a probe and not a conformance case. It is the SOURCE the
// [COL-003] and [RT-021] member matrices are checked against, run live by
// spec/spec.sh -- the same treatment the keyword table and Annex B already get.
// A matrix transcribed into a specification and checked by nobody is the most
// rot-prone thing this document can hold.
//
// ⚠️ It prints the resources' pairs as well as the collections', and spec.sh
// tells the two apart by the kinds each table names in its own header row.
// One source, two tables.

var Kinds := ['List', 'Set', 'Stack', 'Array', 'Map'];

var Names := ['Length', 'IsEmpty', 'Contains', 'Get', 'Add', 'Insert',
              'Remove', 'RemoveAt', 'IndexOf', 'Sort', 'Clear', 'Set',
              'Fill', 'Put', 'Keys', 'Values', 'ToList', 'Push', 'Pop',
              'Peek'];

function Make (Kind);
begin
    if Kind = 'List'  then Exit List ();
    if Kind = 'Set'   then Exit Set ();
    if Kind = 'Stack' then Exit Stack ();
    if Kind = 'Array' then Exit Array (1);
    Exit Map ();
end

for var K in Kinds do
begin
    for var N in Names do
    begin
        var C := Make (K);

        // ⚠️ Reading the member is the test, not calling it: a call would fail
        // for want of arguments and could not be told apart from the member
        // being absent. COL-005 makes a missing member raise, so a member that
        // reads without raising is one the kind has.
        try
            var Ignored := C.Get;
            if N = 'Get' then WriteLn (K + ' ' + N);
        except
            // not this one
        end

        try
            var Probe := 0;
            case N of
                'Length'   : Probe := C.Length;
                'IsEmpty'  : Probe := C.IsEmpty;
                'Contains' : Probe := C.Contains;
                'Add'      : Probe := C.Add;
                'Insert'   : Probe := C.Insert;
                'Remove'   : Probe := C.Remove;
                'RemoveAt' : Probe := C.RemoveAt;
                'IndexOf'  : Probe := C.IndexOf;
                'Sort'     : Probe := C.Sort;
                'Clear'    : Probe := C.Clear;
                'Set'      : Probe := C.Set;
                'Fill'     : Probe := C.Fill;
                'Put'      : Probe := C.Put;
                'Keys'     : Probe := C.Keys;
                'Values'   : Probe := C.Values;
                'ToList'   : Probe := C.ToList;
                'Push'     : Probe := C.Push;
                'Pop'      : Probe := C.Pop;
                'Peek'     : Probe := C.Peek;
            end
            if N <> 'Get' then WriteLn (K + ' ' + N);
        except
            // not this one
        end
    end
end

// The two resources [RT-021]. Probed the same way -- reading the member, never
// calling it -- but listed separately because they share almost no names with
// the collections and only one with each other.

var Resources := ['Length', 'IsEmpty', 'Text', 'Address', 'Append', 'PutInt',
                  'GetInt', 'Resize', 'Free', 'Eof', 'Assign', 'Reset',
                  'Rewrite', 'ReadLn', 'Write', 'WriteLn', 'Flush', 'Close',
                  'Erase', 'Rename'];

// ⚠️ The file is OPEN, because Eof is the one member that answers only when it
// is: reading it on an unopened file raises, which this probe cannot tell from
// the member being absent. Rewrite is the cheapest open that needs no
// pre-existing file, and the file is erased on the way out.
var Probe := TextFile ();
Probe.Assign ('spec-members-probe.tmp');
Probe.Rewrite ();

for var N in Resources do
begin
    var B := Buffer ();

    try
        var Ignored := 0;
        case N of
            'Length'  : Ignored := B.Length;
            'IsEmpty' : Ignored := B.IsEmpty;
            'Text'    : Ignored := B.Text;
            'Address' : Ignored := B.Address;
            'Append'  : Ignored := B.Append;
            'PutInt'  : Ignored := B.PutInt;
            'GetInt'  : Ignored := B.GetInt;
            'Resize'  : Ignored := B.Resize;
            'Free'    : Ignored := B.Free;
            'Eof'     : Ignored := B.Eof;
            'Assign'  : Ignored := B.Assign;
            'Reset'   : Ignored := B.Reset;
            'Rewrite' : Ignored := B.Rewrite;
            'ReadLn'  : Ignored := B.ReadLn;
            'Write'   : Ignored := B.Write;
            'WriteLn' : Ignored := B.WriteLn;
            'Flush'   : Ignored := B.Flush;
            'Close'   : Ignored := B.Close;
            'Erase'   : Ignored := B.Erase;
            'Rename'  : Ignored := B.Rename;
        end
        WriteLn ('Buffer ' + N);
    except
        // not this one
    end

    try
        var Ignored := 0;
        case N of
            'Length'  : Ignored := Probe.Length;
            'IsEmpty' : Ignored := Probe.IsEmpty;
            'Text'    : Ignored := Probe.Text;
            'Address' : Ignored := Probe.Address;
            'Append'  : Ignored := Probe.Append;
            'PutInt'  : Ignored := Probe.PutInt;
            'GetInt'  : Ignored := Probe.GetInt;
            'Resize'  : Ignored := Probe.Resize;
            'Free'    : Ignored := Probe.Free;
            'Eof'     : Ignored := Probe.Eof;
            'Assign'  : Ignored := Probe.Assign;
            'Reset'   : Ignored := Probe.Reset;
            'Rewrite' : Ignored := Probe.Rewrite;
            'ReadLn'  : Ignored := Probe.ReadLn;
            'Write'   : Ignored := Probe.Write;
            'WriteLn' : Ignored := Probe.WriteLn;
            'Flush'   : Ignored := Probe.Flush;
            'Close'   : Ignored := Probe.Close;
            'Erase'   : Ignored := Probe.Erase;
            'Rename'  : Ignored := Probe.Rename;
        end
        WriteLn ('TextFile ' + N);
    except
        // not this one
    end
end

Probe.Close ();
Probe.Erase ();
