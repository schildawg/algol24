// spec: LEX-026
//
// A probe, not a conformance test. It records what the implementation
// DOES; nothing here asserts what it should do.

WriteLn('a' = 'a');
WriteLn(Copy('abc', 0, 1) = 'a');

// Differing text still fails, which is the only reason it can [VAL-010].
WriteLn(Copy('abc', 0, 2) = 'a');
