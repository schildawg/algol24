// spec: DCL-015
//
// A probe, not a conformance test. It records what the implementation
// DOES; nothing here asserts what it should do.

class Counter;
private:
    var Count : Integer := 5;
public:
    var Name : String := 'c';
begin
    function Peek() : Integer;
    begin
        Exit Count;
    end
private:
    procedure Hidden();
    begin
    end
end

// Through a typed receiver the check fires; through Any it does not.
var Loose : Any := Counter();
WriteLn(Loose.Count);
