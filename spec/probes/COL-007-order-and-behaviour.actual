-- insertion order --
  List : 3 1 2 
  Set  : 3 1 2 
  Map  : 3 1 2 
-- reassigning a Map key keeps its place --
  after: 3 1 2 
-- Set deduplicates --
  Set([1,1,2]).Length = 2
  after Add(2)        = 2
-- Remove returns different things --
  Map.Remove(1)  : one
  Set.Remove(1)  : true
  Set.Remove(9)  : false
-- Sort --
  numbers: 1 2 3 
-- Keys and Values --
  Keys  : 1 2 
  Values: a b 
exit: 0
