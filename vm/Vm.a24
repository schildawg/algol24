/// The virtual machine: a stack, a dispatch table, and the loop between them.
///
/// The state is at MODULE level and the handlers are plain subprograms rather
/// than a class and its methods, which is a performance decision and not a
/// style one.  A table of subprograms indexed by opcode is O(1) in the
/// instruction set where a `case` is not -- there is no CaseStmt node, so each
/// arm becomes an IfStmt and an opcode pays for every arm above it.  Measured
/// at 2.4x between the first position and the thirty-first, which is the whole
/// of why `Dispatch` exists.  See PROPOSAL-VM.md.
///
/// One consequence is that there is one machine per process, as there is in
/// clox.  Nothing needs two yet.
unit Vm;

uses OpCode;
uses Chunk;
uses VmFunction;
uses VmClass;
uses VmEnum;
uses VmCell;



/// Every method name the machine can invoke on a host value, lowercased.
///
/// Read only to tell a method named without parentheses -- which is a value
/// this machine cannot make -- from a member that genuinely does not exist.
var HOST_METHODS := ['pop', 'peek', 'keys', 'values', 'tolist', 'tostring',
                     'readln', 'sort', 'clear', 'free', 'reset', 'rewrite',
                     'flush', 'close', 'erase', 'append', 'get', 'contains',
                     'indexof', 'getint', 'getword', 'getdouble', 'add',
                     'push', 'remove', 'removeat', 'fill', 'resize', 'assign',
                     'rename', 'write', 'writeln', 'put', 'set', 'insert',
                     'putint', 'putword', 'putdouble'];

/// Whether a host receiver has a member of a name, which depends on its KIND.
///
/// ⚠️ HOST_METHODS above is every name across every kind, which is right for
/// dispatching a call -- the host raises for a kind that lacks one -- and wrong
/// for reading a member as a VALUE: `L.Push` on a List answered `<fn Push>`
/// where it has to answer `Undefined property 'Push'.` [0144, 0175].
///
/// Mirrors the runtime's own tables, because that is where the answer lives and
/// the interpreter reaches it by PROBING -- `try Obj.Get (Name)` -- which the
/// machine cannot do: a dynamic member name is unreachable from Algol-24. The
/// fifth place that shape appears, after `is`, the properties, the built-ins
/// and method invocation.
function HostHasMember (Self : Any, Named : Any) : Boolean;
begin
    if Self is Integer or Self is Double then Exit Named = 'tostring';

    // Contains is shared by every sequence and by a Map.
    if Named = 'contains' then
        Exit Self is List or Self is Set or Self is Stack
          or Self is Array or Self is Map;

    if Self is List then
        Exit Named = 'get'      or Named = 'add'  or Named = 'insert'
          or Named = 'removeat' or Named = 'indexof'
          or Named = 'sort'     or Named = 'clear';

    if Self is Array then
        Exit Named = 'get' or Named = 'set' or Named = 'fill'
          or Named = 'indexof' or Named = 'sort';

    if Self is Map then
        Exit Named = 'get'  or Named = 'put'    or Named = 'remove'
          or Named = 'keys' or Named = 'values' or Named = 'clear';

    if Self is Set then
        Exit Named = 'add' or Named = 'remove' or Named = 'tolist'
          or Named = 'clear';

    if Self is Stack then
        Exit Named = 'push' or Named = 'pop' or Named = 'peek'
          or Named = 'clear';

    if Self is Buffer then
        Exit Named = 'append'    or Named = 'putint'    or Named = 'getint'
          or Named = 'putword'   or Named = 'getword'
          or Named = 'putdouble' or Named = 'getdouble'
          or Named = 'resize'    or Named = 'free';

    if Self is TextFile then
        Exit Named = 'assign' or Named = 'reset'  or Named = 'rewrite'
          or Named = 'append' or Named = 'readln' or Named = 'write'
          or Named = 'writeln' or Named = 'flush' or Named = 'close'
          or Named = 'erase'  or Named = 'rename';

    Exit False;
end

/// Each declared subrange's low bound, keyed by folded name.
///
/// Registered by OP_SUBRANGE before anything runs.  The compiler's own table is
/// not reachable from here -- the machine may import nothing from compiler/ --
/// so the bounds arrive as instructions, which is also what keeps a chunk
/// self-describing for a serialised one later.
var SUBRANGE_LOW := Map ();

/// Each declared subrange's high bound, keyed by folded name.
var SUBRANGE_HIGH := Map ();

/// Whether a value falls within a declared subrange.
///
/// Only an INTEGER is ever within one: a subrange constrains an Integer, so a
/// Double and a Char are outside every subrange rather than compared against
/// its bounds [0153].
function WithinSubrange (V : Any, Named : Any) : Boolean;
begin
    if not SUBRANGE_LOW.Contains (Str (Named)) then Exit False;
    if not (V is Integer) then Exit False;

    Exit (V as Integer) >= (SUBRANGE_LOW.Get (Str (Named)) as Integer)
     and (V as Integer) <= (SUBRANGE_HIGH.Get (Str (Named)) as Integer);
end

/// A single quote, as a String, for a diagnostic that opens with one.
///
/// A literal cannot be used where the message STARTS with a quote and is then
/// concatenated: `''' + X` opens a string, reads the next two quotes as an
/// escaped one, and swallows the ` + X + ` as content -- after which ` is `
/// parses as the `is` OPERATOR and the compiler reports 'Expect type name
/// after is' from the middle of a string.  A trailing quote is fine, because
/// the text before it separates the open from the escape.
var QUOTE := Str ('''');

/// How many values a byte can take, which is how wide the dispatch table is.
const BYTE_VALUES := 256;

/// How deep the call stack may go.
///
/// A THOUSAND, chosen rather than inherited. Sixty-four is clox's number and
/// was this machine's for a long time, which made it the most restrictive of
/// the three processors by more than an order of magnitude: the interpreter
/// manages about 800 frames before the C stack gives way and the compiled back
/// end more than 50,000, where this stopped at 63. Recursive descent is an
/// ordinary thing to write -- this compiler's own parser is one -- so the
/// first program to meet that limit would read it as a bug in itself.
///
/// Measured: no runtime cost at all (Fib (27) is 1.23 s either way, the depth
/// being a bound and not a loop) and about 7.7 MB more resident, which is the
/// value stack derived below. Raised on that measurement rather than on a
/// program demanding it, because the program that would demand it cannot yet
/// run far enough to ask.
///
/// Fixed, and overflow raises rather than growing: runaway recursion is a bug
/// in the program being run, and a machine that grows to hold it reports the
/// problem as a memory exhaustion somewhere else entirely. Both other
/// processors SEGFAULT at their own limit with no diagnostic, so the
/// diagnostic is this machine's advantage and worth keeping.
const FRAME_ROOM := 1024;

/// How deep the value stack is: enough for every frame to fill its slots.
///
/// Derived from FRAME_ROOM rather than chosen, which is how clox sizes it and
/// for a reason worth keeping.  With the two equal, a runaway recursion
/// overflowed the VALUE stack first and reported it -- a true statement about
/// the wrong thing, because the program's fault was its depth.
///
/// ⚠️ The multiplier was once a GUARANTEE and is now only a margin. It held
/// while a local slot was one byte, so 256 was every frame's ceiling; local
/// slots widened to a short, so a frame may hold more and a program of very
/// many locals can still reach the value stack first.
///
/// Fixed, and overflow raises rather than growing: a runaway stack is a bug in
/// the program being run, and a machine that grows to hold it reports the
/// problem as a memory exhaustion somewhere else entirely.
const STACK_ROOM := FRAME_ROOM * 256;

/// The values being operated on.
///
/// Named Slots and not Stack, which is not taste: `Stack` is a BUILT-IN, and a
/// module-level variable of that name shadowed it inside DoBuiltin -- so a
/// guest program calling `Stack ()` reached this Array and failed with 'Can
/// only call functions and classes'.  The same hazard as a top-level name
/// shadowing another unit's method, with a built-in on the other side.
///
/// Guest numbers are held as Algol-24 Integers and Doubles, which allocates
/// NOTHING -- measured at zero arena bytes across twelve million instructions.
/// That is only true while the guest's values are numbers: a guest string or
/// collection would be an Algol-24 object in the host's arena, which never
/// frees, so those want the Buffer heap PROPOSAL-GC.md describes rather than
/// this stack.  The boundary is the thing to hold on to as opcodes are added.
var Slots := Array (STACK_ROOM);

/// How many values are on the stack.
///
/// Read by a test after a run to check the stack is where the emitter meant to
/// leave it.  That is worth checking rather than assuming: a loop that lands
/// two bytes early still computes the right answer when the answer is read
/// from a LOCAL SLOT, and leaks a value per iteration while doing it.  Asking
/// only for the answer passed twenty-five tests over exactly that bug.
var SP : Integer := 0;

/// Where the next instruction will be read from.
var IP : Integer := 0;

/// The chunk being run, which is the current frame's.
var Running : Chunk := Nil;

/// How deep the handler stack is.
var TryDepth : Integer := 0;

/// How many protected regions may nest.
const TRY_ROOM := 128;

/// Where each protected region's handlers begin, indexed by depth.
var TryIP : Array := Array (TRY_ROOM);

/// The chunk each region's handlers live in.
var TryOf : Array := Array (TRY_ROOM);

/// The call depth each region was opened at.
///
/// Recorded so a raise from several frames down can discard them: unwinding is
/// what makes a handler several calls above the raise still run.
var TryFrame : Array := Array (TRY_ROOM);

/// The cells each frame captured, indexed by depth.
var FrameCells : Array := Array (FRAME_ROOM);

/// The frame base each region was opened at.
var TryBase : Array := Array (TRY_ROOM);

/// The value-stack depth each region was opened at.
///
/// Whatever the protected region pushed is discarded on the way out, so the
/// handler starts from the stack the `try` started from -- which is what keeps
/// a raise out of a half-evaluated expression from leaving rubbish behind.
var TrySP : Array := Array (TRY_ROOM);

/// How deep the call stack is.  Zero means the outermost chunk is running.
var FrameDepth : Integer := 0;

/// The frame depth at which a return STOPS the loop rather than resuming its
/// caller.
///
/// Zero for a program: the script is frame 0, and its return ends the run.  A
/// NESTED call sets it to the depth the callee will run at, which is what lets
/// a handler enter the loop for one frame and get a value back -- the mechanism
/// every class protocol needs, because `ToString`, `Elements`, `Compare` and an
/// operator method are all a host operation asking an instance for a member and
/// waiting for the answer.
var StopDepth : Integer := 0;

/// The callable each frame is running, indexed by depth.
var FrameOf : Array := Array (FRAME_ROOM);

/// Where each frame resumes when the one above it returns.
var FrameResume : Array := Array (FRAME_ROOM);

/// The stack index each frame's locals start at, indexed by depth.
///
/// Slot 0 of a frame is Slots[Base], so OP_GET_LOCAL adds this -- which is the
/// whole of what a frame costs the hot path: one addition.
var FrameBase : Array := Array (FRAME_ROOM);

/// The cells the running frame captured, or an empty List.
///
/// Held out of FrameCells for the reason CodeBytes is held out of the chunk: a
/// subscript on every captured read is what a method call cost, and cost 3x.
var Cells : List := List ();

/// Where the running frame's locals start.
///
/// Held out of FrameBase for the same reason CodeBytes is held out of the
/// chunk: a subscript on every local access is what a method call cost, and
/// cost 3x.
var Base : Integer := 0;

/// The chunk's code, lifted out of it for the duration of the run.
///
/// Read directly rather than through `Running.At (IP)`, and the difference is
/// not small: a method call on an instance dispatches through the runtime by
/// the method's NAME, once per instruction, which measured 5.2 M instr/s
/// against 20 M for the same loop reading a module-level Buffer.  The chunk is
/// not modified while it runs, so lifting its parts out is safe for exactly as
/// long as that stays true.
var CodeBytes : Buffer := Nil;

/// The chunk's constant table, lifted out for the same reason as CodeBytes.
var Constants : List := Nil;

/// The arguments the running PROGRAM sees, element 0 being its own name.
///
/// Held here because ParamCount and ParamStr are the one family of built-ins
/// that cannot be forwarded to the host: the host's answer is about the
/// process, which is the DRIVER, not about the program the machine is running.
/// The interpreter has the same split -- it reads its own ProgramArguments and
/// the host's built-in never sees them -- and this is that, for a third
/// processor.
var Arguments : List := List ();

/// Tells the machine what the program's arguments are.
procedure SetArguments (Given : List);
begin
    Arguments := Given;
end

/// The name of each global slot, taken from the OUTERMOST chunk.
///
/// Held here rather than read from the running frame's chunk, because a global
/// slot means the same thing program-wide and only the script's table numbers
/// them.  Read on the cold path only, to name an undefined variable.
var GlobalNames : List := Nil;

/// The module-level variables, one slot each.
///
/// A flat Array indexed by slot rather than clox's hash table keyed by name.
/// The Resolver already binds every variable before emission, so a name can be
/// resolved to an index once instead of hashed on every access -- which is the
/// whole point of doing it this way.
var GlobalCells : Array := Nil;

/// Whether each global's declaration has run yet.
///
/// Parallel to GlobalCells, and the same thing the emitted C calls `d_name`: a
/// declaration is what defines a global, so `var X;` with no initializer
/// defines it as nil while a subprogram reaching a global from ABOVE its
/// declaration finds it undefined.  The name for that diagnostic comes from
/// the chunk's GlobalNames, which is the only thing that reads them.
var WasDefined : Array := Nil;

/// Whether the loop should keep going.
var Live : Boolean := False;

/// What OP_RETURN left behind, which is what RunChunk answers.
var Answer : Any := Nil;

/// Pushes a value.
///
/// # Raises
///
/// 'The value stack overflowed.' past STACK_ROOM.
procedure Push (V : Any);
begin
    if SP >= STACK_ROOM then raise 'The value stack overflowed.';

    Slots[SP] := V;
    SP := SP + 1;
end

/// Pops a value.
///
/// # Raises
///
/// 'The value stack underflowed.' when nothing is on it, which means the
/// bytecode is wrong rather than the program being run.
function Pop () : Any;
begin
    if SP <= 0 then raise 'The value stack underflowed.';

    SP := SP - 1;

    Exit Slots[SP];
end

/// Reads the byte at IP and advances past it.
function ReadByte () : Integer;
var
    B : Integer;

begin
    B := CodeBytes[IP] as Integer;
    IP := IP + 1;

    Exit B;
end

/// Reads the two-byte operand at IP and advances past it.
///
/// High byte first, which is the order PatchJump and EmitLoop write.
function ReadShort () : Integer;
var
    High : Integer;

begin
    High := ReadByte ();

    Exit High * 256 + ReadByte ();
end

/// Whether the instruction running was prefixed with OP_LONG.
///
/// Cleared by the first index read rather than at the end of the instruction,
/// so a handler reading one index cannot leave it set for the next -- and an
/// opcode whose index comes AFTER another operand, as OP_OVERLOADS's does, is
/// served by the same rule without the flag knowing where it sits.
/// How many instructions between collections.  Zero is off, and is the
/// DEFAULT, because automatic collection is not safe yet.
///
/// ⚠️ It is safe across all 161 corpus programs the machine runs and it is not
/// safe on the Dew Drop Inn, which fails as `Only instances have properties.`
/// or blocks outright depending on what gets released.  So the root set has a
/// gap that 161 programs do not reach and the Inn does -- most likely a value
/// held only in a C local across a safe point, somewhere the corpus never
/// goes.  Until that is found, `--collect N` turns it on for experiment and
/// nothing turns it on by default.
///
/// An explicit `Collect ()` is unaffected and does work: it is the AUTOMATIC
/// trigger that is withheld, not the collector.
var COLLECT_EVERY := 0;

/// Instructions since the last collection.
var Tick : Integer := 0;

/// Sets how many instructions pass between collections, or 0 for none.
///
/// A policy the driver may set, because the right number is a measurement:
/// marking costs O(live heap), so a program holding a lot pays more per
/// collection and wants fewer of them.
procedure SetCollectEvery (N : Integer);
begin
    COLLECT_EVERY := N;
end

var Wide : Boolean := False;


/// Reads a constant index, two bytes where OP_LONG said so.
///
/// Every read of the constants goes through this, which is what makes the
/// prefix one change rather than nineteen.
function ReadIndex () : Integer;
begin
    if not Wide then Exit ReadByte ();

    Wide := False;

    Exit ReadShort ();
end

/// Reads a LOCAL slot, two bytes where OP_LONG said so.
///
/// The same rule an index follows and the same flag, because no opcode carries
/// both -- a subprogram past 256 locals is shroom-slots' RunMachine, nearly
/// 3,900 lines of frame loop, and the slot it wants cannot fit in a byte.
function ReadSlot () : Integer;
begin
    if not Wide then Exit ReadByte ();

    Wide := False;

    Exit ReadShort ();
end

/// Runs the next instruction with its constant index widened.
///
/// The flag is cleared again afterwards as well, so an opcode the emitter
/// prefixed by mistake cannot corrupt the instruction after it -- it would
/// read its own operands narrow and be wrong in one place rather than two.
procedure DoWide ();
begin
    Wide := True;

    Dispatch[ReadByte ()] ();

    Wide := False;
end

/// Answers the value Distance from the top without popping it.
///
/// Named PeekAt rather than Peek, and not for taste: `Parser` has a METHOD
/// called Peek that answers a Token and calls it bare ten times, and a
/// top-level Peek declared in another unit of the same program shadows it.
/// The program then fails to type-check with 'Expected Token, found Any'
/// pointing at a line number in the merged source map -- nowhere near either
/// declaration.  One name may not be declared at the top level of two files of
/// one program, and a method is not the protection it looks like.
function PeekAt (Distance : Integer) : Any;
begin
    Exit Slots[SP - 1 - Distance];
end

/// Pushes the constant its operand names.
procedure DoConstant ();
begin
    Push (Constants[ReadIndex ()]);
end

/// Adds the top two values.
///
/// The operands come off in reverse, so the second popped is the left-hand
/// side -- which matters for every operator that is not commutative.
/// Whether a value answers an operator of a symbol at a given arity.
///
/// An operator is a method NAMED BY ITS SYMBOL [EXP-020], so the protocol test
/// is the ordinary one -- and the arity is what tells unary minus from binary
/// subtraction, exactly as it tells the two subscripts apart.
function AnswersOperator (V : Any, Symbol : Any, Count : Integer) : Boolean;
begin
    if not (V is VmInstance) then Exit False;

    Exit DeclaresShape (V.Klass, Symbol, Count);
end

procedure DoAdd ();
var
    Right : Any;

begin
    Right := Pop ();

    var Left := Pop ();

    if AnswersOperator (Left, '+', 1) then
    begin
        Push (CallNested (Left, '+', [Right]));

        Exit;
    end

    Push (Left + Right);
end

/// Subtracts the top value from the one beneath it.
procedure DoSubtract ();
var
    Right : Any;

begin
    Right := Pop ();

    var Left := Pop ();

    if AnswersOperator (Left, '-', 1) then
    begin
        Push (CallNested (Left, '-', [Right]));

        Exit;
    end

    Push (Left - Right);
end

/// Multiplies the top two values.
procedure DoMultiply ();
var
    Right : Any;

begin
    Right := Pop ();

    var Left := Pop ();

    if AnswersOperator (Left, '*', 1) then
    begin
        Push (CallNested (Left, '*', [Right]));

        Exit;
    end

    Push (Left * Right);
end

/// Divides the value beneath the top by the top, answering a Double.
procedure DoDivide ();
var
    Right : Any;

begin
    Right := Pop ();

    var Left := Pop ();

    if AnswersOperator (Left, '/', 1) then
    begin
        Push (CallNested (Left, '/', [Right]));

        Exit;
    end

    Push (Left / Right);
end

/// Negates the value on top.
procedure DoNegate ();
begin
    var V := Pop ();

    // Arity ZERO is what makes this unary minus rather than subtraction.
    if AnswersOperator (V, '-', 0) then
    begin
        Push (CallNested (V, '-', List ()));

        Exit;
    end

    Push (-V);
end

/// Calls a member on a receiver and answers what it returns, from inside a
/// handler.
///
/// The machine's registers are module-level, so a nested run has to put every
/// one of them back: a handler is itself running inside the dispatch loop, and
/// re-entering it would otherwise leave the outer program resuming at the
/// callee's instruction pointer.
///
/// The arguments are given rather than taken from the stack, because the
/// caller here is a HANDLER -- the host operation that needed the member -- and
/// what it holds is values, not stack positions.
function CallNested (Receiver : Any, Name : Any, Args : List) : Any;
var
    WasRunning : Any;
    WasCells   : Any;

begin
    WasRunning   := Running;
    var WasCode  := CodeBytes;
    var WasConst := Constants;
    var WasIP    := IP;
    var WasSP    := SP;
    var WasBase  := Base;
    WasCells     := Cells;
    var WasDepth := FrameDepth;
    var WasStop  := StopDepth;
    var WasAnswer := Answer;
    var WasLive  := Live;

    // The callee will run one frame above this one, and its return is the
    // floor that ends the nested loop.
    StopDepth := FrameDepth + 1;

    Push (Receiver);
    for var Each in Args do Push (Each);

    InvokeMember (Name, Args.Length, List ());

    var Got := RunLoop ();

    Running    := WasRunning as Chunk;
    CodeBytes  := WasCode;
    Constants  := WasConst;
    IP         := WasIP;
    SP         := WasSP;
    Base       := WasBase;
    Cells      := WasCells as List;
    FrameDepth := WasDepth;
    StopDepth  := WasStop;
    Answer     := WasAnswer;
    Live       := WasLive;

    Exit Got;
end

/// How an instance reads when written or converted to text.
///
/// '<ClassName> instance', which is the interpreter's rendering -- the host
/// would answer the name of the MACHINE's own class, 'VmInstance instance'.
///
/// # Raises
///
/// A refusal when the class declares ToString.  The interpreter calls it and
/// uses what it answers, which means pushing a frame from inside a handler
/// that has to answer a value -- and a handler cannot wait for a frame to
/// return.  Refused by name rather than rendered wrongly.
function Rendered (V : Any) : Any;
begin
    // A member renders as its BARE NAME [ENU-007], not as the host's idea of
    // what one of the machine's objects looks like.
    if V is VmEnum then Exit V.Name;

    // A bound member renders '<fn Name>' in the spelling it was written in.
    if V is VmBound then Exit V.ToString ();

    // A class may say how it reads [CLS-006], and what it answers is used
    // as-is -- which needs a frame entered from inside this function, and that
    // is what CallNested is for.
    //
    // ⚠️ A PROTOCOL IS A NAME AND A SHAPE.  `ToString (N : Integer)` does not
    // implement this one, so the default rendering stands rather than the call
    // failing selection -- which is why the test is ChosenMethod at arity
    // ZERO and not FindMethod [0165].
    if DeclaresShape (V.Klass, 'tostring', 0) then
        Exit CallNested (V, 'ToString', List ());

    Exit Str (V.Klass.Name) + ' instance';
end

/// Writes the value on top, as WriteLn does.
///
/// An instance is rendered the interpreter's way rather than the host's, for
/// the reason the 'str' arm of DoBuiltin gives.
procedure DoPrint ();
var
    V : Any;

begin
    V := Pop ();

    // SWALLOWED during a test run, which is what 0103 is named for: a test
    // body's own output would interleave with the report and the report is
    // compared line for line.  The report itself is printed by the DRIVER and
    // never passes through here, so suppressing everything the machine prints
    // is exactly the right reach.
    if TESTING then Exit;

    if V is VmInstance or (V is VmEnum) then WriteLn (Rendered (V));
    else WriteLn (V);
end

/// Pushes nil.
procedure DoNil ();
begin
    Push (Nil);
end

/// Pushes True.
procedure DoTrue ();
begin
    Push (True);
end

/// Pushes False.
procedure DoFalse ();
begin
    Push (False);
end

/// Discards the value on top.
procedure DoPop ();
begin
    Pop ();
end

/// Pushes a local from its slot.
procedure DoGetLocal ();
begin
    Push (Slots[Base + ReadSlot ()]);
end

/// Stores the top into a local's slot, leaving it on the stack.
procedure DoSetLocal ();
begin
    Slots[Base + ReadSlot ()] := PeekAt (0);
end

/// Pushes a global from its slot.
///
/// # Raises
///
/// Undefined variable, naming it -- which is the one place a slot has to be
/// turned back into a name, and the only reason GlobalNames exists.
procedure DoGetGlobal ();
begin
    GetGlobalAt (ReadByte ());
end

/// Pushes a global from a wide slot.
///
/// The operand is the only difference: one byte caps a program at 256 globals,
/// and a real one needs thousands, so the emitter reaches for this form where
/// the slot will not fit.  Both end in the same subprogram, which is what
/// keeps the two from drifting about what a read means.
procedure DoGetGlobalLong ();
begin
    GetGlobalAt (ReadShort ());
end

/// Pushes the global in a slot, whichever operand named it.
///
/// # Raises
///
/// Undefined variable, naming it -- which is the one place a slot has to be
/// turned back into a name, and the only reason GlobalNames exists.
procedure GetGlobalAt (Slot : Integer);
begin
    if not WasDefined[Slot] then
        raise 'Undefined variable ' + QUOTE + Str (GlobalNames[Slot]) + QUOTE + '.';

    Push (GlobalCells[Slot]);
end

/// Pops a value and defines a global with it.
procedure DoDefineGlobal ();
begin
    DefineGlobalAt (ReadByte ());
end

/// Pops a value and defines a global at a wide slot.
procedure DoDefineGlobalLong ();
begin
    DefineGlobalAt (ReadShort ());
end

/// Pops a value and binds the global in a slot to it.
procedure DefineGlobalAt (Slot : Integer);
begin
    GlobalCells[Slot] := Pop ();
    WasDefined[Slot] := True;
end

/// Stores the top into a global's slot, leaving it on the stack.
procedure DoSetGlobal ();
begin
    SetGlobalAt (ReadByte ());
end

/// Stores the top into a wide global slot, leaving it on the stack.
procedure DoSetGlobalLong ();
begin
    SetGlobalAt (ReadShort ());
end

/// Stores the top into the global in a slot, leaving it on the stack.
///
/// # Raises
///
/// Undefined variable, for a write above the declaration.
procedure SetGlobalAt (Slot : Integer);
begin
    // Writing does NOT bind a global [0044]: a variable is bound by its
    // DECLARATION, so an assignment above one is the same error a read gets.
    // Defining it here instead made the write silently succeed.
    if not WasDefined[Slot] then
        raise 'Undefined variable ' + QUOTE + Str (GlobalNames[Slot]) + QUOTE + '.';

    GlobalCells[Slot] := PeekAt (0);
end

/// Pushes whether the top two values are equal.
procedure DoEqual ();
var
    Right : Any;

begin
    Right := Pop ();
    Push (Pop () = Right);
end

/// Whether a class declares a member of a name taking a given count, up the
/// parent chain.
///
/// ⚠️ This is the SHAPE half of a protocol, and ChosenMethod cannot answer it.
/// Selection reads the arguments WHERE THEY SIT -- `Fits` indexes the stack --
/// so asking it before the arguments are pushed inspected whatever happened to
/// be there and answered differently from one call to the next.  At arity zero
/// it reads nothing and looked correct, which is how `ToString` and `Elements`
/// passed while `Compare` at arity one did not.
function DeclaresShape (Klass : Any, Wanted : Any, Count : Integer) : Boolean;
var
    Where : Any;

begin
    Where := Klass;

    while Where <> Nil do
    begin
        var Candidates := Where.CandidatesFor (Wanted);

        if Candidates <> Nil then
            for var TheCandidate in Candidates as List do
                if CalleeSignature (TheCandidate).Arity = Count then Exit True;

        Where := Where.Parent;
    end

    Exit False;
end

/// Whether a value orders itself, which is a Compare taking one argument.
///
/// Arity ONE, because a protocol is a name and a shape: `Compare ()` does not
/// implement ordering any more than `Elements (N)` implements iteration, and
/// such a class is left to the host's operators and their refusal [0165, 0170].
function OrdersItself (V : Any) : Boolean;
begin
    if not (V is VmInstance) then Exit False;

    Exit DeclaresShape (V.Klass, 'compare', 1);
end

/// How one value orders against another, through the class's own Compare.
///
/// A Compare that answers anything but an Integer is a fault in the CLASS and
/// says so, rather than failing as a cast -- the message is the interpreter's
/// and 0170 compares it.
function OrderOf (Left : Any, Right : Any) : Integer;
begin
    var Said := CallNested (Left, 'Compare', [Right]);

    if not (Said is Integer) then raise 'Compare must answer an Integer.';

    Exit Said as Integer;
end

/// Pushes whether the lower of the top two is greater than the upper.
procedure DoGreater ();
var
    Right : Any;

begin
    Right := Pop ();

    var Left := Pop ();

    // A class may order itself [VAL-014], and what Compare answers is read as
    // a sign.  EQUALITY is untouched and stays identity [VAL-011]: `=` is
    // coupled to `in` by [VAL-013], so a second protocol would have to move
    // with it, which is why ordering is settled where equality is not.
    if OrdersItself (Left) then
    begin
        Push (OrderOf (Left, Right) > 0);

        Exit;
    end

    Push (Left > Right);
end

/// Pushes whether the lower of the top two is less than the upper.
procedure DoLess ();
var
    Right : Any;

begin
    Right := Pop ();

    var Left := Pop ();

    if OrdersItself (Left) then
    begin
        Push (OrderOf (Left, Right) < 0);

        Exit;
    end

    Push (Left < Right);
end

/// Divides the value beneath the top by the top, truncating toward zero.
///
/// # Raises
///
/// Whatever the host raises -- a Double operand and a zero divisor both,
/// unchanged, because the host's own `div` decides them.
procedure DoDiv ();
var
    Right : Any;

begin
    Right := Pop ();

    var Left := Pop ();

    if AnswersOperator (Left, 'div', 1) then
    begin
        Push (CallNested (Left, 'div', [Right]));

        Exit;
    end

    Push (Left div Right);
end

/// The remainder of the same division.
procedure DoMod ();
var
    Right : Any;

begin
    Right := Pop ();

    var Left := Pop ();

    if AnswersOperator (Left, 'mod', 1) then
    begin
        Push (CallNested (Left, 'mod', [Right]));

        Exit;
    end

    Push (Left mod Right);
end

/// Pops a value and a collection and pushes whether the collection has it.
///
/// The host's own `in` decides it, so a Map tests its KEYS and a String tests
/// for a substring without this knowing the difference.
procedure DoIn ();
var
    Over : Any;

begin
    Over := Pop ();
    Push (Pop () in Over);
end

/// Bitwise and of the top two Integers.
procedure DoBitAnd ();
var
    Right : Any;

begin
    Right := Pop ();

    var Left := Pop ();

    if AnswersOperator (Left, '&', 1) then
    begin
        Push (CallNested (Left, '&', [Right]));

        Exit;
    end

    Push (Left & Right);
end

/// Bitwise or of the top two Integers.
procedure DoBitOr ();
var
    Right : Any;

begin
    Right := Pop ();

    var Left := Pop ();

    if AnswersOperator (Left, '|', 1) then
    begin
        Push (CallNested (Left, '|', [Right]));

        Exit;
    end

    Push (Left | Right);
end

/// Bitwise exclusive or of the top two Integers.
procedure DoBitXor ();
var
    Right : Any;

begin
    Right := Pop ();

    var Left := Pop ();

    if AnswersOperator (Left, '^', 1) then
    begin
        Push (CallNested (Left, '^', [Right]));

        Exit;
    end

    Push (Left ^ Right);
end

/// Bitwise complement of the Integer on top.
procedure DoBitNot ();
begin
    var V := Pop ();

    if AnswersOperator (V, '~', 0) then
    begin
        Push (CallNested (V, '~', List ()));

        Exit;
    end

    Push (~V);
end

/// Shifts the value beneath the top left by the top.
procedure DoShiftLeft ();
var
    Right : Any;

begin
    Right := Pop ();

    var Left := Pop ();

    if AnswersOperator (Left, '<<', 1) then
    begin
        Push (CallNested (Left, '<<', [Right]));

        Exit;
    end

    Push (Left << Right);
end

/// Shifts the value beneath the top right by the top.
procedure DoShiftRight ();
var
    Right : Any;

begin
    Right := Pop ();

    var Left := Pop ();

    if AnswersOperator (Left, '>>', 1) then
    begin
        Push (CallNested (Left, '>>', [Right]));

        Exit;
    end

    Push (Left >> Right);
end

/// Replaces the top with whether it is of the type its operand names.
///
/// A chain over the five primitive type names, each arm using the host's own
/// `is` with the type written as a literal -- so the answer is the language's
/// answer and not an imitation of it.
///
/// It cannot be one comparison against a type NAME, because `TypeNameOf` lives
/// in `compiler/ObjFunction` and a chunk must be runnable without the
/// compiler.  And it cannot cover a subrange or a class, because the host's
/// `is` needs the type written at the call: `alg_is` takes a C string the
/// EMITTER wrote.  So the emitter refuses every other type name and this never
/// sees one it would answer wrongly.
///
/// # Raises
///
/// 'No test for type N.' if the emitter ever lets one through, which is a bug
/// in the emitter rather than in a program.
/// Whether a value is of the type a name denotes.
///
/// Shared by `is` and `as`, because [TYP-?] gives them one rule: a cast
/// succeeds exactly where the test answers true.
///
/// Answers false rather than raising for a name that is a declared class or
/// enumeration the value is not of -- `5 is Dog` is a fair question.
function TypeMatches (V : Any, Named : Any) : Boolean;
var
    Where : Any;

begin
    // nil HAS NO TYPE [0027], so `is` is false for it against everything --
    // Any included.  That is not the same rule as a CAST, which nil passes
    // [VAR-005]; DoCast short-circuits before asking.
    if V = Nil then Exit False;

    // A SUBRANGE is a RANGE TEST, which is the program asking explicitly --
    // what the language may not do is dispatch on a value silently [0153].
    if SUBRANGE_LOW.Contains (ToLower (Str (Named))) then
        Exit WithinSubrange (V, ToLower (Str (Named)));

    // An OBJECT answers for the class it is the one instance of [CLS-015], so
    // `Reg is Reg` is true -- which needs the instance, and asking builds it.
    if V is VmSingleton then Exit TypeMatches (Materialised (V), Named);

    // An INSTANCE answers for its own class and every class above it, so a
    // handler -- or a cast -- for a base class takes a derived value
    // [STM-017].
    if V is VmInstance then
    begin
        Where := V.Klass;

        while Where <> Nil do
        begin
            if ToLower (Str (Where.Name)) = Named then Exit True;

            Where := Where.Parent;
        end

        Exit False;
    end

    // A member answers for its own enumeration and no other [ENU-006].
    if V is VmEnum then Exit ToLower (Str (V.TypeName)) = Named;

    // `is Any` is FALSE, for everything [0035].  Any is the absence of a
    // written type rather than a type a value can be tested against -- which
    // is the opposite of a CAST, where `as Any` always passes.
    if Named = 'any' then Exit False;

    if Named = 'integer' then Exit V is Integer;
    if Named = 'double'  then Exit V is Double;
    if Named = 'string'  then Exit V is String;
    if Named = 'char'    then Exit V is Char;
    if Named = 'boolean' then Exit V is Boolean;

    // The collections, each written as a literal for the reason the rest are.
    if Named = 'list'     then Exit V is List;
    if Named = 'map'      then Exit V is Map;
    if Named = 'set'      then Exit V is Set;
    if Named = 'array'    then Exit V is Array;
    if Named = 'stack'    then Exit V is Stack;
    if Named = 'buffer'   then Exit V is Buffer;
    if Named = 'textfile' then Exit V is TextFile;

    // Pointer is only ever a value in a build with foreign calls [TYP-017],
    // but the TEST is answerable in every build -- the host says false for
    // anything that is not one, which is exactly what a program asking needs.
    if Named = 'pointer'  then Exit V is Pointer;

    // A name the emitter allowed that got this far is a declared CLASS or
    // ENUMERATION, and this value is neither one of those -- so the answer is
    // false rather than a refusal.  `5 is Dog` is a fair question with a
    // boring answer, and raising on it reported a gap that was not there.
    Exit False;
end

/// The name of a value's type, for a cast's refusal.
function NameOfType (V : Any) : Any;
begin
    if V is VmInstance then Exit V.Klass.Name;
    if V is VmEnum     then Exit V.TypeName;

    if V is List     then Exit 'List';
    if V is Map      then Exit 'Map';
    if V is Set      then Exit 'Set';
    if V is Array    then Exit 'Array';
    if V is Stack    then Exit 'Stack';
    if V is Buffer   then Exit 'Buffer';
    if V is TextFile then Exit 'TextFile';

    if V is Integer then Exit 'Integer';
    if V is Double  then Exit 'Double';
    if V is Char    then Exit 'Char';
    if V is String  then Exit 'String';
    if V is Boolean then Exit 'Boolean';

    // A Pointer exists only in a build with foreign calls [TYP-017], which is
    // why it was missed twice -- once in the `is` chain and again here.  The
    // fallback below is the trap: a runtime type this does not know answers
    // 'Any', which then satisfies NO declared type, so an omission here is a
    // selection that silently fails rather than a name that is refused.
    if V is Pointer then Exit 'Pointer';

    Exit 'Any';
end

/// Replaces the top with whether it is of the type its operand names.
procedure DoIs ();
var
    Named : Any;

begin
    Named := ToLower (Str (Constants[ReadIndex ()]));

    Push (TypeMatches (Pop (), Named));
end

/// Checks the value on top against a type and leaves it.
///
/// # Raises
///
/// 'Cannot cast A to B.' when the test fails, which is the interpreter's
/// wording.
procedure DoCast ();
var
    Written : Any;
    V       : Any;

begin
    Written := Constants[ReadIndex ()];
    V       := PeekAt (0);

    // nil satisfies every type [VAR-005], so it passes every cast rather than
    // being tested at all -- which is not the rule `is` uses, where nil has no
    // type and answers false.
    if V = Nil then Exit;

    // And `as Any` always passes, where `is Any` is always false: Any is the
    // absence of a written type, so casting to it asserts nothing.
    if ToLower (Str (Written)) = 'any' then Exit;

    if not TypeMatches (V, ToLower (Str (Written))) then
        raise 'Cannot cast ' + Str (NameOfType (V)) + ' to '
            + Str (Written) + '.';
end

/// Replaces the top with whether it was falsey.
///
/// The host's own `not` decides it, which is what makes the machine's
/// truthiness the language's truthiness rather than a second opinion about it.
procedure DoNot ();
begin
    Push (not Truthy (Pop ()));
end

/// Jumps forward by its operand.
///
/// The operand is read into a local FIRST, and that is not a style choice:
/// `IP := IP + ReadShort ()` reads IP before ReadShort advances it past the
/// two operand bytes, so the jump lands two bytes short -- on the operand of
/// whatever follows.  It fails as a plausible wrong answer rather than a
/// crash, which is the worst way for it to fail.
procedure DoJump ();
var
    Distance : Integer;

begin
    Distance := ReadShort ();

    IP := IP + Distance;
end

/// Jumps forward by its operand when the top is falsey, without popping it.
procedure DoJumpIfFalse ();
var
    Distance : Integer;

begin
    Distance := ReadShort ();

    if not Truthy (PeekAt (0)) then IP := IP + Distance;
end

/// Jumps backward by its operand.
///
/// The operand is read into a local first, for the reason DoJump gives.
procedure DoLoop ();
var
    Distance : Integer;

begin
    Distance := ReadShort ();

    IP := IP - Distance;
end

/// Whether a value is truthy, by the language's reading.
///
/// The host decides it for everything except an enumeration MEMBER, and that
/// exception is the whole reason this exists: a member whose ordinal is zero
/// is falsey, where the host sees an object and calls every object truthy.
/// `nil`, `False` and the Integer zero are falsey; `0.0`, the empty String and
/// any Char are truthy -- all of which the host already answers correctly.
function Truthy (V : Any) : Boolean;
begin
    if V is VmEnum then Exit V.Ordinal <> 0;

    if V then Exit True;

    Exit False;
end

/// Pushes a frame for a callable, whose receiver or callee is already on the
/// stack beneath its arguments.
///
/// Shared by a plain call, an instantiation and a method call, which differ
/// only in what they put beneath the arguments.
///
/// # Raises
///
/// Mismatch on the wrong argument count, supplied by the caller because a
/// METHOD reports a selection failure where a subprogram and a constructor
/// report the counts [0049], and 'The call stack overflowed.' past FRAME_ROOM.
procedure EnterFrame (Callee : Any, Count : Integer, Mismatch : String);
begin
    // Gathering happens HERE, so every way into a frame absorbs on the same
    // terms: a plain call, a method, a constructor and a selected overload.
    //
    // An exact or widening fit is preferred, which is why Fits is asked first
    // -- `Total ('a', [1, 2, 3])` passes the list rather than gathering it
    // into a second list holding it.  Comparing counts alone would not do it:
    // `Total ('a', 1)` has the right COUNT and the wrong type, and still has
    // to gather.
    if not Fits (Callee, Count, True) then
    begin
        if CanGather (Callee, Count) then Count := GatherRest (Callee, Count);

        // A VARIADIC callee that neither fits nor gathers reports a SELECTION
        // failure and not a count, because its element type replaced the arity
        // check and is stricter than it: `Total ('a', 1, 2, 'red')` has a
        // stray argument of the wrong TYPE rather than one too many.
        else if Str (CalleeSignature (Callee).Element) <> '' then
            raise 'No matching signature for function.';

        // And a FIXED-arity callee whose arguments do not fit at the right
        // count is a selection failure too: [EXP-013] puts even a lone
        // candidate through selection, so `G ('a string')` where G takes an
        // Integer answers 'No matching signature for function.' rather than
        // running with a String in an Integer's slot.
        //
        // ⚠️ Only at the RIGHT count, because a wrong count reports the counts
        // [0049] -- and a wrong count fails Fits as well, so raising here
        // without that guard would turn every arity error into a selection
        // failure.
        //
        // ⚠️ This fell through to the arity check before, and nothing caught
        // it: refusals/0042 compares the message and `vm/conform.sh` walked
        // only conformance/, so the refusal corpus had never run here at all.
        else if Count = Callee.Arity then
            raise 'No matching signature for function.';
    end

    if Count <> Callee.Arity then
        raise Mismatch;

    if FrameDepth >= FRAME_ROOM then raise 'The call stack overflowed.';

    // Where to come back to, and what to come back as.
    FrameOf[FrameDepth]     := Running;
    FrameResume[FrameDepth] := IP;
    FrameBase[FrameDepth]   := Base;
    FrameCells[FrameDepth]  := Cells;
    FrameDepth := FrameDepth + 1;

    // The arguments are already in place: they were pushed in order, so the
    // first one is slot 0 of the frame about to run.
    Base  := SP - Count;


    // A closure brings its captured cells; anything else captured none.
    if Callee is VmClosure then
    begin
        Cells   := Callee.Cells as List;
        Running := Callee.Body.Body as Chunk;
    end
    else
    begin
        Cells   := List ();
        Running := Callee.Body as Chunk;
    end

    CodeBytes := Running.Code;
    Constants := Running.Constants;
    IP        := 0;
end

/// Calls the value beneath its arguments.
///
/// # Raises
///
/// 'Can only call functions and classes.' for a callee that is not one, the arity
/// message for a mismatch, and 'The call stack overflowed.' past FRAME_ROOM.
procedure DoCall ();
begin
    var Count := ReadByte ();

    CallValue (PeekAt (Count), Count);
end

/// Calls a value whose arguments were written with names.
///
/// The arrangement happens BEFORE CallValue, and must: it decides the arity
/// that selection and gathering then see, which is how naming the absorbing
/// parameter turns absorption off [FUN-005].
procedure DoCallNamed ();
var
    Names : Any;
    Count : Integer;

begin
    Names := Constants[ReadIndex ()];
    Count := ReadByte ();

    var Callee := PeekAt (Count);

    ArrangeCall (Callee, Count, Names as List);

    CallValue (Callee, Count);
end

/// Invokes a member whose arguments were written with names.
///
/// ⚠️ ONE constant carries both: element 0 is the member's name and the rest
/// are the argument names.  Two constant indices would break the invariant
/// that at most one operand per opcode is widenable, which is what makes the
/// OP_LONG prefix sound.
procedure DoInvokeNamed ();
var
    Packed : Any;
    Count  : Integer;

begin
    Packed := Constants[ReadIndex ()];
    Count  := ReadByte ();

    var Written := (Packed as List)[0];

    var Names := List ();
    for var I : Integer := 1; I < (Packed as List).Length; I := I + 1 do
        Names.Add ((Packed as List)[I]);

    // The arrangement happens inside InvokeMember, where the receiver has
    // been read and the chain's candidates for the name are reachable -- which
    // member a named call means cannot be known any earlier.
    InvokeMember (Written, Count, Names);
end

/// Calls a value sitting under Count arguments.
///
/// Separate from DoCall so that OP_INVOKE_EXT reaches the same machinery: an
/// extension call is an ORDINARY call once the receiver is in front of the
/// arguments, and selecting an overload or reporting a wrong count must happen
/// the one way.
///
/// # Raises
///
/// 'Can only call functions and classes.' for a value that is not callable, and
/// whatever a wrong argument count reports for the kind of callee it is.
procedure CallValue (Callee : Any, Count : Integer);
begin
    // A bound extension is unpacked here rather than at OP_EXTEND, because
    // only the call knows how many arguments were written -- the receiver goes
    // in front of them [FUN-016], which is what makes the two spellings one
    // call.
    // A BOUND MEMBER puts its receiver where the callee sat and goes through
    // the one path that knows how to find a member on a value.  The receiver
    // is held rather than re-evaluated, for the reason VmExtension holds its:
    // it is evaluated once, when the member was read.
    if Callee is VmBound then
    begin
        Slots[SP - Count - 1] := Callee.Receiver;

        // A `super` binding names where to START, because the method wanted is
        // the parent's and the receiver's own class would find the override.
        if Callee.From <> Nil then
        begin
            var Found := ChosenMethod (Callee.From,
                                       ToLower (Str (Callee.Written)), Count);

            if Found = Nil then raise 'No matching signature for function.';

            EnterFrame (Found, Count, 'No matching signature for function.');

            Exit;
        end

        InvokeMember (Callee.Written, Count, List ());

        Exit;
    end

    if Callee is VmExtension then
    begin
        Prepend (Callee.Target, Callee.Receiver, Count);

        CallValue (Callee.Target, Count + 1);

        Exit;
    end

    // An EXTERNAL subprogram has no body to enter.  The call goes to the
    // host's own `Foreign` built-in [RT-001], with the four things the
    // declaration recorded -- which is the interpreter's own single line for
    // this, so the machine's foreign call IS the host's and the two cannot
    // disagree about what a symbol does or about the message a build without
    // libffi gives.
    if Callee is VmFunction then
        if Str (Callee.Symbol) <> '' then
        begin
            if Count <> Callee.Arity then
                raise 'Expected ' + Str (Callee.Arity) + ' arguments but got '
                    + Str (Count) + '.';

            // Read off the stack by INDEX and in order; popping would hand the
            // foreign call its arguments backwards.
            var Given := List ();

            for var I : Integer := 0; I < Count; I := I + 1 do
                Given.Add (Slots[SP - Count + I]);

            SP := SP - Count - 1;

            Push (Foreign (Callee.Symbol, Callee.Library,
                           Callee.Types, Callee.Returns, Given));

            Exit;
        end

    // A class is called to make an instance.  The class on the stack is
    // REPLACED by the instance, so the constructor finds it exactly where a
    // method finds its receiver -- one below the frame's base -- and every
    // field assignment in the constructor reaches the thing being made.
    if Callee is VmClass then
    begin
        Slots[SP - Count - 1] := VmInstance (Callee);

        // A CONSTRUCTOR may be overloaded like any other method, so which one
        // runs depends on the arguments.
        var Setup := ChosenMethod (Callee, 'init', Count);

        if Setup = Nil then Setup := Callee.FindMethod ('init');

        // A class with no constructor still answers an instance: there is
        // nothing to call, and the instance is already where the class was.
        if Setup = Nil then
        begin
            if Count <> 0 then
                raise 'Expected 0 arguments but got ' + Str (Count) + '.';

            Exit;
        end

        EnterFrame (Setup, Count, 'Expected ' + Str (Setup.Arity)
                                + ' arguments but got ' + Str (Count) + '.');

        Exit;
    end

    // An OVERLOAD SET selects now, on the values rather than on anything the
    // call site could have known [FUN-013].
    if Callee is VmOverloads then
    begin
        var Picked := Chosen (Callee, Count);

        if Picked = Nil then raise 'No matching signature for function.';

        EnterFrame (Picked, Count, 'No matching signature for function.');

        Exit;
    end

    if not (Callee is VmFunction) and not (Callee is VmClosure) then
        // The interpreter's wording exactly, which conformance/0070 compares.
        // That case is refused for ObjectStmt today, so a message of this
        // machine's own went unnoticed until the Dew Drop Inn raised it and
        // the two processors printed different text for one fault.
        raise 'Can only call functions and classes.';

    // A plain subprogram and a constructor report the COUNTS; only a METHOD
    // reports a selection failure.  0049-call-failures draws the line and all
    // five of its reports are compared, so the split is not a choice.
    EnterFrame (Callee, Count, 'Expected ' + Str (Callee.Arity)
                             + ' arguments but got ' + Str (Count) + '.');
end

/// Replaces the top two -- a collection and an index -- with the element.
///
/// # Raises
///
/// Whatever the host raises: out of range, a bad index type, a target that is
/// not subscriptable.  All of it unchanged, because the host decides it.
procedure DoSubscriptGet ();
var
    Index : Any;

begin
    Index := Pop ();

    var Target := Pop ();

    // A class may be subscriptable, which is `Get` taking one argument and
    // `Put` taking two [CLS-013] -- the two forms told apart by ARITY, as
    // everything else in the language is.
    if Target is VmInstance then
        if DeclaresShape (Target.Klass, 'get', 1) then
        begin
            Push (CallNested (Target, 'Get', [Index]));

            Exit;
        end

    Push (Target[Index]);
end

/// Stores a value at an index, leaving the value on the stack.
procedure DoSubscriptSet ();
var
    Target : Any;
    Index  : Any;
    Value  : Any;

begin
    Value  := Pop ();
    Index  := Pop ();
    Target := Pop ();

    if Target is VmInstance then
        if DeclaresShape (Target.Klass, 'put', 2) then
        begin
            CallNested (Target, 'Put', [Index, Value]);

            // The VALUE is what an assignment answers, not what Put did.
            Push (Value);

            Exit;
        end

    Target[Index] := Value;

    Push (Value);
end

/// Reads a member of a value: a field, a method, or a runtime property.
///
/// The order matters and is the language's.  An INSTANCE is asked for a field
/// first, then ClassName, then a method -- so a class that declares `Length`
/// shadows the runtime's property of that name, which is the asymmetry
/// 0033-no-computed-property is about.  Anything else gets the five
/// properties the runtime has.
///
/// A method reached WITHOUT parentheses is the method as a value, which wants
/// a bound-method object this machine does not have yet -- so it is refused by
/// name rather than answered wrongly.
///
/// # Raises
///
/// 'Undefined property ''N''.' for a member nothing answers, which is the
/// interpreter's wording.
function MemberOf (Self : Any, Written : Any) : Any;
var
    Named : Any;

begin
    Named := ToLower (Str (Written));

    // A qualified member, `Colour.RED`, which must reach the INTERNED object
    // so that it compares equal to the bare name [ENU-002].
    if Self is VmEnumType then
    begin
        var Member := Self.FindMember (Named);

        if Member = Nil then
            raise 'Undefined enum member ' + QUOTE + Str (Written) + QUOTE + '.';

        Exit Member;
    end

    // An OBJECT answers like the instance it stands for, and asking is what
    // builds it.
    if Self is VmSingleton then Exit MemberOf (Materialised (Self), Written);

    if Self is VmInstance then
    begin
        // ClassName answers AHEAD of a field of that name, because the name
        // belongs to the language and a field cannot take it [CLS-008].
        if Named = 'classname' then Exit Self.Klass.Name;

        // A PROPERTY answers on a read by being CALLED [CLS-012], which is the
        // one way a member read differs from reading a method as a value.
        if Self.Klass.HasProperty (Named) then
            Exit CallNested (Self, Written, List ());

        if Self.Fields.Contains (Named) then Exit Self.Fields.Get (Named);

        // A method read without parentheses is the method as a VALUE
        // [FUN-011], bound to the receiver it was read from.
        if Self.Klass.FindMethod (Named) <> Nil then Exit VmBound (Self, Str (Written));

        raise 'Undefined property ' + QUOTE + Str (Written) + QUOTE + '.';
    end

    // A member answers Ordinal, which is the position truthiness reads
    // [ENU-009] and the only way a program can see it.
    if Self is VmEnum then
    begin
        if Named = 'ordinal' then Exit Self.Ordinal;
        if Named = 'name'    then Exit Self.Name;

        raise 'Undefined property ' + QUOTE + Str (Written) + QUOTE + '.';
    end

    // A host method read without parentheses is the same answer: the member
    // is a value, and the written spelling is what it renders as.  Asked PER
    // KIND, because a name belonging to some other kind is not a member here.
    if HostHasMember (Self, Named) then Exit VmBound (Self, Str (Written));

    if Named = 'length'  then Exit Self.Length;
    if Named = 'text'    then Exit Self.Text;
    if Named = 'eof'     then Exit Self.Eof;
    if Named = 'isempty' then Exit Self.IsEmpty;
    if Named = 'address' then Exit Self.Address;

    raise 'Undefined property ' + QUOTE + Str (Written) + QUOTE + '.';
end

/// Replaces the top with one of its members.
procedure DoProperty ();
var
    Written : Any;

begin
    Written := Constants[ReadIndex ()];

    Push (MemberOf (Pop (), Written));
end

/// Builds a List from the values its operand counts.
///
/// Read off the stack by index rather than popped, so the elements go in in
/// SOURCE order -- popping would reverse them, and a reversed list literal is
/// the kind of wrong answer that reads as a parser bug.
procedure DoList ();
var
    Count : Integer;
    From  : Integer;
    Made  : List;

begin
    Count := ReadShort ();
    From  := SP - Count;
    Made  := List ();

    for var I : Integer := 0; I < Count; I := I + 1 do Made.Add (Slots[From + I]);

    SP := From;

    Push (Made);
end

/// Builds a Map from the key and value pairs its operand counts.
///
/// The pairs are on the stack as key, value, key, value in source order, which
/// is the order the emitter pushed them.
procedure DoMap ();
var
    Count : Integer;
    From  : Integer;
    Made  : Map;

begin
    Count := ReadShort ();
    From  := SP - Count * 2;
    Made  := Map ();

    for var I : Integer := 0; I < Count; I := I + 1 do
        Made.Put (Slots[From + I * 2], Slots[From + I * 2 + 1]);

    SP := From;

    Push (Made);
end

/// Calls a method on the value beneath its arguments.
///
/// Every arm calls the host's method with the name written as a LITERAL, which
/// is the only way to reach a member from here and is what makes the machine's
/// `Add` the host's `Add` rather than a second one.
///
/// Dispatched on the name AND the count, because one name means different
/// things at different arities -- `Append` with one argument is a Buffer's and
/// with none is a TextFile's -- which is how the runtime's own member tables
/// are keyed.
///
/// EVERY arm pushes the call's result, including the ones that look like
/// procedures.  A member call is an expression and a void one answers nil, so
/// discarding the result and pushing nil instead was wrong for the ones that
/// have something to say: `Remove` answers the value removed from a Map and a
/// Boolean from a Set [COL-011], and both came back nil.
///
/// # Raises
///
/// 'No method N taking C arguments.' for a pairing with no arm, which is a gap
/// in the machine rather than an error in a program.  Everything else is
/// whatever the host raises.
/// Whether a value has a member of this name.
///
/// Step 1 of [EXP-022], and the whole of what decides between a member and an
/// extension.  It mirrors the interpreter's own Responds rather than improving
/// on it: a String answers to Length and nothing else, a number to ToString,
/// an instance to its fields and methods and to ClassName.
///
/// A host object is asked by NAME against the machine's own tables, because a
/// dynamic member name cannot be reached from Algol-24 -- the interpreter can
/// try `Obj.Get (Name)` and catch, and this cannot.  HOST_METHODS is the same
/// list OP_INVOKE dispatches against, so the two cannot drift.
///
/// # Satisfies
///
/// [EXP-022]
function RespondsTo (Self : Any, Written : Any) : Boolean;
begin
    var Named := ToLower (Str (Written));

    if Self = Nil then Exit False;

    // A Char answers to nothing, which is what lets an extension take one.
    if Self is String then Exit Named = 'length';

    if Self is Integer or Self is Double then Exit Named = 'tostring';

    // An instance's own field map, which MemberOf consults too: an instance
    // begins with every declared field present and nil [CLS-006], so the map
    // IS the answer to whether the class declares one.
    if Self is VmInstance then
        Exit Named = 'classname'
          or Self.Fields.Contains (Named)
          or Self.Klass.FindMethod (Named) <> Nil;

    if Self is VmEnumType then Exit Self.FindMember (Named) <> Nil;

    if Self is VmEnum then Exit Named = 'ordinal' or Named = 'name';

    if Self is VmFunction or Self is VmClosure
            or Self is VmClass or Self is VmOverloads
            or Self is VmExtension then Exit False;

    // The runtime's five properties, then the host's methods.
    if Named = 'length' or Named = 'text' or Named = 'eof'
                        or Named = 'isempty' or Named = 'address' then Exit True;

    for var Known in HOST_METHODS do
        if Known = Named then Exit True;

    Exit False;
end

/// Reads a member, or binds a visible extension where there is no member.
///
/// The receiver is popped and one value replaces it either way, so this is an
/// ordinary expression however it answers.
procedure DoExtend ();
var
    Written : Any;
    Slot    : Integer;

begin
    Written := Constants[ReadIndex ()];
    Slot    := ReadShort ();

    var Self := Pop ();

    if RespondsTo (Self, Written) then
    begin
        Push (MemberOf (Self, Written));

        Exit;
    end

    if not WasDefined[Slot] then
        raise 'Undefined variable ' + QUOTE + Str (GlobalNames[Slot]) + QUOTE + '.';

    Push (VmExtension (Self, GlobalCells[Slot]));
end

/// Calls a member, or a visible extension where there is no member.
///
/// Where the extension answers, the receiver becomes its FIRST argument -- so
/// the written arguments shift up one and the callable takes the receiver's
/// place, after which it is an ordinary call [FUN-016].
procedure DoInvokeExt ();
var
    Written : Any;
    Count   : Integer;
    Slot    : Integer;

begin
    Written := Constants[ReadIndex ()];
    Count   := ReadByte ();
    Slot    := ReadShort ();

    // A MEMBER wins, and this is the only place that can know: the receiver's
    // value decides it, and the type system is gradual [EXP-022].
    if RespondsTo (PeekAt (Count), Written) then
    begin
        InvokeMember (Written, Count, List ());

        Exit;
    end

    if not WasDefined[Slot] then
        raise 'Undefined variable ' + QUOTE + Str (GlobalNames[Slot]) + QUOTE + '.';

    Prepend (GlobalCells[Slot], PeekAt (Count), Count);

    CallValue (GlobalCells[Slot], Count + 1);
end

/// Calls a member written with named arguments, or a visible extension.
///
/// The two halves of OP_INVOKE_EXT and the two halves of OP_INVOKE_NAMED at
/// once: the receiver's value decides whether there is a member [EXP-022], and
/// the names are arranged against whichever answers.
procedure DoInvokeExtNamed ();
var
    Packed  : Any;
    Count   : Integer;
    Slot    : Integer;
    Written : Any;

begin
    Packed := Constants[ReadIndex ()];
    Count  := ReadByte ();
    Slot   := ReadShort ();

    Written := (Packed as List)[0];

    var Names := List ();

    for var I : Integer := 1; I < (Packed as List).Length; I := I + 1 do
        Names.Add ((Packed as List)[I]);

    if RespondsTo (PeekAt (Count), Written) then
    begin
        InvokeMember (Written, Count, Names);

        Exit;
    end

    if not WasDefined[Slot] then
        raise 'Undefined variable ' + QUOTE + Str (GlobalNames[Slot]) + QUOTE + '.';

    Prepend (GlobalCells[Slot], PeekAt (Count), Count);

    // The RECEIVER became the first argument and is POSITIONAL whichever
    // spelling the call used [FUN-016], so the written names shift up one.
    var Shifted := List ();
    Shifted.Add ('');

    for var Each in Names do Shifted.Add (Each);

    ArrangeCall (GlobalCells[Slot], Count + 1, Shifted);

    CallValue (GlobalCells[Slot], Count + 1);
end

/// Puts a callable under Count arguments and a receiver between them.
///
/// The receiver is passed rather than read off the stack, because the two
/// callers hold it in different places: OP_INVOKE_EXT has it in the callee's
/// slot, and a bound extension carries it inside the value sitting there.
/// Taking it from the stack read the VmExtension itself as the receiver, and
/// the extension then asked a function for its Length.
///
/// Written downward because the ranges overlap: upward would copy the first
/// argument over all the rest.
procedure Prepend (Callable : Any, Self : Any, Count : Integer);
begin
    if SP >= STACK_ROOM then raise 'The value stack overflowed.';

    var Bottom := SP - Count - 1;

    for var I : Integer := SP - 1; I >= Bottom; I := I - 1 do
        Slots[I + 1] := Slots[I];

    Slots[Bottom]     := Callable;
    Slots[Bottom + 1] := Self;

    SP := SP + 1;
end

procedure DoInvoke ();
var
    Written : Any;
    Count   : Integer;

begin
    // Both spellings kept: the folded one dispatches and the written one goes
    // in the diagnostic.  Recovering it from IP afterwards indexed the
    // CONSTANTS by a code offset, which is a different array entirely.
    Written := Constants[ReadIndex ()];
    Count   := ReadByte ();

    InvokeMember (Written, Count, List ());
end

/// Calls a member of the receiver sitting under Count arguments.
///
/// Separate from DoInvoke so that OP_INVOKE_EXT can reach it: the extension
/// instruction has to do exactly what OP_INVOKE does when the receiver has a
/// member of the name [EXP-022], and a second copy of this chain would be two
/// answers to maintain rather than one.
///
/// # Raises
///
/// 'Undefined property N.' for a name that is no member at all, and
/// 'No method N taking C arguments.' for a pairing with no arm.
procedure InvokeMember (Written : Any, Count : Integer, Names : List);
var
    Name  : Any;
    Self  : Any;
    A     : Any;
    B     : Any;

begin
    Name := ToLower (Str (Written));

    // An INSTANCE first, and without popping anything: a method call wants its
    // receiver left beneath the arguments, exactly where a plain call keeps
    // its callee, so that OP_THIS finds it one below the frame's base.
    Self := PeekAt (Count);

    // An OBJECT answers like the instance it stands for, and the receiver on
    // the stack is REPLACED so that OP_THIS finds the instance and not the
    // wrapper.
    if Self is VmSingleton then
    begin
        Self := Materialised (Self);

        Slots[SP - Count - 1] := Self;
    end

    if Self is VmInstance then
    begin
        // Arranged BEFORE selection, because the arrangement decides the arity
        // that selection then sees.
        ArrangeMethod (Self.Klass, Name, Count, Names);

        var Found := ChosenMethod (Self.Klass, Name, Count);

        // Nothing fitting is two different reports.  A name no class in the
        // chain declares is `has no method`; a name that is declared and fits
        // nothing is a SELECTION failure -- which is also what a single method
        // called with the wrong count gives, where a subprogram and a
        // constructor report the counts instead [0049].
        if Found = Nil then
        begin
            if Self.Klass.FindMethod (Name) = Nil then
                raise Str (Self.Klass.Name) + ' has no method ' + Str (Name) + '.';

            raise 'No matching signature for function.';
        end

        EnterFrame (Found, Count, 'No matching signature for function.');

        Exit;
    end

    // Everything below is a HOST member -- a collection's, a Buffer's, a
    // file's -- whose parameters are not declared in this language and so have
    // no names to write, exactly as a built-in's do not [RT-001].
    if AnyWritten (Names) then raise 'A built-in has no named parameters.';

    if Count >= 2 then B := Pop ();
    if Count >= 1 then A := Pop ();

    Self := Pop ();

    if Count = 0 then
    begin
        if Name = 'pop'       then begin Push (Self.Pop ());      Exit; end
        if Name = 'peek'      then begin Push (Self.Peek ());     Exit; end
        if Name = 'keys'      then begin Push (Self.Keys ());     Exit; end
        if Name = 'values'    then begin Push (Self.Values ());   Exit; end
        if Name = 'tolist'    then begin Push (Self.ToList ());   Exit; end
        if Name = 'tostring'  then begin Push (Self.ToString ()); Exit; end
        if Name = 'readln'    then begin Push (Self.ReadLn ());   Exit; end
        if Name = 'sort'      then begin Push (Self.Sort ()); Exit; end
        if Name = 'clear'     then begin Push (Self.Clear ()); Exit; end
        if Name = 'free'      then begin Push (Self.Free ()); Exit; end
        if Name = 'reset'     then begin Push (Self.Reset ()); Exit; end
        if Name = 'rewrite'   then begin Push (Self.Rewrite ()); Exit; end
        if Name = 'flush'     then begin Push (Self.Flush ()); Exit; end
        if Name = 'close'     then begin Push (Self.Close ()); Exit; end
        if Name = 'erase'     then begin Push (Self.Erase ()); Exit; end
        if Name = 'append'    then begin Push (Self.Append ()); Exit; end
    end

    if Count = 1 then
    begin
        if Name = 'get'       then begin Push (Self.Get (A));      Exit; end
        if Name = 'contains'  then begin Push (Self.Contains (A)); Exit; end
        if Name = 'indexof'   then begin Push (Self.IndexOf (A));  Exit; end
        if Name = 'getint'    then begin Push (Self.GetInt (A));   Exit; end
        if Name = 'getword'   then begin Push (Self.GetWord (A));  Exit; end
        if Name = 'getdouble' then begin Push (Self.GetDouble (A)); Exit; end
        if Name = 'add'       then begin Push (Self.Add (A)); Exit; end
        if Name = 'push'      then begin Push (Self.Push (A)); Exit; end
        if Name = 'remove'    then begin Push (Self.Remove (A)); Exit; end
        if Name = 'removeat'  then begin Push (Self.RemoveAt (A)); Exit; end
        if Name = 'fill'      then begin Push (Self.Fill (A)); Exit; end
        if Name = 'append'    then begin Push (Self.Append (A)); Exit; end
        if Name = 'resize'    then begin Push (Self.Resize (A)); Exit; end
        if Name = 'assign'    then begin Push (Self.Assign (A)); Exit; end
        if Name = 'rename'    then begin Push (Self.Rename (A)); Exit; end
        if Name = 'write'     then begin Push (Self.Write (A)); Exit; end
        if Name = 'writeln'   then begin Push (Self.WriteLn (A)); Exit; end
    end

    if Count = 2 then
    begin
        if Name = 'put'       then begin Push (Self.Put (A, B)); Exit; end
        if Name = 'set'       then begin Push (Self.Set (A, B)); Exit; end
        if Name = 'insert'    then begin Push (Self.Insert (A, B)); Exit; end
        if Name = 'putint'    then begin Push (Self.PutInt (A, B)); Exit; end
        if Name = 'putword'   then begin Push (Self.PutWord (A, B)); Exit; end
        if Name = 'putdouble' then begin Push (Self.PutDouble (A, B)); Exit; end
    end

    // A name that is not one of the host's methods at all is an undefined
    // PROPERTY, which is what the interpreter says -- `'text'.ToUpper ()`
    // reaches for a built-in FUNCTION as though it were a member [0180].
    var Isa := False;

    for var Known in HOST_METHODS do
        if Known = Name then Isa := True;

    if not Isa then
        raise 'Undefined property ' + QUOTE + Str (Written) + QUOTE + '.';

    raise 'No method ' + Str (Name) + ' taking ' + Str (Count) + ' arguments.';
end

/// Widens the value on top to a declared type.
///
/// Integer to Double and Char to String, which is the whole of the language's
/// widening [VAL-001] -- the interpreter's Widen does exactly these two and
/// then a subrange range-check, which the emitter refuses here because the
/// bounds are not reachable from a chunk.
procedure DoWiden ();
var
    Named   : Any;
    Written : Any;
    V       : Any;

begin
    // Both spellings: the folded one decides, and the WRITTEN one goes in the
    // diagnostic -- `300 is not in Byte.` names the subrange as the program
    // spelled it.
    Written := Constants[ReadIndex ()];
    Named   := ToLower (Str (Written));
    V       := Pop ();

    if V = Nil then
    begin
        Push (V);

        Exit;
    end

    // A SUBRANGE is a bounds check rather than a conversion: the value stays
    // the Integer it is, and a value outside says which subrange it missed
    // [VAR-017].
    if SUBRANGE_LOW.Contains (Named) then
    begin
        if not WithinSubrange (V, Named) then
            raise Str (V) + ' is not in ' + Str (Written) + '.';

        Push (V);

        Exit;
    end

    if Named = 'double' and (V is Integer) then Push (V * 1.0);
    else if Named = 'string' and (V is Char) then Push (Str (V));
    else Push (V);
end

/// Records a subrange's bounds, from a constant holding its name and both.
procedure DoSubrange ();
var
    Said : Any;

begin
    Said := Constants[ReadIndex ()];

    var Named := ToLower (Str ((Said as List)[0]));

    SUBRANGE_LOW.Put  (Named, (Said as List)[1]);
    SUBRANGE_HIGH.Put (Named, (Said as List)[2]);
end

/// Pushes a new enumeration.
procedure DoEnum ();
begin
    Push (VmEnumType (Str (Constants[ReadIndex ()])));
end

/// Adds the next member to the enumeration on top and pushes it.
procedure DoEnumMember ();
begin
    Push (PeekAt (0).AddMember (Constants[ReadIndex ()]));
end

/// Duplicates the value on top.
procedure DoDup ();
begin
    Push (PeekAt (0));
end

/// Opens a protected region.
///
/// # Raises
///
/// 'Too many nested try blocks.' past TRY_ROOM.
procedure DoTry ();
var
    Distance : Integer;

begin
    Distance := ReadShort ();

    if TryDepth >= TRY_ROOM then raise 'Too many nested try blocks.';

    TryIP[TryDepth]    := IP + Distance;
    TryOf[TryDepth]    := Running;
    TryFrame[TryDepth] := FrameDepth;
    TryBase[TryDepth]  := Base;
    TrySP[TryDepth]    := SP;

    TryDepth := TryDepth + 1;
end

/// Closes the innermost protected region.
procedure DoUntry ();
begin
    if TryDepth > 0 then TryDepth := TryDepth - 1;
end

/// Unwinds to the innermost handler and leaves the raised value for it.
///
/// Answers whether a handler was found.  A raise with none is the program's
/// error escaping, which the caller turns back into a host exception so the
/// driver reports it the way the interpreter does.
function Unwind (Value : Any) : Boolean;
begin
    if TryDepth = 0 then Exit False;

    TryDepth := TryDepth - 1;

    // Every frame opened since the `try` goes, which is what lets a handler
    // several calls above the raise still run.
    FrameDepth := TryFrame[TryDepth] as Integer;
    Base       := TryBase[TryDepth] as Integer;
    SP         := TrySP[TryDepth] as Integer;

    Running   := TryOf[TryDepth] as Chunk;
    CodeBytes := Running.Code;
    Constants := Running.Constants;
    IP        := TryIP[TryDepth] as Integer;

    Push (Value);

    Exit True;
end

/// Pops a value and raises it.
///
/// # Raises
///
/// The value, as a host exception, when nothing is protecting it -- which is
/// how an uncaught raise reaches the driver.
procedure DoRaise ();
var
    Value : Any;

begin
    Value := Pop ();

    if not Unwind (Value) then raise Str (Value);
end

/// Replaces a collection with a List of what `for ... in` would visit.
///
/// Built by iterating it with the HOST's own `for ... in`, so a Map yields its
/// keys, a String its Chars and a Set its members -- the machine does not
/// decide any of that and therefore cannot disagree about it.
procedure DoIter ();
var
    Over : Any;
    Made : List;

begin
    Over := Pop ();
    Made := List ();

    // A class may offer its own elements, which is a protocol the host's own
    // `for ... in` knows nothing about [0165] -- so it is named rather than
    // iterated as whatever the host makes of an instance.
    //
    // Only a class that DECLARES it.  An instance without it is not iterable
    // at all [0032], and that is an error in the program rather than a gap in
    // the machine -- refusing both alike reported a gap that was not there.
    // Asked REPEATEDLY, because what Elements answers is iterated on the same
    // terms: an Outer whose Elements hands back an Inner that also declares it
    // resolves the chain [0165].
    //
    // Arity ZERO, for the reason Rendered gives: `Elements (N : Integer)` does
    // not implement the protocol, and such a class is not iterable at all
    // rather than a selection failure.
    while Over is VmInstance and DeclaresShape (Over.Klass, 'elements', 0) do
        Over := CallNested (Over, 'Elements', List ());

    for var Element in Over do Made.Add (Element);

    Push (Made);
end

/// Replaces the value on top with a cell holding it.
procedure DoCell ();
begin
    Push (VmCell (Pop ()));
end

/// Pushes what the cell in a local slot holds.
procedure DoGetBox ();
begin
    Push (Slots[Base + ReadSlot ()].Held);
end

/// Stores the top into the cell in a local slot, leaving it on the stack.
procedure DoSetBox ();
var
    At : Integer;

begin
    At := Base + ReadSlot ();

    Slots[At].Held := PeekAt (0);
end

/// Pushes what a captured cell holds.
procedure DoGetCell ();
begin
    Push (Cells[ReadSlot ()].Held);
end

/// Stores the top into a captured cell, leaving it on the stack.
procedure DoSetCell ();
var
    At : Integer;

begin
    At := ReadSlot ();

    Cells[At].Held := PeekAt (0);
end

/// Makes a closure over the subprogram its operand names.
///
/// The cells come from the enclosing frame, read by the descriptors that
/// follow -- so each evaluation of the enclosing subprogram closes over the
/// cells that call made [FUN-010].
///
/// A descriptor says WHERE, which is what lets nesting go to any depth
/// [FUN-012]: from one of this frame's own slots, which holds a cell because a
/// frame that declares a nested subprogram boxes every local; or from a cell
/// this frame itself captured, which is how a subprogram two deep reaches a
/// name its parent only captured. clox's is-local flag.
procedure DoClosure ();
var
    Body  : Any;
    Count : Integer;
    Taken : List;

begin
    Body  := Constants[ReadIndex ()];
    Count := ReadShort ();
    Taken := List ();

    for var I : Integer := 0; I < Count; I := I + 1 do
    begin
        var Own := ReadByte ();
        var At  := ReadShort ();

        if Own <> 0 then Taken.Add (Slots[Base + At]);
        else Taken.Add (Cells[At]);
    end

    Push (VmClosure (Body, Taken));
end

/// Whether one value could be passed where a type was written.
///
/// The interpreter's FitsAt, which is the rule being matched rather than
/// improved on.  An unwritten type and Any take anything; nil takes any type
/// [VAR-005]; a derived value fits a base class; and on the WIDENING pass an
/// Integer fits a Double and a Char a String.
function FitsAt (Argument : Any, Declared : Any, Widening : Boolean) : Boolean;
var
    Wanted : Any;
    Actual : Any;

begin
    Wanted := ToLower (Str (Declared));

    if Wanted = '' or Wanted = 'any' then Exit True;

    if Argument = Nil then Exit True;

    Actual := ToLower (Str (NameOfType (Argument)));

    if Actual = Wanted then Exit True;

    // A derived value fits a base class, by the chain `is` walks.
    if Argument is VmInstance then
        if TypeMatches (Argument, Wanted) then Exit True;

    if not Widening then Exit False;

    if Wanted = 'double' and Actual = 'integer' then Exit True;
    if Wanted = 'string' and Actual = 'char'    then Exit True;

    Exit False;
end

/// Whether a candidate takes these arguments on a given pass.
function Fits (Callee : Any, Count : Integer, Widening : Boolean) : Boolean;
begin
    var Candidate := CalleeSignature (Callee);

    if Candidate.Arity <> Count then Exit False;

    for var I : Integer := 0; I < Count; I := I + 1 do
    begin
        var Declared := '';

        if I < Candidate.Types.Length then Declared := Candidate.Types[I];

        if not FitsAt (Slots[SP - Count + I], Declared, Widening) then Exit False;
    end

    Exit True;
end

/// Chooses a candidate for the arguments on the stack.
///
/// Two passes, EXACT then WIDENING, and within a pass the candidates are tried
/// in DECLARATION ORDER -- so a tie goes to the one written first, which is
/// what the interpreter does.  Its third pass, ABSORBING, is for a variadic
/// candidate; the emitter refuses one of those, so there is no third pass here
/// and nothing silently falls through it.
///
/// Answers nil when nothing fits.
/// The thing carrying a callee's signature.
///
/// A closure borrows its subprogram's, so a nested variadic absorbs on the
/// same terms as a top-level one.
function CalleeSignature (Callee : Any) : Any;
begin
    if Callee is VmClosure then Exit Callee.Body;

    Exit Callee;
end

/// Whether any argument at a call site was written with a name.
///
/// The names arrive as one entry per argument, EMPTY for a positional one, so
/// the count is never the question -- whether any was written is.
function AnyWritten (Names : List) : Boolean;
begin
    for var Each in Names do
        if Str (Each) <> '' then Exit True;

    Exit False;
end

/// The parameter a name denotes in a callee, or -1 where it has none.
///
/// Both sides are folded: the emitter folds what the call site wrote and
/// VmFunction.Params holds the declaration folded, because a parameter name is
/// an identifier [SRC-011].
function ParameterSlot (Callee : Any, Wanted : String) : Integer;
begin
    var Signature := CalleeSignature (Callee);

    for var I : Integer := 0; I < (Signature.Params as List).Length; I := I + 1 do
        if Str ((Signature.Params as List)[I]) = Wanted then Exit I;

    Exit -1;
end

/// Rearranges the arguments on the stack to the DECLARATION's order, answering
/// False where they cannot be arranged against this callee.
///
/// Mirrors ObjFunction.Arrange rather than improving on it: a slot per
/// parameter, each filled exactly once, and every slot filled by the end.  So
/// a name no parameter has, a parameter named twice, and a call that leaves a
/// slot empty are one answer -- False -- and the caller turns that into the
/// one message [EXP-013] gives them all.
///
/// ⚠️ An arrangement has exactly the declared arity, which is what turns
/// ABSORPTION off without a rule of its own [FUN-005]: every slot is filled
/// once, so `Take (Items: [1], Label: 'a')` arrives as a two-argument call and
/// the exact pass takes it before gathering is ever reached.
/// ⚠️ The locals here are NOT called `Slots`.  That is the machine's value
/// stack, a module-level name, and a local of the spelling shadows it -- so
/// `Slots[SP - Count + I]` would have read this list instead of the stack and
/// arranged nothing. The same trap as a module-level table losing to a local.
function ArrangeNamed (Callee : Any, Count : Integer, Names : List) : Boolean;
var
    Placed : List;
    Filled : List;

begin
    var Wanted := CalleeSignature (Callee).Arity;

    if Count <> Wanted then Exit False;

    Placed := List ();
    Filled := List ();

    for var I : Integer := 0; I < Wanted; I := I + 1 do
    begin
        Placed.Add (Nil);
        Filled.Add (False);
    end

    for var I : Integer := 0; I < Count; I := I + 1 do
    begin
        var Written := '';
        if I < Names.Length then Written := Str (Names[I]);

        var At := I;
        if Written <> '' then At := ParameterSlot (Callee, Written);

        if At < 0 or At >= Wanted then Exit False;
        if Filled[At] then Exit False;

        Placed[At] := Slots[SP - Count + I];
        Filled[At] := True;
    end

    for var Each in Filled do
        if not Each then Exit False;

    // Written back only once every slot is known good, so a failed
    // arrangement leaves the stack exactly as it was for the next candidate
    // to try.
    for var I : Integer := 0; I < Count; I := I + 1 do
        Slots[SP - Count + I] := Placed[I];

    Exit True;
end

/// Arranges a named METHOD call against the chain's candidates for the name.
///
/// Walks the chain exactly as FittingMethod walks it, because the method a
/// named call means is found the same way -- and takes the first candidate
/// that can be arranged, which is what tells two methods of one name apart by
/// their parameter names alone.
procedure ArrangeMethod (Klass : Any, Wanted : Any, Count : Integer,
                         Names : List);
var
    Where : Any;

begin
    if not AnyWritten (Names) then Exit;

    Where := Klass;

    while Where <> Nil do
    begin
        var Candidates := Where.CandidatesFor (Wanted);

        if Candidates <> Nil then
            for var TheCandidate in Candidates as List do
                if ArrangeNamed (TheCandidate, Count, Names) then Exit;

        Where := Where.Parent;
    end

    raise 'No matching signature for function.';
end

/// Arranges a named call against whatever the callee turns out to be.
///
/// Mirrors Interpreter.Arranged, and happens BEFORE selection for the reason
/// that one does: the arrangement decides the arity, and selection reads the
/// arranged arguments.  An overload set takes the first candidate that can be
/// arranged, which is what lets `Note (Code: 7)` and `Note (Level: 'a',
/// Message: 'b')` be told apart by their names alone.
procedure ArrangeCall (Callee : Any, Count : Integer, Names : List);
begin
    if not AnyWritten (Names) then Exit;

    if Callee is VmOverloads then
    begin
        for var Candidate in Callee.Candidates as List do
            if ArrangeNamed (Candidate, Count, Names) then Exit;

        raise 'No matching signature for function.';
    end

    if Callee is VmClass then
    begin
        var Setup := Callee.FindMethod ('init');

        if Setup <> Nil then
            if ArrangeNamed (Setup, Count, Names) then Exit;

        raise 'No matching signature for function.';
    end

    if Callee is VmFunction or Callee is VmClosure then
    begin
        if ArrangeNamed (Callee, Count, Names) then Exit;

        raise 'No matching signature for function.';
    end

    // A built-in's parameters are not declared in this language at all -- they
    // exist only as a count -- so there is no name to write [RT-001].
    raise 'A built-in has no named parameters.';
end

/// Whether these arguments fit by GATHERING the trailing ones into a list.
///
/// The interpreter's third pass, and it mirrors ObjFunction.CanGather rather
/// than improving on it.  The element type REPLACES the arity check and is
/// stricter than it: `Total ('a', 1, 2, 'red')` is still an error against
/// `List of Integer`, and it fails as a selection failure rather than as a
/// wrong count, because the stray argument is the wrong TYPE and not one too
/// many.
///
/// # Satisfies
///
/// [FUN-005]
function CanGather (Callee : Any, Count : Integer) : Boolean;
begin
    var Candidate := CalleeSignature (Callee);

    if Str (Candidate.Element) = '' then Exit False;

    var Fixed := (Candidate.Arity as Integer) - 1;

    if Count < Fixed then Exit False;

    for var I : Integer := 0; I < Fixed; I := I + 1 do
    begin
        var Declared := '';

        if I < Candidate.Types.Length then Declared := Candidate.Types[I];

        if not FitsAt (Slots[SP - Count + I], Declared, True) then Exit False;
    end

    for var I : Integer := Fixed; I < Count; I := I + 1 do
        if not FitsAt (Slots[SP - Count + I], Candidate.Element, True) then
            Exit False;

    Exit True;
end

/// Gathers the trailing arguments into one list, answering the new count.
///
/// Read off the stack by INDEX and in order, because a list built by popping
/// would hold them backwards -- the same trap a collection literal has.
function GatherRest (Callee : Any, Count : Integer) : Integer;
begin
    var Fixed := (CalleeSignature (Callee).Arity as Integer) - 1;
    var Rest  := List ();

    for var I : Integer := Fixed; I < Count; I := I + 1 do
        Rest.Add (Slots[SP - Count + I]);

    // Absorbing NOTHING yields the empty list, which is structural rather than
    // a default: the loop above simply runs no times.
    SP := SP - Count + Fixed;

    Push (Rest);

    Exit Fixed + 1;
end

/// AnswersOn the method of this name that these arguments fit.
///
/// Three passes, exact before widening before absorbing, mirroring both
/// `ObjClass.FindOverload` and the Chosen below it -- one rule for overloads
/// wherever they live.
///
/// NOT named FindOverload, which is a METHOD of ObjClass that ObjClass calls
/// bare: a top-level name here shadows it, and the compiler's own constructor
/// selection then reached this instead and reported
/// `Expected ObjFunction, found Any` from a file with no overload in it.
///
/// # Satisfies
///
/// [EXP-013], [EXP-014], [FUN-007]
function ChosenMethod (Klass : Any, Wanted : Any, Count : Integer) : Any;
begin
    var Exact := FittingMethod (Klass, Wanted, Count, 0);

    if Exact <> Nil then Exit Exact;

    var Widened := FittingMethod (Klass, Wanted, Count, 1);

    if Widened <> Nil then Exit Widened;

    Exit FittingMethod (Klass, Wanted, Count, 2);
end

/// Runs one pass of method selection, up the WHOLE chain.
///
/// Each pass finishes the chain before the next begins, which is the rule
/// rather than an optimisation [EXP-014]: an exact match on a parent must beat
/// a widened match on the child, or adding an overload to a subclass would
/// silently capture calls the parent was answering exactly.
///
/// A failed match FALLS THROUGH to the superclass rather than returning.
/// Returning would let a class declaring `Take (String)` hide an inherited
/// `Take (Integer)` entirely, which overloading across a hierarchy has to
/// allow -- and is the mistake ObjClass.Fitting records having made.
function FittingMethod (Klass : Any, Wanted : Any, Count : Integer,
                        Pass : Integer) : Any;
var
    Where : Any;

begin
    Where := Klass;

    while Where <> Nil do
    begin
        var Candidates := Where.CandidatesFor (Wanted);

        if Candidates <> Nil then
            for var TheCandidate in Candidates as List do
                if AnswersOn (TheCandidate, Count, Pass) then Exit TheCandidate;

        Where := Where.Parent;
    end

    Exit Nil;
end

/// Whether a candidate answers on one pass: exact, widening, then absorbing.
function AnswersOn (Candidate : Any, Count : Integer, Pass : Integer) : Boolean;
begin
    if Pass = 0 then Exit Fits (Candidate, Count, False);
    if Pass = 1 then Exit Fits (Candidate, Count, True);

    Exit CanGather (Candidate, Count);
end

function Chosen (Set : Any, Count : Integer) : Any;
begin
    for var TheCandidate in Set.Candidates do
        if Fits (TheCandidate, Count, False) then Exit TheCandidate;

    for var TheCandidate in Set.Candidates do
        if Fits (TheCandidate, Count, True) then Exit TheCandidate;

    // ABSORBING is the third pass and never runs when either of the first two
    // found something -- which is the whole of why a fixed-arity signature
    // beats a gathering one [EXP-014].  It is pass ORDER rather than a rule of
    // its own, so there is nothing here to express it but the position.
    for var TheCandidate in Set.Candidates do
        if CanGather (TheCandidate, Count) then Exit TheCandidate;

    Exit Nil;
end

/// Gathers the subprograms above it into an overload set.
procedure DoOverloads ();
var
    Count : Integer;
    Made  : VmOverloads;
    From  : Integer;

begin
    Count := ReadByte ();
    Made  := VmOverloads (Str (Constants[ReadIndex ()]));
    From  := SP - Count;

    // Read by index rather than popped, so the candidates keep DECLARATION
    // ORDER -- which decides a tie within a selection pass.
    for var I : Integer := 0; I < Count; I := I + 1 do Made.Add (Slots[From + I]);

    SP := From;

    Push (Made);
end

/// Calls a built-in by name.
///
/// Every arm ends in a call to the HOST's built-in of the same name, which is
/// the point: the interpreter guarantees that interpreted `Length` is host
/// `Length` by having one implementation, and this keeps that promise for a
/// third processor rather than writing a second `Length` that must agree with
/// the first forever.
///
/// Dispatched on the name AND the count, because six of them are variadic and
/// the host decides what each arity means.
///
/// A collection built-in -- List, Map, Set, Array, Buffer, Slots, TextFile --
/// hands back a HOST object, allocated in an arena that never frees.  That is
/// the guest-heap boundary PROPOSAL-GC.md describes, crossed deliberately and
/// for now: it matches what the interpreter does, and the `Buffer` heap that
/// would fix it is the VM's own work rather than a built-in's.
///
/// # Raises
///
/// 'No built-in N takes C arguments.' for a pairing with no arm, which is a
/// gap in the machine rather than an error in a program.  Everything else is
/// whatever the host raises, unchanged.
procedure DoBuiltin ();
var
    Name  : Any;
    Count : Integer;
    A     : Any;
    B     : Any;
    C     : Any;
    D     : Any;
    E     : Any;

begin
    Name  := ToLower (Str (Constants[ReadIndex ()]));
    Count := ReadByte ();

    // Write and WriteLn take any number [RT-015], so they are handled before
    // the fixed-arity arms rather than needing one arm per count.
    if Name = 'write' or Name = 'writeln' then
    begin
        var Given := List ();

        for var I : Integer := 0; I < Count; I := I + 1 do
            Given.Insert (0, Pop ());

        // Swallowed during a test run, for the reason DoPrint gives.  The
        // arguments are still evaluated and still popped: a program's output
        // disappearing must not change what it computes.
        if not TESTING then
        begin
            for var Each in Given do Write (Each);

            if Name = 'writeln' then WriteLn (Str (''));
        end

        Push (Nil);

        Exit;
    end

    // Popped in reverse, because the arguments were pushed in order.
    if Count >= 5 then E := Pop ();
    if Count >= 4 then D := Pop ();
    if Count >= 3 then C := Pop ();
    if Count >= 2 then B := Pop ();
    if Count >= 1 then A := Pop ();

    if Count = 0 then
    begin
        if Name = 'clock'      then begin Push (clock ());      Exit; end

        // The machine ACCEPTS the request where the interpreter declines it
        // [RT-029].  It can: every live guest value is on Slots or in a
        // module-level variable, both of which the collector sees, and a
        // built-in call is a safe point because no handler is part-way
        // through when one runs.
        if Name = 'collect'    then begin Push (Collect ());    Exit; end
        if Name = 'getdir'     then begin Push (GetDir ());     Exit; end
        if Name = 'list'       then begin Push (List ());       Exit; end
        if Name = 'map'        then begin Push (Map ());        Exit; end
        if Name = 'set'        then begin Push (Set ());        Exit; end
        if Name = 'stack'      then begin Push (Stack ());      Exit; end
        if Name = 'textfile'   then begin Push (TextFile ());   Exit; end
        if Name = 'paramcount' then begin Push (Arguments.Length - 1); Exit; end
        if Name = 'buffer'     then begin Push (Buffer ());     Exit; end
        if Name = 'writeln'    then begin WriteLn (''); Push (Nil); Exit; end
    end

    if Count = 1 then
    begin
        if Name = 'length'     then begin Push (Length (A));     Exit; end
        if Name = 'str' then
        begin
            // An instance reads as '<ClassName> instance', which is the
            // interpreter's rendering -- the host would answer the name of the
            // machine's OWN class, 'VmInstance instance', instead.
            if A is VmInstance or (A is VmEnum) then Push (Rendered (A));
            else Push (Str (A));

            Exit;
        end
        if Name = 'toupper'    then begin Push (ToUpper (A));    Exit; end
        if Name = 'tolower'    then begin Push (ToLower (A));    Exit; end
        // An enum MEMBER has an ordinal and the host cannot see it: it holds
        // one of the machine's own objects, so it reports no ordinal where the
        // other two processors answer the position [ENU-010].  The same place
        // the machine must not defer about truth.
        if Name = 'ord' and A is VmEnum then begin Push (A.Ordinal); Exit; end

        if Name = 'ord'        then begin Push (Ord (A));        Exit; end
        if Name = 'char'       then begin Push (Char (A));       Exit; end
        if Name = 'val'        then begin Push (Val (A));        Exit; end
        if Name = 'pred'       then begin Push (Pred (A));       Exit; end
        if Name = 'succ'       then begin Push (Succ (A));       Exit; end
        if Name = 'array'      then begin Push (Array (A));      Exit; end
        if Name = 'buffer'     then begin Push (Buffer (A));     Exit; end
        if Name = 'set'        then begin Push (Set (A));        Exit; end
        if Name = 'fileexists' then begin Push (FileExists (A)); Exit; end
        if Name = 'paramstr' then
        begin
            var At := A as Integer;

            // Out of range answers the empty String rather than raising,
            // which is what the interpreter does.
            if At < 0 or At >= Arguments.Length then Push (Str (''));
            else Push (Arguments[At]);

            Exit;
        end
        if Name = 'asserttrue' then
        begin
            if not TESTING then raise 'Undefined variable ' + QUOTE
                                    + 'AssertTrue' + QUOTE + '.';

            AssertedTrue (A);
            Push (Nil);

            Exit;
        end
        if Name = 'fail' then
        begin
            if not TESTING then raise 'Undefined variable ' + QUOTE
                                    + 'Fail' + QUOTE + '.';

            FailedWith (A);
            Push (Nil);

            Exit;
        end
        if Name = 'halt'       then begin Halt (A);       Push (Nil); Exit; end
        if Name = 'chdir'      then begin ChDir (A);      Push (Nil); Exit; end
        if Name = 'mkdir'      then begin MkDir (A);      Push (Nil); Exit; end
        if Name = 'rmdir'      then begin RmDir (A);      Push (Nil); Exit; end
        if Name = 'write'      then begin Write (A);      Push (Nil); Exit; end
        if Name = 'writeln'    then begin WriteLn (A);    Push (Nil); Exit; end
    end

    if Count = 2 then
    begin
        if Name = 'pos'         then begin Push (Pos (A, B)); Exit; end
        if Name = 'str'         then begin Push (Str (A, B)); Exit; end
        if Name = 'copy'        then begin Push (Copy (A, B)); Exit; end
        if Name = 'assertequal' then
        begin
            if not TESTING then raise 'Undefined variable ' + QUOTE
                                    + 'AssertEqual' + QUOTE + '.';

            AssertedEqual (A, B);
            Push (Nil);

            Exit;
        end
    end

    if Count = 3 then
    begin
        if Name = 'copy' then begin Push (Copy (A, B, C)); Exit; end
        if Name = 'str'  then begin Push (Str (A, B, C));  Exit; end
        if Name = 'pos'  then begin Push (Pos (A, B, C));  Exit; end
    end

    // Foreign is the one built-in taking five [RT-001], and a program may call
    // it directly as well as reaching it through an `external` declaration.
    if Count = 5 then
        if Name = 'foreign' then
        begin
            Push (Foreign (A, B, C, D, E));

            Exit;
        end

    // The interpreter names the arities it accepts rather than the name of
    // the built-in, and the two reports are compared.
    if Name = 'str' then
        raise 'Expected 1, 2 or 3 arguments but got ' + Str (Count) + '.';

    if Name = 'pos' then
        raise 'Expected 2 or 3 arguments but got ' + Str (Count) + '.';

    if Name = 'buffer' or Name = 'set' then
        raise 'Expected 0 or 1 arguments but got ' + Str (Count) + '.';

    // A FIXED-arity built-in reports the same way a subprogram does, because
    // the interpreter registers it with an arity and the ordinary arity check
    // is what fires -- `Expected 1 arguments but got 2.` for `Length ('a','b')`.
    //
    // ⚠️ Reached only once an unresolvable name stopped being refused: while
    // the emitter refused `Nonexistent`, 0145 never ran far enough to compare
    // this message, and the machine's own wording went unnoticed.
    if BUILTIN_ARITY.Contains (Str (Name)) then
        raise 'Expected ' + Str (BUILTIN_ARITY.Get (Str (Name)))
            + ' arguments but got ' + Str (Count) + '.';

    raise 'No built-in ' + Str (Name) + ' takes ' + Str (Count) + ' arguments.';
end

/// Whether the machine is running test blocks rather than a program.
///
/// `AssertTrue`, `AssertEqual` and `Fail` are the three built-ins [RT-001]
/// makes available only under a test run, so outside one a call to them must
/// answer exactly what the interpreter answers -- `Undefined variable`, naming
/// it -- rather than quietly working.
var TESTING : Boolean := False;

/// Turns test mode on, which is what `--test` asks the driver to do.
procedure SetTesting (On : Boolean);
begin
    TESTING := On;
end

/// Raises unless the value is truthy.
///
/// ⚠️ These three carry the interpreter's wording character for character,
/// two spaces after `failed.` included, because a test's failure line is what
/// `conformance/0107` and `conformance/0132` compare. They cannot forward to
/// the host's own the way every other built-in does: the host's `AssertEqual`
/// exists only in a build made with `--test`, and the machine is not one.
procedure AssertedTrue (Value : Any);
begin
    if not Truthy (Value) then
        raise 'Assertion failed.  Expected true but got ' + QUOTE
            + Str (Value) + QUOTE + '.';
end

/// Raises unless the two values are equal.
///
/// Names the TYPES when the two render alike, because `Expected '5' but got
/// '5'` tells a reader nothing -- a Char and a one-character String are the
/// case that reaches it [TST-008].
procedure AssertedEqual (Expected : Any, Actual : Any);
begin
    if Expected = Actual then Exit;

    var Left  := Str (Expected);
    var Right := Str (Actual);

    if Left = Right then
        raise 'Assertion failed.  Expected ' + Str (NameOfType (Expected))
            + ' ' + QUOTE + Left + QUOTE + ' but got '
            + Str (NameOfType (Actual)) + ' ' + QUOTE + Right + QUOTE + '.';

    raise 'Assertion failed.  Expected ' + QUOTE + Left + QUOTE
        + ' but got ' + QUOTE + Right + QUOTE + '.';
end

/// Fails a test outright, with a reason.
procedure FailedWith (Said : Any);
begin
    raise 'Failed.  ' + Str (Said);
end

/// How many arguments each FIXED-arity built-in takes, mirroring the arities
/// the interpreter registers its natives with.
///
/// The six variadic ones are absent on purpose -- `Str`, `Pos`, `Set`,
/// `Write`, `WriteLn` and `Buffer` each name the counts they accept, and those
/// messages are raised above this table rather than derived from it.
var BUILTIN_ARITY := ['clock' : 0, 'collect' : 0, 'length' : 1, 'copy' : 3,
                      'toupper' : 1, 'tolower' : 1, 'array' : 1, 'list' : 0,
                      'map' : 0, 'stack' : 0, 'halt' : 1, 'ord' : 1,
                      'succ' : 1, 'pred' : 1, 'foreign' : 5, 'val' : 1,
                      'char' : 1, 'textfile' : 0, 'fileexists' : 1,
                      'mkdir' : 1, 'rmdir' : 1, 'chdir' : 1, 'getdir' : 0,
                      'paramcount' : 0, 'paramstr' : 1, 'asserttrue' : 1,
                      'assertequal' : 2, 'fail' : 1];

/// Returns from the running frame, or stops the machine at the outermost one.
procedure DoReturn ();
var
    Value : Any;

begin
    Value := Pop ();

    // At the floor the loop STOPS and nothing is restored: either this is the
    // script returning and the run is over, or a nested call is answering and
    // CallNested puts the machine back as it found it.
    if FrameDepth = StopDepth then
    begin
        Answer := Value;
        Live := False;

        Exit;
    end

    FrameDepth := FrameDepth - 1;

    // Everything the frame put on the stack goes, the callee beneath its
    // arguments included -- which is why Base - 1 and not Base.
    SP := Base - 1;

    Running   := FrameOf[FrameDepth] as Chunk;
    IP        := FrameResume[FrameDepth] as Integer;
    Base      := FrameBase[FrameDepth] as Integer;
    Cells     := FrameCells[FrameDepth] as List;
    CodeBytes := Running.Code;
    Constants := Running.Constants;

    Push (Value);
end

/// Refuses a byte that is not an instruction.
///
/// # Raises
///
/// 'No handler for opcode N.' always -- that is the whole of what it does.
procedure DoUnknown ();
begin
    raise 'No handler for opcode ' + Str (CodeBytes[IP - 1]) + '.';
end

/// Pushes a new class.
procedure DoClass ();
begin
    Push (VmClass (Str (Constants[ReadIndex ()])));
end

/// Records a method on the class on top, leaving the class there.
procedure DoMethod ();
var
    Named : Any;
    Body  : Any;

begin
    Named := Constants[ReadIndex ()];
    Body  := Pop ();

    PeekAt (0).AddMethod (Named, Body);
end

/// The instance an object stands for, built the first time it is asked for.
///
/// The wrapper records the instance BEFORE the constructor runs, so an object
/// whose own constructor reaches it finds the half-built instance rather than
/// recursing forever -- which is what "built on first use" has to mean.
///
/// The constructor is where a class's field initializers live, so it runs even
/// for an object that declares none: EmitClass synthesizes one.
function Materialised (Only : Any) : Any;
begin
    if Only.Made <> Nil then Exit Only.Made;

    var Made := VmInstance (Only.Klass as VmClass);

    Only.Made := Made;

    if ChosenMethod (Only.Klass, 'init', 0) <> Nil then
        CallNested (Made, 'Init', List ());

    Exit Made;
end

/// Replaces the class on top with an object of it.
procedure DoSingleton ();
begin
    Push (VmSingleton (Pop () as VmClass));
end

/// Pushes `super.Member`: the member bound to `this`, looked up starting at the
/// parent of the class the code was written in.
procedure DoSuper ();
var
    Written : Any;

begin
    Written := Constants[ReadIndex ()];

    var Slot := ReadShort ();

    // `this` sits one below the running frame's base, where a method call left
    // its receiver.
    //
    // The starting class is set after construction rather than through a second
    // constructor: a named one is called `VmBound.Above (...)`, which the C back
    // end resolves as a VARIABLE of that name and fails to compile.
    var Made := VmBound (Slots[Base - 1], Str (Written));

    Made.From := GlobalCells[Slot];

    Push (Made);
end

/// Records the method on top as a property of the class beneath it.
///
/// Not DoProperty, which already exists for OP_PROPERTY and reads one of the
/// runtime's five.
procedure DoDeclareProperty ();
var
    Named : Any;
    Body  : Any;

begin
    Named := Constants[ReadIndex ()];
    Body  := Pop ();

    PeekAt (0).AddMethod (Named, Body);
    PeekAt (0).AddProperty (Named);
end

/// Records a field name on the class on top, leaving the class there.
procedure DoField ();
begin
    PeekAt (0).AddField (Constants[ReadIndex ()]);
end

/// Makes the popped class the parent of the one on top.
///
/// # Raises
///
/// '''N'' is not a class.' for a parent that is not one, quoting the name the
/// program wrote -- the interpreter's wording.
procedure DoInherit ();
var
    Parent     : Any;
    ParentName : Any;

begin
    // The NAME is an operand so the refusal can quote what the program wrote,
    // which is what the interpreter's own message does.
    ParentName := Constants[ReadIndex ()];
    Parent     := Pop ();

    if not (Parent is VmClass) then
        raise QUOTE + Str (ParentName) + QUOTE + ' is not a class.';

    PeekAt (0).Parent := Parent;
end

/// Pushes the running frame's receiver.
///
/// One below the base, where a plain call keeps its callee -- so `this` costs
/// a subscript and no slot of its own.
procedure DoThis ();
begin
    Push (Slots[Base - 1]);
end

/// Replaces a value with one of its members.
///
/// The same read as OP_PROPERTY, kept as its own opcode because the emitter
/// knows which names are the runtime's five and which are not -- and a
/// disassembly that says GET_FIELD where a field was meant reads better than
/// one that says PROPERTY everywhere.
procedure DoGetField ();
var
    Written : Any;

begin
    Written := Constants[ReadIndex ()];

    Push (MemberOf (Pop (), Written));
end

/// Stores a value in a field, leaving the value on the stack.
procedure DoSetField ();
var
    Written : Any;
    Named   : Any;
    Self    : Any;
    Value   : Any;

begin
    // Both spellings kept, for the reason DoGetField gives -- and the WRITTEN
    // one has to be captured here rather than recovered from IP afterwards,
    // which indexed the constants by a code offset instead.
    Written := Constants[ReadIndex ()];
    Named   := ToLower (Str (Written));
    Value   := Pop ();
    Self    := Pop ();

    if not (Self is VmInstance) then raise 'Only an instance has fields.';

    // An instance is CLOSED [0169]: a field the class never declared cannot be
    // created by writing to it, which is what tells a typo from a new member.
    if not Self.Fields.Contains (Named) then
        raise 'Undefined property ' + QUOTE + Str (Written) + QUOTE + '.';

    Self.Fields.Put (Named, Value);

    Push (Value);
end

/// Builds the dispatch table, every slot filled.
///
/// A function rather than a run of assignments at unit level, because a unit's
/// bare STATEMENTS do not run under `--test` -- only a declaration's
/// initializer does.  A table left half-built that way fails as 'Can only call
/// functions and classes' at the first instruction, which says nothing about
/// why.
function BuildHandlers () : Array;
var
    Table : Array;

begin
    Table := Array (BYTE_VALUES);

    for var Slot : Integer := 0; Slot < BYTE_VALUES; Slot := Slot + 1 do
        Table[Slot] := DoUnknown;

    Table[OP_CONSTANT]      := DoConstant;
    Table[OP_NIL]           := DoNil;
    Table[OP_TRUE]          := DoTrue;
    Table[OP_FALSE]         := DoFalse;
    Table[OP_POP]           := DoPop;
    Table[OP_GET_LOCAL]     := DoGetLocal;
    Table[OP_SET_LOCAL]     := DoSetLocal;
    Table[OP_GET_GLOBAL]    := DoGetGlobal;
    Table[OP_DEFINE_GLOBAL] := DoDefineGlobal;
    Table[OP_SET_GLOBAL]    := DoSetGlobal;
    Table[OP_EQUAL]         := DoEqual;
    Table[OP_GREATER]       := DoGreater;
    Table[OP_LESS]          := DoLess;
    Table[OP_NOT]           := DoNot;
    Table[OP_JUMP]          := DoJump;
    Table[OP_JUMP_IF_FALSE] := DoJumpIfFalse;
    Table[OP_LOOP]          := DoLoop;
    Table[OP_DIV]           := DoDiv;
    Table[OP_MOD]           := DoMod;
    Table[OP_IN]            := DoIn;
    Table[OP_BIT_AND]       := DoBitAnd;
    Table[OP_BIT_OR]        := DoBitOr;
    Table[OP_BIT_XOR]       := DoBitXor;
    Table[OP_BIT_NOT]       := DoBitNot;
    Table[OP_SHIFT_LEFT]    := DoShiftLeft;
    Table[OP_SHIFT_RIGHT]   := DoShiftRight;
    Table[OP_IS]            := DoIs;
    Table[OP_CALL]          := DoCall;
    Table[OP_CALL_NAMED]    := DoCallNamed;
    Table[OP_PROPERTY]      := DoProperty;
    Table[OP_INVOKE_NAMED]  := DoInvokeNamed;
    Table[OP_SUBSCRIPT_GET] := DoSubscriptGet;
    Table[OP_SUBSCRIPT_SET] := DoSubscriptSet;
    Table[OP_DECLARE_PROPERTY] := DoDeclareProperty;
    Table[OP_SUPER]         := DoSuper;
    Table[OP_SINGLETON]     := DoSingleton;
    Table[OP_SUBRANGE]      := DoSubrange;
    Table[OP_LIST]          := DoList;
    Table[OP_MAP]           := DoMap;
    Table[OP_INVOKE]        := DoInvoke;
    Table[OP_CLASS]         := DoClass;
    Table[OP_METHOD]        := DoMethod;
    Table[OP_FIELD]         := DoField;
    Table[OP_INHERIT]       := DoInherit;
    Table[OP_THIS]          := DoThis;
    Table[OP_GET_FIELD]     := DoGetField;
    Table[OP_SET_FIELD]     := DoSetField;
    Table[OP_WIDEN]         := DoWiden;
    Table[OP_CAST]          := DoCast;
    Table[OP_DUP]           := DoDup;
    Table[OP_TRY]           := DoTry;
    Table[OP_UNTRY]         := DoUntry;
    Table[OP_RAISE]         := DoRaise;
    Table[OP_ENUM]          := DoEnum;
    Table[OP_ENUM_MEMBER]   := DoEnumMember;
    Table[OP_ITER]          := DoIter;
    Table[OP_CELL]          := DoCell;
    Table[OP_GET_BOX]       := DoGetBox;
    Table[OP_SET_BOX]       := DoSetBox;
    Table[OP_GET_CELL]      := DoGetCell;
    Table[OP_SET_CELL]      := DoSetCell;
    Table[OP_CLOSURE]       := DoClosure;
    Table[OP_OVERLOADS]     := DoOverloads;
    Table[OP_BUILTIN]       := DoBuiltin;
    Table[OP_GET_GLOBAL_LONG]    := DoGetGlobalLong;
    Table[OP_DEFINE_GLOBAL_LONG] := DoDefineGlobalLong;
    Table[OP_SET_GLOBAL_LONG]    := DoSetGlobalLong;
    Table[OP_LONG]          := DoWide;
    Table[OP_EXTEND]        := DoExtend;
    Table[OP_INVOKE_EXT]    := DoInvokeExt;
    Table[OP_INVOKE_EXT_NAMED] := DoInvokeExtNamed;
    Table[OP_ADD]      := DoAdd;
    Table[OP_SUBTRACT] := DoSubtract;
    Table[OP_MULTIPLY] := DoMultiply;
    Table[OP_DIVIDE]   := DoDivide;
    Table[OP_NEGATE]   := DoNegate;
    Table[OP_PRINT]    := DoPrint;
    Table[OP_RETURN]   := DoReturn;

    Exit Table;
end

/// One handler per possible BYTE, indexed by it.
///
/// Sized to every value a byte can take rather than to OP_COUNT, which costs
/// four kilobytes once and buys two things: a byte that is not an instruction
/// reaches DoUnknown and is named, instead of failing as an Array subscript
/// that mentions neither bytecode nor an opcode; and the dispatch loop needs
/// no bounds check, which is a branch removed from the hottest path there is.
///
/// Built once, by the declaration's own initializer, which is what makes
/// dispatch a subscript rather than a search.
var Dispatch : Array := BuildHandlers ();

/// Runs a chunk and answers what its OP_RETURN left on the stack.
///
/// # Raises
///
/// Whatever the instructions raise, unchanged.  A machine that caught and
/// rewrapped them would make a guest program's error harder to read than the
/// same program compiled, and the two are meant to agree.
///
/// # Examples
///
/// See test 'Arithmetic Runs On The Machine'.
function RunChunk (C : Chunk) : Any;
begin
    Running   := C;
    CodeBytes      := C.Code;
    Constants := C.Constants;

    // Sized from the chunk, and nothing is defined until its declaration runs.
    // Array (0) is not legal, so a program with no globals still gets one slot
    // that it never reads.
    GlobalNames := C.GlobalNames;

    var Slots := GlobalNames.Length;
    if Slots < 1 then Slots := 1;

    GlobalCells := Array (Slots);
    WasDefined := Array (Slots);

    for var Slot : Integer := 0; Slot < Slots; Slot := Slot + 1 do
        WasDefined[Slot] := False;

    IP         := 0;
    SP         := 0;
    Base       := 0;
    FrameDepth := 0;
    TryDepth   := 0;
    Cells      := List ();
    Answer     := Nil;
    Live       := True;
    Tick       := 0;

    Exit RunLoop ();
end

/// Runs a chunk against the globals an earlier run already defined.
///
/// RunChunk SIZES the globals from the chunk it is given and clears them, which
/// is right for starting a program and wrong for anything after: a second call
/// would wipe every definition the first made.  So a run that continues one --
/// a test body called after the script that bound it -- enters here instead,
/// and the globals are whatever the script left.
///
/// The frame and value stacks are reset, because what is being entered is a
/// fresh call and not a resumption.
function ContinueWith (C : Chunk) : Any;
begin
    Running   := C;
    CodeBytes := C.Code;
    Constants := C.Constants;

    IP         := 0;
    SP         := 0;
    Base       := 0;
    FrameDepth := 0;
    TryDepth   := 0;
    Cells      := List ();
    Answer     := Nil;
    Live       := True;

    Exit RunLoop ();
end

/// The dispatch loop, which is the machine.
///
/// Separate from the setup above it so that both ways in share it exactly --
/// a second copy would be a second safe point, a second place a runtime error
/// becomes catchable, and a second thing to keep in step.
function RunLoop () : Any;
begin
    // Two loops, and the outer one is what makes a RUNTIME error catchable
    // [STM-020].  A host error arrives as a String -- 'Division by zero.',
    // 'Index out of range.' -- and is turned into a raise of that String, so a
    // program can catch the language's own diagnostics.  One try for the whole
    // run rather than one per instruction: the cost is paid on the way IN, and
    // re-entered only when something is actually caught.
    while Live do
        try
            while Live do
            begin
                var Op := ReadByte ();

                Dispatch[Op] ();

                // THE SAFE POINT.  An instruction has just finished, so every
                // live guest value is on Slots or in a module-level variable
                // and no handler is part-way through -- the one place a
                // collection can see everything [RT-029].
                //
                // Counted rather than asked, because asking costs a call and
                // this runs per instruction.  COLLECT_EVERY is a policy and
                // nothing more: too small spends the frame marking, too large
                // lets the arena climb between collections.
                Tick := Tick + 1;

                if COLLECT_EVERY > 0 and Tick >= COLLECT_EVERY then
                begin
                    Tick := 0;

                    Collect ();
                end
            end
        except
            on e : String do
                // Nothing protecting it means the program's error escapes,
                // and it escapes as the same String the interpreter reports.
                if not Unwind (e) then raise e;
        end

    Exit Answer;
end


/// Runs OP_NOT over one value, for the truthiness tests.
function NotOf (V : Any) : Any;
begin
    var C := Chunk ();

    C.EmitConstant (V);
    C.Emit (OP_NOT);
    C.Emit (OP_RETURN);

    Exit RunChunk (C);
end

/// Runs `Left and Right` as the emitter would, for the short-circuit tests.
///
/// The shape is clox's: jump over the right-hand side when the left is falsey
/// and leave it on the stack, otherwise discard it and evaluate the right.
function AndOf (Left : Any, Right : Any) : Any;
begin
    var C := Chunk ();

    C.EmitConstant (Left);

    var Short := C.EmitJump (OP_JUMP_IF_FALSE);
    C.Emit (OP_POP);
    C.EmitConstant (Right);
    C.PatchJump (Short);

    C.Emit (OP_RETURN);

    Exit RunChunk (C);
end

/// Runs `Left or Right` as the emitter would.
///
/// One more jump than `and`: falsey falls into the right-hand side, so the
/// truthy path needs a jump of its own over it.
function OrOf (Left : Any, Right : Any) : Any;
begin
    var C := Chunk ();

    C.EmitConstant (Left);

    var Falsey := C.EmitJump (OP_JUMP_IF_FALSE);
    var Done   := C.EmitJump (OP_JUMP);

    C.PatchJump (Falsey);
    C.Emit (OP_POP);
    C.EmitConstant (Right);
    C.PatchJump (Done);

    C.Emit (OP_RETURN);

    Exit RunChunk (C);
end

test 'A Constant Reaches The Slots';
begin
    var C := Chunk ();

    C.EmitConstant (42);
    C.Emit (OP_RETURN);

    AssertEqual (42, RunChunk (C) as Integer);
end

test 'Arithmetic Runs On The Machine';
begin
    // 1 + 2 * 3, in the order a postorder walk emits it.
    var C := Chunk ();

    C.EmitConstant (1);
    C.EmitConstant (2);
    C.EmitConstant (3);
    C.Emit (OP_MULTIPLY);
    C.Emit (OP_ADD);
    C.Emit (OP_RETURN);

    AssertEqual (7, RunChunk (C) as Integer);
end

test 'Subtraction Takes Its Operands In Order';
begin
    var C := Chunk ();

    C.EmitConstant (10);
    C.EmitConstant (4);
    C.Emit (OP_SUBTRACT);
    C.Emit (OP_RETURN);

    AssertEqual (6, RunChunk (C) as Integer);
end

test 'Division Answers A Double As The Language Does';
begin
    var C := Chunk ();

    C.EmitConstant (7);
    C.EmitConstant (2);
    C.Emit (OP_DIVIDE);
    C.Emit (OP_RETURN);

    AssertEqual (3.5, RunChunk (C) as Double);
end

test 'Negation Replaces The Top';
begin
    var C := Chunk ();

    C.EmitConstant (5);
    C.Emit (OP_NEGATE);
    C.Emit (OP_RETURN);

    AssertEqual (-5, RunChunk (C) as Integer);
end

test 'An Unbounded Integer Stays Unbounded On The Machine';
begin
    // The guest's arithmetic is the host's, so LEX-018 holds inside the VM
    // without the VM doing anything about it.
    var C := Chunk ();

    C.EmitConstant (1);
    for var I : Integer := 0; I < 70; I := I + 1 do
    begin
        C.EmitConstant (2);
        C.Emit (OP_MULTIPLY);
    end
    C.Emit (OP_RETURN);

    AssertEqual (1 << 70, RunChunk (C) as Integer);
end

test 'The Slots Underflows Rather Than Reading Rubbish';
begin
    var C := Chunk ();

    C.Emit (OP_ADD);
    C.Emit (OP_RETURN);

    try
        RunChunk (C);
        Fail ('expected a raise');
    except
        on e : String do AssertEqual ('The value stack underflowed.', e);
    end
end

test 'A Byte That Is Not An Instruction Is Named';
begin
    var C := Chunk ();

    C.Write (200);

    try
        RunChunk (C);
        Fail ('expected a raise');
    except
        on e : String do AssertEqual ('No handler for opcode 200.', e);
    end
end

test 'Every Opcode Has A Handler';
begin
    // Asks only whether a handler is REGISTERED, by comparing against the one
    // that refuses -- not whether each opcode works, which needs a stack shaped
    // for it and a constant table set up for it.  An earlier version tried to
    // run every opcode with zero operands and grew a special case per opcode
    // that reads its operand as an index: OP_IS wanted a type name, OP_BUILTIN
    // a built-in name, OP_CALL something callable, and OP_PROPERTY a property.
    // Each one it lacked failed as a refusal that looked like a real finding.
    //
    // A gap in the numbering is what this is for, and that it still catches.
    for var Op : Integer := 0; Op < OP_COUNT; Op := Op + 1 do
        AssertTrue (Dispatch[Op] <> DoUnknown);
end

test 'A While Loop Sums A Range';
begin
    // var S := 0; var I := 0; while I < 10 do begin S := S + I; I := I + 1 end
    //
    // The locals live in the slots the constants were pushed into: S is slot
    // 0 and I is slot 1, which is what lets OP_GET_LOCAL be a subscript.
    var C := Chunk ();

    C.EmitConstant (0);                       // slot 0 -- S
    C.EmitConstant (0);                       // slot 1 -- I

    var Top := C.Count;
    C.EmitWith (OP_GET_LOCAL, 1);
    C.EmitConstant (10);
    C.Emit (OP_LESS);

    var Done := C.EmitJump (OP_JUMP_IF_FALSE);
    C.Emit (OP_POP);                          // the condition

    C.EmitWith (OP_GET_LOCAL, 0);
    C.EmitWith (OP_GET_LOCAL, 1);
    C.Emit (OP_ADD);
    C.EmitWith (OP_SET_LOCAL, 0);
    C.Emit (OP_POP);

    C.EmitWith (OP_GET_LOCAL, 1);
    C.EmitConstant (1);
    C.Emit (OP_ADD);
    C.EmitWith (OP_SET_LOCAL, 1);
    C.Emit (OP_POP);

    C.EmitLoop (Top);
    C.PatchJump (Done);
    C.Emit (OP_POP);                          // the condition

    C.EmitWith (OP_GET_LOCAL, 0);
    C.Emit (OP_RETURN);

    AssertEqual (45, RunChunk (C) as Integer);

    // The two locals, and nothing else: a backward jump that lands early
    // leaves a value behind per iteration, and the answer alone cannot see it.
    AssertEqual (2, SP);
end

test 'A Loop Leaves The Slots Where It Found It';
begin
    // The same shape with an empty body, so the only thing under test is that
    // OP_LOOP lands exactly where EmitLoop aimed it.
    var C := Chunk ();

    C.EmitConstant (0);                       // slot 0 -- the counter

    var Top := C.Count;
    C.EmitWith (OP_GET_LOCAL, 0);
    C.EmitConstant (50);
    C.Emit (OP_LESS);

    var Done := C.EmitJump (OP_JUMP_IF_FALSE);
    C.Emit (OP_POP);

    C.EmitWith (OP_GET_LOCAL, 0);
    C.EmitConstant (1);
    C.Emit (OP_ADD);
    C.EmitWith (OP_SET_LOCAL, 0);
    C.Emit (OP_POP);

    C.EmitLoop (Top);
    C.PatchJump (Done);
    C.Emit (OP_POP);

    C.EmitWith (OP_GET_LOCAL, 0);
    C.Emit (OP_RETURN);

    AssertEqual (50, RunChunk (C) as Integer);
    AssertEqual (1, SP);
end

test 'The Machines Truthiness Is The Languages';
begin
    // Not Lox's: nil, False and the Integer zero are falsey, where 0.0, the
    // empty String and any Char are truthy.  Checked through OP_NOT, which is
    // the only instruction that has to agree about it.
    AssertTrue (NotOf (Nil) as Boolean);
    AssertTrue (NotOf (False) as Boolean);
    AssertTrue (NotOf (0) as Boolean);

    AssertTrue (not (NotOf (0.0) as Boolean));
    AssertTrue (not (NotOf ('') as Boolean));
    AssertTrue (not (NotOf ('0') as Boolean));
end

test 'And Yields An Operand Rather Than A Boolean';
begin
    // 6 and 3 is 3, and 0 and 3 is 0 [EXP-010].  No opcode does this: it is
    // OP_JUMP_IF_FALSE not popping, plus an OP_POP on the path that continues.
    AssertEqual (3, AndOf (6, 3) as Integer);
    AssertEqual (0, AndOf (0, 3) as Integer);
end

test 'Or Yields An Operand Rather Than A Boolean';
begin
    // 6 or 3 is 6, and 0 or 3 is 3 [EXP-010].
    AssertEqual (6, OrOf (6, 3) as Integer);
    AssertEqual (3, OrOf (0, 3) as Integer);
end

test 'A Comparison Of A Char And A String Is Unequal';
begin
    var C := Chunk ();

    C.EmitConstant ('a');                     // a Char
    C.EmitConstant (Str ('a'));               // a String
    C.Emit (OP_EQUAL);
    C.Emit (OP_RETURN);

    AssertTrue (not (RunChunk (C) as Boolean));
end

test 'A Global Round Trips Through Its Slot';
begin
    var C := Chunk ();

    var Total := C.GlobalSlot ('Total');

    C.EmitConstant (41);
    C.EmitWith (OP_DEFINE_GLOBAL, Total);

    C.EmitWith (OP_GET_GLOBAL, Total);
    C.EmitConstant (1);
    C.Emit (OP_ADD);
    C.EmitWith (OP_SET_GLOBAL, Total);
    C.Emit (OP_POP);

    C.EmitWith (OP_GET_GLOBAL, Total);
    C.Emit (OP_RETURN);

    AssertEqual (42, RunChunk (C) as Integer);
    AssertEqual (0, SP);
end

test 'An External Subprogram Calls The Host Rather Than Entering A Frame';
begin
    var C := Chunk ();

    // function TextLength (S : String) : Integer; external 'strlen';
    var Ext := VmFunction ('TextLength', 1);

    Ext.Types.Add ('String');
    Ext.Symbol  := 'strlen';
    Ext.Returns := 'Integer';

    C.EmitConstant (Ext);
    C.EmitConstant ('abc');
    C.EmitWith (OP_CALL, 1);
    C.Emit (OP_RETURN);

    // What is asserted is that the call REACHED the host's Foreign rather than
    // entering a frame -- not the text, which differs by how this file is
    // being run.  Compiled, a build without libffi says
    // 'Foreign calls are not available in this build'.  INTERPRETED, it says
    // 'A foreign call takes at most eight arguments' for a call of one,
    // because the runtime reads a guest List as a host sequence and that is
    // DEF-36 rather than anything this machine did.  Either way the message
    // is the host's and no frame was entered; 0174 compares the compiled text
    // under the compiled machine, which is where it belongs.
    try
        RunChunk (C);

        // A build WITH foreign calls answers 3.
        AssertEqual (3, RunChunk (C));
    except
        on e : String do
            AssertTrue (Pos (Str (e), 'oreign') >= 0);
    end
end

test 'An External Subprogram Still Checks Its Argument Count';
begin
    var C := Chunk ();

    var Ext := VmFunction ('TextLength', 1);

    Ext.Types.Add ('String');
    Ext.Symbol := 'strlen';

    C.EmitConstant (Ext);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_RETURN);

    // The count is checked where EnterFrame would have checked it, because an
    // external never reaches EnterFrame at all.
    try
        RunChunk (C);

        Fail ('expected a count error');
    except
        on e : String do
            AssertEqual ('Expected 1 arguments but got 0.', Str (e));
    end
end

test 'Pointer Is A Testable Type In Every Build';
begin
    // A Pointer is only a VALUE in a build with foreign calls [TYP-017], but
    // the test is answerable in all of them.
    AssertTrue (not TypeMatches (5, 'pointer'));
    AssertTrue (not TypeMatches (Str ('x'), 'pointer'));
end

/// Builds a method of this arity answering this value.
function Answering (Name : String, Types : List, Answer : Any) : VmFunction;
begin
    var F := VmFunction (Name, Types.Length);

    for var T in Types do F.Types.Add (T);

    F.Body.EmitConstant (Answer);
    F.Body.Emit (OP_RETURN);

    Exit F;
end

/// Calls a method on an instance of a class, with these arguments.
function Invoked (Klass : Any, Name : String, Arguments : List) : Any;
begin
    var C := Chunk ();

    C.EmitConstant (VmInstance (Klass));

    for var Each in Arguments do C.EmitConstant (Each);

    C.Write (OP_INVOKE);
    C.Write (C.AddConstant (Name));
    C.Write (Arguments.Length);
    C.Emit (OP_RETURN);

    Exit RunChunk (C);
end

test 'Two Methods Of One Name Are Told Apart At The Call';
begin
    var K := VmClass ('Box');

    K.AddMethod ('Take', Answering ('Take', [Str ('Integer')], 'one'));
    K.AddMethod ('Take', Answering ('Take', [Str ('Integer'), Str ('Integer')], 'two'));

    AssertEqual ('one', Str (Invoked (K, 'Take', [1])));
    AssertEqual ('two', Str (Invoked (K, 'Take', [1, 2])));
    AssertEqual (0, SP);
end

test 'An Exact Match Beats One Needing Widening, Across Methods';
begin
    var K := VmClass ('Box');

    // Declared Double FIRST, so declaration order would pick it for a Char
    // if the passes did not run exact before widening.
    K.AddMethod ('Take', Answering ('Take', [Str ('Double')], 'as a double'));
    K.AddMethod ('Take', Answering ('Take', [Str ('Integer')], 'as an integer'));

    AssertEqual ('as an integer', Str (Invoked (K, 'Take', [7])));
    AssertEqual ('as a double',   Str (Invoked (K, 'Take', [7.5])));
end

test 'Each Pass Runs The Whole Chain Before The Next Begins';
begin
    var Parent := VmClass ('Above');
    var Child  := VmClass ('Below');

    Child.Parent := Parent;

    // The PARENT answers an Integer exactly; the CHILD would take one by
    // widening it to a Double.  The parent has to win [EXP-014], or adding an
    // overload to a subclass silently captures calls the parent answered
    // exactly.  A class-at-a-time walk would pick the child.
    Parent.AddMethod ('Take', Answering ('Take', [Str ('Integer')], 'the parent'));
    Child.AddMethod  ('Take', Answering ('Take', [Str ('Double')],  'the child'));

    AssertEqual ('the parent', Str (Invoked (Child, 'Take', [7])));

    // And a Double reaches the child, which is the only one that fits it.
    AssertEqual ('the child', Str (Invoked (Child, 'Take', [7.5])));
end

test 'A Subclass Does Not Hide An Inherited Overload Of Another Arity';
begin
    var Parent := VmClass ('Above');
    var Child  := VmClass ('Below');

    Child.Parent := Parent;

    // A failed match in the child must FALL THROUGH rather than return, or a
    // class declaring Take (String) hides an inherited Take (Integer).
    Parent.AddMethod ('Take', Answering ('Take', [Str ('Integer')], 'inherited'));
    Child.AddMethod  ('Take', Answering ('Take', [Str ('String')],  'declared'));

    AssertEqual ('inherited', Str (Invoked (Child, 'Take', [7])));
    AssertEqual ('declared',  Str (Invoked (Child, 'Take', [Str ('x')])));
end

test 'A Name That Fits Nothing Is A Selection Failure, Not A Missing Method';
begin
    var K := VmClass ('Box');

    K.AddMethod ('Take', Answering ('Take', [Str ('Integer')], 'one'));

    // Declared but fitting nothing is a SELECTION failure; a method's wrong
    // count reports that where a subprogram's reports the counts [0049].
    try
        Invoked (K, 'Take', [1, 2]);

        Fail ('expected a selection failure');
    except
        on e : String do
            AssertEqual ('No matching signature for function.', Str (e));
    end

    // A name no class in the chain declares is a different report.
    try
        Invoked (K, 'Missing', []);

        Fail ('expected no such method');
    except
        on e : String do AssertEqual ('Box has no method missing.', Str (e));
    end
end

test 'An Exit Inside A Constructor Answers The Instance';
begin
    var K := VmClass ('Thing');

    K.AddField ('N');

    // constructor Init (); begin this.N := 1; Exit; end
    //
    // The early Exit must answer the INSTANCE, not its own value.  Both other
    // processors do -- ObjFunction.Call answers `this` on the Return path as
    // well as on falling off the end -- so a constructor that returns nil is
    // a divergence, and it surfaced two calls later as a member read on nil.
    var Setup := VmFunction ('Init', 0);

    Setup.Body.Emit (OP_THIS);
    Setup.Body.EmitConstant (1);
    Setup.Body.EmitWith (OP_SET_FIELD, Setup.Body.AddConstant ('N'));
    Setup.Body.Emit (OP_POP);

    // The explicit return, as the emitter writes one inside a constructor.
    Setup.Body.Emit (OP_THIS);
    Setup.Body.Emit (OP_RETURN);

    K.AddMethod ('Init', Setup);

    var C := Chunk ();

    C.EmitConstant (K);
    C.EmitWith (OP_CALL, 0);
    C.EmitIndexed (OP_GET_FIELD, C.AddConstant ('N'));
    C.Emit (OP_RETURN);

    // An instance holding what the constructor set, not nil -- reading a
    // member of it is what the Inn did next and what failed.
    AssertEqual (1, RunChunk (C));
end

test 'A Bare Name Is Read As A Field Of The Receiver';
begin
    var C := Chunk ();
    var At := C.GlobalSlot ('Box');

    // class Box; var N : Integer; begin function Twice (); ... end
    var Box := VmClass ('Box');
    Box.Fields.Add ('N');

    // Twice reads N bare, which the emitter turns into `this.N`.
    var Twice := VmFunction ('Twice', 0);

    Twice.Body.Emit (OP_THIS);
    Twice.Body.EmitWith (OP_GET_FIELD, Twice.Body.AddConstant ('N'));
    Twice.Body.EmitConstant (2);
    Twice.Body.Emit (OP_MULTIPLY);
    Twice.Body.Emit (OP_RETURN);

    Box.AddMethod ('Twice', Twice);

    var It := VmInstance (Box);

    // Keyed with Str, because a field map's keys are STRINGS and a
    // one-character literal is a Char [TYP-003] -- putting `'n'` added a
    // SECOND entry under a Char key, and the String one still held nil.  The
    // symptom read as `MemberOf` being broken.
    It.Fields.Put (Str ('n'), 21);

    C.EmitConstant (It);
    C.Write (OP_INVOKE);
    C.Write (C.AddConstant ('Twice'));
    C.Write (0);
    C.Emit (OP_RETURN);

    AssertEqual (42, RunChunk (C));
    AssertEqual (0, SP);
end

test 'A Bare Call Reaches A Method Of The Receiver';
begin
    var C := Chunk ();

    // A method calling another of its own class bare, which is how the
    // library writes `while not AtEnd () do`.
    var Box := VmClass ('Box');

    var Inner := VmFunction ('AtEnd', 0);
    Inner.Body.EmitConstant (True);
    Inner.Body.Emit (OP_RETURN);

    var Outer := VmFunction ('Check', 0);
    Outer.Body.Emit (OP_THIS);
    Outer.Body.Write (OP_INVOKE);
    Outer.Body.Write (Outer.Body.AddConstant ('AtEnd'));
    Outer.Body.Write (0);
    Outer.Body.Emit (OP_RETURN);

    Box.AddMethod ('AtEnd', Inner);
    Box.AddMethod ('Check', Outer);

    C.EmitConstant (VmInstance (Box));
    C.Write (OP_INVOKE);
    C.Write (C.AddConstant ('Check'));
    C.Write (0);
    C.Emit (OP_RETURN);

    AssertEqual (True, RunChunk (C));
    AssertEqual (0, SP);
end

test 'A Local Beyond The First 256 Is Read Through The Long Prefix';
begin
    var F := VmFunction ('Deep', 0);

    // Fill the frame past a byte's reach, then read the far slot.
    for var I : Integer := 0; I < 300; I := I + 1 do
    begin
        F.Body.EmitConstant (I);
        F.Body.Emit (OP_POP);
    end

    // Slot 300 holds 42; everything below it is whatever the frame began with,
    // so the test is about the OPERAND and not about the values.
    for var I : Integer := 0; I < 300; I := I + 1 do F.Body.EmitConstant (0);

    F.Body.EmitConstant (42);
    F.Body.EmitIndexed (OP_GET_LOCAL, 300);
    F.Body.Emit (OP_RETURN);

    var C := Chunk ();

    C.EmitConstant (F);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_RETURN);

    AssertEqual (42, RunChunk (C));
end

test 'A Local Slot Is A Widenable Operand Like An Index';
begin
    // Both widen and neither is a mere byte, which is what OpShape records so
    // a disassembler knows which operand to read as a short.
    AssertEqual (Str ('l'), Str (OpShape (OP_GET_LOCAL)));
    AssertEqual (Str ('l'), Str (OpShape (OP_SET_CELL)));
    AssertEqual (Str ('i'), Str (OpShape (OP_CONSTANT)));
    AssertEqual (Str ('b'), Str (OpShape (OP_CALL)));
end

test 'A Constant Beyond The First 256 Is Read Through The Long Prefix';
begin
    var C := Chunk ();

    // Fill past a byte's reach with distinct values, so interning cannot
    // collapse them back under 256.
    for var I : Integer := 0; I < 300; I := I + 1 do
        C.AddConstant ('filler ' + Str (I));

    var Far := C.AddConstant (42);

    AssertTrue (Far > 255);

    C.EmitIndexed (OP_CONSTANT, Far);
    C.Emit (OP_RETURN);

    AssertEqual (42, RunChunk (C));
    AssertEqual (0, SP);
end

test 'The Long Prefix Widens Only The Index Beside Other Operands';
begin
    var C := Chunk ();

    for var I : Integer := 0; I < 300; I := I + 1 do
        C.AddConstant ('filler ' + Str (I));

    // OP_OVERLOADS carries its COUNT first and its index second, so a prefix
    // that widened "the first operand" would read the count as a short and
    // the whole instruction after it would be misaligned.
    var Named := C.AddConstant ('Take');

    AssertTrue (Named > 255);

    C.EmitConstant (Candidate ('Take', [Str ('Integer')], 'one'));
    C.EmitConstant (Candidate ('Take', [Str ('Integer'), Str ('Integer')], 'two'));

    C.WriteIndexed (OP_OVERLOADS, Named);
    C.Write (2);
    C.WriteIndex (Named);

    C.EmitConstant (1);
    C.EmitConstant (2);
    C.EmitWith (OP_CALL, 2);
    C.Emit (OP_RETURN);

    AssertEqual ('two', Str (RunChunk (C)));
    AssertEqual (0, SP);
end

test 'A Narrow Instruction After A Long One Is Still Narrow';
begin
    var C := Chunk ();

    for var I : Integer := 0; I < 300; I := I + 1 do
        C.AddConstant ('filler ' + Str (I));

    var Far  := C.AddConstant (40);
    var Near := C.AddConstant (2);

    AssertTrue (Far > 255);
    AssertTrue (Near > 255);

    // Two widened instructions in a row: the flag has to be cleared by the
    // first index READ, or the second reads one byte and then drifts.
    C.EmitIndexed (OP_CONSTANT, Far);
    C.EmitIndexed (OP_CONSTANT, Near);
    C.Emit (OP_ADD);
    C.Emit (OP_RETURN);

    AssertEqual (42, RunChunk (C));
end

test 'A Global Beyond The First 256 Is Read Through The Wide Form';
begin
    var C := Chunk ();

    // Claim enough slots that the one wanted cannot be addressed by a byte.
    for var I : Integer := 0; I < 300; I := I + 1 do
        C.GlobalSlot ('Filler' + Str (I));

    var Far := C.GlobalSlot ('Answer');

    AssertTrue (Far > 255);

    C.EmitConstant (42);
    C.EmitWide (OP_DEFINE_GLOBAL_LONG, Far);

    C.EmitWide (OP_GET_GLOBAL_LONG, Far);
    C.Emit (OP_RETURN);

    AssertEqual (42, RunChunk (C));
    AssertEqual (0, SP);
end

test 'A Wide Slot Names Its Variable In A Diagnostic Too';
begin
    var C := Chunk ();

    for var I : Integer := 0; I < 300; I := I + 1 do
        C.GlobalSlot ('Filler' + Str (I));

    var Far := C.GlobalSlot ('Missing');

    // Read without a declaration: the wide form has to reach GlobalNames the
    // same way the narrow one does, or the message loses the name.
    C.EmitWide (OP_GET_GLOBAL_LONG, Far);
    C.Emit (OP_RETURN);

    try
        RunChunk (C);

        Fail ('expected an undefined variable');
    except
        on e : String do
            AssertEqual ('Undefined variable ' + QUOTE + 'Missing' + QUOTE + '.',
                         Str (e));
    end
end

test 'A Global Read Above Its Declaration Is Named';
begin
    // What a module-level subprogram called before its own globals does, and
    // the reason the chunk keeps GlobalNames at all.
    var C := Chunk ();

    var Later := C.GlobalSlot ('Later');

    C.EmitWith (OP_GET_GLOBAL, Later);
    C.Emit (OP_RETURN);

    try
        RunChunk (C);
        Fail ('expected a raise');
    except
        on e : String do
            AssertEqual ('Undefined variable ''Later''.', e);
    end
end

test 'A Declaration With No Initializer Defines A Global As Nil';
begin
    // 'var X;' answers nil rather than being undefined -- a DECLARATION is
    // what defines a global, which is what OP_DEFINE_GLOBAL models.
    var C := Chunk ();

    var X := C.GlobalSlot ('X');

    C.Emit (OP_NIL);
    C.EmitWith (OP_DEFINE_GLOBAL, X);
    C.EmitWith (OP_GET_GLOBAL, X);
    C.Emit (OP_RETURN);

    AssertTrue (RunChunk (C) = Nil);
end

test 'Assigning A Global Leaves Its Value For An Expression';
begin
    // Assignment is an expression here, so OP_SET_GLOBAL leaves the value and
    // a statement that wants it gone emits its own OP_POP.
    var C := Chunk ();

    var X := C.GlobalSlot ('X');

    C.Emit (OP_NIL);
    C.EmitWith (OP_DEFINE_GLOBAL, X);

    C.EmitConstant (9);
    C.EmitWith (OP_SET_GLOBAL, X);
    C.Emit (OP_RETURN);

    AssertEqual (9, RunChunk (C) as Integer);
end

test 'GlobalCells And Locals Do Not Share Slots';
begin
    // A global slot indexes GlobalCells and a local slot indexes the value stack,
    // so slot 0 means two different things and must not be confused.
    var C := Chunk ();

    var G := C.GlobalSlot ('G');

    C.EmitConstant (100);
    C.EmitWith (OP_DEFINE_GLOBAL, G);

    C.EmitConstant (7);                       // local slot 0

    C.EmitWith (OP_GET_GLOBAL, G);
    C.EmitWith (OP_GET_LOCAL, 0);
    C.Emit (OP_ADD);
    C.Emit (OP_RETURN);

    AssertEqual (107, RunChunk (C) as Integer);
end

test 'A Call Runs A Frame And Comes Back';
begin
    // function Twice (N) begin Exit N * 2; end  -- then Twice (21)
    var Twice := VmFunction ('Twice', 1);
    Twice.Body.EmitWith (OP_GET_LOCAL, 0);      // the argument is slot 0
    Twice.Body.EmitConstant (2);
    Twice.Body.Emit (OP_MULTIPLY);
    Twice.Body.Emit (OP_RETURN);

    var C := Chunk ();
    C.EmitConstant (Twice);
    C.EmitConstant (21);
    C.EmitWith (OP_CALL, 1);
    C.Emit (OP_RETURN);

    AssertEqual (42, RunChunk (C) as Integer);

    // The callee and its argument are both gone: a frame leaves nothing.
    AssertEqual (0, SP);
end

test 'A Frames Locals Do Not Reach Its Callers';
begin
    // The callee's slot 0 is its own argument and not the caller's local, which
    // is the whole of what FrameBase buys.
    var Inner := VmFunction ('Inner', 1);
    Inner.Body.EmitWith (OP_GET_LOCAL, 0);
    Inner.Body.Emit (OP_RETURN);

    var C := Chunk ();
    C.EmitConstant (111);                       // the caller's slot 0
    C.EmitConstant (Inner);
    C.EmitConstant (222);
    C.EmitWith (OP_CALL, 1);

    // 222 from the callee, and the caller's 111 still beneath it.
    C.EmitWith (OP_GET_LOCAL, 0);
    C.Emit (OP_ADD);
    C.Emit (OP_RETURN);

    AssertEqual (333, RunChunk (C) as Integer);
end

test 'Recursion Nests Frames';
begin
    // function Down (N) begin if N = 0 then Exit 0; Exit N + Down (N - 1); end
    //
    // A chunk refers to ITSELF through a global slot, which is what lets a
    // subprogram recurse without the constant table holding a cycle.
    var C := Chunk ();
    var Slot := C.GlobalSlot ('Down');

    var Down := VmFunction ('Down', 1);
    var B := Down.Body;
    var DownSlot := B.GlobalSlot ('Down');

    B.EmitWith (OP_GET_LOCAL, 0);
    B.EmitConstant (0);
    B.Emit (OP_EQUAL);
    var Deeper := B.EmitJump (OP_JUMP_IF_FALSE);
    B.Emit (OP_POP);
    B.EmitConstant (0);
    B.Emit (OP_RETURN);
    B.PatchJump (Deeper);
    B.Emit (OP_POP);

    B.EmitWith (OP_GET_LOCAL, 0);
    B.EmitWith (OP_GET_GLOBAL, DownSlot);
    B.EmitWith (OP_GET_LOCAL, 0);
    B.EmitConstant (1);
    B.Emit (OP_SUBTRACT);
    B.EmitWith (OP_CALL, 1);
    B.Emit (OP_ADD);
    B.Emit (OP_RETURN);

    C.EmitConstant (Down);
    C.EmitWith (OP_DEFINE_GLOBAL, Slot);
    C.EmitWith (OP_GET_GLOBAL, Slot);
    C.EmitConstant (10);
    C.EmitWith (OP_CALL, 1);
    C.Emit (OP_RETURN);

    AssertEqual (55, RunChunk (C) as Integer);
    AssertEqual (0, SP);
end

test 'A Subprograms Wrong Count Names The Counts';
begin
    var F := VmFunction ('Twice', 1);
    F.Body.Emit (OP_NIL);
    F.Body.Emit (OP_RETURN);

    var C := Chunk ();
    C.EmitConstant (F);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_RETURN);

    try
        RunChunk (C);
        Fail ('expected a raise');
    except
        on e : String do
            // A subprogram and a constructor name the counts; only a METHOD
            // reports a selection failure [0049].
            AssertEqual ('Expected 1 arguments but got 0.', e);
    end
end

test 'Calling Something That Is Not A Subprogram Is Refused';
begin
    var C := Chunk ();

    C.EmitConstant (7);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_RETURN);

    try
        RunChunk (C);
        Fail ('expected a raise');
    except
        on e : String do AssertEqual ('Can only call functions and classes.', e);
    end
end

test 'Runaway Recursion Overflows The Call Slots Rather Than Memory';
begin
    // function Forever () begin Exit Forever (); end
    var C := Chunk ();
    var Slot := C.GlobalSlot ('Forever');

    var F := VmFunction ('Forever', 0);
    F.Body.EmitWith (OP_GET_GLOBAL, F.Body.GlobalSlot ('Forever'));
    F.Body.EmitWith (OP_CALL, 0);
    F.Body.Emit (OP_RETURN);

    C.EmitConstant (F);
    C.EmitWith (OP_DEFINE_GLOBAL, Slot);
    C.EmitWith (OP_GET_GLOBAL, Slot);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_RETURN);

    try
        RunChunk (C);
        Fail ('expected a raise');
    except
        on e : String do AssertEqual ('The call stack overflowed.', e);
    end
end

/// Runs one binary opcode over two constants, for the operator tests.
function BinaryOf (Left : Any, Op : Integer, Right : Any) : Any;
begin
    var C := Chunk ();

    C.EmitConstant (Left);
    C.EmitConstant (Right);
    C.Emit (Op);
    C.Emit (OP_RETURN);

    Exit RunChunk (C);
end

test 'Shifting Right Is Not Dividing';
begin
    // >> floors where div truncates toward zero, so they disagree exactly
    // where the shifted-out bits are not zero [EXP-024].
    AssertEqual (-4, BinaryOf (-7, OP_SHIFT_RIGHT, 1) as Integer);
    AssertEqual (-3, BinaryOf (-7, OP_DIV, 2) as Integer);

    // And agree where they are.
    AssertEqual (4, BinaryOf (8, OP_SHIFT_RIGHT, 1) as Integer);
    AssertEqual (4, BinaryOf (8, OP_DIV, 2) as Integer);
end

test 'A Shift Grows Rather Than Wrapping';
begin
    // The machine inherits an unbounded Integer because a guest value IS a
    // host value, so [LEX-018] holds without the machine doing anything.
    AssertEqual (1 << 70, BinaryOf (1, OP_SHIFT_LEFT, 70) as Integer);
    AssertEqual (-1, BinaryOf (0, OP_BIT_XOR, -1) as Integer);
end

test 'And Is Not Bitwise On The Machine Either';
begin
    // 6 & 3 is 2 where `6 and 3` is 3, and the machine keeps them apart
    // because they are different instructions -- OP_BIT_AND against a jump.
    AssertEqual (2, BinaryOf (6, OP_BIT_AND, 3) as Integer);
    AssertEqual (3, AndOf (6, 3) as Integer);
end

test 'Dividing By Zero Raises Where Real Division Does Not';
begin
    // div and mod are the only things that raise on a zero divisor; 7 / 0 is
    // Infinity.  The machine asks the host, so it inherits both answers.
    AssertTrue (BinaryOf (7, OP_DIVIDE, 0) > 0);

    try
        BinaryOf (7, OP_DIV, 0);
        Fail ('expected a raise');
    except
        on e : String do AssertTrue (Pos (ToLower (e), 'zero') >= 0);
    end
end

test 'Is Answers False For A Type The Value Is Not';
begin
    var C := Chunk ();

    C.EmitConstant (1);
    C.EmitWith (OP_IS, C.AddConstant ('Integer'));
    C.Emit (OP_RETURN);

    AssertTrue (RunChunk (C) as Boolean);

    // A declared class or enumeration the value is not of answers FALSE
    // rather than raising -- `5 is Dog` is a fair question with a boring
    // answer, and the emitter is what refuses a name nothing can test.
    var D := Chunk ();

    D.EmitConstant (1);
    D.EmitWith (OP_IS, D.AddConstant ('Dog'));
    D.Emit (OP_RETURN);

    AssertTrue (not (RunChunk (D) as Boolean));
end

test 'A List Literal Keeps Its Source Order';
begin
    // Read off the stack by index rather than popped, because popping would
    // reverse them -- and a reversed list literal reads as a parser bug.
    var C := Chunk ();

    C.EmitConstant (10);
    C.EmitConstant (20);
    C.EmitConstant (30);
    C.EmitWide (OP_LIST, 3);
    C.Emit (OP_RETURN);

    var L := RunChunk (C);

    AssertEqual (3, L.Length);
    AssertEqual (10, L[0] as Integer);
    AssertEqual (30, L[2] as Integer);
    AssertEqual (0, SP);
end

test 'An Empty List Literal Is A List';
begin
    var C := Chunk ();

    C.EmitWide (OP_LIST, 0);
    C.Emit (OP_RETURN);

    AssertEqual (0, RunChunk (C).Length);
end

test 'A Map Literal Pairs Its Keys And Values';
begin
    var C := Chunk ();

    C.EmitConstant ('a');
    C.EmitConstant (1);
    C.EmitConstant ('b');
    C.EmitConstant (2);
    C.EmitWide (OP_MAP, 2);
    C.Emit (OP_RETURN);

    var M := RunChunk (C);

    AssertEqual (2, M.Length);
    AssertEqual (1, M['a'] as Integer);
    AssertEqual (2, M['b'] as Integer);
end

test 'A Subscript Reads And Writes';
begin
    var C := Chunk ();

    C.EmitConstant (1);
    C.EmitConstant (2);
    C.EmitConstant (3);
    C.EmitWide (OP_LIST, 3);                  // local slot 0

    C.EmitWith (OP_GET_LOCAL, 0);
    C.EmitConstant (1);
    C.EmitConstant (99);
    C.Emit (OP_SUBSCRIPT_SET);
    C.Emit (OP_POP);

    C.EmitWith (OP_GET_LOCAL, 0);
    C.EmitConstant (1);
    C.Emit (OP_SUBSCRIPT_GET);
    C.Emit (OP_RETURN);

    AssertEqual (99, RunChunk (C) as Integer);
end

test 'A Property Is Read By Name';
begin
    var C := Chunk ();

    C.EmitConstant ('hello');
    C.EmitWith (OP_PROPERTY, C.AddConstant ('Length'));
    C.Emit (OP_RETURN);

    AssertEqual (5, RunChunk (C) as Integer);
end

test 'A Property The Machine Has No Arm For Is Named';
begin
    var C := Chunk ();

    C.EmitConstant ('hello');
    C.EmitWith (OP_PROPERTY, C.AddConstant ('Nonesuch'));
    C.Emit (OP_RETURN);

    try
        RunChunk (C);
        Fail ('expected a raise');
    except
        on e : String do
            // The interpreter's wording, echoing the spelling the program
            // wrote rather than the folded one used for the lookup.
            AssertEqual ('Undefined property ''Nonesuch''.', e);
    end
end

/// Invokes one method on a receiver, for the method tests.
function InvokeOn (Receiver : Any, Name : String, Args : List) : Any;
begin
    var C := Chunk ();

    C.EmitConstant (Receiver);

    for var Argument in Args do C.EmitConstant (Argument);

    C.Write (OP_INVOKE);
    C.Write (C.AddConstant (Name));
    C.Write (Args.Length);
    C.Emit (OP_RETURN);

    Exit RunChunk (C);
end

test 'A Method Answers Its Result And Not Nil';
begin
    // Remove answers different kinds of thing by kind [COL-011]: the value
    // removed from a Map, and a Boolean from a Set.  Treating every method
    // that reads like a procedure as void returned nil for both, and the
    // corpus caught it in 0079-collection-behavior.
    var M := Map ();
    M.Put (1, 'one');

    AssertEqual ('one', Str (InvokeOn (M, 'Remove', [1])));
    AssertTrue (InvokeOn (M, 'Remove', [99]) = Nil);

    var S := Set ();
    S.Add (5);

    AssertTrue (InvokeOn (S, 'Remove', [5]) as Boolean);
    AssertTrue (not (InvokeOn (S, 'Remove', [5]) as Boolean));
end

test 'One Method Name Means Different Things At Different Arities';
begin
    // Append with one argument is a Buffer's and with none is a TextFile's,
    // which is why the dispatch is keyed on the count as well as the name.
    var B := Buffer ();

    InvokeOn (B, 'Append', ['hi']);

    AssertEqual ('hi', B.Text);
end

test 'A Member That Is Not A Method At All Is An Undefined Property';
begin
    // The interpreter's wording: a name that is not one of the host's methods
    // is a PROPERTY that does not exist, which is what reaching for a built-in
    // function as though it were a member looks like [0180].
    try
        InvokeOn (List (), 'Nonesuch', []);
        Fail ('expected a raise');
    except
        on e : String do
            AssertEqual ('Undefined property ''Nonesuch''.', e);
    end
end

test 'A Real Method At The Wrong Arity Names The Arity';
begin
    try
        InvokeOn (List (), 'Add', [1, 2]);
        Fail ('expected a raise');
    except
        on e : String do
            AssertEqual ('No method add taking 2 arguments.', e);
    end
end

test 'A Method Leaves The Stack Where It Found It';
begin
    var L := List ();

    InvokeOn (L, 'Add', [1]);

    AssertEqual (0, SP);
end

test 'An Instance Carries Its Fields And Finds Its Methods';
begin
    var K := VmClass ('Point');
    K.AddField ('X');

    var Setup := VmFunction ('Init', 1);
    Setup.Body.Emit (OP_THIS);
    Setup.Body.EmitWith (OP_GET_LOCAL, 0);
    Setup.Body.EmitWith (OP_SET_FIELD, Setup.Body.AddConstant ('X'));
    Setup.Body.Emit (OP_POP);
    Setup.Body.Emit (OP_THIS);
    Setup.Body.Emit (OP_RETURN);
    K.AddMethod ('Init', Setup);

    var Twice := VmFunction ('Twice', 0);
    Twice.Body.Emit (OP_THIS);
    Twice.Body.EmitWith (OP_GET_FIELD, Twice.Body.AddConstant ('X'));
    Twice.Body.EmitConstant (2);
    Twice.Body.Emit (OP_MULTIPLY);
    Twice.Body.Emit (OP_RETURN);
    K.AddMethod ('Twice', Twice);

    var C := Chunk ();
    C.EmitConstant (K);
    C.EmitConstant (21);
    C.EmitWith (OP_CALL, 1);

    C.EmitWith (OP_GET_LOCAL, 0);
    C.Write (OP_INVOKE);
    C.Write (C.AddConstant ('Twice'));
    C.Write (0);
    C.Emit (OP_RETURN);

    AssertEqual (42, RunChunk (C) as Integer);
end

test 'A Class With No Constructor Still Answers An Instance';
begin
    var C := Chunk ();

    C.EmitConstant (VmClass ('Empty'));
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_RETURN);

    AssertTrue (RunChunk (C) is VmInstance);
    AssertEqual (0, SP);
end

test 'ClassName Answers Ahead Of A Field Of That Name';
begin
    // The name belongs to the language, so a field cannot take it [CLS-008].
    var K := VmClass ('Thing');
    K.AddField ('ClassName');

    var C := Chunk ();
    C.EmitConstant (K);
    C.EmitWith (OP_CALL, 0);
    C.EmitWith (OP_GET_FIELD, C.AddConstant ('ClassName'));
    C.Emit (OP_RETURN);

    AssertEqual ('Thing', Str (RunChunk (C)));
end

test 'A Member Nothing Answers Is Named As Undefined';
begin
    var C := Chunk ();

    C.EmitConstant (VmClass ('Thing'));
    C.EmitWith (OP_CALL, 0);
    C.EmitWith (OP_GET_FIELD, C.AddConstant ('Nope'));
    C.Emit (OP_RETURN);

    try
        RunChunk (C);
        Fail ('expected a raise');
    except
        on e : String do
            AssertEqual ('Undefined property ' + QUOTE + 'Nope' + QUOTE + '.', e);
    end
end

test 'Extending Something That Is Not A Class Is Refused';
begin
    var C := Chunk ();

    C.EmitWith (OP_CLASS, C.AddConstant ('C'));
    C.EmitConstant (1);
    C.EmitWith (OP_INHERIT, C.AddConstant ('X'));
    C.Emit (OP_RETURN);

    try
        RunChunk (C);
        Fail ('expected a raise');
    except
        on e : String do
            AssertEqual (QUOTE + 'X' + QUOTE + ' is not a class.', e);
    end
end

test 'Widening Converts Only What The Language Says It Does';
begin
    var C := Chunk ();

    C.EmitConstant (1);
    C.EmitWith (OP_WIDEN, C.AddConstant ('Double'));
    C.Emit (OP_RETURN);

    AssertEqual (1.0, RunChunk (C) as Double);

    // And leaves everything else alone.
    var D := Chunk ();

    D.EmitConstant (7);
    D.EmitWith (OP_WIDEN, D.AddConstant ('Integer'));
    D.Emit (OP_RETURN);

    AssertEqual (7, RunChunk (D) as Integer);
end

test 'An Enum Member Is Falsey At Ordinal Zero';
begin
    // The one place an enumeration touches truthiness [ENU-009], and the one
    // thing the host cannot answer: it sees an object, and every object is
    // truthy to it.
    var T := VmEnumType ('Colour');
    var Red := T.AddMember ('RED');
    var Green := T.AddMember ('GREEN');

    AssertTrue (not Truthy (Red));
    AssertTrue (Truthy (Green));

    // And the host disagrees, which is the whole reason Truthy exists: it
    // sees one of the machine's objects and calls every object truthy.
    AssertTrue (Red);
end

test 'A Member Renders As Its Bare Name';
begin
    var T := VmEnumType ('Colour');

    AssertEqual ('RED', Str (Rendered (T.AddMember ('RED'))));
end

test 'For In Walks Every Kind Of Collection';
begin
    // OP_ITER asks the HOST what to visit, so a Map yields keys and a String
    // yields Chars without the machine deciding either.
    var C := Chunk ();

    C.EmitConstant (Str ('abc'));
    C.Emit (OP_ITER);
    C.Emit (OP_RETURN);

    var Chars := RunChunk (C);

    AssertEqual (3, Chars.Length);
    // Str of a Char is a String, and a Char never equals one [TYP-003], so
    // the expectation is widened too rather than compared across the two.
    AssertEqual (Str ('a'), Str (Chars[0]));

    var D := Chunk ();
    var M := Map ();
    M.Put (Str ('k'), 1);

    D.EmitConstant (M);
    D.Emit (OP_ITER);
    D.Emit (OP_RETURN);

    AssertEqual (Str ('k'), Str (RunChunk (D)[0]));
end

test 'A Raise Unwinds To The Innermost Handler';
begin
    var C := Chunk ();

    var Opened := C.EmitJump (OP_TRY);
    C.EmitConstant (42);
    C.Emit (OP_RAISE);
    C.Emit (OP_UNTRY);
    var Survived := C.EmitJump (OP_JUMP);

    C.PatchJump (Opened);
    C.Emit (OP_RETURN);                       // the raised value is on top

    C.PatchJump (Survived);
    C.Emit (OP_NIL);
    C.Emit (OP_RETURN);

    AssertEqual (42, RunChunk (C) as Integer);
end

test 'A Raise Carries Any Value, Not Only A String';
begin
    // The machine unwinds its OWN handler stack rather than using a host
    // exception, which is what lets a raise carry an instance or a number
    // [STM-016] -- a host exception carries a String.
    var K := VmClass ('Boom');

    var C := Chunk ();

    var Opened := C.EmitJump (OP_TRY);
    C.EmitConstant (K);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_RAISE);
    C.Emit (OP_UNTRY);
    var Survived := C.EmitJump (OP_JUMP);

    C.PatchJump (Opened);
    C.Emit (OP_RETURN);

    C.PatchJump (Survived);
    C.Emit (OP_NIL);
    C.Emit (OP_RETURN);

    AssertTrue (RunChunk (C) is VmInstance);
end

test 'A Host Error Is Catchable As A String';
begin
    // The language's own diagnostics are catchable [STM-020], which is what
    // the try around the dispatch loop is for: a host error arrives as a
    // String and becomes a raise of it.
    var C := Chunk ();

    var Opened := C.EmitJump (OP_TRY);
    C.EmitConstant (7);
    C.EmitConstant (0);
    C.Emit (OP_DIV);
    C.Emit (OP_UNTRY);
    var Survived := C.EmitJump (OP_JUMP);

    C.PatchJump (Opened);
    C.Emit (OP_RETURN);

    C.PatchJump (Survived);
    C.Emit (OP_NIL);
    C.Emit (OP_RETURN);

    AssertTrue (Pos (ToLower (Str (RunChunk (C))), 'zero') >= 0);
end

test 'A Handler Several Frames Above The Raise Still Runs';
begin
    // Unwinding discards every frame opened since the try, which is the whole
    // reason a handler records the call depth it was opened at.
    var Deep := VmFunction ('Deep', 0);
    Deep.Body.EmitConstant ('from inside');
    Deep.Body.Emit (OP_RAISE);
    Deep.Body.Emit (OP_NIL);
    Deep.Body.Emit (OP_RETURN);

    var C := Chunk ();

    var Opened := C.EmitJump (OP_TRY);
    C.EmitConstant (Deep);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_UNTRY);
    var Survived := C.EmitJump (OP_JUMP);

    C.PatchJump (Opened);
    C.Emit (OP_RETURN);

    C.PatchJump (Survived);
    C.Emit (OP_NIL);
    C.Emit (OP_RETURN);

    AssertEqual ('from inside', Str (RunChunk (C)));
    AssertEqual (0, FrameDepth);
end

test 'An Uncaught Raise Escapes As The Interpreter Reports It';
begin
    var C := Chunk ();

    C.EmitConstant ('no handler');
    C.Emit (OP_RAISE);
    C.Emit (OP_RETURN);

    try
        RunChunk (C);
        Fail ('expected a raise');
    except
        on e : String do AssertEqual ('no handler', e);
    end
end

test 'A Closure Captures By Reference And Outlives The Call';
begin
    // function MakeCounter (); var Count := 0;
    // begin function Next (); begin Count := Count + 1; Exit Count; end
    //       Exit Next; end
    //
    // Count is boxed because MakeCounter declares a nested subprogram, so Next
    // reads it as a captured CELL and the two see one variable [FUN-009].
    var Next := VmFunction ('Next', 0);
    Next.Body.EmitWith (OP_GET_CELL, 0);
    Next.Body.EmitConstant (1);
    Next.Body.Emit (OP_ADD);
    Next.Body.EmitWith (OP_SET_CELL, 0);
    Next.Body.Emit (OP_RETURN);

    var Make := VmFunction ('MakeCounter', 0);
    Make.Body.EmitConstant (0);
    Make.Body.Emit (OP_CELL);                 // Count, in slot 0, boxed
    Make.Body.Write (OP_CLOSURE);
    Make.Body.Write (Make.Body.AddConstant (Next));
    Make.Body.WriteShort (1);                 // one capture
    Make.Body.Write (1);                      // ... from this frame's own slot
    Make.Body.WriteShort (0);                 // ... slot 0
    Make.Body.Emit (OP_RETURN);

    var C := Chunk ();
    C.EmitConstant (Make);
    C.EmitWith (OP_CALL, 0);                  // the counter, in slot 0

    // Three calls, which must answer 1, 2, 3 -- the capture outliving the call
    // that made it is the whole point.
    C.EmitWith (OP_GET_LOCAL, 0);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_POP);
    C.EmitWith (OP_GET_LOCAL, 0);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_POP);
    C.EmitWith (OP_GET_LOCAL, 0);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_RETURN);

    AssertEqual (3, RunChunk (C) as Integer);
end

test 'Two Closures Over One Subprogram Count Separately';
begin
    // [FUN-010]: each call to the enclosing subprogram makes a FRESH set of
    // captured variables, which is what boxing per call gives.
    var Next := VmFunction ('Next', 0);
    Next.Body.EmitWith (OP_GET_CELL, 0);
    Next.Body.EmitConstant (1);
    Next.Body.Emit (OP_ADD);
    Next.Body.EmitWith (OP_SET_CELL, 0);
    Next.Body.Emit (OP_RETURN);

    var Make := VmFunction ('MakeCounter', 0);
    Make.Body.EmitConstant (0);
    Make.Body.Emit (OP_CELL);
    Make.Body.Write (OP_CLOSURE);
    Make.Body.Write (Make.Body.AddConstant (Next));
    Make.Body.WriteShort (1);
    Make.Body.Write (1);
    Make.Body.WriteShort (0);
    Make.Body.Emit (OP_RETURN);

    var C := Chunk ();
    C.EmitConstant (Make);
    C.EmitWith (OP_CALL, 0);                  // counter A, slot 0
    C.EmitConstant (Make);
    C.EmitWith (OP_CALL, 0);                  // counter B, slot 1

    C.EmitWith (OP_GET_LOCAL, 0);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_POP);
    C.EmitWith (OP_GET_LOCAL, 0);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_POP);

    // B has never been called, so it must answer 1 and not 3.
    C.EmitWith (OP_GET_LOCAL, 1);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_RETURN);

    AssertEqual (1, RunChunk (C) as Integer);
end

/// Builds a candidate with written parameter types, for the overload tests.
function Candidate (Name : String, Types : List, Answer : Any) : VmFunction;
begin
    var F := VmFunction (Name, Types.Length);

    for var T in Types do F.Types.Add (T);

    F.Body.EmitConstant (Answer);
    F.Body.Emit (OP_RETURN);

    Exit F;
end

/// Calls an overload set with one argument, for the overload tests.
function CallWith (Set : Any, Argument : Any) : Any;
begin
    var C := Chunk ();

    C.EmitConstant (Set);
    C.EmitConstant (Argument);
    C.EmitWith (OP_CALL, 1);
    C.Emit (OP_RETURN);

    Exit RunChunk (C);
end

test 'Selection Is On The Argument Value, Not On The Call Site';
begin
    // [FUN-013]: the type system is gradual, so a declared type may be Any
    // while the VALUE has a definite type -- which is why no call site can
    // decide this earlier than the call.
    var Set := VmOverloads ('Take');

    Set.Add (Candidate ('Take', [Str ('Integer')], 'took an integer'));
    Set.Add (Candidate ('Take', [Str ('String')],  'took a string'));

    AssertEqual ('took an integer', Str (CallWith (Set, 1)));
    AssertEqual ('took a string',   Str (CallWith (Set, Str ('x'))));
end

test 'An Exact Match Beats One That Needs Widening';
begin
    // Two passes, EXACT then WIDENING, so an Integer takes the Integer
    // candidate even though it would also widen into the Double one.
    var Set := VmOverloads ('Take');

    Set.Add (Candidate ('Take', [Str ('Double')],  'widened'));
    Set.Add (Candidate ('Take', [Str ('Integer')], 'exact'));

    AssertEqual ('exact', Str (CallWith (Set, 1)));

    // And a Double still reaches the Double one.
    AssertEqual ('widened', Str (CallWith (Set, 1.5)));
end

/// Builds an extension taking one argument and answering it doubled.
function Doubler () : VmFunction;
begin
    var F := VmFunction ('Doubled', 1);

    F.Types.Add ('Integer');

    F.Body.EmitWith (OP_GET_LOCAL, 0);
    F.Body.EmitConstant (2);
    F.Body.Emit (OP_MULTIPLY);
    F.Body.Emit (OP_RETURN);

    Exit F;
end

test 'An Extension Answers Where The Receiver Has No Member Of The Name';
begin
    var C := Chunk ();
    var At := C.GlobalSlot ('Doubled');

    C.EmitConstant (Doubler ());
    C.EmitWith (OP_DEFINE_GLOBAL, At);

    // 21.Doubled () -- an Integer answers only to ToString, so the extension
    // is reached and the receiver becomes its first argument.
    C.EmitConstant (21);
    C.Write (OP_INVOKE_EXT);
    C.Write (C.AddConstant ('Doubled'));
    C.Write (0);
    C.Write (At div 256);
    C.Write (At mod 256);
    C.Emit (OP_RETURN);

    AssertEqual (42, RunChunk (C));

    // A correct emitter leaves a balanced stack: Prepend shifts the arguments
    // up by one and the frame has to give that slot back.  RunChunk pops the
    // answer, so balanced is nothing left at all.
    AssertEqual (0, SP);
end

test 'A Member Wins Over An Extension Of The Same Name';
begin
    var C := Chunk ();
    var At := C.GlobalSlot ('Size');

    // An extension that would answer something else entirely.
    var Ext := VmFunction ('Size', 1);
    Ext.Types.Add ('Any');
    Ext.Body.EmitConstant ('from the extension');
    Ext.Body.Emit (OP_RETURN);

    C.EmitConstant (Ext);
    C.EmitWith (OP_DEFINE_GLOBAL, At);

    // A class declaring Size: step 1 of EXP-022 answers, and the extension is
    // never reached.  This is 0190's Box, which is the case that decides it.
    var Box := VmClass ('Box');
    var Own := VmFunction ('Size', 0);

    Own.Body.EmitConstant (7);
    Own.Body.Emit (OP_RETURN);

    Box.AddMethod ('Size', Own);

    C.EmitConstant (VmInstance (Box));
    C.Write (OP_INVOKE_EXT);
    C.Write (C.AddConstant ('Size'));
    C.Write (0);
    C.Write (At div 256);
    C.Write (At mod 256);
    C.Emit (OP_RETURN);

    AssertEqual (7, RunChunk (C));
    AssertEqual (0, SP);
end

test 'An Extension Without A Call Is A Value Bound To Its Receiver';
begin
    var C := Chunk ();
    var At := C.GlobalSlot ('Doubled');

    C.EmitConstant (Doubler ());
    C.EmitWith (OP_DEFINE_GLOBAL, At);

    // `var F := 21.Doubled;` -- no parentheses, so it is a value [FUN-011] --
    // and then F () supplies the receiver the binding kept.
    C.EmitConstant (21);
    C.Write (OP_EXTEND);
    C.Write (C.AddConstant ('Doubled'));
    C.Write (At div 256);
    C.Write (At mod 256);
    C.EmitWith (OP_CALL, 0);
    C.Emit (OP_RETURN);

    AssertEqual (42, RunChunk (C));
    AssertEqual (0, SP);
end

test 'A Receiver With The Member Answers It Rather Than Binding';
begin
    var C := Chunk ();
    var At := C.GlobalSlot ('Length');

    var Ext := VmFunction ('Length', 1);
    Ext.Types.Add ('Any');
    Ext.Body.EmitConstant (-1);
    Ext.Body.Emit (OP_RETURN);

    C.EmitConstant (Ext);
    C.EmitWith (OP_DEFINE_GLOBAL, At);

    // A String responds to Length, so OP_EXTEND reads the member.
    C.EmitConstant ('abcd');
    C.Write (OP_EXTEND);
    C.Write (C.AddConstant ('Length'));
    C.Write (At div 256);
    C.Write (At mod 256);
    C.Emit (OP_RETURN);

    AssertEqual (4, RunChunk (C));
end

test 'What Responds To A Name Is What The Interpreter Says Responds';
begin
    // A String answers to Length and nothing else; a Char to nothing at all,
    // which is what lets an extension take one.
    AssertTrue (RespondsTo ('text', 'Length'));
    AssertTrue (not RespondsTo ('text', 'Trimmed'));
    AssertTrue (not RespondsTo (Char (120), 'Twice'));

    // A number answers to ToString.
    AssertTrue (RespondsTo (7, 'ToString'));
    AssertTrue (not RespondsTo (7, 'Doubled'));

    // A host object answers to its own methods and the five properties.
    AssertTrue (RespondsTo (List (), 'Length'));
    AssertTrue (RespondsTo (List (), 'Add'));
    AssertTrue (not RespondsTo (List (), 'Size'));

    // Nil has nothing, and neither has a subprogram.
    AssertTrue (not RespondsTo (Nil, 'Length'));
    AssertTrue (not RespondsTo (VmFunction ('F', 0), 'Length'));
end

/// Builds a variadic subprogram answering the gathered list's length.
///
/// `procedure Counted (Label : String, Items : List of Integer)`.
function Gathering () : VmFunction;
begin
    var F := VmFunction ('Counted', 2);

    F.Types.Add ('String');
    F.Types.Add ('List');
    F.Element := 'Integer';

    F.Body.EmitWith (OP_GET_LOCAL, 1);
    F.Body.EmitWith (OP_PROPERTY, F.Body.AddConstant ('Length'));
    F.Body.Emit (OP_RETURN);

    Exit F;
end

/// Calls a subprogram with these arguments, answering what it answered.
function CalledWith (Callee : Any, Arguments : List) : Any;
begin
    var C := Chunk ();

    C.EmitConstant (Callee);

    for var Each in Arguments do C.EmitConstant (Each);

    C.EmitWith (OP_CALL, Arguments.Length);
    C.Emit (OP_RETURN);

    Exit RunChunk (C);
end

test 'A Variadic Parameter Gathers The Trailing Arguments';
begin
    AssertEqual (3, CalledWith (Gathering (), ['a', 1, 2, 3]));

    // The stack is balanced afterwards: GatherRest drops the arguments it
    // gathered and pushes one list in their place.
    AssertEqual (0, SP);
end

test 'Gathering Nothing Yields The Empty List';
begin
    // Structural rather than a default: the gathering loop simply runs no
    // times, which is the same rule that gathers three.
    AssertEqual (0, CalledWith (Gathering (), ['a']));
end

test 'An Exact Match Is Preferred To Gathering';
begin
    // The list is PASSED rather than gathered into a second list holding it,
    // because Fits is asked before CanGather [EXP-014].
    AssertEqual (3, CalledWith (Gathering (), ['a', [7, 8, 9]]));
end

test 'The Right Count With The Wrong Type Still Gathers';
begin
    // Two arguments is the arity, so comparing counts alone would pass this
    // straight through with an Integer where the list belongs.
    AssertEqual (1, CalledWith (Gathering (), ['a', 5]));
end

test 'A Stray Argument Of The Wrong Type Is A Selection Failure';
begin
    // The element type REPLACED the arity check and is stricter than it, so
    // this is not 'Expected 2 arguments but got 4'.
    try
        CalledWith (Gathering (), ['a', 1, 2, 'red']);

        Fail ('expected a selection failure');
    except
        on e : String do
            AssertEqual ('No matching signature for function.', Str (e));
    end
end

test 'A Fixed Arity Candidate Beats A Gathering One';
begin
    var Set := VmOverloads ('Pick');

    // Declaration order puts the gathering one FIRST, so if absorption were
    // not the third pass it would win.  It is pass order that decides this
    // and not a rule of its own [EXP-014].
    var Loose := VmFunction ('Pick', 1);
    Loose.Types.Add ('List');
    Loose.Element := 'Integer';
    Loose.Body.EmitConstant ('gathered');
    Loose.Body.Emit (OP_RETURN);

    Set.Add (Loose);
    Set.Add (Candidate ('Pick', [Str ('Integer'), Str ('Integer')], 'fixed'));

    AssertEqual ('fixed', Str (CalledWith (Set, [1, 2])));

    // Three arguments fit no fixed signature, so the third pass answers.
    AssertEqual ('gathered', Str (CalledWith (Set, [1, 2, 3])));
end

test 'Only A List Of Something Absorbs';
begin
    // A bare `List` has no element type to check gathered arguments against,
    // which is what leaves it the spelling for a parameter that wants the
    // list itself and nothing else.  So this is a COUNT error, which is also
    // what says absorption never ran: a variadic mismatch reports a selection
    // failure instead.
    var Bare := VmFunction ('Bare', 1);

    Bare.Types.Add ('List');
    Bare.Body.EmitWith (OP_GET_LOCAL, 0);
    Bare.Body.Emit (OP_RETURN);

    try
        CalledWith (Bare, [4, 5]);

        Fail ('expected a count error');
    except
        on e : String do
            AssertEqual ('Expected 1 arguments but got 2.', Str (e));
    end

    // Asked of the stack, so CanGather is exercised through a call rather than
    // on its own -- it reads the arguments where a frame would find them.
    AssertEqual (2, CalledWith (Bare, [[4, 5]]).Length);
end

test 'Widening Is Tried When Nothing Matches Exactly';
begin
    var Set := VmOverloads ('Take');

    Set.Add (Candidate ('Take', [Str ('Double')], 'as a double'));

    AssertEqual ('as a double', Str (CallWith (Set, 1)));
end

test 'A Tie Within A Pass Goes To The One Declared First';
begin
    var Set := VmOverloads ('Take');

    Set.Add (Candidate ('Take', [Str ('Any')], 'first'));
    Set.Add (Candidate ('Take', [Str ('Any')], 'second'));

    AssertEqual ('first', Str (CallWith (Set, 1)));
end

test 'Nothing Matching Is A Selection Failure';
begin
    var Set := VmOverloads ('Take');

    Set.Add (Candidate ('Take', [Str ('Integer'), Str ('Integer')], 'two'));

    try
        CallWith (Set, 1);
        Fail ('expected a raise');
    except
        on e : String do AssertEqual ('No matching signature for function.', e);
    end
end

test 'An Untyped Parameter Takes Anything';
begin
    var Set := VmOverloads ('Take');

    Set.Add (Candidate ('Take', [Str ('Integer')], 'integer'));
    Set.Add (Candidate ('Take', [Str ('')],        'anything'));

    AssertEqual ('integer',  Str (CallWith (Set, 1)));
    AssertEqual ('anything', Str (CallWith (Set, True)));
end
