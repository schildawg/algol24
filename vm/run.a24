/// Runs a program on the bytecode machine.
///
///     algvm program.a24
///
/// A SECOND BINARY rather than a mode of algc, which is what finished/PROPOSAL-VM.md
/// prefers and what `uses` taking a path makes possible today: the compiler's
/// front end is imported from here instead of this being imported into it.
/// So nothing in `compiler/` changes, the VM stays out of the seed in
/// `bootstrap/`, and a change to an opcode needs no reseed.
///
/// It parses the source itself rather than reading bytecode, because there is
/// no bytecode file format yet.  When there is, this splits in two along the
/// line the proposal draws -- `algc --emit` writing it and this reading it --
/// and the front-end imports below are what goes away.
///
/// The order of the imports is Main.a24's order and must stay that way: a
/// module's functions close over the environment its file was loaded in, so
/// TypeChecker has to come after Parser to reach it.

uses 'compiler/Release';
uses 'compiler/Token';
uses 'compiler/TokenType';

uses 'compiler/Expr';
uses 'compiler/Stmt';

uses 'compiler/Environment';
uses 'compiler/ObjFunction';
uses 'compiler/ObjClass';
uses 'compiler/ObjInstance';
uses 'compiler/ObjEnum';
uses 'compiler/ObjCollection';
uses 'compiler/ObjBuffer';
uses 'compiler/ObjFile';
uses 'compiler/SourceCode';
uses 'compiler/Console';
uses 'compiler/TestReport';

uses 'compiler/Scanner';
uses 'compiler/Parser';

uses 'compiler/TypeChecker';

uses 'compiler/Resolver';
uses 'compiler/Interpreter';

uses 'compiler/VmEmitter';

uses OpCode;
uses Chunk;
uses Vm;

/// Reads a whole file as one String.
///
/// # Raises
///
/// Whatever Reset raises when the file cannot be opened.
function SourceOf (SourcePath : String) : String;
var
    Handle : TextFile;
    Accum  : Buffer;

begin
    Handle := TextFile ();
    Handle.Assign (SourcePath);
    Handle.Reset ();

    // `Buffer ()` and not `Buffer (1024)`: a size pre-fills with that many
    // ZERO bytes, which Append then adds after -- and a Buffer holding a zero
    // byte has no Text.  A size is right for the code array in Chunk, which is
    // indexed, and wrong for anything accumulated.
    Accum := Buffer ();

    while not Handle.Eof do
    begin
        Accum.Append (Handle.ReadLn ());
        Accum.Append (#10);
    end

    Handle.Close ();

    // `.Text` and not `Str (Accum)`.  Str answers a Buffer's PRINTED form --
    // `Buffer(1041)` -- which parsed as a program and failed on the bracket.
    // The same trap as `Length (B)`; see DEF-36.
    Exit Accum.Text;
end

/// Fails the run if anything scanned badly.
///
/// A scan error is RECORDED rather than thrown -- the Scanner sets HadError and
/// keeps the message -- so every driver has to ask.  This one did not, and the
/// corpus found it immediately: `0006-line-endings-lf` expects `Unexpected
/// character: $` and the VM ran the program with the character silently
/// dropped, which is the exact failure Main.a24's own FailIfScanErrors was written
/// for.
///
/// Called TWICE, as Main.a24 calls it: once after scanning for the right
/// message, and once after parsing so that a module loaded by `uses` is
/// covered too.
///
/// # Raises
///
/// The scanner's last message, unchanged.
procedure FailIfScanErrors ();
begin
    if HadError then raise Str (LastError);
end

/// Parses, checks and compiles a program, answering its chunk.
///
/// The front end is the compiler's own, unchanged, which is the invariant the
/// three back ends rest on: a program that fails to parse or type-check fails
/// identically whichever one is asked for.
/// Whether to report what each phase of the compile cost, for `--time`.
var Timing := False;

/// Reports a phase's elapsed time, for `--time`.
procedure Took (What : String, Began : Double);
begin
    if not Timing then Exit;

    WriteLn ('[time] ' + What + ' '
           + Str ((clock () - Began) * 1000.0, 0) + 'ms');
end

function ChunkOf (Source : String, SourcePath : String) : Chunk;
var
    TheScanner     : Scanner;
    TheParser      : Parser;
    TheResolver    : Resolver;
    TheInterpreter : Interpreter;

    Tokens : List;
    Stmts  : List;

begin
    SourceCode.Begins (SourcePath);

    var At := clock ();

    TheScanner := Scanner (Source, SourcePath);
    Tokens := TheScanner.ScanTokens ();
    FailIfScanErrors ();

    Took ('scan   ', At);
    At := clock ();

    TheParser := Parser (Tokens);
    TheParser.FileName := SourcePath;

    Stmts := TheParser.Parse ();
    FailIfScanErrors ();

    Took ('parse  ', At);
    At := clock ();

    // The Resolver reports through an Interpreter, so one is made for it even
    // though nothing here interprets anything.
    TheInterpreter := Interpreter ();
    TheInterpreter.RootFile := SourcePath;

    TheResolver := Resolver (TheInterpreter);
    TheResolver.ResolveAll (Stmts);

    Took ('resolve', At);
    At := clock ();

    TypeChecker ().Resolve (Stmts);

    Took ('check  ', At);
    At := clock ();

    var Made := CompileProgram (Stmts);

    Took ('emit   ', At);

    Exit Made;
end

/// A chunk that calls the subprogram in one global slot and answers it.
///
/// Three instructions, built here rather than emitted: a test body is bound to
/// a slot by the compile, and calling it needs no more than a read, a call and
/// a return.
function CallChunk (Slot : Integer) : Chunk;
begin
    var C := Chunk ();

    // The wide form past 255, which is the same split the emitter makes and
    // for the same reason: a program may hold more globals than a byte spans.
    if Slot > 255 then
    begin
        C.Write (OP_GET_GLOBAL_LONG);
        C.Write (Slot div 256);
        C.Write (Slot mod 256);
    end
    else
    begin
        C.Write (OP_GET_GLOBAL);
        C.Write (Slot);
    end

    C.Write (OP_CALL);
    C.Write (0);
    C.Write (OP_RETURN);

    Exit C;
end

/// Runs every test the compile found and answers how many failed.
///
/// The order is the interpreter's and is compared by
/// `conformance/0104-test-collection-and-order`: files in the order they were
/// first seen, which puts an imported module ahead of the file importing it,
/// and names sorted within a file.
///
/// A test that RAISES fails rather than ending the run, which is what lets one
/// broken test leave the rest measurable -- and the raise arrives as a String
/// because that is what the machine turns a runtime error into [STM-020].
///
/// Every line printed here comes from `compiler/TestReport`, which the
/// interpreter prints through as well: the format is compared character for
/// character by 0105 and 0106, so the two cannot be allowed to drift.
function RunEveryTest (RootFile : String) : Integer;
var
    Files  : List;
    ByFile : Map;
    Passed : Integer;
    Failed : Integer;

begin
    var Found := TestsFound ();

    Files  := List ();
    ByFile := Map ();

    for var Each in Found do
    begin
        var Where := Str ((Each as List)[0]);

        if not Files.Contains (Where) then
        begin
            Files.Add (Where);
            ByFile.Put (Where, List ());
        end

        (ByFile.Get (Where) as List).Add (Each);
    end

    WriteLn (TestOpening (Found.Length));

    Passed := 0;
    Failed := 0;

    var Opened := False;

    for var Where in Files do
    begin
        // A blank line before every banner but the first, and one more before
        // the totals.
        if Opened then WriteLn (INFO_TAG);
        Opened := True;

        WriteLn (TestBanner (Str (Where)));

        var Group := ByFile.Get (Str (Where)) as List;

        // Sorted on the NAMES rather than on the entries, which are lists and
        // would order by something no rule mentions.
        var Names := List ();
        for var Each in Group do Names.Add (Str ((Each as List)[1]));
        Names.Sort ();

        for var Name in Names do
        begin
            var Slot := -1;

            for var Each in Group do
                if Str ((Each as List)[1]) = Str (Name) then
                    Slot := (Each as List)[2] as Integer;

            var Said  := '';
            var Broke := False;

            try
                ContinueWith (CallChunk (Slot));
            except
                on E : String do
                begin
                    Broke := True;
                    Said  := E;
                end
            end

            if Broke then
            begin
                Failed := Failed + 1;

                WriteLn (TestLine (Str (Name), 'FAIL'));
                WriteLn (TestFailure (RootFile, Said));
            end
            else
            begin
                Passed := Passed + 1;

                WriteLn (TestLine (Str (Name), 'PASS'));
            end
        end
    end

    WriteLn (INFO_TAG);
    WriteLn (TestTotals (Passed, Failed));

    Exit Failed;
end

/// Prints how to invoke the machine.
///
/// Its own usage rather than algc's, because the two take different flags --
/// the machine has no `--compile`, and algc has none of the tracing.
procedure Usage ();
begin
    WriteLn ('algvm -- the Algol-24 bytecode machine.');
    WriteLn ('');
    WriteLn ('Usage:');
    WriteLn ('  algvm <file.a24> [args]       run a program');
    WriteLn ('  algvm --test <file.a24>       run its test blocks');
    WriteLn ('  algvm --list <file.a24>       disassemble every chunk');
    WriteLn ('  algvm --time <file.a24>       report what compiling and running cost');
    WriteLn ('  algvm --stop <file.a24>       compile and stop, without running');
    WriteLn ('  algvm --collect N <file>      collect every N instructions, 0 for never');
    WriteLn ('  algvm --trace N <file>        keep the last N instructions and dump them on a raise');
    WriteLn ('  algvm --watch TEXT <file>     dump the trace where TEXT is raised, caught or not');
    WriteLn ('  algvm --version               the version');
    WriteLn ('  algvm --help                  this');
    WriteLn ('');
    WriteLn ('Foreign calls are always available, which algc makes a build switch:');
    WriteLn ('a foreign call is a feature of the language, and this binary is built');
    WriteLn ('by someone who already has algc.');
end

// ⚠️ BEFORE the flag loop, because that loop takes the first non-flag argument
// as the program -- so `--version` with no file would otherwise be read as a
// request to run a file called `--version`, which is what it did: `Reset
// failed: cannot open '--version'.`
if ParamCount () < 1 then
begin
    Usage ();
    Halt (2);
end

if ParamStr (1) = '--version' then
begin
    WriteLn ('algvm ' + VERSION);
    Halt (0);
end

if ParamStr (1) = '--help' or ParamStr (1) = '-h' then
begin
    Usage ();
    Halt (0);
end

var SourcePath := ParamStr (1);
var Listing := False;

/// How many instructions `--trace N` should remember, or -1 for none.
///
/// A RING and not a stream: the instruction that matters is deep inside a long
/// run, so the last few hundred are what is wanted. Dumped where a raised
/// value escapes uncaught, which is the moment the machine knows something
/// went wrong.
var Ring : Integer := -1;

/// Whether the next argument is the trace's size.
var WantsTrace := False;

/// Text whose raise should dump the trace, caught or not.
var Watch : String := '';

/// Whether the next argument is that text.
var WantsWatch := False;

/// How many instructions between collections.  `--collect N` overrides it,
/// and `--collect 0` turns collection off.
///
/// A knob on the driver rather than a constant in the machine, because the
/// right number is a measurement and not a fact: marking costs O(live heap),
/// so a program holding a lot pays more per collection and wants fewer of
/// them.
///
/// ON BY DEFAULT, and 2,000,000 is where the measurement put the knee.
/// Compiling the compiler on the machine:
///
///       off          30.59 s   2952 MB
///       5,000,000    32.03 s    780 MB
///   --> 2,000,000    32.38 s    707 MB
///       1,000,000    33.27 s    674 MB
///         200,000    39.59 s    658 MB
///
/// So about 4x less memory for about 6% of the time, and below the knee the
/// time climbs while the memory does not: 200,000 costs five times as much
/// time as 2,000,000 to save 7% more memory.  A program that allocates almost
/// nothing pays the same 5% -- Fib (27) reads 1.29 s off and 1.35 s here --
/// because the counter is tested per instruction either way.
///
/// Every interval emitted byte-identical C, which is what [RT-029] asks of a
/// request: collection changes how much memory a correct program uses and
/// never what it computes.
var Every := 2000000;

/// Whether to compile and stop, for `--stop`.
///
/// What it separates is worth separating: a program's own startup -- loading
/// art, parsing its JSON -- is not the compile, and peak memory before the
/// first frame is both.
var Stopping := False;

var WantsEvery := False;

// The driver's own arguments, read BEFORE anything changes them.
//
// SetProgramArguments replaces what ParamCount and ParamStr answer, so a
// second loop over them after the call reads the PROGRAM's arguments and not
// this file's -- which is how an earlier version re-derived SourcePath from a
// list it had just rewritten.
var Given := List ();

var Seen := False;

/// Whether to run the program's test blocks instead of the program.
///
/// ⚠️ Not `Testing`, which FOLDS to Vm's own `TESTING` [SRC-011] -- the two
/// became one name and the C came out with a static declaration following an
/// extern one. ALL_CAPS is not a namespace.
var WantsTests := False;

for var I : Integer := 1; I <= ParamCount (); I := I + 1 do
    if ParamStr (I) = '--list' then Listing := True;
    else if ParamStr (I) = '--test' then WantsTests := True;
    else if ParamStr (I) = '--time' then Timing := True;
    else if ParamStr (I) = '--stop' then Stopping := True;
    else if ParamStr (I) = '--collect' then WantsEvery := True;
    else if ParamStr (I) = '--trace' then WantsTrace := True;
    else if ParamStr (I) = '--watch' then WantsWatch := True;
    else if WantsEvery then
    begin
        Every := Val (ParamStr (I)) as Integer;
        WantsEvery := False;
    end
    else if WantsTrace then
    begin
        Ring := Val (ParamStr (I)) as Integer;
        WantsTrace := False;
    end
    else if WantsWatch then
    begin
        Watch := Str (ParamStr (I));
        WantsWatch := False;
    end
    else
    begin
        // The FIRST non-flag argument is the program; the rest are its own,
        // and taking the last one instead made `algvm prog.a24 a b` try to
        // open 'b' as the source.
        if not Seen then
        begin
            SourcePath := ParamStr (I);
            Seen := True;
        end

        Given.Add (ParamStr (I));
    end

// Asked BEFORE compiling: the survey has to claim a slot for every test body
// it is going to bind, and the main block has to be left out of the script.
if WantsTests then
begin
    WantTests (SourcePath);
    SetTesting (True);
end

// BEFORE the chunk is built, because building it parses -- and before
// SetArguments below, which replaces what ParamStr (0) answers.  The machine
// is a second binary, so it asks the same question of its own path that algc
// asks of its.
SetModuleFolders (LibraryFolders ());

var Program := ChunkOf (SourceOf (SourcePath), SourcePath);

// What the PROGRAM sees, and not what this driver was given: run as
// `algvm prog.a24 a b` a program must find ParamCount () = 2 and ParamStr (0)
// = 'prog.a24', exactly as it would run directly.
//
// The MACHINE is told, not the interpreter: SetProgramArguments sets what the
// tree-walker reads, and the machine forwards a built-in to the HOST, whose
// answer is about this driver's process instead.
// Compiled and nothing more, so what the COMPILE costs can be told from what
// the program's own loading costs.
if Stopping then Halt (0);

SetArguments (Given);

// Before the run, so the first collection honours it.
if Every >= 0 then SetCollectEvery (Every);

// And before the run for the same reason: a trace of the instructions after
// the failure would be no use.
if Ring > 0 then SetTraceRoom (Ring);
if Watch <> '' then SetTraceWatch (Watch);

if Listing then
begin
    // A disassembly, which is the first thing wanted when a chunk misbehaves.
    //
    // ⚠️ EVERY chunk, not just the script's.  A nested subprogram's body is a
    // constant of the chunk that declares it, so listing only the root showed
    // nothing of the code that actually misbehaves -- and a method's body is
    // where a slot question gets answered.
    var Pending := [Program];
    var Labels  := ['<script>'];
    var Seen    := 0;

    while Seen < Pending.Length do
    begin
        var Chunky := Pending[Seen] as Chunk;

        WriteLn ('== ' + Str (Labels[Seen]) + ' ==');

        // Anything callable among the constants is a chunk of its own, queued
        // before this one is walked so the order reads top-down.
        for var K : Integer := 0; K < Chunky.Constants.Length; K := K + 1 do
        begin
            var Held := Chunky.Constants[K];

            if Held is VmFunction then
            begin
                Pending.Add (Held.Body);
                Labels.Add (Str (Held.Name));
            end
        end

    var At : Integer := 0;
    while At < Chunky.Count do
    begin
        var Op := Chunky.At (At);
        var Line := Str (At) + '  ' + OpName (Op);

        // OP_LONG is a PREFIX: its operand is the whole instruction after it,
        // whose constant index is then two bytes.  Rendered as the prefix and
        // then the instruction, which is what the bytes are.
        var Widened := Op = OP_LONG;

        if Widened then
        begin
            WriteLn (Line);

            At   := At + 1;
            Op   := Chunky.At (At);
            Line := Str (At) + '  ' + OpName (Op);
        end


        // OP_CLOSURE is the one variable-width instruction -- a constant
        // index, a capture count as a SHORT, then a descriptor per capture: a
        // flag byte saying whether it comes from this frame's own slot or from
        // a cell this frame captured, and a short for which -- and OpOperands
        // answers 0 for it.  Walking it as a one-byte instruction put every
        // later offset out by the captures, so a disassembly of a chunk with a
        // nested subprogram in it was fiction after that point.
        if Op = OP_CLOSURE then
        begin
            // Its index widens under the prefix like any other, so where the
            // capture count sits depends on that.
            var Index := At + 1;
            var After := At + 2;

            var Named := Str (Chunky.At (Index));

            if Widened then
            begin
                Named := Str ((Chunky.At (Index) as Integer) * 256
                            + (Chunky.At (Index + 1) as Integer));
                After := At + 3;
            end

            var Taken := (Chunky.At (After) as Integer) * 256
                       + (Chunky.At (After + 1) as Integer);

            Line := Line + ' ' + Named + ' ' + Str (Taken);

            // Three bytes a descriptor, rendered as `local:N` or `cell:N` --
            // a bare number could not tell the two apart, and which one it is
            // is the whole of what the flag carries.
            for var I : Integer := 0; I < Taken; I := I + 1 do
            begin
                var Where := After + 2 + I * 3;
                var Index := (Chunky.At (Where + 1) as Integer) * 256
                           + (Chunky.At (Where + 2) as Integer);

                if Chunky.At (Where) <> 0 then
                    Line := Line + ' local:' + Str (Index);
                else Line := Line + ' cell:' + Str (Index);
            end

            WriteLn (Line);

            At := After + 2 + Taken * 3;

            continue;
        end

        // Walked from the opcode's SHAPE, one letter per operand, because a
        // pair of bytes is not always one number -- `OP_INVOKE` carries a
        // name's index beside a count where `OP_JUMP` carries a distance, and
        // `OP_EXTEND` carries a byte and a short together.
        var Where := At + 1;
        var Shape := OpShape (Op);

        // Two bytes for a short, and for an INDEX under the prefix; one for
        // anything else.  Walked rather than totalled, because the width
        // depends on the prefix and on which operand the index is.
        for var I : Integer := 0; I < Length (Shape); I := I + 1 do
            if Shape[I] = 's'
                   or (Widened and (Shape[I] = 'i' or Shape[I] = 'l')) then
            begin
                Line  := Line + ' ' + Str ((Chunky.At (Where) as Integer) * 256
                                         + (Chunky.At (Where + 1) as Integer));
                Where := Where + 2;
            end
            else
            begin
                Line  := Line + ' ' + Str (Chunky.At (Where));
                Where := Where + 1;
            end

        WriteLn (Line);

        At := Where;
    end

    WriteLn ('');

        WriteLn ('');

        Seen := Seen + 1;
    end

end

/// Reports an uncaught runtime error with the instruction it happened on, and
/// stops with status 70 [ERR-009].
///
/// Worded exactly as the interpreter's driver words it: the sentence is what
/// every recorded case compares, and only the second line is new.  The
/// location is a second LINE rather than part of the message because a runtime
/// error is catchable [STM-020] and arrives as a String, so putting it in the
/// message would change every handler that prints one.
procedure ReportRuntime (Message : String);
begin
    ErrorLn ('Uncaught: ' + Message);

    if SITE_LINE > 0 then
        ErrorLn ('       at ' + SITE_FILE + ':' + Str (SITE_LINE));

    Halt (70);
end

// THE TEST RUN.  The script defines every declaration, test bodies included --
// its own statements are left out of the compile -- and then each body is
// called in the report's order.
// WHERE A RUNTIME ERROR HAPPENED, which only a driver can report: the runtime
// produces the message and is handed values and nothing else [ERR-003].  The
// machine recovers the site from its own IP where the raise escapes, so this
// costs nothing until something fails.
//
// ⚠️ COMPILED Algol-24 reports no location, by decision, and conform.sh drops
// the 'at' line from both sides for that reason.
try
    RunChunk (Program);
except
    on e : String do ReportRuntime (e);
    on e : Any    do ReportRuntime (Str (e));
end

// 70 and not the count, which is the status a failing test run exits with
// [TST-013] and what the other two processors answer.
if WantsTests then
    if RunEveryTest (SourcePath) > 0 then Halt (70);
