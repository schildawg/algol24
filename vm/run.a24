/// Runs a program on the bytecode machine.
///
///     algvm program.a24
///
/// A SECOND BINARY rather than a mode of algc, which is what PROPOSAL-VM.md
/// prefers and what `uses` taking a path makes possible today: the compiler's
/// front end is imported from here instead of this being imported into it.
/// So nothing in `compiler/` changes, the VM stays out of the seed in
/// `bootstrap/`, and a change to an opcode needs no reseed.
///
/// It parses the source itself rather than reading bytecode, because there is
/// no bytecode file format yet.  When there is, this splits in two along the
/// line the proposal draws -- `algc --emit` writing it and this reading it --
/// and the front-end imports below are what goes away.
///
/// The order of the imports is Main.a24's order and must stay that way: a
/// module's functions close over the environment its file was loaded in, so
/// TypeChecker has to come after Parser to reach it.

uses 'compiler/Token';
uses 'compiler/TokenType';

uses 'compiler/Expr';
uses 'compiler/Stmt';

uses 'compiler/Environment';
uses 'compiler/ObjFunction';
uses 'compiler/ObjClass';
uses 'compiler/ObjInstance';
uses 'compiler/ObjEnum';
uses 'compiler/ObjCollection';
uses 'compiler/ObjBuffer';
uses 'compiler/ObjFile';
uses 'compiler/SourceCode';
uses 'compiler/Console';

uses 'compiler/Scanner';
uses 'compiler/Parser';

uses 'compiler/TypeChecker';

uses 'compiler/Resolver';
uses 'compiler/Interpreter';

uses 'compiler/VmEmitter';

uses OpCode;
uses Chunk;
uses Vm;

/// Reads a whole file as one String.
///
/// # Raises
///
/// Whatever Reset raises when the file cannot be opened.
function SourceOf (SourcePath : String) : String;
var
    Handle : TextFile;
    Accum  : Buffer;

begin
    Handle := TextFile ();
    Handle.Assign (SourcePath);
    Handle.Reset ();

    // `Buffer ()` and not `Buffer (1024)`: a size pre-fills with that many
    // ZERO bytes, which Append then adds after -- and a Buffer holding a zero
    // byte has no Text.  A size is right for the code array in Chunk, which is
    // indexed, and wrong for anything accumulated.
    Accum := Buffer ();

    while not Handle.Eof do
    begin
        Accum.Append (Handle.ReadLn ());
        Accum.Append (#10);
    end

    Handle.Close ();

    // `.Text` and not `Str (Accum)`.  Str answers a Buffer's PRINTED form --
    // `Buffer(1041)` -- which parsed as a program and failed on the bracket.
    // The same trap as `Length (B)`; see DEF-36.
    Exit Accum.Text;
end

/// Fails the run if anything scanned badly.
///
/// A scan error is RECORDED rather than thrown -- the Scanner sets HadError and
/// keeps the message -- so every driver has to ask.  This one did not, and the
/// corpus found it immediately: `0006-line-endings-lf` expects `Unexpected
/// character: $` and the VM ran the program with the character silently
/// dropped, which is the exact failure Main.a24's own FailIfScanErrors was written
/// for.
///
/// Called TWICE, as Main.a24 calls it: once after scanning for the right
/// message, and once after parsing so that a module loaded by `uses` is
/// covered too.
///
/// # Raises
///
/// The scanner's last message, unchanged.
procedure FailIfScanErrors ();
begin
    if HadError then raise Str (LastError);
end

/// Parses, checks and compiles a program, answering its chunk.
///
/// The front end is the compiler's own, unchanged, which is the invariant the
/// three back ends rest on: a program that fails to parse or type-check fails
/// identically whichever one is asked for.
function ChunkOf (Source : String, SourcePath : String) : Chunk;
var
    TheScanner     : Scanner;
    TheParser      : Parser;
    TheResolver    : Resolver;
    TheInterpreter : Interpreter;

    Tokens : List;
    Stmts  : List;

begin
    SourceCode.Begins (SourcePath);

    TheScanner := Scanner (Source);
    Tokens := TheScanner.ScanTokens ();
    FailIfScanErrors ();

    TheParser := Parser (Tokens);
    TheParser.FileName := SourcePath;

    Stmts := TheParser.Parse ();
    FailIfScanErrors ();

    // The Resolver reports through an Interpreter, so one is made for it even
    // though nothing here interprets anything.
    TheInterpreter := Interpreter ();
    TheInterpreter.RootFile := SourcePath;

    TheResolver := Resolver (TheInterpreter);
    TheResolver.ResolveAll (Stmts);

    TypeChecker ().Resolve (Stmts);

    Exit CompileProgram (Stmts);
end

if ParamCount () < 1 then
begin
    WriteLn ('usage: algvm <program.a24>');
    Halt (2);
end

var SourcePath := ParamStr (1);
var Listing := False;

// The driver's own arguments, read BEFORE anything changes them.
//
// SetProgramArguments replaces what ParamCount and ParamStr answer, so a
// second loop over them after the call reads the PROGRAM's arguments and not
// this file's -- which is how an earlier version re-derived SourcePath from a
// list it had just rewritten.
var Given := List ();

var Seen := False;

for var I : Integer := 1; I <= ParamCount (); I := I + 1 do
    if ParamStr (I) = '--list' then Listing := True;
    else
    begin
        // The FIRST non-flag argument is the program; the rest are its own,
        // and taking the last one instead made `algvm prog.a24 a b` try to
        // open 'b' as the source.
        if not Seen then
        begin
            SourcePath := ParamStr (I);
            Seen := True;
        end

        Given.Add (ParamStr (I));
    end

var Program := ChunkOf (SourceOf (SourcePath), SourcePath);

// What the PROGRAM sees, and not what this driver was given: run as
// `algvm prog.a24 a b` a program must find ParamCount () = 2 and ParamStr (0)
// = 'prog.a24', exactly as it would run directly.
//
// The MACHINE is told, not the interpreter: SetProgramArguments sets what the
// tree-walker reads, and the machine forwards a built-in to the HOST, whose
// answer is about this driver's process instead.
SetArguments (Given);

if Listing then
begin
    // A disassembly, which is the first thing wanted when a chunk misbehaves.
    WriteLn ('== ' + SourcePath + ' ==');

    var At : Integer := 0;
    while At < Program.Count do
    begin
        var Op := Program.At (At);
        var Line := Str (At) + '  ' + OpName (Op);
        var Wide := OpOperands (Op);

        // OP_CLOSURE is the one variable-width instruction -- a constant
        // index, a capture count, then one enclosing slot per capture -- and
        // OpOperands answers 0 for it.  Walking it as a one-byte instruction
        // put every later offset out by the captures, so a disassembly of a
        // chunk with a nested subprogram in it was fiction after that point.
        if Op = OP_CLOSURE then
        begin
            var Taken := Program.At (At + 2);

            Line := Line + ' ' + Str (Program.At (At + 1)) + ' ' + Str (Taken);

            for var I : Integer := 0; I < Taken; I := I + 1 do
                Line := Line + ' ' + Str (Program.At (At + 3 + I));

            WriteLn (Line);

            At := At + 3 + Taken;

            continue;
        end

        // Walked from the opcode's SHAPE, one letter per operand, because a
        // pair of bytes is not always one number -- `OP_INVOKE` carries a
        // name's index beside a count where `OP_JUMP` carries a distance, and
        // `OP_EXTEND` carries a byte and a short together.
        var Where := At + 1;
        var Shape := OpShape (Op);

        for var I : Integer := 0; I < Length (Shape); I := I + 1 do
            if Shape[I] = 's' then
            begin
                Line  := Line + ' ' + Str ((Program.At (Where) as Integer) * 256
                                         + (Program.At (Where + 1) as Integer));
                Where := Where + 2;
            end
            else
            begin
                Line  := Line + ' ' + Str (Program.At (Where));
                Where := Where + 1;
            end

        WriteLn (Line);

        At := At + 1 + Wide;
    end

    WriteLn ('');
end

RunChunk (Program);
